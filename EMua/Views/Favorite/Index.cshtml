@model List<EMua.ViewModels.FavoriteItemViewModel>
@{
    ViewData["Title"] = "Sản phẩm yêu thích";
    var viCulture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");

    string FixImageUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return "/images/no-image.png";

        url = url.Trim().Replace("\\", "/");

        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return url;

        if (!url.StartsWith("/"))
            url = "/" + url;

        return url;
    }
}

<link rel="stylesheet" href="~/css/home-refresh.css" asp-append-version="true" />

<style>
    .emua-favorite-page {
        background: var(--ep-bg, #fafaf9);
        min-height: calc(100vh - 240px);
        padding: 32px 0 60px;
    }

    .fav-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        margin-bottom: 24px;
        flex-wrap: wrap;
    }

    .fav-header-left {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .fav-back-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        background: #ffffff;
        border: 1px solid var(--ep-border, #e7e5e4);
        color: var(--ep-text, #1c1917);
        text-decoration: none;
        transition: all 0.2s ease;
    }

    .fav-back-btn:hover {
        background: var(--ep-blue-light, #eff6ff);
        border-color: var(--ep-blue, #2563eb);
        color: var(--ep-blue, #2563eb);
        transform: translateX(-2px);
    }

    .fav-title {
        font-size: clamp(20px, 2.2vw, 26px);
        font-weight: 800;
        letter-spacing: -0.5px;
        color: var(--ep-text, #1c1917);
        margin: 0;
    }

    .fav-badge-count {
        font-size: 12px;
        font-weight: 700;
        color: var(--ep-blue, #2563eb);
        background: var(--ep-blue-light, #eff6ff);
        padding: 4px 12px;
        border-radius: var(--ep-radius-pill, 9999px);
        border: 1px solid rgba(37, 99, 235, 0.15);
    }

    /* Product Grid — 4 columns desktop, 2 tablet, 1-2 mobile */
    .fav-products-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
    }

    /* Card styling using .ep-card system */
    .fav-card {
        position: relative;
    }

    /* Floating remove action button on top right of the card image */
    .fav-card-remove-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.95);
        border: 1px solid #fee2e2;
        color: #ef4444;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: all 0.2s ease;
        z-index: 3;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.08);
    }

    .fav-card-remove-btn:hover {
        background: #ef4444;
        color: #ffffff;
        border-color: #ef4444;
        transform: scale(1.08);
        box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);
    }

    /* Detail button inside card */
    .fav-btn-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        width: 100%;
        padding: 9px 16px;
        min-height: 38px;
        border-radius: var(--ep-radius-pill, 9999px);
        background: var(--ep-blue, #2563eb);
        color: #ffffff !important;
        font-size: 13px;
        font-weight: 650;
        text-decoration: none;
        border: none;
        transition: all 0.2s ease;
    }

    .fav-btn-action:hover {
        background: var(--ep-blue-hover, #1d4ed8);
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
        transform: translateY(-1px);
    }

    /* Empty state */
    .fav-empty-card {
        background: #ffffff;
        border: 1px dashed var(--ep-border, #e7e5e4);
        border-radius: var(--ep-radius-lg, 20px);
        padding: 56px 24px;
        text-align: center;
        max-width: 520px;
        margin: 24px auto;
        box-shadow: var(--ep-shadow-sm, 0 1px 4px rgba(28, 25, 23, 0.04));
    }

    .fav-empty-icon {
        width: 68px;
        height: 68px;
        border-radius: 50%;
        background: var(--ep-blue-light, #eff6ff);
        color: var(--ep-blue, #2563eb);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        margin-bottom: 16px;
    }

    .fav-empty-card h2 {
        font-size: 20px;
        font-weight: 800;
        color: var(--ep-text, #1c1917);
        margin-bottom: 8px;
    }

    .fav-empty-card p {
        font-size: 14px;
        color: var(--ep-muted, #78716c);
        margin-bottom: 24px;
        line-height: 1.55;
    }

    .fav-empty-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 26px;
        border-radius: var(--ep-radius-pill, 9999px);
        background: var(--ep-blue, #2563eb);
        color: #ffffff !important;
        font-size: 14px;
        font-weight: 650;
        text-decoration: none;
        box-shadow: 0 4px 14px rgba(37, 99, 235, 0.35);
        transition: all 0.2s ease;
    }

    .fav-empty-btn:hover {
        background: var(--ep-blue-hover, #1d4ed8);
        transform: translateY(-2px);
    }

    /* Alert */
    .fav-alert {
        padding: 12px 16px;
        border-radius: 12px;
        margin-bottom: 20px;
        font-size: 13.5px;
        font-weight: 550;
        background: #f0fdf4;
        border: 1px solid #bbf7d0;
        color: #166534;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    /* Responsive */
    @@media (max-width: 1100px) {
        .fav-products-grid {
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }

    @@media (max-width: 768px) {
        .fav-products-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 12px;
        }

        .fav-header {
            margin-bottom: 18px;
        }
    }

    @@media (max-width: 480px) {
        .fav-products-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="emua-favorite-page">
    <div class="ep-container">

        <!-- Header -->
        <header class="fav-header">
            <div class="fav-header-left">
                <a asp-controller="Home" asp-action="Index" class="fav-back-btn" title="Về trang chủ">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <h1 class="fav-title">Sản phẩm yêu thích</h1>
                @if (Model != null && Model.Count > 0)
                {
                    <span class="fav-badge-count">@Model.Count sản phẩm</span>
                }
            </div>

            <a class="ep-text-link" asp-controller="Product" asp-action="Index">
                <span>Khám phá thêm</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </header>

        <!-- Thông báo thao tác -->
        @if (TempData["Success"] != null)
        {
            <div class="fav-alert" role="status">
                <div>
                    <i class="bi bi-check-circle-fill me-2 text-success"></i>@TempData["Success"]
                </div>
                <button type="button" class="btn-close btn-sm" onclick="this.parentElement.remove()" aria-label="Đóng"></button>
            </div>
        }

        <!-- Empty State -->
        @if (Model == null || Model.Count == 0)
        {
            <div class="fav-empty-card">
                <div class="fav-empty-icon">
                    <i class="bi bi-heart"></i>
                </div>
                <h2>Danh sách yêu thích đang trống</h2>
                <p>Lưu lại những thiết bị công nghệ bạn quan tâm để dễ dàng theo dõi, so sánh và nhận thông báo ưu đãi tốt nhất.</p>
                <a asp-controller="Product" asp-action="Index" class="fav-empty-btn">
                    <i class="bi bi-bag-plus"></i> Khám phá sản phẩm
                </a>
            </div>
        }
        else
        {
            <!-- Product Grid -->
            <div class="fav-products-grid">
                @foreach (var item in Model)
                {
                    var hasDiscount = item.OriginalPrice.HasValue && item.OriginalPrice.Value > item.Price && item.Price > 0;
                    var discountPercent = hasDiscount ? (int)Math.Round((1m - (item.Price / item.OriginalPrice!.Value)) * 100m) : 0;
                    var isStock = item.InStock;
                    var name = item.ProductName;
                    var image = FixImageUrl(item.ImageUrl);

                    <article class="ep-card fav-card">
                        <!-- Nút Xóa yêu thích (gọn gàng, góc trên bên phải) -->
                        <form asp-controller="Favorite" asp-action="Remove" method="post" style="margin: 0;">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" class="fav-card-remove-btn" title="Xóa khỏi yêu thích" onclick="return confirm('Bạn có chắc muốn xóa sản phẩm này khỏi danh sách yêu thích?');">
                                <i class="bi bi-heart-fill"></i>
                            </button>
                        </form>

                        <!-- Ảnh sản phẩm -->
                        <a class="ep-picture" asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" aria-label="Xem @name">
                            @if (hasDiscount)
                            {
                                <span class="ep-chip ep-chip-discount">-@discountPercent%</span>
                            }
                            else
                            {
                                <span class="ep-chip ep-chip-blue">Yêu thích</span>
                            }

                            <img src="@image" alt="@name" loading="lazy" decoding="async" onerror="this.onerror=null; this.src='/images/no-image.png';" />
                        </a>

                        <!-- Nội dung thẻ -->
                        <div class="ep-card-body">
                            <div class="ep-card-meta">
                                <span class="ep-brand">@(item.BrandName ?? "EMUA")</span>
                                <span class="ep-stock-status @(isStock ? "" : "ep-stock-out")">
                                    <span class="ep-stock-dot"></span>
                                    @(isStock ? "Còn hàng" : "Hết hàng")
                                </span>
                            </div>

                            <a class="ep-product-name" asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" title="@name">
                                @name
                            </a>

                            <p class="ep-spec">@(item.CategoryName ?? "Thiết bị chính hãng")</p>

                            <div class="ep-buy">
                                <div class="ep-price-block">
                                    <div class="ep-price-row">
                                        <span class="ep-price">@(item.Price > 0 ? item.Price.ToString("N0", viCulture) + " ₫" : "Liên hệ")</span>
                                        @if (hasDiscount)
                                        {
                                            <span class="ep-original-price">@item.OriginalPrice!.Value.ToString("N0", viCulture) ₫</span>
                                        }
                                    </div>
                                </div>

                                <div class="ep-card-actions" style="grid-template-columns: 1fr;">
                                    <a class="fav-btn-action" asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId">
                                        <i class="bi bi-eye"></i>
                                        <span>Xem chi tiết</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</div>
