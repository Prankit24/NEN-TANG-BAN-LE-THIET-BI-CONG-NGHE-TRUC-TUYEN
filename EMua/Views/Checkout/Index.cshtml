@using System.Globalization
@model EMua.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Thanh toán";
}

@section Scripts {
    <script src="~/js/checkout.js" asp-append-version="true"></script>
}

<link rel="stylesheet" href="~/css/home/checkout.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/home/checkout-payment.css" asp-append-version="true" />

<div class="checkout-page"
     data-subtotal="@Model.Subtotal.ToString(CultureInfo.InvariantCulture)"
     data-shipping="@Model.ShippingFee.ToString(CultureInfo.InvariantCulture)">

    @Html.AntiForgeryToken()

    <div class="container emua-container">

        <div class="checkout-breadcrumb">
            <a asp-controller="Home" asp-action="Index">
                Trang chủ
            </a>

            <i class="bi bi-chevron-right"></i>

            <span>Thanh toán</span>
        </div>

        <h1>Thanh toán</h1>


        @if (!Model.Items.Any())
        {
            <div class="checkout-empty">

                <i class="bi bi-cart-x"></i>

                <h3>Giỏ hàng đang trống</h3>

                <p>
                    Hãy thêm sản phẩm vào giỏ hàng trước khi thanh toán.
                </p>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-dark">

                    Tiếp tục mua sắm

                </a>

            </div>
        }
        else
        {
            <div id="checkoutAlert"></div>

            <div class="checkout-grid">

                <!-- ==================================================
                     BÊN TRÁI
                =================================================== -->

                <section class="checkout-left">


                    <!-- THÔNG TIN NHẬN HÀNG -->

                    <div class="checkout-card">

                        <h2>
                            Thông tin nhận hàng
                        </h2>

                        <div class="form-grid">

                            <div>

                                <label for="fullName">
                                    Họ và tên
                                    <span>*</span>
                                </label>

                                <input id="fullName"
                                       value="@Model.FullName"
                                       placeholder="Nhập họ và tên" />

                            </div>


                            <div>

                                <label for="phoneNumber">
                                    Số điện thoại
                                    <span>*</span>
                                </label>

                                <input id="phoneNumber"
                                       value="@Model.PhoneNumber"
                                       placeholder="Nhập số điện thoại" />

                            </div>


                            <div class="full-width">

                                <label for="address">
                                    Địa chỉ nhận hàng
                                    <span>*</span>
                                </label>

                                <input id="address"
                                       value="@Model.Address"
                                       placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố" />

                            </div>

                        </div>

                    </div>


                    <!-- SẢN PHẨM -->

                    <div class="checkout-card product-card">

                        <h2>
                            Sản phẩm sẽ đặt mua

                            <small>
                                (@Model.Items.Sum(x => x.Quantity) sản phẩm)
                            </small>
                        </h2>


                        @foreach (var item in Model.Items)
                        {
                            <div class="checkout-product">

                                @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                {
                                    <img src="@item.ImageUrl"
                                         alt="@item.ProductName" />
                                }
                                else
                                {
                                    <div class="product-image-placeholder">

                                        <i class="bi bi-image"></i>

                                    </div>
                                }


                                <div class="product-info">

                                    <strong>
                                        @item.ProductName
                                    </strong>

                                    <span>
                                        @item.VariantName
                                    </span>

                                </div>


                                <div>

                                    <span>
                                        Đơn giá
                                    </span>

                                    <strong>
                                        @item.UnitPrice.ToString("N0") ₫
                                    </strong>

                                </div>


                                <div>

                                    <span>
                                        Số lượng
                                    </span>

                                    <strong>
                                        x @item.Quantity
                                    </strong>

                                </div>


                                <div class="line-total">

                                    <span>
                                        Thành tiền
                                    </span>

                                    <strong>
                                        @item.LineTotal.ToString("N0") ₫
                                    </strong>

                                </div>

                            </div>
                        }

                </div>


                <!-- MÃ GIẢM GIÁ -->

                <div class="checkout-card coupon-card">

                    <h2>
                        Mã giảm giá
                    </h2>

                    <div class="coupon-row">

                        <i class="bi bi-ticket-perforated"></i>

                        <input id="couponCode"
                               placeholder="Nhập mã giảm giá" />

                        <button id="applyCoupon"
                                type="button">

                            Áp dụng

                        </button>

                    </div>

                    <small id="couponMessage"></small>

                </div>

            </section>



            <!-- ==================================================
                 BÊN PHẢI
            =================================================== -->

            <aside class="checkout-right">


                <!-- PAYMENT -->

                <div class="checkout-card payment-card">

                    <h2>
                        Phương thức thanh toán
                    </h2>


                    <label class="payment-option active">

                        <input type="radio"
                               name="paymentMethod"
                               value="MBBANK"
                               checked />

                        <i class="bi bi-bank"></i>

                        <span>

                            <strong>
                                MB Bank QR
                            </strong>

                            <small>
                                Quét mã để chuyển khoản, tự điền số tiền và nội dung
                            </small>

                        </span>

                    </label>


                    <label class="payment-option">

                        <input type="radio"
                               name="paymentMethod"
                               value="MOMO" />

                        <i class="bi bi-wallet2"></i>

                        <span>

                            <strong>
                                Ví điện tử MoMo
                            </strong>

                            <small>
                                Thanh toán qua ứng dụng MoMo
                            </small>

                        </span>

                    </label>


                    <label class="payment-option">

                        <input type="radio"
                               name="paymentMethod"
                               value="CARD" />

                        <i class="bi bi-credit-card"></i>

                        <span>

                            <strong>
                                Thẻ ngân hàng
                            </strong>

                            <small>
                                Demo thanh toán qua thẻ ngân hàng
                            </small>

                        </span>

                    </label>


                    <label class="payment-option">

                        <input type="radio"
                               name="paymentMethod"
                               value="COD" />

                        <i class="bi bi-cash-stack"></i>

                        <span>

                            <strong>
                                Thanh toán khi nhận hàng (COD)
                            </strong>

                            <small>
                                Thanh toán bằng tiền mặt khi nhận hàng
                            </small>

                        </span>

                    </label>

                </div>


                <!-- NOTE -->

                <div class="checkout-card">

                    <h2>
                        Ghi chú đơn hàng
                    </h2>

                    <textarea id="note"
                              rows="3"
                              placeholder="Nhập ghi chú (nếu có)..."></textarea>

                </div>


                <!-- SUMMARY -->

                <div class="checkout-card summary-card">

                    <h2>
                        Tổng thanh toán
                    </h2>


                    <div>

                        <span>
                            Tạm tính
                        </span>

                        <strong id="subtotalText">
                            @Model.Subtotal.ToString("N0") ₫
                        </strong>

                    </div>


                    <div>

                        <span>
                            Giảm giá
                        </span>

                        <strong id="discountText">
                            -0 ₫
                        </strong>

                    </div>


                    <div>

                        <span>
                            Phí vận chuyển
                        </span>

                        <strong id="shippingText">

                            @(Model.ShippingFee == 0
                                                        ? "Miễn phí"
                                                        : $"{Model.ShippingFee:N0} ₫")

                        </strong>

                        </div>


                        <div class="grand-total">

                            <span>
                                Tổng thanh toán
                            </span>

                            <strong id="totalText">
                                @Model.Total.ToString("N0") ₫
                            </strong>

                        </div>


                        <button id="placeOrder"
                                type="button">

                            Đặt hàng

                            <i class="bi bi-arrow-right"></i>

                        </button>

                    </div>

                </aside>

            </div>
                }

    </div>

</div>



<!-- ==================================================
     PAYMENT MODAL
=================================================== -->

<div class="modal fade"
     id="paymentGuideModal"
     tabindex="-1">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">


            <div class="modal-header">

                <h5 class="modal-title">
                    Quét mã để thanh toán
                </h5>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal">
                </button>

            </div>


            <div class="modal-body text-center">

                <img id="paymentQrImage"
                     class="payment-qr-image"
                     alt="Mã QR thanh toán" />


                <h5 id="paymentGuideTitle"
                    class="mt-3">
                </h5>


                <p id="paymentGuideText"
                   class="mb-0 text-muted">
                </p>


                <div id="paymentTransferNote"
                     class="payment-transfer-note">
                </div>

            </div>


            <div class="modal-footer">

                <a id="orderSuccessLink"
                   class="btn btn-dark"
                   asp-controller="Account"
                   asp-action="Profile">

                    Xem hồ sơ đơn hàng

                </a>

            </div>

        </div>

    </div>

</div>