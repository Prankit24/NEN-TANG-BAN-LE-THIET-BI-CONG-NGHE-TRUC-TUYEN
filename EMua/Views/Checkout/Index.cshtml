@model EMua.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Thanh toán - Thông tin giao hàng";
}

<link rel="stylesheet" href="~/css/customer/payment.css" asp-append-version="true" />
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

<div class="customer-page container py-4">
    <partial name="_CheckoutSteps" model="1" />

    <div class="customer-heading compact">
        <div>
            <span class="eyebrow">BƯỚC 1 / 3</span>
            <h1>Thông tin giao hàng</h1>
            <p>Vui lòng điền thông tin người nhận và địa chỉ giao hàng.</p>
        </div>
    </div>

    @if (Model.Items == null || !Model.Items.Any())
    {
        <div class="checkout-empty text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h3 class="mt-3">Giỏ hàng đang trống</h3>
            <p class="text-muted">Hãy thêm sản phẩm vào giỏ hàng trước khi thanh toán.</p>
            <a asp-controller="Home" asp-action="Index" class="customer-button mt-2">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <form asp-action="Index" method="post" class="checkout-review-layout">
            @Html.AntiForgeryToken()

            <section class="form-panel">
                <h2>Thông tin nhận hàng</h2>

                <div class="form-group mb-3">
                    <label asp-for="RecipientName" class="form-label">Họ và tên <span>*</span></label>
                    <input asp-for="RecipientName" class="form-control" placeholder="Nhập họ và tên người nhận" />
                    <span asp-validation-for="RecipientName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="RecipientPhone" class="form-label">Số điện thoại <span>*</span></label>
                    <input asp-for="RecipientPhone" class="form-control" placeholder="Nhập số điện thoại (VD: 0905123456)" />
                    <span asp-validation-for="RecipientPhone" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                        <label asp-for="ShippingAddress" class="form-label mb-0">Địa chỉ nhận hàng <span>*</span></label>
                        <button type="button" id="btnSelectOnMap" class="btn btn-outline-primary btn-sm"><i class="bi bi-geo-alt me-1"></i>Chọn địa chỉ trên bản đồ</button>
                    </div>
                    <input asp-for="ShippingAddress" id="shippingAddressInput" class="form-control" autocomplete="street-address" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..." />
                    <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                    <div id="locationFeedback" class="form-text" role="status" aria-live="polite">
                        Định vị có thể chưa chính xác đến số nhà. Vui lòng kiểm tra địa chỉ trước khi tiếp tục.
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Note" class="form-label">Ghi chú đơn hàng</label>
                    <textarea asp-for="Note" class="form-control" rows="3" placeholder="Ghi chú thêm về địa chỉ hoặc thời gian giao hàng (nếu có)..."></textarea>
                </div>

                <h2>Phương thức giao hàng</h2>
                <div class="form-check mb-2">
                    <input type="radio" asp-for="ShippingMethod" value="STANDARD" id="shipStandard" class="form-check-input" />
                    <label for="shipStandard" class="form-check-label">
                        <strong>Giao tiêu chuẩn</strong> - Miễn phí
                    </label>
                </div>
                <div class="form-check mb-3">
                    <input type="radio" asp-for="ShippingMethod" value="EXPRESS" id="shipExpress" class="form-check-input" />
                    <label for="shipExpress" class="form-check-label">
                        <strong>Giao nhanh 2 giờ</strong> - 25.000 đ
                    </label>
                </div>
            </section>

            <aside class="summary-card">
                <h2>Tóm tắt đơn hàng</h2>
                <div class="summary-line">
                    <span>Số lượng</span>
                    <strong>@Model.Items.Sum(x => x.Quantity) sản phẩm</strong>
                </div>
                <div class="summary-line">
                    <span>Tạm tính</span>
                    <strong>@Model.Subtotal.ToString("N0") đ</strong>
                </div>
                <div class="summary-line discount">
                    <span>Giảm giá</span>
                    <strong>-@Model.Discount.ToString("N0") đ</strong>
                </div>
                <div class="summary-line">
                    <span>Vận chuyển</span>
                    <strong id="summaryShipping">@(Model.ShippingFee == 0 ? "Miễn phí" : $"{Model.ShippingFee:N0} đ")</strong>
                </div>
                <hr />
                <div class="summary-total">
                    <span>Tổng tạm tính</span>
                    <strong id="summaryTotal">@Model.Total.ToString("N0") đ</strong>
                </div>

                <div class="review-actions mt-3">
                    <button class="customer-button w-100" type="submit">
                        Tiếp tục: Chọn PTTT <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </aside>
        </form>
    }
</div>


<div class="modal fade" id="addressMapModal" tabindex="-1" aria-labelledby="addressMapTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header"><h5 class="modal-title" id="addressMapTitle">Chọn địa chỉ giao hàng</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <div class="modal-body">
                <button type="button" id="mapUseMyLocation" class="btn btn-outline-primary btn-sm mb-3"><i class="bi bi-crosshair me-1"></i>Dùng vị trí hiện tại</button>
                <div class="input-group mb-2"><input id="mapSearchText" class="form-control" placeholder="Tìm tên đường, địa điểm, phường/xã..." aria-label="Tìm địa chỉ" /><button type="button" id="mapSearchButton" class="btn btn-outline-primary">Tìm kiếm</button></div>
                <div id="checkoutAddressMap" style="height:350px;min-height:300px;border-radius:10px" aria-label="Bản đồ chọn địa chỉ"></div>
                <small class="text-muted d-block mt-2">Nhấn vào bản đồ hoặc kéo ghim để chọn điểm giao hàng. Vị trí có thể có sai số.</small>
                <div id="mapAddressStatus" class="form-text" role="status" aria-live="polite"></div>
                <label for="mapHouseNumber" class="form-label mt-2">Số nhà / địa chỉ chi tiết (vui lòng xác nhận)</label>
                <input id="mapHouseNumber" class="form-control" placeholder="Ví dụ: 45, kiệt 12, tầng 2..." />
                <label for="mapResolvedAddress" class="form-label mt-2">Địa chỉ bản đồ tìm được</label>
                <textarea id="mapResolvedAddress" class="form-control" rows="2" placeholder="Chọn điểm trên bản đồ hoặc tìm kiếm"></textarea>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button><button type="button" id="mapConfirmAddress" class="btn btn-primary">Sử dụng địa chỉ này</button></div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const subtotal = @((long)Model.Subtotal);
            const discount = @((long)Model.Discount);
            const expressFee = 25000;
            const standardFee = subtotal >= 500000 ? 0 : 30000;

            const fmt = v => v === 0 ? 'Miễn phí' : v.toLocaleString('vi-VN') + ' đ';

            function updateShippingSummary() {
                const method = document.querySelector('input[name="ShippingMethod"]:checked')?.value;
                const fee = method === 'EXPRESS' ? expressFee : standardFee;
                const total = Math.max(0, subtotal - discount + fee);
                document.getElementById('summaryShipping').textContent = fmt(fee);
                document.getElementById('summaryTotal').textContent = total.toLocaleString('vi-VN') + ' đ';
            }

            document.querySelectorAll('input[name="ShippingMethod"]').forEach(r => {
                r.addEventListener('change', updateShippingSummary);
            });
        })();
    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

    <script>
        (() => {
          const openButton = document.getElementById('btnSelectOnMap');
          const addressInput = document.getElementById('shippingAddressInput');
          const modalElement = document.getElementById('addressMapModal');
          if (!openButton || !modalElement || !addressInput) return;
          const status = document.getElementById('mapAddressStatus');
          const resolved = document.getElementById('mapResolvedAddress');
          const house = document.getElementById('mapHouseNumber');
          const search = document.getElementById('mapSearchText');
          const gpsButton = document.getElementById('mapUseMyLocation');
          const setStatus = (message, error = false) => { status.textContent = message; status.classList.toggle('text-danger', error); };
          let map, marker, lastRequest = 0;
          const modal = () => bootstrap.Modal.getOrCreateInstance(modalElement);
          const fmt = a => {
            const street = [a.house_number, a.road || a.pedestrian || a.residential].filter(Boolean).join(' ');
            return [...new Set([street, a.suburb || a.quarter || a.neighbourhood || a.village, a.city_district || a.county, a.city || a.town || a.state].filter(Boolean))].join(', ');
          };
          async function request(url) {
            const wait = Math.max(0, 1100 - (Date.now() - lastRequest));
            if (wait) await new Promise(r => setTimeout(r, wait));
            lastRequest = Date.now();
            const response = await fetch(url, {headers:{Accept:'application/json'}});
            if (!response.ok) throw new Error('Dịch vụ bản đồ trả về HTTP ' + response.status);
            return await response.json();
          }
          async function reverse(lat, lon) {
            setStatus('Đang tìm địa chỉ gần ghim...');
            try {
              const params = new URLSearchParams({format:'jsonv2',lat:String(lat),lon:String(lon),zoom:'18',addressdetails:'1','accept-language':'vi'});
              const data = await request('https://nominatim.openstreetmap.org/reverse?' + params);
              resolved.value = fmt(data.address || {}) || data.display_name || '';
              setStatus('Hãy kiểm tra số nhà và địa chỉ trước khi xác nhận.');
            } catch(e) { console.error('Nominatim reverse:',e); setStatus('Không tra cứu được địa chỉ (' + e.message + '). Hãy nhập địa chỉ vào ô bên dưới hoặc thử lại.',true); }
          }
          function setPoint(lat,lon,zoom) {
            if (!marker) { marker = L.marker([lat,lon],{draggable:true}).addTo(map); marker.on('dragend',()=>{const p=marker.getLatLng();reverse(p.lat,p.lng);}); }
            else marker.setLatLng([lat,lon]);
            map.setView([lat,lon],zoom || Math.max(map.getZoom(),16));
            reverse(lat,lon);
          }
          openButton.addEventListener('click',()=>{
            if (!window.L || !window.bootstrap?.Modal) { alert('Không tải được thư viện bản đồ. Hãy kiểm tra Internet và tải lại trang.');return; }
            modal().show();
          });
          modalElement.addEventListener('shown.bs.modal',()=>{
            if (!map) {
              map = L.map('checkoutAddressMap').setView([16.0544,108.2022],12);
              L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',{maxZoom:19,attribution:'&copy; OpenStreetMap contributors'}).addTo(map);
              map.on('click',e=>setPoint(e.latlng.lat,e.latlng.lng));
              setStatus('Tìm địa chỉ, nhấn vào bản đồ hoặc dùng vị trí hiện tại.');
            }
            setTimeout(()=>map.invalidateSize(),100);
          });
          gpsButton.addEventListener('click', () => {
            if (!navigator.geolocation || !window.isSecureContext) {setStatus('Trình duyệt không hỗ trợ định vị hoặc trang chưa dùng HTTPS.',true);return;}
            gpsButton.disabled = true;
            setStatus('Đang lấy vị trí từ thiết bị...');
            navigator.geolocation.getCurrentPosition(p => {
              gpsButton.disabled = false;
              if (!map) {setStatus('Hãy mở bản đồ trước.',true);return;}
              setPoint(p.coords.latitude,p.coords.longitude,18);
              if (p.coords.accuracy > 50) setStatus('Vị trí có sai số khoảng ' + Math.round(p.coords.accuracy) + ' m. Hãy kéo ghim đến đúng nơi giao hàng và xác nhận số nhà.');
            }, e => {
              gpsButton.disabled = false;
              setStatus(e.code===1?'Bạn chưa cấp quyền vị trí cho trình duyệt.':e.code===3?'Định vị quá thời gian. Hãy thử lại hoặc chọn thủ công.':'Không lấy được tọa độ. Hãy chọn trên bản đồ hoặc nhập thủ công.',true);
            },{enableHighAccuracy:true,timeout:20000,maximumAge:0});
          });
          document.getElementById('mapSearchButton').addEventListener('click',async()=>{
            const q=search.value.trim(); if(q.length<3){setStatus('Nhập ít nhất 3 ký tự để tìm kiếm.',true);return;}
            setStatus('Đang tìm kiếm...');
            try {
              const params=new URLSearchParams({q,format:'jsonv2',limit:'1',addressdetails:'1','accept-language':'vi'});
              const results=await request('https://nominatim.openstreetmap.org/search?'+params);
              if(!results.length){setStatus('Không tìm thấy địa điểm. Hãy thử tên đường và thành phố.',true);return;}
              setPoint(Number(results[0].lat),Number(results[0].lon),17);
            }catch(e){setStatus('Không thể tìm địa chỉ: '+e.message,true);}
          });
          search.addEventListener('keydown',e=>{if(e.key==='Enter'){e.preventDefault();document.getElementById('mapSearchButton').click();}});
          document.getElementById('mapConfirmAddress').addEventListener('click',()=>{
            const base=resolved.value.trim(), number=house.value.trim();
            if(!base && !number){setStatus('Hãy chọn vị trí hoặc nhập địa chỉ trước.',true);return;}
            const value=number && base.toLowerCase().startsWith(number.toLowerCase()) ? base : [number,base].filter(Boolean).join(', ');
            if(addressInput.value.trim() && addressInput.value.trim()!==value && !confirm('Thay địa chỉ giao hàng hiện tại bằng địa chỉ đã chọn?'))return;
            addressInput.value=value;
            addressInput.dispatchEvent(new Event('input',{bubbles:true}));
            addressInput.dispatchEvent(new Event('change',{bubbles:true}));
            modal().hide();
            document.getElementById('locationFeedback').textContent='Đã chọn địa chỉ. Vui lòng kiểm tra lại số nhà và thông tin giao hàng.';
          });
        })();
    </script>

}
