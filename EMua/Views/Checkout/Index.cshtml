@model EMua.ViewModels.CheckoutViewModel
@{
    ViewData["Title"] = "Đặt hàng";
}
<link rel="stylesheet" href="~/css/customer.css" asp-append-version="true" />
<div class="customer-page container py-4"><a class="back-link" asp-controller="Cart" asp-action="Index"><i class="bi bi-arrow-left"></i> Quay lại giỏ hàng</a>
    <div class="customer-heading compact"><div><span class="eyebrow">BƯỚC 1 / 3</span><h1>Thông tin đặt hàng</h1><p>Nhập thông tin nhận hàng và chọn mã giảm giá.</p></div></div>
    <partial name="_CheckoutSteps" model="1" />
    @if (TempData["Success"] != null)
    {
        <div class="customer-alert success">@TempData["Success"]</div>
    }
    <div asp-validation-summary="ModelOnly" class="customer-alert error"></div>
    <div class="checkout-layout">
        <form asp-action="Review" method="post" class="form-panel">@Html.AntiForgeryToken()<h2>Thông tin giao hàng</h2>
            <label>Họ tên người nhận<input asp-for="RecipientName" /></label><span asp-validation-for="RecipientName" class="field-error"></span>
            <label>Số điện thoại<input asp-for="RecipientPhone" /></label><span asp-validation-for="RecipientPhone" class="field-error"></span>
            <label>Địa chỉ giao hàng<textarea asp-for="ShippingAddress" rows="3"></textarea></label><span asp-validation-for="ShippingAddress" class="field-error"></span>
            <label>Ghi chú<textarea asp-for="Note" rows="2" placeholder="Không bắt buộc"></textarea></label>
            <section class="checkout-section"><h2><i class="bi bi-truck"></i> Phương thức giao hàng</h2><div class="choice-grid"><label class="choice-card"><input asp-for="ShippingMethod" value="STANDARD" type="radio" /><span class="choice-icon"><i class="bi bi-truck"></i></span><span class="choice-copy"><strong>Giao tiêu chuẩn</strong><small>Nhận hàng trong 2–4 ngày</small></span><strong class="choice-price free">Miễn phí</strong></label><label class="choice-card"><input asp-for="ShippingMethod" value="EXPRESS" type="radio" /><span class="choice-icon"><i class="bi bi-clock"></i></span><span class="choice-copy"><strong>Giao nhanh 2 giờ</strong><small>Áp dụng tại HCM &amp; HN</small></span><strong class="choice-price">25.000 đ</strong></label></div></section>
            <section class="checkout-section"><h2><i class="bi bi-credit-card"></i> Phương thức thanh toán</h2><div class="choice-grid payment-grid"><label class="choice-card payment-card"><input asp-for="PaymentMethod" value="COD" type="radio" /><i class="bi bi-cash-stack"></i><strong>COD</strong></label><label class="choice-card payment-card"><input asp-for="PaymentMethod" value="MOMO" type="radio" /><i class="bi bi-wallet2"></i><strong>Ví điện tử</strong></label><label class="choice-card payment-card"><input asp-for="PaymentMethod" value="BANK" type="radio" /><i class="bi bi-credit-card"></i><strong>Ngân hàng</strong></label></div><div class="provider-panel" data-provider-group="MOMO"><strong>Chọn ví điện tử liên kết</strong><div class="provider-list"><label><input asp-for="PaymentProvider" value="MOMO" type="radio" /> MoMo</label><label><input asp-for="PaymentProvider" value="ZALOPAY" type="radio" /> ZaloPay</label><label><input asp-for="PaymentProvider" value="APPLEPAY" type="radio" /> Apple Pay</label></div></div><div class="provider-panel" data-provider-group="BANK"><strong>Chọn ngân hàng liên kết</strong><div class="provider-list"><label><input asp-for="PaymentProvider" value="VIETCOMBANK" type="radio" /> Vietcombank</label><label><input asp-for="PaymentProvider" value="VIETINBANK" type="radio" /> VietinBank</label><label><input asp-for="PaymentProvider" value="MB" type="radio" /> MB Bank</label><label><input asp-for="PaymentProvider" value="TPBANK" type="radio" /> TPBank</label></div></div><span asp-validation-for="PaymentProvider" class="field-error"></span></section>
            <input type="hidden" asp-for="CouponCode" />
            <button class="customer-button" type="submit">Tiếp tục xác nhận <i class="bi bi-arrow-right"></i></button>
        </form>
    <aside class="summary-card">
        <h2>Mã giảm giá</h2>
        <form asp-action="ApplyCoupon" method="post" class="coupon-form">@Html.AntiForgeryToken()<input type="hidden" name="ShippingMethod" id="coupon-shipping-method" value="@Model.ShippingMethod" /><input type="hidden" name="PaymentMethod" id="coupon-payment-method" value="@Model.PaymentMethod" /><input type="hidden" name="PaymentProvider" id="coupon-payment-provider" value="@Model.PaymentProvider" /><select
            asp-for="CouponCode">
            <option value="">Chọn mã giảm giá</option>@foreach (var coupon in Model.AvailableCoupons)
            {
                var fullCouponText = $"{coupon.Code} - {coupon.DiscountText}{(coupon.MinimumOrder.HasValue ? $" (đơn từ {coupon.MinimumOrder.Value:N0} đ)" : "")}";
                var displayCouponText = fullCouponText.Length > 34 ? $"{fullCouponText[..31]}..." : fullCouponText;
                <option value="@coupon.Code" title="@fullCouponText">@displayCouponText</option>
            }
        </select><button class="customer-button" type="submit">Áp dụng</button></form>
        <hr />@foreach (var item in Model.Items) {
        <div class="summary-line"><span>@item.ProductName x
            @item.Quantity</span><strong>@item.LineTotal.ToString("N0") đ</strong></div>
        }
        <div class="summary-line"><span>Tạm tính</span><span>@Model.Subtotal.ToString("N0") đ</span></div>
        <div class="summary-line discount"><span>Giảm giá</span><span>-@Model.Discount.ToString("N0") đ</span></div>
        <div class="summary-line"><span>Vận chuyển</span><span>@(Model.ShippingFee == 0 ? "Miễn phí" : $"{Model.ShippingFee:N0} đ")</span></div>
        <hr />
        <div class="summary-total"><span>Cần thanh toán</span><strong>@Model.Total.ToString("N0") đ</strong></div>
    </aside>
</div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var paymentInputs = document.querySelectorAll('input[name="PaymentMethod"]');
        var providerPanels = document.querySelectorAll('[data-provider-group]');
        function updatePaymentOptions() {
            var method = document.querySelector('input[name="PaymentMethod"]:checked')?.value || 'COD';
            var shipping = document.querySelector('input[name="ShippingMethod"]:checked')?.value || 'STANDARD';
            document.getElementById('coupon-payment-method').value = method;
            document.getElementById('coupon-shipping-method').value = shipping;
            providerPanels.forEach(function (panel) { var visible = panel.dataset.providerGroup === method; panel.hidden = !visible; panel.querySelectorAll('input').forEach(function (input) { input.disabled = !visible; }); });
            var provider = document.querySelector('input[name="PaymentProvider"]:checked');
            document.getElementById('coupon-payment-provider').value = provider ? provider.value : '';
        }
        paymentInputs.forEach(function (input) { input.addEventListener('change', updatePaymentOptions); });
        document.querySelectorAll('input[name="ShippingMethod"], input[name="PaymentProvider"]').forEach(function (input) { input.addEventListener('change', updatePaymentOptions); });
        updatePaymentOptions();
    </script>
}