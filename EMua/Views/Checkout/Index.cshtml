@model EMua.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Thanh toán - Thông tin giao hàng";
}

<link rel="stylesheet" href="~/css/customer/payment.css" asp-append-version="true" />
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />

<div class="customer-page container py-4">
    <partial name="_CheckoutSteps" model="1" />

    <div class="customer-heading compact">
        <div>
            <span class="eyebrow">BƯỚC 1 / 3</span>
            <h1>Thông tin giao hàng</h1>
            <p>Vui lòng điền thông tin người nhận và địa chỉ giao hàng.</p>
        </div>
    </div>

    @if (Model.Items == null || !Model.Items.Any())
    {
        <div class="checkout-empty text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h3 class="mt-3">Giỏ hàng đang trống</h3>
            <p class="text-muted">Hãy thêm sản phẩm vào giỏ hàng trước khi thanh toán.</p>
            <a asp-controller="Home" asp-action="Index" class="customer-button mt-2">Tiếp tục mua sắm</a>
        </div>
    }
    else
    {
        <form asp-action="Index" method="post" class="checkout-review-layout">
            @Html.AntiForgeryToken()

            <section class="form-panel">
                <h2>Thông tin nhận hàng</h2>

                <div class="form-group mb-3">
                    <label asp-for="RecipientName" class="form-label">Họ và tên <span>*</span></label>
                    <input asp-for="RecipientName" class="form-control" placeholder="Nhập họ và tên người nhận" />
                    <span asp-validation-for="RecipientName" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="RecipientPhone" class="form-label">Số điện thoại <span>*</span></label>
                    <input asp-for="RecipientPhone" class="form-control" placeholder="Nhập số điện thoại (VD: 0905123456)" />
                    <span asp-validation-for="RecipientPhone" class="text-danger"></span>
                </div>

                <div class="form-group mb-3">
                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                        <label asp-for="ShippingAddress" class="form-label mb-0">Địa chỉ nhận hàng <span>*</span></label>
                        <button type="button" id="btnSelectOnMap" class="btn btn-outline-primary btn-sm"><i class="bi bi-geo-alt me-1"></i>Chọn địa chỉ trên bản đồ</button>
                    </div>
                    <input asp-for="ShippingAddress" id="shippingAddressInput" class="form-control" autocomplete="street-address" placeholder="Số nhà, tên đường, phường/xã, quận/huyện, tỉnh/thành phố..." />
                    <span asp-validation-for="ShippingAddress" class="text-danger"></span>
                    <div id="locationFeedback" class="form-text" role="status" aria-live="polite">
                        Định vị có thể chưa chính xác đến số nhà. Vui lòng kiểm tra địa chỉ trước khi tiếp tục.
                    </div>
                </div>

                <div class="form-group mb-3">
                    <label asp-for="Note" class="form-label">Ghi chú đơn hàng</label>
                    <textarea asp-for="Note" class="form-control" rows="3" placeholder="Ghi chú thêm về địa chỉ hoặc thời gian giao hàng (nếu có)..."></textarea>
                </div>

                <h2>Phương thức giao hàng</h2>
                <div class="form-check mb-2">
                    <input type="radio" asp-for="ShippingMethod" value="STANDARD" id="shipStandard" class="form-check-input" />
                    <label for="shipStandard" class="form-check-label">
                        <strong>Giao tiêu chuẩn</strong> - Miễn phí
                    </label>
                </div>
                <div class="form-check mb-3">
                    <input type="radio" asp-for="ShippingMethod" value="EXPRESS" id="shipExpress" class="form-check-input" />
                    <label for="shipExpress" class="form-check-label">
                        <strong>Giao nhanh 2 giờ</strong> - 25.000 đ
                    </label>
                </div>
            </section>

            <aside class="summary-card">
                <h2>Tóm tắt đơn hàng</h2>
                <div class="summary-line">
                    <span>Số lượng</span>
                    <strong>@Model.Items.Sum(x => x.Quantity) sản phẩm</strong>
                </div>
                <div class="summary-line">
                    <span>Tạm tính</span>
                    <strong>@Model.Subtotal.ToString("N0") đ</strong>
                </div>
                <div class="summary-line discount">
                    <span>Giảm giá</span>
                    <strong>-@Model.Discount.ToString("N0") đ</strong>
                </div>
                <div class="summary-line">
                    <span>Vận chuyển</span>
                    <strong id="summaryShipping">@(Model.ShippingFee == 0 ? "Miễn phí" : $"{Model.ShippingFee:N0} đ")</strong>
                </div>
                <hr />
                <div class="summary-total">
                    <span>Tổng tạm tính</span>
                    <strong id="summaryTotal">@Model.Total.ToString("N0") đ</strong>
                </div>

                <div class="review-actions mt-3">
                    <button class="customer-button w-100" type="submit">
                        Tiếp tục: Chọn PTTT <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </aside>
        </form>
    }
</div>


<div class="modal fade" id="addressMapModal" tabindex="-1" aria-labelledby="addressMapTitle" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 16px; overflow: hidden;">
            <div class="modal-header py-3 px-4 bg-light border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-geo-alt-fill text-primary fs-5"></i>
                    <h5 class="modal-title fw-bold text-dark m-0" id="addressMapTitle">Chọn địa chỉ giao hàng</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Thanh công cụ tìm kiếm và định vị vị trí -->
                <div class="d-flex flex-wrap gap-2 mb-3">
                    <button type="button" id="mapUseMyLocation" class="btn btn-outline-primary btn-sm px-3 rounded-pill">
                        <i class="bi bi-crosshair me-1"></i> Dùng vị trí hiện tại
                    </button>
                    <div class="position-relative flex-grow-1">
                        <div class="input-group input-group-sm">
                            <input id="mapSearchText" class="form-control rounded-start-pill ps-3" placeholder="Tìm tên đường, địa điểm, phường/xã, quận/huyện..." aria-label="Tìm địa chỉ" autocomplete="off" />
                            <button type="button" id="mapSearchButton" class="btn btn-primary rounded-end-pill px-3">
                                <i class="bi bi-search me-1"></i> Tìm kiếm
                            </button>
                        </div>
                        <!-- Dropdown gợi ý kết quả tìm kiếm -->
                        <div id="mapSearchResults" class="list-group position-absolute w-100 shadow-lg mt-1 d-none" style="z-index: 1050; max-height: 220px; overflow-y: auto; border-radius: 10px;"></div>
                    </div>
                </div>

                <!-- Khung bản đồ 300px chuẩn đẹp, không bị tràn màn hình -->
                <div class="position-relative border rounded-3 overflow-hidden shadow-sm" style="height: 300px; min-height: 300px; background: #e2e8f0;">
                    <div id="checkoutAddressMap" style="width: 100%; height: 100%;" aria-label="Bản đồ chọn địa chỉ"></div>
                </div>
                
                <div class="d-flex justify-content-between align-items-center mt-2">
                    <small class="text-muted"><i class="bi bi-info-circle me-1"></i> Nhấn vào bản đồ hoặc kéo ghim để chọn vị trí giao hàng.</small>
                    <div id="mapAddressStatus" class="form-text m-0 fw-semibold" role="status" aria-live="polite"></div>
                </div>

                <!-- Ô nhập địa chỉ chi tiết -->
                <div class="row g-2 mt-2">
                    <div class="col-md-5">
                        <label for="mapHouseNumber" class="form-label small fw-bold text-secondary mb-1">Số nhà / Số ngõ / Tòa nhà</label>
                        <input id="mapHouseNumber" class="form-control form-control-sm rounded-2" placeholder="Ví dụ: 120/4, Tầng 3..." />
                    </div>
                    <div class="col-md-7">
                        <label for="mapResolvedAddress" class="form-label small fw-bold text-secondary mb-1">Địa chỉ bản đồ xác định</label>
                        <input id="mapResolvedAddress" class="form-control form-control-sm rounded-2" placeholder="Chưa chọn điểm trên bản đồ" />
                    </div>
                </div>
            </div>
            <div class="modal-footer py-2 px-4 bg-light border-top">
                <button type="button" class="btn btn-sm btn-outline-secondary px-3 rounded-pill" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="mapConfirmAddress" class="btn btn-sm btn-primary px-4 rounded-pill fw-bold">
                    <i class="bi bi-check2-circle me-1"></i> Sử dụng địa chỉ này
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {
            const subtotal = @((long)Model.Subtotal);
            const discount = @((long)Model.Discount);
            const expressFee = 25000;
            const standardFee = subtotal >= 500000 ? 0 : 30000;

            const fmt = v => v === 0 ? 'Miễn phí' : v.toLocaleString('vi-VN') + ' ₫';

            function updateShippingSummary() {
                const method = document.querySelector('input[name="ShippingMethod"]:checked')?.value;
                const fee = method === 'EXPRESS' ? expressFee : standardFee;
                const total = Math.max(0, subtotal - discount + fee);
                document.getElementById('summaryShipping').textContent = fmt(fee);
                document.getElementById('summaryTotal').textContent = total.toLocaleString('vi-VN') + ' ₫';
            }

            document.querySelectorAll('input[name="ShippingMethod"]').forEach(r => {
                r.addEventListener('change', updateShippingSummary);
            });
        })();
    </script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

    <script>
        (() => {
          const openButton = document.getElementById('btnSelectOnMap');
          const addressInput = document.getElementById('shippingAddressInput');
          const modalElement = document.getElementById('addressMapModal');
          if (!openButton || !modalElement || !addressInput) return;

          const status = document.getElementById('mapAddressStatus');
          const resolved = document.getElementById('mapResolvedAddress');
          const house = document.getElementById('mapHouseNumber');
          const search = document.getElementById('mapSearchText');
          const searchResults = document.getElementById('mapSearchResults');
          const gpsButton = document.getElementById('mapUseMyLocation');
          const setStatus = (message, error = false) => {
            status.textContent = message;
            status.className = 'form-text m-0 fw-semibold ' + (error ? 'text-danger' : 'text-primary');
          };

          let map, marker, currentCoords = { lat: 16.0544, lon: 108.2022 };
          const modal = () => bootstrap.Modal.getOrCreateInstance(modalElement);

          // Ẩn dropdown gợi ý khi click bên ngoài
          document.addEventListener('click', e => {
            if (searchResults && !searchResults.contains(e.target) && e.target !== search) {
              searchResults.classList.add('d-none');
            }
          });

          // Gọi qua proxy server-side /api/location để lấy địa chỉ tiếng Việt thật và tự động fallback Photon Komoot
          async function reverseGeocode(lat, lon) {
            currentCoords = { lat, lon };
            setStatus('Đang lấy tên đường...');
            try {
              const res = await fetch(`/api/location/reverse?lat=${lat}&lon=${lon}`);
              if (!res.ok) throw new Error('HTTP ' + res.status);
              const data = await res.json();
              const addr = data.display_name || '';
              resolved.value = addr || `Vị trí đã ghim (${lat.toFixed(4)}, ${lon.toFixed(4)})`;
              setStatus('Đã xác định vị trí.', false);
            } catch (e) {
              console.warn('Reverse geocode error fallback:', e);
              resolved.value = `Vị trí đã ghim (${lat.toFixed(4)}, ${lon.toFixed(4)}) - Đà Nẵng`;
              setStatus('Đã ghim vị trí. Bạn có thể bổ sung số nhà/tên đường nếu cần.', false);
            }
          }

          function setPoint(lat, lon, zoom) {
            currentCoords = { lat, lon };
            if (!marker) {
              marker = L.marker([lat, lon], { draggable: true }).addTo(map);
              marker.on('dragend', () => {
                const p = marker.getLatLng();
                reverseGeocode(p.lat, p.lng);
              });
            } else {
              marker.setLatLng([lat, lon]);
            }
            map.setView([lat, lon], zoom || Math.max(map.getZoom(), 16));
            reverseGeocode(lat, lon);
          }

          openButton.addEventListener('click', () => {
            if (!window.L || !window.bootstrap?.Modal) {
              EmuaNotify.error('Không tải được thư viện bản đồ. Hãy kiểm tra kết nối mạng.');
              return;
            }
            modal().show();
          });

          modalElement.addEventListener('shown.bs.modal', () => {
            if (!map) {
              map = L.map('checkoutAddressMap', {
                zoomControl: true,
                attributionControl: false
              }).setView([16.0544, 108.2022], 14);

              L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.webp', {
                maxZoom: 19,
                subdomains: ['a', 'b', 'c']
              }).addTo(map);

              map.on('click', e => setPoint(e.latlng.lat, e.latlng.lng));
              setPoint(16.0544, 108.2022, 14);
            }

            setTimeout(() => {
              if (map) {
                map.invalidateSize(true);
              }
            }, 250);
          });

          // Định vị GPS hiện tại
          gpsButton.addEventListener('click', () => {
            if (!navigator.geolocation) {
              setStatus('Trình duyệt không hỗ trợ định vị GPS.', true);
              return;
            }

            gpsButton.disabled = true;
            setStatus('Đang lấy vị trí GPS từ thiết bị...');

            navigator.geolocation.getCurrentPosition(p => {
              gpsButton.disabled = false;
              if (!map) return;
              setPoint(p.coords.latitude, p.coords.longitude, 16);
            }, err => {
              gpsButton.disabled = false;
              console.warn('Geolocation error:', err);
              setStatus('Không thể lấy GPS (chưa cấp quyền hoặc trên PC). Đã đưa về vị trí mặc định.', true);
              if (map) setPoint(16.0544, 108.2022, 14);
            }, { enableHighAccuracy: true, timeout: 10000, maximumAge: 0 });
          });

          // Tìm kiếm địa điểm với autocomplete / danh sách gợi ý thả xuống
          const doSearch = async () => {
            const q = search.value.trim();
            if (q.length < 2) {
              setStatus('Vui lòng nhập ít nhất 2 ký tự để tìm kiếm.', true);
              if (searchResults) searchResults.classList.add('d-none');
              return;
            }
            setStatus('Đang tìm kiếm địa điểm...');
            try {
              const res = await fetch(`/api/location/search?q=${encodeURIComponent(q)}`);
              if (!res.ok) throw new Error('HTTP ' + res.status);
              const list = await res.json();
              if (!list || !list.length) {
                setStatus('Không tìm thấy địa điểm. Vui lòng thử từ khóa khác.', true);
                if (searchResults) {
                  searchResults.innerHTML = '<div class="list-group-item text-muted small p-2">Không tìm thấy địa điểm phù hợp</div>';
                  searchResults.classList.remove('d-none');
                }
                return;
              }

              // Hiển thị dropdown kết quả gợi ý
              if (searchResults) {
                searchResults.innerHTML = list.map(item => `
                  <button type="button" class="list-group-item list-group-item-action text-start p-2 border-bottom d-flex align-items-center gap-2" data-lat="${item.lat}" data-lon="${item.lon}" data-name="${encodeURIComponent(item.display_name)}">
                    <i class="bi bi-geo-alt text-primary flex-shrink-0"></i>
                    <span class="small text-truncate">${item.display_name}</span>
                  </button>
                `).join('');
                searchResults.classList.remove('d-none');

                searchResults.querySelectorAll('button').forEach(btn => {
                  btn.addEventListener('click', () => {
                    const lat = parseFloat(btn.dataset.lat);
                    const lon = parseFloat(btn.dataset.lon);
                    const name = decodeURIComponent(btn.dataset.name);
                    search.value = name;
                    searchResults.classList.add('d-none');
                    setPoint(lat, lon, 16);
                  });
                });
              }

              const item = list[0];
              setPoint(parseFloat(item.lat), parseFloat(item.lon), 16);
            } catch (e) {
              console.warn('Search error:', e);
              setStatus('Không thể tìm kiếm tự động. Bạn hãy bấm chọn trực tiếp trên bản đồ.', true);
              if (searchResults) searchResults.classList.add('d-none');
            }
          };

          document.getElementById('mapSearchButton').addEventListener('click', doSearch);
          search.addEventListener('keydown', e => {
            if (e.key === 'Enter') {
              e.preventDefault();
              doSearch();
            }
          });

          // Nút "Sử dụng địa chỉ này"
          document.getElementById('mapConfirmAddress').addEventListener('click', () => {
            const base = resolved.value.trim();
            const number = house.value.trim();
            const searchText = search.value.trim();

            let finalAddress = '';
            if (number && base) {
              finalAddress = base.toLowerCase().startsWith(number.toLowerCase()) ? base : `${number}, ${base}`;
            } else {
              finalAddress = number || base || searchText || `Vị trí đã ghim (${currentCoords.lat.toFixed(4)}, ${currentCoords.lon.toFixed(4)})`;
            }

            if (!finalAddress) {
              setStatus('Vui lòng chọn vị trí trên bản đồ hoặc nhập địa chỉ.', true);
              return;
            }

            const apply = () => {
              addressInput.value = finalAddress;
              addressInput.dispatchEvent(new Event('input', { bubbles: true }));
              addressInput.dispatchEvent(new Event('change', { bubbles: true }));
              modal().hide();
              const feedback = document.getElementById('locationFeedback');
              if (feedback) {
                feedback.textContent = 'Đã chọn địa chỉ từ bản đồ. Vui lòng xác nhận lại thông tin giao hàng.';
              }
            };

            if (addressInput.value.trim() && addressInput.value.trim() !== finalAddress) {
              EmuaConfirm('Cập nhật địa chỉ nhận hàng bằng vị trí bản đồ đã chọn?', apply, {
                title: 'Thay đổi địa chỉ',
                isDanger: false
              });
              return;
            }
            apply();
          });
        })();
    </script>

}
