@model EMua.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Chọn phương thức thanh toán";

    var selectedMethod =
        ViewBag.PaymentMethod as string
        ?? Model.PaymentMethod
        ?? "COD";

    var vi = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<link rel="stylesheet"
      href="~/css/customer/payment.css"
      asp-append-version="true" />

<link rel="stylesheet" href="~/css/customer/customer-checkout-payment.css" asp-append-version="true" />

<div class="customer-page container py-4 emua-payment">
    <partial name="_CheckoutSteps" model="2" />

    <div class="customer-heading compact mb-4">
        <div>
            <span class="eyebrow">BƯỚC 2 / 3</span>
            <h1>Phương thức thanh toán</h1>
            <p>Chọn cách thanh toán và kiểm tra ưu đãi cho đơn hàng.</p>
        </div>
    </div>

    <form id="paymentForm"
          asp-controller="Checkout"
          asp-action="Payment"
          method="post"
          class="checkout-review-layout"
          data-coupon-url="@Url.Action("ApplyCoupon", "Checkout")"
          data-login-url="@Url.Action("Login", "Auth", new { returnUrl = Url.Action("Payment", "Checkout") })">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
             class="checkout-validation"
             role="alert"></div>

        <section class="form-panel">
            <h2>Lựa chọn thanh toán</h2>

            <label class="payment-option @(selectedMethod == "COD" ? "is-selected" : "")">
                <input type="radio"
                       name="paymentMethod"
                       value="COD"
                       checked="@(selectedMethod == "COD")"
                       required />

                <span class="payment-option-copy">
                    <strong>
                        <i class="bi bi-cash-stack" aria-hidden="true"></i>
                        Thanh toán khi nhận hàng
                    </strong>
                    <small>Thanh toán cho đơn vị vận chuyển khi nhận sản phẩm.</small>
                </span>
            </label>

            <label class="payment-option @(selectedMethod == "BANK_TRANSFER" ? "is-selected" : "")">
                <input type="radio"
                       name="paymentMethod"
                       value="BANK_TRANSFER"
                       checked="@(selectedMethod == "BANK_TRANSFER")"
                       aria-controls="bank-details-box" />

                <span class="payment-option-copy">
                    <strong>
                        <i class="bi bi-qr-code-scan" aria-hidden="true"></i>
                        Chuyển khoản ngân hàng
                    </strong>
                    <small>Thanh toán qua VietQR / MB Bank.</small>
                </span>
            </label>

            <div id="bank-details-box"
                 class="payment-method-note"
                 hidden="@(selectedMethod != "BANK_TRANSFER")">
                Mã QR và nội dung chuyển khoản theo đơn hàng sẽ được hiển thị
                sau khi bạn xác nhận đặt hàng.
            </div>

            <label class="payment-option @(selectedMethod == "WEB3" ? "is-selected" : "")">
                <input type="radio"
                       name="paymentMethod"
                       value="WEB3"
                       checked="@(selectedMethod == "WEB3")"
                       aria-controls="web3-details-box" />

                <span class="payment-option-copy">
                    <strong>
                        <i class="bi bi-wallet2" aria-hidden="true"></i>
                        Ví Web3
                    </strong>
                    <small>Chọn thanh toán bằng tiền mã hóa.</small>
                </span>
            </label>

            <div id="web3-details-box"
                 class="payment-method-note"
                 hidden="@(selectedMethod != "WEB3")">
                Kiểm tra hướng dẫn thanh toán, mạng chuyển và số tiền
                sau khi tạo đơn hàng.
            </div>
        </section>

        <aside class="summary-card">
            <h2>Mã giảm giá</h2>

            <div class="coupon-field">
                <label for="checkoutCouponCode">
                    Nhập mã ưu đãi của bạn
                </label>

                <div class="coupon-input-row">
                    <input id="checkoutCouponCode"
                           name="couponCode"
                           value="@Model.CouponCode"
                           maxlength="50"
                           autocomplete="off"
                           placeholder="Nhập mã giảm giá"
                           aria-describedby="couponStatus couponApplied" />

                    <button id="applyCouponButton"
                            type="button"
                            class="coupon-apply">
                        Áp dụng
                    </button>
                </div>

                <p id="couponApplied"
                   class="coupon-applied"
                   hidden="@(string.IsNullOrWhiteSpace(Model.CouponCode) || Model.Discount <= 0)">
                    Đang áp dụng:
                    <strong id="appliedCouponCode">@Model.CouponCode</strong>
                </p>

                <p id="couponStatus"
                   class="coupon-message"
                   role="status"
                   aria-live="polite"
                   aria-atomic="true"
                   hidden></p>

                <a id="couponLoginLink"
                   class="back-link"
                   href="@Url.Action("Login", "Auth", new { returnUrl = Url.Action("Payment", "Checkout") })"
                   hidden>
                    Đăng nhập lại
                </a>
            </div>

            <h2 class="summary-heading">Tóm tắt đơn hàng</h2>

            <div class="summary-line">
                <span>Tạm tính</span>
                <strong>@Model.Subtotal.ToString("N0", vi) đ</strong>
            </div>

            <div class="summary-line discount">
                <span>Giảm giá</span>
                <strong id="checkoutDiscount">
                    -@Model.Discount.ToString("N0", vi) đ
                </strong>
            </div>

            <div class="summary-line">
                <span>Vận chuyển</span>
                <strong id="checkoutShipping">
                    @(Model.ShippingFee == 0
                                        ? "Miễn phí"
                                        : Model.ShippingFee.ToString("N0", vi) + " đ")
                </strong>
            </div>

            <hr />

            <div class="summary-total">
                <span>Tổng cần thanh toán</span>
                <strong id="checkoutTotal">
                    @Model.Total.ToString("N0", vi) đ
                </strong>
            </div>

            <div class="review-actions">
                <a asp-controller="Checkout"
                   asp-action="Index"
                   class="customer-button customer-button-light">
                    Quay lại
                </a>

                <button id="continuePaymentButton"
                        class="customer-button"
                        type="submit">
                    Tiếp tục: Xác nhận
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </button>
            </div>
        </aside>
    </form>
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';

            const form = document.getElementById('paymentForm');
            if (!form) return;

            const input = document.getElementById('checkoutCouponCode');
            const applyButton = document.getElementById('applyCouponButton');
            const continueButton = document.getElementById('continuePaymentButton');
            const status = document.getElementById('couponStatus');
            const loginLink = document.getElementById('couponLoginLink');

            let applying = false;

            const formatMoney = value =>
                Number(value).toLocaleString('vi-VN', {
                    maximumFractionDigits: 0
                }) + ' đ';

            function showStatus(message, type) {
                status.textContent = message;
                status.className = 'coupon-message is-' + type;
                status.hidden = false;
            }

            function setBusy(value) {
                applying = value;
                applyButton.disabled = value;
                continueButton.disabled = value;
                input.readOnly = value;

                applyButton.textContent = value
                    ? 'Đang kiểm tra…'
                    : 'Áp dụng';

                form.setAttribute('aria-busy', String(value));
            }

            function updatePaymentDetails() {
                const selected = form.querySelector(
                    'input[name="paymentMethod"]:checked'
                );

                const method = selected?.value || 'COD';

                document.getElementById('bank-details-box').hidden =
                    method !== 'BANK_TRANSFER';

                document.getElementById('web3-details-box').hidden =
                    method !== 'WEB3';

                form.querySelectorAll('.payment-option').forEach(option => {
                    const radio = option.querySelector(
                        'input[name="paymentMethod"]'
                    );

                    option.classList.toggle(
                        'is-selected',
                        Boolean(radio?.checked)
                    );
                });
            }

            async function applyCoupon() {
                if (applying) return;

                const code = input.value.trim();

                loginLink.hidden = true;
                input.removeAttribute('aria-invalid');

                if (!code) {
                    showStatus('Vui lòng nhập mã giảm giá.', 'error');
                    input.setAttribute('aria-invalid', 'true');
                    input.focus();
                    return;
                }

                const token = form.querySelector(
                    'input[name="__RequestVerificationToken"]'
                )?.value;

                if (!token) {
                    showStatus(
                        'Không tìm thấy mã bảo mật. Vui lòng tải lại trang.',
                        'error'
                    );
                    return;
                }

                setBusy(true);
                showStatus('Đang kiểm tra mã giảm giá…', 'info');

                try {
                    const response = await fetch(form.dataset.couponUrl, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify({
                            couponCode: code
                        })
                    });

                    if (
                        response.status === 401 ||
                        response.status === 403 ||
                        response.redirected
                    ) {
                        showStatus(
                            'Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại.',
                            'error'
                        );

                        loginLink.hidden = false;
                        return;
                    }

                    const contentType =
                        response.headers.get('content-type') || '';

                    if (!contentType.includes('application/json')) {
                        throw new Error(
                            response.status === 400
                                ? 'Phiên bảo mật đã hết hạn hoặc yêu cầu không hợp lệ. Vui lòng tải lại trang.'
                                : 'Máy chủ chưa thể xử lý mã giảm giá. Vui lòng thử lại.'
                        );
                    }

                    const result = await response.json();

                    if (!response.ok || !result.success) {
                        input.setAttribute('aria-invalid', 'true');

                        throw new Error(
                            result.message ||
                            'Không thể áp dụng mã giảm giá này.'
                        );
                    }

                    const discount = Number(result.discount);
                    const total = Number(result.total);
                    const shipping = Number(result.shippingFee);

                    if (
                        !Number.isFinite(discount) ||
                        !Number.isFinite(total) ||
                        !Number.isFinite(shipping)
                    ) {
                        throw new Error(
                            'Phản hồi tổng tiền không hợp lệ. Vui lòng tải lại trang để kiểm tra.'
                        );
                    }

                    input.value = result.couponCode || code;

                    document.getElementById('checkoutDiscount').textContent =
                        '-' + formatMoney(discount);

                    document.getElementById('checkoutTotal').textContent =
                        formatMoney(total);

                    document.getElementById('checkoutShipping').textContent =
                        shipping === 0 ? 'Miễn phí' : formatMoney(shipping);

                    document.getElementById('appliedCouponCode').textContent =
                        input.value;

                    document.getElementById('couponApplied').hidden = false;

                    showStatus(
                        'Đã áp dụng ' + input.value +
                        ' — giảm ' + formatMoney(discount) + '.',
                        'success'
                    );
                } catch (error) {
                    showStatus(
                        error instanceof TypeError
                            ? 'Chưa nhận được phản hồi từ máy chủ. Kiểm tra kết nối và tải lại trang để xác nhận mã đang dùng.'
                            : error.message || 'Không thể áp dụng mã. Vui lòng thử lại.',
                        'error'
                    );
                } finally {
                    setBusy(false);
                }
            }

            applyButton.addEventListener('click', applyCoupon);

            input.addEventListener('keydown', function (event) {
                if (event.key === 'Enter') {
                    event.preventDefault();
                    applyCoupon();
                }
            });

            input.addEventListener('input', function () {
                input.removeAttribute('aria-invalid');

                showStatus(
                    'Bạn đã sửa mã. Bấm Áp dụng để cập nhật số tiền; tổng tiền đang hiển thị là kết quả trước đó.',
                    'info'
                );
            });

            form.querySelectorAll(
                'input[name="paymentMethod"]'
            ).forEach(radio => {
                radio.addEventListener('change', updatePaymentDetails);
            });

            form.addEventListener('submit', function (event) {
                if (applying) {
                    event.preventDefault();

                    showStatus(
                        'Vui lòng chờ kiểm tra mã giảm giá hoàn tất.',
                        'info'
                    );
                }
            });

            updatePaymentDetails();
        })();
    </script>
}