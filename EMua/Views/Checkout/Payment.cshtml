@model EMua.ViewModels.CheckoutViewModel

@{
    ViewData["Title"] = "Chọn phương thức thanh toán";
    string selectedMethod = ViewBag.PaymentMethod as string ?? Model.PaymentMethod ?? "COD";
    var selectedCoupon = Model.AvailableCoupons.FirstOrDefault(x => x.Code == Model.CouponCode);
}

<link rel="stylesheet" href="~/css/payment.css" asp-append-version="true" />

<div class="customer-page container py-4">
    <partial name="_CheckoutSteps" model="2" />

    <div class="customer-heading compact mb-4">
        <div>
            <span class="eyebrow">BƯỚC 2 / 3</span>
            <h1>Phương thức thanh toán</h1>
            <p>Chọn phương thức thanh toán phù hợp với bạn.</p>
        </div>
    </div>

    <form asp-action="Payment" method="post" class="checkout-review-layout">
        @Html.AntiForgeryToken()

        <section class="form-panel">
            <h2>Lựa chọn thanh toán</h2>

            <!-- Option 1: COD -->
            <label class="form-check p-3 mb-2 cursor-pointer">
                <input type="radio" name="paymentMethod" value="COD" class="form-check-input" @(selectedMethod == "COD"        ? "checked" : "") onchange="togglePaymentDetails('COD')" />
                <span class="form-check-label ms-2">
                    <i class="bi bi-cash-stack text-success me-2 fs-5"></i>
                    <strong>Thanh toán khi nhận hàng (COD)</strong>
                </span>
            </label>

            <!-- Option 2: BANK QR -->
            <label class="form-check p-3 mb-2 cursor-pointer">
                <input type="radio" name="paymentMethod" value="BANK_TRANSFER" class="form-check-input" @(selectedMethod
                       == "BANK_TRANSFER" ? "checked" : "") onchange="togglePaymentDetails('BANK_TRANSFER')" />
                <span class="form-check-label ms-2">
                    <i class="bi bi-qr-code-scan text-primary me-2 fs-5"></i>
                    <strong>Chuyển khoản Ngân hàng (VietQR / MB Bank)</strong>
                </span>
            </label>

            <!-- Box thông tin QR Bank -->
            <div id="bank-details-box" class="payment-notice alert alert-info mt-2" style="display: none;">
                <div class="d-flex flex-column flex-sm-row align-items-center gap-3">
                    <img src="https://img.vietqr.io/image/MB-0963453170-compact2.png?accountName=PHAN%20DANG%20PHUONG%20ANH"
                         alt="QR MB Bank" style="width: 140px; height: 140px;" class="rounded border" />
                    <div class="small">
                        <h6 class="fw-bold mb-1 text-primary"><i class="bi bi-bank me-1"></i>Thông tin MB Bank</h6>
                        <p class="mb-1">Số TK: <strong class="fs-6 text-dark">0963453170</strong></p>
                        <p class="mb-1">Chủ TK: <strong>PHAN DANG PHUONG ANH</strong></p>
                        <p class="mb-0 text-muted">* Bạn có thể quét mã QR thanh toán ngay bây giờ.</p>
                    </div>
                </div>
            </div>

            <!-- Option 3: WEB3 -->
            <label class="form-check p-3 mb-2 cursor-pointer">
                <input type="radio" name="paymentMethod" value="WEB3" class="form-check-input" @(selectedMethod ==
                       "WEB3" ? "checked" : "") onchange="togglePaymentDetails('WEB3')" />
                <span class="form-check-label ms-2">
                    <i class="bi bi-wallet2 text-warning me-2 fs-5"></i>
                    <strong>Ví Web3 (Crypto / USDT)</strong>
                </span>
            </label>

            <!-- Box thông tin Web3 -->
            <div id="web3-details-box" class="payment-notice alert alert-warning mt-2" style="display: none;">
                <h6 class="fw-bold text-dark mb-1"><i class="bi bi-currency-bitcoin me-1"></i>Địa chỉ ví nhận USDT
                    (BEP20 / ERC20)</h6>
                    <code
                    class="d-block p-2 bg-dark text-warning rounded mt-2 text-break">0x71C7656EC7ab88b098defB751B7401B5f6d8976F</code>
                </div>
            </section>

            <aside class="summary-card">
                <h2>Mã giảm giá</h2>
                <div class="form-group mb-3">
                    <label class="form-label" for="couponCode">Mã phù hợp với đơn hàng</label>
                    <div class="coupon-picker" id="couponPicker">
                        <div class="coupon-picker-control">
                            <input type="text" id="couponDisplay" class="form-control" value="@selectedCoupon?.Code"
                                   placeholder="Chọn mã giảm giá" readonly aria-haspopup="listbox" aria-expanded="false" />
                            <button type="button" id="couponPickerToggle" class="coupon-picker-toggle"
                                    aria-label="Chọn mã giảm giá" aria-expanded="false">
                                <i class="bi bi-chevron-down" aria-hidden="true"></i>
                            </button>
                        </div>
                        <input type="hidden" name="couponCode" id="couponCode" value="@selectedCoupon?.Code" />
                        <div class="coupon-options" id="couponOptions" role="listbox" aria-label="Mã giảm giá đủ điều kiện">
                            <button type="button" class="coupon-option" role="option" data-code="" data-discount="0">
                                <span class="coupon-option-code">Không áp dụng mã</span>
                            </button>
                            @foreach (var coupon in Model.AvailableCoupons)
                            {
                                <button type="button" class="coupon-option" role="option" data-code="@coupon.Code"
                                        data-discount="@coupon.DiscountAmount.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                                    <span class="coupon-option-code">@coupon.Code</span>
                                    <span class="coupon-option-name">@coupon.Name</span>
                                    <span class="coupon-option-discount">@coupon.DiscountText</span>
                                </button>
                            }
                        </div>
                    </div>
                    @if (!Model.AvailableCoupons.Any())
                    {
                        <small class="text-muted d-block mt-2">Chưa có mã nào đủ điều kiện cho đơn hàng này.</small>
                    }
                </div>

                <h2>Tóm tắt đơn hàng</h2>
                <div class="summary-line">
                    <span>Tạm tính</span>
                    <strong>@Model.Subtotal.ToString("N0") đ</strong>
                </div>
                <div class="summary-line discount">
                    <span>Giảm giá</span>
                    <strong id="couponDiscount">-@Model.Discount.ToString("N0") đ</strong>
                </div>
                <div class="summary-line">
                    <span>@(Model.ShippingMethod == "EXPRESS" ? "Giao nhanh 2 giờ" : "Giao tiêu chuẩn")</span>
                    <strong>@(Model.ShippingFee == 0 ? "Miễn phí" : $"{Model.ShippingFee:N0} đ")</strong>
                </div>
                <hr />
                <div class="summary-total">
                    <span>Tổng cần thanh toán</span>
                    <strong id="checkoutTotal">@Model.Total.ToString("N0") đ</strong>
                </div>

                <div class="review-actions mt-3">
                    <a asp-action="Index" class="customer-button customer-button-light">Quay lại</a>
                    <button class="customer-button" type="submit">
                        Tiếp tục: Xác nhận <i class="bi bi-arrow-right"></i>
                    </button>
                </div>
            </aside>
        </form>
    </div>

    @section Scripts {
        <script>
            function togglePaymentDetails(method) {
                document.getElementById('bank-details-box').style.display = (method === 'BANK_TRANSFER') ? 'block' : 'none';
                document.getElementById('web3-details-box').style.display = (method === 'WEB3') ? 'block' : 'none';
            }

            document.addEventListener('DOMContentLoaded', function () {
                const checkedRadio = document.querySelector('input[name="paymentMethod"]:checked');
                if (checkedRadio) {
                    togglePaymentDetails(checkedRadio.value);
                }

                const couponPicker = document.getElementById('couponPicker');
                const couponToggle = document.getElementById('couponPickerToggle');
                const couponOptions = document.getElementById('couponOptions');
                const couponCode = document.getElementById('couponCode');
                const couponDisplay = document.getElementById('couponDisplay');
                const discountElement = document.getElementById('couponDiscount');
                const totalElement = document.getElementById('checkoutTotal');
                if (couponPicker && couponToggle && couponOptions && couponCode && couponDisplay && discountElement && totalElement) {
                    const subtotal = @Model.Subtotal.ToString(System.Globalization.CultureInfo.InvariantCulture);
                    const shippingFee = @Model.ShippingFee.ToString(System.Globalization.CultureInfo.InvariantCulture);
                    const formatMoney = value => new Intl.NumberFormat('vi-VN').format(value) + ' đ';
                    const setCoupon = function (option) {
                        const discount = Number(option.dataset.discount || 0);
                        couponCode.value = option.dataset.code || '';
                        couponDisplay.value = option.dataset.code || '';
                        discountElement.textContent = '-' + formatMoney(discount);
                        totalElement.textContent = formatMoney(Math.max(0, subtotal + shippingFee - discount));
                        couponOptions.classList.remove('is-open');
                        couponToggle.setAttribute('aria-expanded', 'false');
                        couponDisplay.setAttribute('aria-expanded', 'false');
                    };

                    const toggleCouponOptions = function () {
                        const isOpen = couponOptions.classList.toggle('is-open');
                        couponToggle.setAttribute('aria-expanded', String(isOpen));
                        couponDisplay.setAttribute('aria-expanded', String(isOpen));
                    };
                    couponToggle.addEventListener('click', toggleCouponOptions);
                    couponDisplay.addEventListener('click', toggleCouponOptions);
                    couponDisplay.addEventListener('keydown', function (event) {
                        if (event.key === 'Enter' || event.key === ' ' || event.key === 'ArrowDown') {
                            event.preventDefault();
                            if (!couponOptions.classList.contains('is-open')) toggleCouponOptions();
                        }
                    });
                    couponOptions.addEventListener('click', function (event) {
                        const option = event.target.closest('.coupon-option');
                        if (option) setCoupon(option);
                    });
                    document.addEventListener('click', function (event) {
                        if (!couponPicker.contains(event.target)) {
                            couponOptions.classList.remove('is-open');
                            couponToggle.setAttribute('aria-expanded', 'false');
                            couponDisplay.setAttribute('aria-expanded', 'false');
                        }
                    });
                }
            });
        </script>
    }