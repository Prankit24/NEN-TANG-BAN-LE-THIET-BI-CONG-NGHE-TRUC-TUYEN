@model EMua.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
    var couponError = TempData["CouponError"] as string;
    var couponSuccess = TempData["CouponSuccess"] as string;
}
<link rel="stylesheet" href="~/css/customer/shopping-cart.css" asp-append-version="true" />

<div class="cart-container">
    <!-- Thanh điều hướng giỏ hàng gọn, không dùng H1 lớn -->
    <header class="cart-header">
        <a asp-controller="Product" asp-action="Index"
           class="btn-back-icon"
           title="Tiếp tục mua sắm"
           aria-label="Tiếp tục mua sắm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <span class="cart-item-count">Giỏ hàng · @Model.TotalQuantity sản phẩm</span>
    </header>

    @if (TempData["Error"] != null)
    {
        <div class="customer-alert error" role="alert">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="customer-alert success" role="status">@TempData["Success"]</div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            <h2>Giỏ hàng đang trống</h2>
            <p>Thêm sản phẩm bạn yêu thích để bắt đầu đặt hàng.</p>
            <a asp-controller="Product" asp-action="Index" class="btn-outline">Khám phá sản phẩm</a>
        </div>
    }
    else
    {
        <div class="cart-main-grid">
            <!-- Khối bên trái: Bảng danh sách sản phẩm -->
            <div class="cart-card">
                <!-- 2. Bảng tiêu đề sản phẩm -->
                <div class="cart-table-head">
                    <div class="col-info">Sản phẩm</div>
                    <div class="col-price">Đơn giá</div>
                    <div class="col-qty">Số lượng</div>
                    <div class="col-total">Thành tiền</div>
                    <div class="col-action">Thao tác</div>
                </div>

                <div class="cart-table-body">
                    @foreach (var item in Model.Items)
                    {
                        <article class="cart-row" data-unit-price="@item.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            <!-- Thông tin sản phẩm -->
                            <div class="col-info product-meta">
                                <div class="product-thumb">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.ProductName" />
                                    }
                                    else
                                    {
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#a0aec0" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="8.5" cy="8.5" r="1.5" /><path d="M21 15l-5-5L5 21" /></svg>
                                    }
                                </div>
                                <div class="product-details">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId" class="product-title">
                                        @item.ProductName
                                    </a>
                                    @if (!string.IsNullOrEmpty(item.VariantLabel))
                                    {
                                        <span class="product-variant">@item.VariantLabel</span>
                                    }
                                </div>
                            </div>

                            <!-- Đơn giá -->
                            <div class="col-price">
                                <span>@item.UnitPrice.ToString("N0")đ</span>
                            </div>

                            <!-- 3. Bộ tăng/giảm số lượng -->
                            <div class="col-qty">
                                <form asp-action="Update" method="post" class="qty-control">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.CartItemId" />
                                    <button type="button" class="qty-btn qty-minus">−</button>
                                    <input name="quantity" type="number" min="0" max="@item.Stock" value="@item.Quantity" readonly />
                                    <button type="button" class="qty-btn qty-plus">+</button>
                                </form>
                            </div>

                            <!-- Thành tiền -->
                            <div class="col-total">
                                <span data-line-total>@item.LineTotal.ToString("N0")đ</span>
                            </div>

                            <!-- 4. Nút xóa -->
                            <div class="col-action">
                                <form asp-action="Remove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.CartItemId" />
                                    <button type="submit" class="btn-delete" title="Xóa">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" /></svg>
                                    </button>
                                </form>
                            </div>
                        </article>
                    }
                </div>
            </div>

            <!-- Khối bên phải: Tổng tiền & Mã giảm giá -->
            <aside class="cart-card summary-card">
                <h2>Tổng tiền</h2>

                <section class="emua-coupons" id="couponWidget"
                         data-options-url="@Url.Action("CouponOptions", "Cart")"
                         data-active-code="@Model.CouponCode" aria-label="Mã giảm giá">
                    <details id="couponPicker">
                        <summary><span><i class="bi bi-ticket-perforated" aria-hidden="true"></i> Chọn mã giảm giá</span><span class="ec-chevron" aria-hidden="true">⌄</span></summary>
                        <div class="ec-panel">
                            <div class="ec-panel-heading"><strong>Ưu đãi dành cho giỏ hàng</strong><small>Chỉ hiện mã bạn đủ điều kiện sử dụng</small></div>
                            <div id="couponList" class="ec-list" aria-live="polite"></div>
                            <p id="couponListStatus" class="ec-list-status" role="status"></p>
                            <button type="button" id="couponRetry" class="ec-retry" hidden>Thử tải lại</button>
                            <nav class="ec-pagination" id="couponPagination" aria-label="Trang mã giảm giá" hidden>
                                <button type="button" id="couponPrev" aria-label="Trang mã trước">‹</button>
                                <span id="couponPage" aria-live="polite">1 / 1</span>
                                <button type="button" id="couponNext" aria-label="Trang mã tiếp theo">›</button>
                            </nav>
                        </div>
                    </details>
                    <form asp-controller="Cart" asp-action="ApplyCoupon" method="post" id="couponApplyForm" class="ec-manual">
                        @Html.AntiForgeryToken()
                        <label for="couponCode">Bạn có mã khác?</label>
                        <div class="ec-input-row">
                            <input id="couponCode" name="code" maxlength="50" autocomplete="off" placeholder="Nhập mã giảm giá" aria-describedby="couponMessage" />
                            <button type="submit">Áp dụng</button>
                        </div>
                    </form>
                    <form asp-controller="Cart" asp-action="RemoveCoupon" method="post" id="couponRemoveForm" class="ec-applied" hidden="@(string.IsNullOrWhiteSpace(Model.CouponCode))">
                        @Html.AntiForgeryToken()
                        <span>Đang dùng <strong id="couponActiveCode">@Model.CouponCode</strong></span>
                        <button type="submit" aria-label="Bỏ mã giảm giá đang áp dụng">Bỏ mã</button>
                    </form>
                    <p id="couponMessage" class="ec-message @(couponError != null ? "is-error" : "is-success")" role="status" aria-live="polite" aria-atomic="true" hidden="@(couponError == null && couponSuccess == null)">@(couponError ?? couponSuccess)</p>
                    <noscript><small>Nhập mã và bấm Áp dụng. Bật JavaScript để xem danh sách mã phù hợp.</small></noscript>
                </section>
                <div class="summary-row">
                    <span>Tạm tính (@Model.TotalQuantity sản phẩm)</span>
                    <span data-cart-subtotal>@Model.Subtotal.ToString("N0")đ</span>
                </div>

                <div class="summary-row">
                    <span>Phí vận chuyển</span>
                    <span data-cart-shipping>@(Model.ShippingFee == 0 ? "Miễn phí" : Model.ShippingFee.ToString("N0") + "đ")</span>
                </div>

                <div class="summary-row" id="discount-row" style="@(Model.Discount > 0 ? "" : "display:none;")">
                    <span>Giảm giá</span>
                    <span id="discount-amount" class="text-danger">-@Model.Discount.ToString("N0")đ</span>
                </div>

                <div class="summary-divider"></div>

                <!-- 5. Tổng cộng -->
                <div class="summary-row total-row">
                    <span>Tổng cộng</span>
                    <strong data-cart-finaltotal>@Model.FinalTotal.ToString("N0")đ</strong>
                </div>

                <!-- 6 & 7. Các nút chuyển hướng -->
                <div class="summary-actions">
                    <a asp-controller="Product" asp-action="Index" class="btn-outline">
                        Tiếp tục mua sắm
                    </a>
                    <a asp-controller="Checkout" asp-action="Index" asp-route-fromCart="true" class="btn-solid">
                        Thanh toán
                    </a>
                </div>
            </aside>
        </div>
    }
</div>

@section Scripts {
    <script>
        (function () {
            'use strict';
            const widget = document.getElementById('couponWidget');
            let busy = false, loading = false, currentPage = 1, pages = 1;
            const money = value => Number(value).toLocaleString('vi-VN', { maximumFractionDigits: 0 }) + 'đ';

            // Quantities are recalculated by the server, including coupon eligibility.
            document.querySelectorAll('.cart-row').forEach(row => {
                const input = row.querySelector('input[name="quantity"]');
                const minus = row.querySelector('.qty-minus');
                const plus = row.querySelector('.qty-plus');
                minus.disabled = Number(input.value) <= 1;
                plus.disabled = Number(input.value) >= Number(input.max);
                function change(delta) {
                    if (busy) return;
                    const next = Number(input.value) + delta;
                    if (next < 1 || next > Number(input.max)) return;
                    busy = true;
                    input.value = next;
                    minus.disabled = plus.disabled = true;
                    input.form.requestSubmit();
                }
                minus.addEventListener('click', () => change(-1));
                plus.addEventListener('click', () => change(1));
            });
            if (!widget) return;
            const el = id => document.getElementById(id);
            const picker = el('couponPicker'), list = el('couponList');
            const applyForm = el('couponApplyForm'), removeForm = el('couponRemoveForm');
            const input = el('couponCode'), message = el('couponMessage');
            const prev = el('couponPrev'), next = el('couponNext');
            let activeCode = widget.dataset.activeCode || '';

            function showMessage(text, error = false) {
                message.textContent = text;
                message.className = 'ec-message ' + (error ? 'is-error' : 'is-success');
                message.hidden = false;
            }
            function controls() {
                widget.querySelectorAll('button').forEach(button => {
                    button.disabled = busy || loading || button.dataset.applied === 'true';
                });
                prev.disabled = busy || loading || currentPage <= 1;
                next.disabled = busy || loading || currentPage >= pages;
                input.disabled = busy;
                widget.setAttribute('aria-busy', String(busy || loading));
            }
            async function readResponse(response) {
                if (response.status === 401 || response.status === 403 || response.redirected) {
                    throw new Error('Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại rồi thử mã.');
                }
                const json = (response.headers.get('content-type') || '').includes('application/json');
                const result = json ? await response.json() : null;
                if (!response.ok || !result) {
                    throw new Error(result?.message || (response.status === 400
                        ? 'Phiên bảo mật đã hết hạn hoặc yêu cầu không hợp lệ. Vui lòng tải lại trang.'
                        : 'Chưa thể xử lý mã giảm giá. Vui lòng thử lại.'));
                }
                return result;
            }
            function textNode(tag, className, text) {
                const node = document.createElement(tag);
                node.className = className;
                node.textContent = text;
                return node;
            }
            function renderItems(items) {
                list.replaceChildren();
                items.forEach(coupon => {
                    const card = document.createElement('article');
                    card.className = 'ec-ticket';
                    const heading = document.createElement('div');
                    heading.className = 'ec-ticket-heading';
                    heading.append(textNode('strong', 'ec-code', coupon.code), textNode('span', 'ec-value', coupon.label));
                    card.append(heading, textNode('p', 'ec-name', coupon.name),
                        textNode('p', 'ec-condition', Number(coupon.minimum) > 0 ? 'Đơn từ ' + money(coupon.minimum) : 'Không yêu cầu đơn tối thiểu'),
                        textNode('p', 'ec-expiry', 'Hạn dùng: ' + coupon.expires));
                    const footer = document.createElement('div');
                    footer.className = 'ec-ticket-footer';
                    const button = document.createElement('button');
                    button.type = 'button';
                    button.dataset.code = coupon.code;
                    const applied = coupon.code === activeCode;
                    button.dataset.applied = String(applied);
                    button.textContent = applied ? 'Đang dùng' : 'Áp dụng';
                    button.setAttribute('aria-label', (applied ? 'Đang dùng mã ' : 'Áp dụng mã ') + coupon.code);
                    button.disabled = applied;
                    button.addEventListener('click', () => mutate(applyForm, coupon.code));
                    footer.append(textNode('span', 'ec-saving', 'Tiết kiệm ' + money(coupon.discount)), button);
                    card.append(footer);
                    list.append(card);
                });
            }
            async function loadPage(page) {
                if (loading || busy) return;
                loading = true;
                controls();
                el('couponRetry').hidden = true;
                el('couponListStatus').textContent = 'Đang tìm ưu đãi phù hợp…';
                try {
                    const url = new URL(widget.dataset.optionsUrl, window.location.href);
                    url.searchParams.set('page', page);
                    const result = await readResponse(await fetch(url, { headers: { Accept: 'application/json' }, cache: 'no-store' }));
                    currentPage = result.page;
                    pages = result.pages;
                    renderItems(result.items);
                    el('couponPage').textContent = currentPage + ' / ' + pages;
                    el('couponPagination').hidden = pages <= 1;
                    el('couponListStatus').textContent = result.total === 0 ? 'Chưa có mã phù hợp với giỏ hàng hiện tại. Bạn vẫn có thể nhập mã bên dưới.' : '';
                } catch (error) {
                    list.replaceChildren();
                    el('couponPagination').hidden = true;
                    el('couponListStatus').textContent = error instanceof TypeError
                        ? 'Không thể tải ưu đãi. Kiểm tra kết nối rồi thử lại.' : error.message;
                    el('couponRetry').hidden = false;
                } finally {
                    loading = false;
                    controls();
                }
            }
            function updateTotals(result) {
                document.querySelectorAll('[data-cart-subtotal]').forEach(node => node.textContent = money(result.subtotal));
                document.querySelectorAll('[data-cart-finaltotal]').forEach(node => node.textContent = money(result.total));
                document.querySelectorAll('[data-cart-shipping]').forEach(node => node.textContent = result.shipping === 0 ? 'Miễn phí' : money(result.shipping));
                el('discount-row').style.display = result.discount > 0 ? '' : 'none';
                el('discount-amount').textContent = '-' + money(result.discount);
                activeCode = result.code || '';
                el('couponActiveCode').textContent = activeCode;
                removeForm.hidden = !activeCode;
                list.querySelectorAll('button[data-code]').forEach(button => {
                    const applied = button.dataset.code === activeCode;
                    button.dataset.applied = String(applied);
                    button.textContent = applied ? 'Đang dùng' : 'Áp dụng';
                    button.setAttribute('aria-label', (applied ? 'Đang dùng mã ' : 'Áp dụng mã ') + button.dataset.code);
                });
            }
            async function mutate(form, code) {
                if (busy || loading) return;
                // Capture form fields before disabling inputs.
                const body = new FormData(form);
                if (form === applyForm) {
                    const value = (code ?? input.value).trim();
                    if (!value) {
                        showMessage('Vui lòng nhập mã giảm giá.', true);
                        input.setAttribute('aria-invalid', 'true');
                        input.focus();
                        return;
                    }
                    body.set('code', value);
                }
                busy = true;
                controls();
                let succeeded = false;
                input.removeAttribute('aria-invalid');
                try {
                    const result = await readResponse(await fetch(form.action, { method: 'POST', headers: { Accept: 'application/json' }, body }));
                    if (!result.success) throw new Error(result.message || 'Chưa thể áp dụng mã giảm giá.');
                    updateTotals(result);
                    showMessage(result.message);
                    input.value = '';
                    succeeded = true;
                } catch (error) {
                    showMessage(error instanceof TypeError ? 'Chưa nhận được phản hồi. Kiểm tra kết nối và tải lại trang để xác nhận mã đang dùng.' : error.message, true);
                } finally {
                    busy = false;
                    controls();
                }
                if (succeeded) {
                    message.tabIndex = -1;
                    message.focus({ preventScroll: true });
                    if (picker.open) await loadPage(currentPage);
                }
            }
            applyForm.addEventListener('submit', event => { event.preventDefault(); mutate(applyForm); });
            removeForm.addEventListener('submit', event => { event.preventDefault(); mutate(removeForm); });
            picker.addEventListener('toggle', () => { if (picker.open) loadPage(1); });
            prev.addEventListener('click', () => loadPage(currentPage - 1));
            next.addEventListener('click', () => loadPage(currentPage + 1));
            el('couponRetry').addEventListener('click', () => loadPage(currentPage));
        })();

    </script>
}
