@model EMua.ViewModels.CartViewModel
@{
    ViewData["Title"] = "Giỏ hàng";
    var selectedCoupon = Model.AvailableCoupons.FirstOrDefault(x => x.Code == Model.CouponCode);
}
<link rel="stylesheet" href="~/css/shopping-cart.css" asp-append-version="true" />

<div class="cart-container">
    <!-- 1. Tiêu đề trang + Nút quay lại -->
    <header class="cart-header">
        <a asp-controller="Product" asp-action="Index" class="btn-back-icon" title="Quay lại mua sắm">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1>Giỏ hàng</h1>
            <p>Bạn có @Model.TotalQuantity sản phẩm trong giỏ hàng</p>
        </div>
    </header>

    @if (TempData["Error"] != null)
    {
        <div class="customer-alert error">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="customer-alert success">@TempData["Success"]</div>
    }

    @if (Model.Items.Count == 0)
    {
        <div class="empty-state">
            <h2>Giỏ hàng đang trống</h2>
            <p>Thêm sản phẩm bạn yêu thích để bắt đầu đặt hàng.</p>
            <a asp-controller="Product" asp-action="Index" class="btn-outline">Khám phá sản phẩm</a>
        </div>
    }
    else
    {
        <div class="cart-main-grid">
            <!-- Khối bên trái: Bảng danh sách sản phẩm -->
            <div class="cart-card">
                <!-- 2. Bảng tiêu đề sản phẩm -->
                <div class="cart-table-head">
                    <div class="col-info">Sản phẩm</div>
                    <div class="col-price">Đơn giá</div>
                    <div class="col-qty">Số lượng</div>
                    <div class="col-total">Thành tiền</div>
                    <div class="col-action">Thao tác</div>
                </div>

                <div class="cart-table-body">
                    @foreach (var item in Model.Items)
                    {
                        <article class="cart-row"
                                 data-unit-price="@item.UnitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)">
                            <!-- Thông tin sản phẩm -->
                            <div class="col-info product-meta">
                                <div class="product-thumb">
                                    @if (!string.IsNullOrWhiteSpace(item.ImageUrl))
                                    {
                                        <img src="@item.ImageUrl" alt="@item.ProductName" />
                                    }
                                    else
                                    {
                                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#a0aec0"
                                             stroke-width="1.5">
                                            <rect x="3" y="3" width="18" height="18" rx="2" />
                                            <circle cx="8.5" cy="8.5" r="1.5" />
                                            <path d="M21 15l-5-5L5 21" />
                                        </svg>
                                    }
                                </div>
                                <div class="product-details">
                                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.ProductId"
                                       class="product-title">
                                        @item.ProductName
                                    </a>
                                    @if (!string.IsNullOrEmpty(item.VariantLabel))
                                    {
                                        <span class="product-variant">@item.VariantLabel</span>
                                    }
                                </div>
                            </div>

                            <!-- Đơn giá -->
                            <div class="col-price">
                                <span>@item.UnitPrice.ToString("N0")đ</span>
                            </div>

                            <!-- 3. Bộ tăng/giảm số lượng -->
                            <div class="col-qty">
                                <form asp-action="Update" method="post" class="qty-control">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.CartItemId" />
                                    <button type="button" class="qty-btn qty-minus">−</button>
                                    <input name="quantity" type="number" min="0" max="@Math.Min(item.Stock, 5)"
                                           value="@item.Quantity" readonly />
                                    <button type="button" class="qty-btn qty-plus">+</button>
                                </form>
                            </div>

                            <!-- Thành tiền -->
                            <div class="col-total">
                                <span data-line-total>@item.LineTotal.ToString("N0")đ</span>
                            </div>

                            <!-- 4. Nút xóa -->
                            <div class="col-action">
                                <form asp-action="Remove" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.CartItemId" />
                                    <button type="submit" class="btn-delete" title="Xóa">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="1.8">
                                            <path
                                            d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2" />
                                        </svg>
                                    </button>
                                </form>
                            </div>
                        </article>
                    }
                </div>
            </div>

            <!-- Khối bên phải: Tổng tiền & Mã giảm giá -->
            <aside class="cart-card summary-card">
                <h2>Tổng tiền</h2>

                <!-- KHỐI CHỌN VOUCHER -->
                <div class="voucher-box">
                    <form asp-action="ApplyCoupon" method="post" class="voucher-form">
                        @Html.AntiForgeryToken()
                        <div class="voucher-picker coupon-picker" id="cartCouponPicker">
                            <div class="coupon-picker-control">
                                <input type="text" name="code" id="cartCouponCode" class="voucher-input form-control"
                                       value="@selectedCoupon?.Code" placeholder="Nhập hoặc chọn mã giảm giá"
                                       autocomplete="off" autocapitalize="characters" aria-haspopup="listbox"
                                       aria-expanded="false" />
                                <button type="button" id="cartCouponToggle" class="coupon-picker-toggle"
                                        aria-label="Chọn mã giảm giá" aria-expanded="false">
                                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div class="coupon-options" id="cartCouponOptions" role="listbox"
                                 aria-label="Mã giảm giá đủ điều kiện">
                                <button type="button" class="coupon-option" role="option" data-code="">
                                    <span class="coupon-option-code">Bỏ mã giảm giá</span>
                                </button>
                                @foreach (var coupon in Model.AvailableCoupons)
                                {
                                    <button type="button" class="coupon-option" role="option" data-code="@coupon.Code">
                                        <span class="coupon-option-code">@coupon.Code</span>
                                        <span class="coupon-option-name">@coupon.Name</span>
                                        <span class="coupon-option-discount">@coupon.DiscountText</span>
                                    </button>
                                }
                            </div>
                        </div>
                        <button type="submit" class="btn-apply-voucher">Áp dụng</button>
                    </form>
                    @if (!Model.AvailableCoupons.Any())
                    {
                        <small class="text-muted d-block mt-2">Chưa có mã nào đủ điều kiện cho đơn hàng này.</small>
                    }
                </div>

                <div class="summary-row">
                    <span>Tạm tính (@Model.TotalQuantity sản phẩm)</span>
                    <span data-cart-subtotal>@Model.Subtotal.ToString("N0")đ</span>
                </div>

                <div class="summary-row">
                    <span>Phí vận chuyển</span>
                    <span data-cart-shipping>@(Model.ShippingFee == 0 ? "Miễn phí" : $"{Model.ShippingFee:N0}đ")</span>
                </div>

                <div class="summary-row" id="discount-row" style="@(Model.Discount > 0 ? "" : "display:none;")">
                    <span>Giảm giá</span>
                    <span id="discount-amount" class="text-danger">-@Model.Discount.ToString("N0")đ</span>
                </div>

                <div class="summary-divider"></div>

                <!-- 5. Tổng cộng -->
                <div class="summary-row total-row">
                    <span>Tổng cộng</span>
                    <strong data-cart-finaltotal>@Model.FinalTotal.ToString("N0")đ</strong>
                </div>

                <!-- 6 & 7. Các nút chuyển hướng -->
                <div class="summary-actions">
                    <a asp-controller="Product" asp-action="Index" class="btn-outline">
                        Tiếp tục mua sắm
                    </a>
                    <a asp-controller="Checkout" asp-action="Index" class="btn-solid">
                        Thanh toán
                    </a>
                </div>
            </aside>
        </div>
    }
</div>

@section Scripts {
    <script>
        const cartDiscount = @Html.Raw(Model.Discount.ToString(System.Globalization.CultureInfo.InvariantCulture));

        const cartCouponPicker = document.getElementById('cartCouponPicker');
        const cartCouponToggle = document.getElementById('cartCouponToggle');
        const cartCouponOptions = document.getElementById('cartCouponOptions');
        const cartCouponCode = document.getElementById('cartCouponCode');
        if (cartCouponPicker && cartCouponToggle && cartCouponOptions && cartCouponCode) {
            const setCouponOptionsOpen = function (isOpen) {
                cartCouponOptions.classList.toggle('is-open', isOpen);
                cartCouponToggle.setAttribute('aria-expanded', String(isOpen));
                cartCouponCode.setAttribute('aria-expanded', String(isOpen));
            };

            cartCouponToggle.addEventListener('click', function () {
                setCouponOptionsOpen(!cartCouponOptions.classList.contains('is-open'));
            });
            cartCouponCode.addEventListener('focus', function () {
                setCouponOptionsOpen(true);
            });
            cartCouponCode.addEventListener('keydown', function (event) {
                if (event.key === 'Enter' || event.key === ' ' || event.key === 'ArrowDown') {
                    event.preventDefault();
                    setCouponOptionsOpen(true);
                } else if (event.key === 'Escape') {
                    setCouponOptionsOpen(false);
                }
            });
            cartCouponCode.addEventListener('input', function () {
                const search = cartCouponCode.value.trim().toLowerCase();
                setCouponOptionsOpen(true);
                cartCouponOptions.querySelectorAll('.coupon-option').forEach(function (option) {
                    const searchable = `${option.dataset.code || ''} ${option.textContent || ''}`.toLowerCase();
                    option.hidden = Boolean(search) && !searchable.includes(search);
                });
            });
            cartCouponOptions.addEventListener('click', function (event) {
                const option = event.target.closest('.coupon-option');
                if (!option) return;
                cartCouponCode.value = option.dataset.code || '';
                cartCouponOptions.querySelectorAll('.coupon-option').forEach(function (item) {
                    item.hidden = false;
                });
                setCouponOptionsOpen(false);
            });
            document.addEventListener('click', function (event) {
                if (!cartCouponPicker.contains(event.target)) setCouponOptionsOpen(false);
            });
        }

        document.querySelectorAll('.cart-row').forEach(function (item) {
            const input = item.querySelector('input[name="quantity"]');
            const price = Number(item.dataset.unitPrice || 0);
            const lineTotal = item.querySelector('[data-line-total]');
            const max = Number(input.max || Infinity);
            const minusBtn = item.querySelector('.qty-minus');
            const plusBtn = item.querySelector('.qty-plus');

            function updateCalculations() {
                const qty = Math.max(0, Number(input.value || 0));
                if (lineTotal) lineTotal.textContent = (price * qty).toLocaleString('vi-VN') + 'đ';

                let subtotal = 0;
                document.querySelectorAll('.cart-row').forEach(function (row) {
                    const rowPrice = Number(row.dataset.unitPrice || 0);
                    const rowQty = Math.max(0, Number(row.querySelector('input[name="quantity"]').value || 0));
                    subtotal += rowPrice * rowQty;
                });

                document.querySelectorAll('[data-cart-subtotal]').forEach(e => e.textContent = subtotal.toLocaleString('vi-VN') + 'đ');
                const shipping = subtotal <= 0 || subtotal >= 500000 ? 0 : 30000;
                document.querySelectorAll('[data-cart-shipping]').forEach(e => {
                    e.textContent = shipping === 0 ? 'Miễn phí' : shipping.toLocaleString('vi-VN') + 'đ';
                });
                document.querySelectorAll('[data-cart-finaltotal]').forEach(e => {
                    const finalTotal = Math.max(0, subtotal - cartDiscount + shipping);
                    e.textContent = finalTotal.toLocaleString('vi-VN') + 'đ';
                });
            }

            if (minusBtn) {
                minusBtn.addEventListener('click', function () {
                    if (Number(input.value) > 1) {
                        input.value = Number(input.value) - 1;
                        updateCalculations();
                        input.form.submit();
                    }
                });
            }
            if (plusBtn) {
                plusBtn.addEventListener('click', function () {
                    if (Number(input.value) < max) {
                        input.value = Number(input.value) + 1;
                        updateCalculations();
                        input.form.submit();
                    }
                });
            }
        });
    </script>
}
