<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>


<script>
    // =====================================================
    // DỮ LIỆU CỬA HÀNG
    // =====================================================
    var stores = [
        {
            lat: 21.0338,
            lng: 105.8342,
            title: "EMUA - Ba Đình",
            address: "13 Ba Đình, Q. Ba Đình, Hà Nội",
            city: "hanoi"
        },
        {
            lat: 16.0825,
            lng: 108.1402,
            title: "EMUA - Ngô Xuân Thu",
            address: "76 Ngô Xuân Thu, Q. Liên Chiểu, Đà Nẵng",
            city: "danang"
        },
        {
            lat: 16.0752,
            lng: 108.1531,
            title: "EMUA - Nguyễn Lương Bằng",
            address: "540 Nguyễn Lương Bằng, Q. Liên Chiểu, Đà Nẵng",
            city: "danang"
        },
        {
            lat: 16.0689,
            lng: 108.2145,
            title: "EMUA - Tôn Thất Đạm",
            address: "65 Tôn Thất Đạm, Q. Thanh Khê, Đà Nẵng",
            city: "danang"
        },
        {
            lat: 16.0601,
            lng: 108.2098,
            title: "EMUA - Nguyễn Văn Linh",
            address: "1020 Nguyễn Văn Linh, Q. Thanh Khê, Đà Nẵng",
            city: "danang"
        }
    ];

    // Mảng lưu danh sách tọa độ nối liền dọc Việt Nam
    var routeCoordinates = stores.map(function(s) { return [s.lat, s.lng]; });

    // =====================================================
    // KHỞI TẠO MAP
    // =====================================================
    var map = L.map('storeMap', {
        zoomControl: true,
        scrollWheelZoom: true
    });

    // Fit bản đồ tự động ôm trọn tất cả các điểm cửa hàng trên bản đồ Việt Nam
    map.fitBounds(routeCoordinates, { padding: [40, 40] });

    // =====================================================
    // MAP TILE
    // =====================================================
        L.tileLayer(
        'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png',
        {
            attribution: '&copy; OpenStreetMap contributors',
            subdomains: 'abc',
            maxZoom: 19,
            minZoom: 3
        }
    ).addTo(map);

    // =====================================================
    // VẼ ĐƯỜNG NỐI HỆ THỐNG CỬA HÀNG (POLYLINE)
    // =====================================================
    var storePolyline = L.polyline(routeCoordinates, {
        color: '#2563eb',       // Màu xanh đặc trưng EMUA
        weight: 3,              // Độ dầy nét vẽ
        opacity: 0.8,
        dashArray: '6, 8',      // Nét đứt quãng hiện đại
        lineJoin: 'round'
    }).addTo(map);

    // =====================================================
    // TẠO MARKER & POPUP
    // =====================================================
    stores.forEach(function (store) {
        var popupContent = `
            <div class="emua-popup">
                <div class="popup-title">${store.title}</div>
                <div class="popup-address">
                    <i class="bi bi-geo-alt-fill"></i>
                    ${store.address}
                </div>
                <div class="popup-time">
                    <i class="bi bi-clock-fill"></i>
                    08:00 - 22:00
                </div>
            </div>
        `;

        L.marker([store.lat, store.lng])
            .addTo(map)
            .bindPopup(popupContent);
    });

    // =====================================================
    // CLICK STORE
    // =====================================================
    function focusStore(lat, lng, title, address) {
        map.flyTo([lat, lng], 16, {
            animate: true,
            duration: 1
        });

        var popupContent = `
            <div class="emua-popup">
                <div class="popup-title">${title}</div>
                <div class="popup-address">
                    <i class="bi bi-geo-alt-fill"></i>
                    ${address}
                </div>
                <div class="popup-time">
                    <i class="bi bi-clock-fill"></i>
                    08:00 - 22:00
                </div>
            </div>
        `;

        L.popup({ closeButton: true, autoClose: true })
            .setLatLng([lat, lng])
            .setContent(popupContent)
            .openOn(map);
    }

    // =====================================================
    // FILTER CITY
    // =====================================================
    function filterCity(city, btn) {
        document.querySelectorAll('.store-filter-btn').forEach(function (button) {
            button.classList.remove('active');
        });
        btn.classList.add('active');

        var items = document.querySelectorAll('.store-item');
        items.forEach(function (item) {
            if (city === 'all' || item.classList.contains(city)) {
                item.style.display = 'flex';
            } else {
                item.style.display = 'none';
            }
        });

        if (city === 'all') {
            map.fitBounds(routeCoordinates, { padding: [40, 40] });
        } else if (city === 'danang') {
            map.flyTo([16.0601, 108.2098], 12, { duration: 1 });
        } else if (city === 'hanoi') {
            map.flyTo([21.0338, 105.8342], 13, { duration: 1 });
        }
    }

    // =====================================================
    // FIX MAP SIZE
    // =====================================================
    setTimeout(function () {
        map.invalidateSize();
    }, 300);

    window.addEventListener('resize', function () {
        map.invalidateSize();
    });
</script>