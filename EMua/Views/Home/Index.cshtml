@model EMua.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "EMUA — Siêu thị thiết bị công nghệ chính hãng";
    ViewData["HomeRedesign"] = true;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/home-refresh.css"
          asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div class="emua-home">
    @* 1. HERO BANNER CÔNG NGHỆ CAO CẤP (Carousel 4 Slide Flagship) *@
    <partial name="Home/_Hero" />

    @* 2. DANH MỤC THIẾT BỊ DẠNG GRID HIỆN ĐẠI *@
    <partial name="Home/_Categories" model="Model.DanhMucs" />

    @* 3. FLASH SALE GIÁ SỐC (Nếu có dữ liệu) *@
    @if (Model.FlashSale != null && Model.FlashSale.Any())
    {
        <partial name="Home/_FlashSale" model="Model.FlashSale" />
    }

    @* 4. SẢN PHẨM NỔI BẬT (BÁN CHẠY NHẤT) *@
    <partial name="Home/_FeaturedProducts" model="Model.SanPhamNoiBat" />

    @* 5. PRODUCT SHOWCASE (Bố cục bất đối xứng: Laptop, Smartphone, Âm thanh, Gaming) *@
    <partial name="Home/_Showcase" />

    @* 6. LỰA CHỌN ĐÁNG CÂN NHẮC (EMUA SELECTION) *@
    @if (Model.BestChoice != null && Model.BestChoice.Any())
    {
        <partial name="Home/_BestChoice" model="Model.BestChoice" />
    }

    @* 7. KHU VỰC TRỢ LÝ AI EMUA (Tư vấn công nghệ cao cấp) *@
    <section class="home-advisor" aria-labelledby="advisor-title">
        <div class="ep-container">
            <div class="home-advisor-inner">
                <div class="advisor-copy">
                    <span>
                        <i class="bi bi-cpu-fill" aria-hidden="true"></i> TRỢ LÝ THÔNG MINH
                    </span>
                    <h2 id="advisor-title">Chọn đúng thiết bị, dễ dàng hơn cùng AI.</h2>
                    <p>Chia sẻ nhu cầu và ngân sách — trợ lý AI sẽ phân tích và đề xuất cấu hình tối ưu nhất cho bạn.</p>
                </div>
                <button type="button" class="advisor-button" onclick="document.getElementById('aiToggleButton')?.click()" aria-label="Bắt đầu tư vấn cùng AI">
                    <i class="bi bi-chat-dots-fill" aria-hidden="true"></i>
                    <span>Tư vấn cùng AI</span>
                </button>
            </div>
        </div>
    </section>

    @* 8. SẢN PHẨM MỚI TẠI EMUA *@
    <partial name="Home/_NewProducts" model="Model.SanPhamMoi" />

    @* 9. THƯƠNG HIỆU ĐỐI TÁC CHIẾN LƯỢC *@
    <partial name="Home/_Brands" model="Model.ThuongHieus" />
</div>

<script>
    // Đồng hồ đếm ngược Flash Sale kết thúc vào 23:59:59 mỗi ngày
    (function initFlashSaleTimer() {
        function updateTimer() {
            const now = new Date();
            const midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59);
            let diff = Math.max(0, Math.floor((midnight - now) / 1000));

            const hours = String(Math.floor(diff / 3600)).padStart(2, '0');
            diff %= 3600;
            const minutes = String(Math.floor(diff / 60)).padStart(2, '0');
            const seconds = String(diff % 60).padStart(2, '0');

            const hElem = document.getElementById('fsHours');
            const mElem = document.getElementById('fsMinutes');
            const sElem = document.getElementById('fsSeconds');

            if (hElem) hElem.textContent = hours;
            if (mElem) mElem.textContent = minutes;
            if (sElem) sElem.textContent = seconds;
        }

        updateTimer();
        setInterval(updateTimer, 1000);
    })();

</script>
