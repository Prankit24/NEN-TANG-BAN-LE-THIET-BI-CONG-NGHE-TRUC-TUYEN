@model EMua.Models.ViewModels.HomeViewModel

@{
    ViewData["Title"] = "Trang chủ";
}

@Html.AntiForgeryToken()


<partial name="Home/_Hero" />

<partial name="Home/_IPhoneDuo" />

<partial name="Home/_Categories" model="Model.DanhMucs" />

<partial name="Home/_FlashSale" model="Model.FlashSale" />

<partial name="Home/_FeaturedProducts" model="Model.SanPhamNoiBat" />

<partial name="Home/_BestChoice" model="Model.BestChoice" />

<partial name="Home/_NewProducts" model="Model.SanPhamMoi" />

<partial name="Home/_Brands" model="Model.ThuongHieus" />

<style>
    :is(.featured-image, .new-product-image, .best-image, .emua-flash-image) {
        position: relative;
    }

    .product-favorite-form {
        position: absolute;
        top: 10px;
        right: 10px;
        z-index: 3;
        margin: 0;
    }

    .product-favorite-button {
        display: grid;
        place-items: center;
        width: 42px;
        aspect-ratio: 1;
        padding: 0;
        border: 1px solid #d9dee7;
        border-radius: 50%;
        background: #fff;
        color: #343a40;
        box-shadow: 0 2px 8px rgb(0 0 0 / 12%);
        cursor: pointer;
    }

    .product-favorite-button:hover {
        color: #d6336c;
        border-color: #d6336c;
    }

    .product-favorite-button.is-favorite {
        color: #d6336c;
        border-color: #d6336c;
    }

    .product-favorite-button i {
        font-size: 1.1rem;
    }
</style>

<script>

    async function homeAddCart(variantId, buyNow = false) {

        // Khách chưa đăng nhập vẫn được thêm vào giỏ tạm trên trình duyệt.
        if (!window.EMUA_IS_AUTHENTICATED) {
            if (!window.addToGuestCart(variantId, 1)) return;
            if (typeof showCartAddedFeedback === 'function') showCartAddedFeedback();
            if (buyNow) window.location.href = '/Checkout/Index';
            return;
        }

        /*
         * Token được sinh bởi:
         *
         * @Html.AntiForgeryToken()
         */
        const tokenInput =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );


        if (!tokenInput) {

            console.error(
                'Không tìm thấy __RequestVerificationToken'
            );

            alert(
                'Không tìm thấy mã bảo mật.'
            );

            return;
        }


        try {

            const response =
                await fetch(
                    '/Cart/Add',
                    {

                        method:
                            'POST',

                        headers: {

                            'Content-Type':
                                'application/x-www-form-urlencoded; charset=UTF-8',

                            'Accept':
                                'application/json',

                            'RequestVerificationToken':
                                tokenInput.value
                        },


                        body:
                            new URLSearchParams({
                                VariantId: variantId,
                                Quantity: 1,
                                buyNow: buyNow
                            })

                    }
                );


            /*
             * Chưa đăng nhập.
             */
            if (
                response.status === 401
                ||
                response.status === 403
            ) {

                window.location.href =
                    '/Auth/Login?returnUrl='
                    +
                    encodeURIComponent(
                        window.location.pathname
                    );

                return;
            }

            let result = null;
            const contentType = response.headers.get('content-type');
            if (contentType && contentType.includes('application/json')) {
                result = await response.json();
            }

            /*
             * Nếu lỗi.
             */
            if (!response.ok) {

                console.error(
                    'Cart Add Error',
                    response.status,
                    result
                );


                alert(
                    result?.message
                    ||
                    'Không thể thêm sản phẩm vào giỏ hàng.'
                );

                return;
            }

            if (buyNow) {
                window.location.href = result.redirectUrl || '/Checkout/Index';
                return;
            }

            if (result.count !== undefined && typeof setGlobalCartCount === 'function') {
                setGlobalCartCount(result.count, false);
            }


            /*
             * Thành công: không hiện toast.
             * Chỉ nháy icon giỏ hàng và hiện +1.
             */
            if (typeof showCartAddedFeedback === 'function') {
                showCartAddedFeedback();
            }


        }
        catch (error) {

            console.error(
                'Lỗi khi gọi /Cart/Add:',
                error
            );


            alert(
                'Không thể kết nối đến giỏ hàng.'
            );

        }

    }

</script>