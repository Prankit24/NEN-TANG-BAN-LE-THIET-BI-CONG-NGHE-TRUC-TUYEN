@model EMua.Models.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "EMUA — Siêu thị thiết bị công nghệ chính hãng";
    ViewData["HomeRedesign"] = true;
}

@section Styles {
    <link rel="stylesheet"
          href="~/css/customer/home-refresh.css"
          asp-append-version="true" />
}

@Html.AntiForgeryToken()

<div class="emua-home">
    @* KHỐI 1: HERO BANNER & THANH DANH MỤC NHANH (Bố cục 2 cột hiện đại Bento) *@
    <partial name="Home/_Hero" model="Model.DanhMucs" />

    @* KHỐI 2: FLASH SALE GIÁ SỐC (Tối đa 5 sản phẩm kèm thanh tiến độ Đã bán) *@
    @if (Model.FlashSale != null && Model.FlashSale.Any())
    {
        <partial name="Home/_FlashSale" model="Model.FlashSale" />
    }

    @* KHỐI 3: DANH MỤC NỔI BẬT (Category Bento Cards có icon, bấm lọc ngay) *@
    <partial name="Home/_Categories" model="Model.DanhMucs" />

    @* KHỐI 4: SẢN PHẨM NỔI BẬT (Tabbed Grid: Tất cả, Điện thoại, Laptop, Âm thanh, Gaming - Tối đa 8 SP) *@
    <partial name="Home/_FeaturedProducts" model="Model.SanPhamNoiBat" />

    @* KHỐI 5: TRỢ LÝ TƯ VẤN AI EMUA *@
    <section class="home-advisor" aria-labelledby="advisor-title">
        <div class="ep-container">
            <div class="home-advisor-inner">
                <div class="advisor-copy">
                    <span>
                        <i class="bi bi-cpu-fill" aria-hidden="true"></i> TRỢ LÝ THÔNG MINH
                    </span>
                    <h2 id="advisor-title">Chọn đúng thiết bị, dễ dàng hơn cùng AI.</h2>
                    <p>Chia sẻ nhu cầu và ngân sách — trợ lý AI sẽ phân tích và đề xuất cấu hình tối ưu nhất cho bạn.</p>
                </div>
                <button type="button" class="advisor-button" onclick="document.getElementById('aiToggleButton')?.click()" aria-label="Bắt đầu tư vấn cùng AI">
                    <i class="bi bi-chat-dots-fill" aria-hidden="true"></i>
                    <span>Tư vấn cùng AI</span>
                </button>
            </div>
        </div>
    </section>

    @* KHỐI 6: CAM KẾT DỊCH VỤ TIN CẬY (4 Cột Tinh Gọn) *@
    <section class="ep-commitments-section" aria-label="Cam kết dịch vụ">
        <div class="ep-container">
            <div class="ep-commitments-grid">
                <div class="ep-commitment-card">
                    <div class="ep-commitment-icon bg-blue-subtle text-primary">
                        <i class="bi bi-truck"></i>
                    </div>
                    <div class="ep-commitment-info">
                        <strong>Miễn phí vận chuyển</strong>
                        <span>Giao nhanh toàn quốc, miễn phí đơn từ 500K</span>
                    </div>
                </div>

                <div class="ep-commitment-card">
                    <div class="ep-commitment-icon bg-success-subtle text-success">
                        <i class="bi bi-shield-check"></i>
                    </div>
                    <div class="ep-commitment-info">
                        <strong>100% Chính hãng</strong>
                        <span>Bảo hành 12–24 tháng tại trung tâm ủy quyền</span>
                    </div>
                </div>

                <div class="ep-commitment-card">
                    <div class="ep-commitment-icon bg-warning-subtle text-warning">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </div>
                    <div class="ep-commitment-info">
                        <strong>Đổi trả 30 ngày</strong>
                        <span>Lỗi 1 đổi 1 nhanh chóng nếu có lỗi từ nhà sản xuất</span>
                    </div>
                </div>

                <div class="ep-commitment-card">
                    <div class="ep-commitment-icon bg-info-subtle text-info">
                        <i class="bi bi-headset"></i>
                    </div>
                    <div class="ep-commitment-info">
                        <strong>Hỗ trợ kỹ thuật 24/7</strong>
                        <span>Đội ngũ chuyên viên tư vấn tận tâm, chu đáo</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    @* KHỐI 7: THƯƠNG HIỆU ĐỐI TÁC CHIẾN LƯỢC *@
    @if (Model.ThuongHieus != null && Model.ThuongHieus.Any())
    {
        <partial name="Home/_Brands" model="Model.ThuongHieus" />
    }
</div>

<script>
    // Đồng hồ đếm ngược Flash Sale kết thúc vào 23:59:59 mỗi ngày
    (function initFlashSaleTimer() {
        function updateTimer() {
            const now = new Date();
            const midnight = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 23, 59, 59);
            let diff = Math.max(0, Math.floor((midnight - now) / 1000));

            const hours = String(Math.floor(diff / 3600)).padStart(2, '0');
            diff %= 3600;
            const minutes = String(Math.floor(diff / 60)).padStart(2, '0');
            const seconds = String(diff % 60).padStart(2, '0');

            const hElem = document.getElementById('fsHours');
            const mElem = document.getElementById('fsMinutes');
            const sElem = document.getElementById('fsSeconds');

            if (hElem) hElem.textContent = hours;
            if (mElem) mElem.textContent = minutes;
            if (sElem) sElem.textContent = seconds;
        }

        updateTimer();
        setInterval(updateTimer, 1000);
    })();
</script>
