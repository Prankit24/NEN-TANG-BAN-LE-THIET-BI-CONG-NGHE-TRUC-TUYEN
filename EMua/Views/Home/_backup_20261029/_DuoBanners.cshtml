<section class="ep ep-promos" aria-label="Chương trình ưu đãi danh mục">
    <div class="ep-container ep-promo-grid">
        <a class="ep-promo" asp-area="" asp-controller="Product" asp-action="Index" asp-route-category="DienThoai">
            <div>
                <span class="ep-eyebrow"><i class="bi bi-phone" aria-hidden="true"></i> LUÔN BÊN BẠN</span>
                <h3>Kết nối thông minh.<br />Theo cách của bạn.</h3>
                <span class="ep-text-link">
                    <span>Khám phá điện thoại</span>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </span>
            </div>
            <div class="ep-promo-image">
                <img src="~/images/products/iphone18-promax/1.jpg" asp-append-version="true" alt="Điện thoại thông minh" loading="lazy" onerror="this.hidden=true;this.nextElementSibling.hidden=false;" />
                <span class="ep-placeholder" hidden>Điện thoại</span>
            </div>
        </a>

        <a class="ep-promo ep-promo-blue" asp-area="" asp-controller="Product" asp-action="Index" asp-route-category="Laptop">
            <div>
                <span class="ep-eyebrow"><i class="bi bi-laptop" aria-hidden="true"></i> HIỆU NĂNG & SÁNG TẠO</span>
                <h3>Ý tưởng bứt phá.<br />Khởi đầu mạnh mẽ.</h3>
                <span class="ep-text-link">
                    <span>Khám phá laptop</span>
                    <i class="bi bi-arrow-right" aria-hidden="true"></i>
                </span>
            </div>
            <div class="ep-promo-image">
                <img src="~/images/products/macbook-air-m2/1.jpg" asp-append-version="true" alt="Laptop mỏng nhẹ" loading="lazy" onerror="this.hidden=true;this.nextElementSibling.hidden=false;" />
                <span class="ep-placeholder" hidden>Laptop</span>
            </div>
        </a>
    </div>
</section>
