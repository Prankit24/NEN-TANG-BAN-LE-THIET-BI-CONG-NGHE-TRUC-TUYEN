@{
    var displayName = User.Identity?.Name ?? "Tài khoản";
    var avatarLetter = string.IsNullOrWhiteSpace(displayName)
        ? "U"
        : displayName[..1].ToUpperInvariant();
    var isStaff = User.IsInRole("NhanVien") || User.IsInRole("Nhân viên");
}

<header class="emua-site-header">

    <div class="emua-topbar">
        <div class="container-fluid emua-container">
            <div class="topbar-content">
                <span>🚀 Miễn phí vận chuyển đơn từ 500K</span>
                <span class="topbar-divider">|</span>
                <span>Giao 2 giờ tại Đà Nẵng & Hà Nội</span>
                <span class="topbar-divider">|</span>
                <span>Hotline: <strong>1800 2005</strong></span>
            </div>
        </div>
    </div>

    <div class="emua-main-header">
        <div class="container-fluid emua-container">
            <div class="main-header-wrapper">

                <!-- Đã cập nhật điều hướng về Trang chủ Home/Index -->
                <a asp-controller="Home" asp-action="Index" class="emua-logo" aria-label="Logo EMUA">
                    <div class="emua-logo-icon">
                        <i class="bi bi-lightning-charge"></i>
                    </div>

                    <div class="emua-logo-text">
                        <strong>EMUA</strong>
                        <span>Mua sắm điện tử</span>
                    </div>
                </a>

                <form asp-controller="Product" asp-action="Search" method="get" class="emua-search">
                    <i class="bi bi-search"></i>

                    <input type="text" name="keyword" autocomplete="off"
                           placeholder="Tìm kiếm laptop, điện thoại, gaming gear..." />
                </form>

                <div class="emua-header-actions">

                    <div class="dropdown">
                        <button class="header-action-btn dropdown-toggle" type="button" data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <i class="bi bi-person"></i>

                            <span>
                                @(User.Identity?.IsAuthenticated == true
                                                                ? displayName
                                                                : "Tài khoản")
                            </span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end account-dropdown">

                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li>
                                    <a class="account-dropdown-profile" asp-controller="Account" asp-action="Profile">

                                        <span class="account-dropdown-avatar">
                                            @avatarLetter
                                        </span>

                                        <span class="account-dropdown-info">
                                            <strong>@displayName</strong>
                                            <small>Hồ sơ của tôi</small>
                                        </span>

                                        <i class="bi bi-chevron-right"></i>
                                    </a>
                                </li>

                                @if (isStaff)
                                {
                                    <li>
                                        <a class="account-dropdown-staff" asp-area="Staff" asp-controller="Dashboard"
                                           asp-action="Index">
                                            <i class="bi bi-grid-1x2"></i>
                                            Khu vực nhân viên
                                        </a>
                                    </li>
                                }

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>
                                    <form asp-controller="Auth" asp-action="Logout" method="post">
                                        @Html.AntiForgeryToken()

                                        <button type="submit" class="account-dropdown-logout">
                                            <i class="bi bi-box-arrow-right"></i>
                                            Đăng xuất
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a class="dropdown-item" asp-controller="Auth" asp-action="Login">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>
                                        Đăng nhập
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item" asp-controller="Auth" asp-action="Register">
                                        <i class="bi bi-person-plus me-2"></i>
                                        Đăng ký
                                    </a>
                                </li>
                            }

                        </ul>
                    </div>

                    <!-- Bấm vào nút Cửa hàng mới xổ ra Danh sách cửa hàng toàn quốc -->
                    <div class="dropdown">
                        <button class="header-action-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-shop"></i>
                            <span>Cửa hàng</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow p-2" style="min-width: 320px; max-height: 480px; overflow-y: auto;">
                            <li>
                                <div class="px-2 py-1 mb-2">
                                    <small class="text-muted d-block fw-bold text-uppercase">📍 HỆ THỐNG CỬA HÀNG EMUA</small>
                                </div>
                            </li>

                            <!-- Danh sách 4 cơ sở -->
                            <li>
                                <div class="px-3 py-2 bg-light rounded-2 mb-2 border-start border-3 border-danger">
                                    <span class="fw-bold text-dark d-block">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Cơ sở 1: Nguyễn Văn Linh
                                    </span>
                                    <small class="text-secondary d-block ps-3">1020 Nguyễn Văn Linh, Đà Nẵng</small>
                                </div>
                            </li>

                            <li>
                                <div class="px-3 py-2 bg-light rounded-2 mb-2 border-start border-3 border-danger">
                                    <span class="fw-bold text-dark d-block">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Cơ sở 2: Nguyễn Lương Bằng
                                    </span>
                                    <small class="text-secondary d-block ps-3">540 Nguyễn Lương Bằng, Đà Nẵng</small>
                                </div>
                            </li>

                            <li>
                                <div class="px-3 py-2 bg-light rounded-2 mb-2 border-start border-3 border-danger">
                                    <span class="fw-bold text-dark d-block">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Cơ sở 3: Tôn Thất Đạm
                                    </span>
                                    <small class="text-secondary d-block ps-3">65 Tôn Thất Đạm, Đà Nẵng</small>
                                </div>
                            </li>

                            <li>
                                <div class="px-3 py-2 bg-light rounded-2 mb-2 border-start border-3 border-danger">
                                    <span class="fw-bold text-dark d-block">
                                        <i class="bi bi-geo-alt-fill text-danger me-1"></i> Cơ sở 4: Ngô Xuân Thu
                                    </span>
                                    <small class="text-secondary d-block ps-3">76 Ngô Xuân Thu, Đà Nẵng</small>
                                </div>
                            </li>

                            <li>
                                <div class="px-3 py-2 bg-light rounded-2 mb-2 border-start border-3 border-primary">
                                    <span class="fw-bold text-dark d-block">
                                        <i class="bi bi-geo-alt-fill text-primary me-1"></i> Cơ sở Hà Nội: Ba Đình
                                    </span>
                                    <small class="text-secondary d-block ps-3">13 Ba Đình, Hà Nội</small>
                                </div>
                            </li>

                            <li><hr class="dropdown-divider my-2" /></li>

                            <!-- Nút chuyển tới Landing Page Bản đồ hệ thống cửa hàng Việt Nam -->
                            <li>
                                <a class="dropdown-item py-2 rounded-2 fw-bold text-primary bg-primary-subtle mb-1" asp-controller="Home" asp-action="StoreLocations">
                                    <i class="bi bi-map-fill me-2"></i> Bản đồ hệ thống cửa hàng (Toàn quốc)
                                </a>
                            </li>

                            <!-- Đường dẫn Nhượng quyền cửa hàng -->
                            <li>
                                <a class="dropdown-item py-2 rounded-2 text-warning fw-bold" asp-controller="Home" asp-action="Franchise">
                                    <i class="bi bi-award-fill me-2"></i> Nhượng quyền cửa hàng
                                </a>
                            </li>
                        </ul>
                    </div>

                    <a href="@(User.Identity?.IsAuthenticated == true ? "/Cart" : "/Auth/Login?returnUrl=%2FCart")"
                       class="header-action-btn cart-action">
                        <div class="header-icon-wrapper">
                            <i class="bi bi-cart3"></i>
                            @await Component.InvokeAsync("CartSummary")
                        </div>

                        <span>Giỏ hàng</span>
                    </a>

                </div>

                <button class="mobile-menu-button" type="button" data-bs-toggle="collapse"
                        data-bs-target="#mobileCategories">
                    <i class="bi bi-list"></i>
                </button>

            </div>
        </div>
    </div>

    <nav class="emua-category-nav">
        <div class="container-fluid emua-container">
            <div class="category-list">

                <a asp-controller="Product" asp-action="Index" asp-route-category="Laptop">
                    <i class="bi bi-laptop"></i>
                    Laptop
                </a>

                <a asp-controller="Product" asp-action="Index" asp-route-category="DienThoai">
                    <i class="bi bi-phone"></i>
                    Điện thoại
                </a>

                <a asp-controller="Product" asp-action="Index" asp-route-category="Gaming">
                    <i class="bi bi-controller"></i>
                    Gaming
                </a>

                <a asp-controller="Product" asp-action="Index" asp-route-category="PhuKien">
                    <i class="bi bi-box"></i>
                    Phụ kiện
                </a>

                <a asp-controller="Product" asp-action="Index" asp-route-category="AmThanh">
                    <i class="bi bi-headphones"></i>
                    Âm thanh
                </a>

                <a asp-controller="Product" asp-action="Index" asp-route-category="ThietBiThongMinh">
                    <i class="bi bi-smartwatch"></i>
                    Thiết bị thông minh
                </a>

            </div>
        </div>
    </nav>

    <div class="collapse" id="mobileCategories">
        <div class="mobile-category-menu">
            @if (isStaff)
            {
                <a asp-area="Staff" asp-controller="Dashboard" asp-action="Index">
                    <i class="bi bi-grid-1x2"></i> Khu vực nhân viên
                </a>
            }
            <a asp-controller="Product" asp-action="Index" asp-route-category="Laptop">Laptop</a>
            <a asp-controller="Product" asp-action="Index" asp-route-category="DienThoai">Điện thoại</a>
            <a asp-controller="Product" asp-action="Index" asp-route-category="Gaming">Gaming</a>
            <a asp-controller="Product" asp-action="Index" asp-route-category="PhuKien">Phụ kiện</a>
            <a asp-controller="Product" asp-action="Index" asp-route-category="AmThanh">Âm thanh</a>
            <a asp-controller="Product" asp-action="Index" asp-route-category="ThietBiThongMinh">Thiết bị thông minh</a>
            <hr class="my-2" />
            <a asp-controller="Home" asp-action="StoreLocations" class="text-primary fw-bold">
                <i class="bi bi-map-fill me-1"></i> Bản đồ cửa hàng toàn quốc
            </a>
            <a asp-controller="Home" asp-action="Franchise" class="text-warning fw-bold">
                <i class="bi bi-award-fill me-1"></i> Nhượng quyền cửa hàng
            </a>
        </div>
    </div>

</header>