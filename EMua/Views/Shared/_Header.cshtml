@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject EMua.Data.EMuaDbContext DbContext
@{
    var displayName = User.Identity?.Name ?? "Tài khoản";

    var avatarLetter = string.IsNullOrWhiteSpace(displayName)
        ? "U"
        : displayName.Trim()[..1].ToUpperInvariant();

    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    string? avatarUrl = null;
    if (isAuthenticated)
    {
        var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
        if (int.TryParse(userIdClaim, out var custUserId))
        {
            var custUser = DbContext.NguoiDungs.AsNoTracking().FirstOrDefault(u => u.MaNguoiDung == custUserId);
            if (custUser != null && !string.IsNullOrWhiteSpace(custUser.AnhDaiDien))
            {
                avatarUrl = custUser.AnhDaiDien;
            }
        }
    }

    var isAdmin = User.IsInRole("Admin")
        || User.IsInRole("Quản trị viên")
        || User.IsInRole("QuanTriVien");

    var isStaff = User.IsInRole("NhanVien")
        || User.IsInRole("Nhân viên")
        || User.IsInRole("Staff");

    var cartUrl = isAuthenticated
        ? Url.Action("Index", "Cart", new { area = "" })
        : Url.Action(
            "Login",
            "Auth",
            new { area = "", returnUrl = "/Cart" });

    var favoriteUrl = isAuthenticated
        ? Url.Action("Index", "Favorite", new { area = "" })
        : Url.Action(
            "Login",
            "Auth",
            new { area = "", returnUrl = "/Favorite" });

    var categories = new[]
    {
        new { Key = "DienThoai", Name = "Điện thoại", Icon = "bi-phone" },
        new { Key = "Laptop", Name = "Laptop", Icon = "bi-laptop" },
        new { Key = "Tablet", Name = "Máy tính bảng", Icon = "bi-tablet" },
        new { Key = "AmThanh", Name = "Âm thanh", Icon = "bi-headphones" },
        new { Key = "Gaming", Name = "Gaming Gear", Icon = "bi-controller" },
        new { Key = "PhuKien", Name = "Phụ kiện", Icon = "bi-plug" }
    };

    var stores = new[]
    {
        new
        {
            Name = "Cơ sở 1: Nguyễn Văn Linh",
            Address = "1020 Nguyễn Văn Linh, Hải Châu, Đà Nẵng",
            Phone = "0236 3888 101"
        },
        new
        {
            Name = "Cơ sở 2: Nguyễn Lương Bằng",
            Address = "540 Nguyễn Lương Bằng, Liên Chiểu, Đà Nẵng",
            Phone = "0236 3888 102"
        },
        new
        {
            Name = "Cơ sở 3: Tôn Thất Đạm",
            Address = "65 Tôn Thất Đạm, Thanh Khê, Đà Nẵng",
            Phone = "0236 3888 103"
        },
        new
        {
            Name = "Cơ sở 4: Ngô Xuân Thu",
            Address = "76 Ngô Xuân Thu, Liên Chiểu, Đà Nẵng",
            Phone = "0236 3888 104"
        },
        new
        {
            Name = "Cơ sở Hà Nội: Ba Đình",
            Address = "13 Ba Đình, Ba Đình, Hà Nội",
            Phone = "024 3888 2005"
        }
    };
}

<header class="emua-site-header">

    <!-- 1. TOPBAR: Announcement Marquee (Chạy ngang mượt mà, thuần CSS, dừng khi hover/focus) -->
    <div class="emua-topbar" role="region" aria-label="Thông báo ưu đãi">
        <div class="emua-marquee-wrap">
            <div class="emua-marquee-track">
                <!-- Nhóm thông báo 1 (Chính) -->
                <div class="emua-marquee-group">
                    <span class="marquee-item">
                        <i class="bi bi-truck text-primary" aria-hidden="true"></i>
                        <span>Miễn phí vận chuyển đơn từ <strong>500K</strong></span>
                    </span>
                    <span class="marquee-divider" aria-hidden="true">✦</span>
                    <span class="marquee-item">
                        <i class="bi bi-lightning-charge-fill text-warning" aria-hidden="true"></i>
                        <span>Giao 2 giờ tại <strong>Đà Nẵng &amp; Hà Nội</strong></span>
                    </span>
                    <span class="marquee-divider" aria-hidden="true">✦</span>
                    <span class="marquee-item">
                        <i class="bi bi-shield-check text-success" aria-hidden="true"></i>
                        <span>100% Thiết bị chính hãng · Bảo hành 12 - 24 tháng</span>
                    </span>
                    <span class="marquee-divider" aria-hidden="true">✦</span>
                    <span class="marquee-item">
                        <i class="bi bi-telephone-fill text-info" aria-hidden="true"></i>
                        <span>Hotline: <a href="tel:18002005" class="marquee-link"><strong>1800 2005</strong></a> (Miễn phí cước)</span>
                    </span>
                    <span class="marquee-divider" aria-hidden="true">✦</span>
                    <span class="marquee-item">
                        <i class="bi bi-shop text-primary" aria-hidden="true"></i>
                        <a asp-area="" asp-controller="Home" asp-action="StoreLocations" class="marquee-link">Hệ thống @stores.Length showroom trải nghiệm công nghệ</a>
                    </span>
                    <span class="marquee-divider" aria-hidden="true">✦</span>
                </div>

                <!-- Nhóm thông báo 2 (Bản sao tạo vòng lặp vô tận liền mạch, không giật) -->
                <div class="emua-marquee-group" aria-hidden="true">
                    <span class="marquee-item">
                        <i class="bi bi-truck text-primary" aria-hidden="true"></i>
                        <span>Miễn phí vận chuyển đơn từ <strong>500K</strong></span>
                    </span>
                    <span class="marquee-divider" aria-hidden="true">✦</span>
                    <span class="marquee-item">
                        <i class="bi bi-lightning-charge-fill text-warning" aria-hidden="true"></i>
                        <span>Giao 2 giờ tại <strong>Đà Nẵng &amp; Hà Nội</strong></span>
                    </span>
                    <span class="marquee-divider" aria-hidden="true">✦</span>
                    <span class="marquee-item">
                        <i class="bi bi-shield-check text-success" aria-hidden="true"></i>
                        <span>100% Thiết bị chính hãng · Bảo hành 12 - 24 tháng</span>
                    </span>
                    <span class="marquee-divider" aria-hidden="true">✦</span>
                    <span class="marquee-item">
                        <i class="bi bi-telephone-fill text-info" aria-hidden="true"></i>
                        <span>Hotline: <a href="tel:18002005" class="marquee-link" tabindex="-1"><strong>1800 2005</strong></a> (Miễn phí cước)</span>
                    </span>
                    <span class="marquee-divider" aria-hidden="true">✦</span>
                    <span class="marquee-item">
                        <i class="bi bi-shop text-primary" aria-hidden="true"></i>
                        <a asp-area="" asp-controller="Home" asp-action="StoreLocations" class="marquee-link" tabindex="-1">Hệ thống @stores.Length showroom trải nghiệm công nghệ</a>
                    </span>
                    <span class="marquee-divider" aria-hidden="true">✦</span>
                </div>
            </div>
        </div>
    </div>

    <!-- 2. MAIN HEADER -->
    <div class="emua-main-header">
        <div class="container-fluid emua-container">
            <div class="main-header-wrapper">

                <!-- BRAND LOGO -->
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="emua-logo"
                   aria-label="EMUA — Về trang chủ">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 180 62"
                         role="img"
                         aria-label="EMUA"
                         class="emua-wordmark"
                         style="height: 36px; width: auto; display: block;">
                        <text x="4" y="49"
                              fill="#0f172a"
                              font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif"
                              font-weight="900"
                              font-size="46"
                              letter-spacing="-1">EMUA</text>
                        <g fill="#2563eb">
                            <path d="M148 28 C149 20, 151 12, 156 10 C159 9, 162 10, 163 12 L169 13.5 L162 15.5 C159 17, 158 23, 158 30 Z" />
                            <path d="M122 33 C123 23, 142 22, 158 29 C164 33, 162 42, 151 44 C138 46, 125 42, 122 36 L114 38 L119 33 Z" />
                            <path d="M134 42 L127 51 L117 56 L119 58 L129 53 L138 43 Z" />
                            <path d="M146 43 L151 51 L161 52 L160 55 L149 53 L143 44 Z" />
                        </g>
                    </svg>
                    <span class="emua-brand-tagline">TECH STORE</span>
                </a>

                <!-- OMNI SEARCH -->
                <div class="emua-search-container">
                    <form asp-area=""
                          asp-controller="Product"
                          asp-action="Search"
                          method="get"
                          role="search"
                          class="emua-search"
                          onsubmit="return validateEmuaSearch(this)">
                        <i class="bi bi-search emua-search-icon" aria-hidden="true"></i>
                        <input type="search"
                               name="keyword"
                               class="emua-search-input"
                               autocomplete="off"
                               aria-label="Tìm kiếm sản phẩm"
                               placeholder="Tìm kiếm laptop, điện thoại, phụ kiện công nghệ..." />
                        <button type="submit" class="emua-search-btn" aria-label="Tìm kiếm">
                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </button>
                    </form>
                    <!-- Search Suggestions Dropdown (Desktop) -->
                    <div class="emua-search-suggestions d-none" role="listbox" aria-label="Gợi ý tìm kiếm"></div>
                </div>

                <!-- DESKTOP ACTIONS -->
                <div class="emua-header-actions">

                    <!-- STORES DROPDOWN -->
                    <div class="dropdown emua-header-dropdown">
                        <button type="button"
                                id="headerStoreMenu"
                                class="header-action-btn dropdown-toggle"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            <i class="bi bi-shop action-icon" aria-hidden="true"></i>
                            <span class="action-text">
                                <small>Hệ thống</small>
                                <strong>Cửa hàng</strong>
                            </span>
                            <i class="bi bi-chevron-down action-arrow" aria-hidden="true"></i>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end emua-dropdown-panel store-dropdown-panel"
                            aria-labelledby="headerStoreMenu">
                            <li class="dropdown-header-custom">
                                <div>
                                    <span class="dropdown-badge">HỆ THỐNG PHÂN PHỐI</span>
                                    <h6>Hệ thống cửa hàng EMUA</h6>
                                </div>
                                <span class="store-count-badge">@stores.Length chi nhánh</span>
                            </li>
                            <li class="dropdown-scroll-list">
                                @foreach (var store in stores)
                                {
                                    <div class="store-item">
                                        <div class="store-item-icon">
                                            <i class="bi bi-geo-alt-fill" aria-hidden="true"></i>
                                        </div>
                                        <div class="store-item-info">
                                            <strong class="store-item-name">@store.Name</strong>
                                            <p class="store-item-address">@store.Address</p>
                                            <small class="store-item-phone"><i class="bi bi-telephone me-1" aria-hidden="true"></i>@store.Phone</small>
                                        </div>
                                    </div>
                                }
                            </li>
                            <li class="dropdown-footer-actions">
                                <a asp-area=""
                                   asp-controller="Home"
                                   asp-action="StoreLocations"
                                   class="dropdown-footer-btn primary">
                                    <i class="bi bi-map-fill" aria-hidden="true"></i>
                                    <span>Bản đồ hệ thống</span>
                                </a>
                                <a asp-area=""
                                   asp-controller="Home"
                                   asp-action="Franchise"
                                   class="dropdown-footer-btn secondary">
                                    <i class="bi bi-award-fill" aria-hidden="true"></i>
                                    <span>Nhượng quyền</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- ACCOUNT DROPDOWN -->
                    <div class="dropdown emua-header-dropdown">
                        <button type="button"
                                id="headerAccountMenu"
                                class="header-action-btn dropdown-toggle"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">
                            @if (isAuthenticated)
                            {
                                <span class="header-avatar-circle" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(avatarUrl))
                                    {
                                        <img src="@avatarUrl" alt="@displayName" class="header-avatar-img" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                        <span class="header-avatar-fallback" style="display: none;">@avatarLetter</span>
                                    }
                                    else
                                    {
                                        <span class="header-avatar-fallback">@avatarLetter</span>
                                    }
                                </span>
                            }
                            else
                            {
                                <i class="bi bi-person-circle action-icon" aria-hidden="true"></i>
                            }
                            <span class="action-text">
                                <small>Xin chào</small>
                                <strong>@(isAuthenticated? displayName : "Tài khoản")</strong>
                            </span>
                            <i class="bi bi-chevron-down action-arrow" aria-hidden="true"></i>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end emua-dropdown-panel account-dropdown-panel"
                            aria-labelledby="headerAccountMenu">

                            @if (isAuthenticated)
                            {
                                <li class="dropdown-user-card">
                                    <span class="dropdown-user-avatar">
                                        @if (!string.IsNullOrWhiteSpace(avatarUrl))
                                        {
                                            <img src="@avatarUrl" alt="@displayName" class="header-avatar-img" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                            <span class="header-avatar-fallback" style="display: none;">@avatarLetter</span>
                                        }
                                        else
                                        {
                                            <span class="header-avatar-fallback">@avatarLetter</span>
                                        }
                                    </span>
                                    <div class="dropdown-user-details">
                                        <strong>@displayName</strong>
                                        <small>Thành viên EMUA</small>
                                    </div>
                                </li>
                                <li>
                                    <a asp-area=""
                                       asp-controller="Account"
                                       asp-action="Profile"
                                       class="dropdown-menu-link">
                                        <i class="bi bi-person-badge" aria-hidden="true"></i>
                                        <span>Thông tin tài khoản</span>
                                    </a>
                                </li>
                                <li>
                                    <a asp-area=""
                                       asp-controller="Favorite"
                                       asp-action="Index"
                                       class="dropdown-menu-link">
                                        <i class="bi bi-heart" aria-hidden="true"></i>
                                        <span>Sản phẩm yêu thích</span>
                                    </a>
                                </li>
                                <li>
                                    <a asp-area=""
                                       asp-controller="Account"
                                       asp-action="ChangePassword"
                                       class="dropdown-menu-link">
                                        <i class="bi bi-key" aria-hidden="true"></i>
                                        <span>Đổi mật khẩu</span>
                                    </a>
                                </li>

                                @if (isStaff)
                                {
                                    <li>
                                        <a asp-area="Staff"
                                           asp-controller="Dashboard"
                                           asp-action="Index"
                                           class="dropdown-menu-link link-highlight">
                                            <i class="bi bi-grid-1x2-fill" aria-hidden="true"></i>
                                            <span>Khu vực nhân viên</span>
                                        </a>
                                    </li>
                                }

                                @if (isAdmin)
                                {
                                    <li>
                                        <a asp-area="Admin"
                                           asp-controller="Dashboard"
                                           asp-action="Index"
                                           class="dropdown-menu-link link-admin">
                                            <i class="bi bi-shield-lock-fill" aria-hidden="true"></i>
                                            <span>Khu vực quản trị</span>
                                        </a>
                                    </li>
                                }

                                <li><hr class="dropdown-divider-custom" /></li>

                                <li>
                                    <form asp-area=""
                                          asp-controller="Auth"
                                          asp-action="Logout"
                                          method="post"
                                          class="m-0">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-menu-link link-logout">
                                            <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                                            <span>Đăng xuất</span>
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li class="dropdown-auth-guest">
                                    <p class="dropdown-guest-lead">Đăng nhập để nhận ưu đãi thành viên và theo dõi đơn hàng dễ dàng.</p>
                                    <a asp-area=""
                                       asp-controller="Auth"
                                       asp-action="Login"
                                       class="btn-emua-dropdown primary">
                                        <i class="bi bi-box-arrow-in-right" aria-hidden="true"></i>
                                        <span>Đăng nhập</span>
                                    </a>
                                    <a asp-area=""
                                       asp-controller="Auth"
                                       asp-action="Register"
                                       class="btn-emua-dropdown secondary">
                                        <i class="bi bi-person-plus" aria-hidden="true"></i>
                                        <span>Đăng ký tài khoản</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- CART ACTION -->
                    <a href="@cartUrl"
                       class="header-action-btn cart-action-btn cart-action"
                       aria-label="Giỏ hàng">
                        <div class="header-icon-wrapper">
                            <i class="bi bi-bag-fill action-icon" aria-hidden="true"></i>
                            <span class="cart-count" style="display:none;">0</span>
                        </div>
                        <span class="action-text">
                            <small>Đơn hàng</small>
                            <strong>Giỏ hàng</strong>
                        </span>
                    </a>
                </div>

                <!-- MOBILE ACTION CONTROLS -->
                <div class="emua-mobile-controls">
                    <a href="@cartUrl" class="mobile-action-btn cart-action" aria-label="Giỏ hàng">
                        <div class="header-icon-wrapper">
                            <i class="bi bi-bag-fill" aria-hidden="true"></i>
                            <span class="cart-count" style="display:none;">0</span>
                        </div>
                    </a>
                    <button type="button"
                            class="mobile-menu-button"
                            data-bs-toggle="collapse"
                            data-bs-target="#mobileCategories"
                            aria-controls="mobileCategories"
                            aria-expanded="false"
                            aria-label="Mở menu">
                        <i class="bi bi-list" aria-hidden="true"></i>
                    </button>
                </div>

            </div>

            <!-- MOBILE SEARCH (Hiển thị ngay dưới Logo trên Mobile) -->
            <div class="emua-mobile-search-wrap">
                <div class="emua-search-container mobile">
                    <form asp-area=""
                          asp-controller="Product"
                          asp-action="Search"
                          method="get"
                          role="search"
                          class="emua-search emua-mobile-search"
                          onsubmit="return validateEmuaSearch(this)">
                        <i class="bi bi-search emua-search-icon" aria-hidden="true"></i>
                        <input type="search"
                               name="keyword"
                               class="emua-search-input"
                               autocomplete="off"
                               aria-label="Tìm kiếm sản phẩm"
                               placeholder="Tìm kiếm laptop, điện thoại, phụ kiện..." />
                        <button type="submit" class="emua-search-btn" aria-label="Tìm kiếm">
                            <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </button>
                    </form>
                    <!-- Search Suggestions Dropdown (Mobile) -->
                    <div class="emua-search-suggestions d-none" role="listbox" aria-label="Gợi ý tìm kiếm"></div>
                </div>
            </div>

        </div>
    </div>

    <!-- 3. CATEGORY NAVIGATION BAR VỚI MEGA MENU CHUẨN SENIOR (Hick's Law 6 danh mục chính + Mega Menu 3 cột) -->
    <nav class="emua-category-nav" aria-label="Danh mục sản phẩm">
        <div class="container-fluid emua-container">
            <div class="category-list">
                <!-- NÚT MEGA MENU TẤT CẢ DANH MỤC -->
                <div class="dropdown emua-mega-dropdown d-inline-block">
                    <button class="category-nav-item emua-mega-btn dropdown-toggle border-0" type="button" id="megaMenuBtn" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-grid-3x3-gap-fill text-primary" aria-hidden="true"></i>
                        <span class="fw-bold">Tất cả danh mục</span>
                        <i class="bi bi-chevron-down ms-1" style="font-size: 11px;"></i>
                    </button>
                    <div class="dropdown-menu shadow-lg border-0 emua-mega-menu-panel p-4" aria-labelledby="megaMenuBtn">
                        <div class="emua-mega-menu-grid">
                            <div class="emua-mega-col">
                                <h6 class="emua-mega-col-title">Thiết bị di động</h6>
                                <div class="emua-mega-link-list">
                                    <a class="emua-mega-link" asp-controller="Product" asp-action="Index" asp-route-category="DienThoai">
                                        <i class="bi bi-phone"></i>
                                        <span>Điện thoại thông minh</span>
                                    </a>
                                    <a class="emua-mega-link" asp-controller="Product" asp-action="Index" asp-route-category="Tablet">
                                        <i class="bi bi-tablet"></i>
                                        <span>Máy tính bảng (iPad/Tab)</span>
                                    </a>
                                    <a class="emua-mega-link" asp-controller="Product" asp-action="Index" asp-route-category="ThietBiThongMinh">
                                        <i class="bi bi-smartwatch"></i>
                                        <span>Đồng hồ thông minh</span>
                                    </a>
                                </div>
                            </div>
                            <div class="emua-mega-col">
                                <h6 class="emua-mega-col-title">Máy tính &amp; Màn hình</h6>
                                <div class="emua-mega-link-list">
                                    <a class="emua-mega-link" asp-controller="Product" asp-action="Index" asp-route-category="Laptop">
                                        <i class="bi bi-laptop"></i>
                                        <span>Laptop cao cấp &amp; Gaming</span>
                                    </a>
                                    <a class="emua-mega-link" asp-controller="Product" asp-action="Index" asp-route-category="ManHinh">
                                        <i class="bi bi-display"></i>
                                        <span>Màn hình máy tính</span>
                                    </a>
                                    <a class="emua-mega-link" asp-controller="Product" asp-action="Index" asp-route-category="LinhKien">
                                        <i class="bi bi-cpu"></i>
                                        <span>Linh kiện PC &amp; Mainboard</span>
                                    </a>
                                </div>
                            </div>
                            <div class="emua-mega-col">
                                <h6 class="emua-mega-col-title">Âm thanh &amp; Phụ kiện</h6>
                                <div class="emua-mega-link-list">
                                    <a class="emua-mega-link" asp-controller="Product" asp-action="Index" asp-route-category="AmThanh">
                                        <i class="bi bi-headphones"></i>
                                        <span>Tai nghe &amp; Loa Bluetooth</span>
                                    </a>
                                    <a class="emua-mega-link" asp-controller="Product" asp-action="Index" asp-route-category="Gaming">
                                        <i class="bi bi-controller"></i>
                                        <span>Gaming Gear &amp; Bàn phím</span>
                                    </a>
                                    <a class="emua-mega-link" asp-controller="Product" asp-action="Index" asp-route-category="PhuKien">
                                        <i class="bi bi-plug"></i>
                                        <span>Củ sạc, Cáp &amp; Pin sạc</span>
                                    </a>
                                </div>
                            </div>
                        </div>
                        <div class="emua-mega-footer">
                            <span class="small text-muted"><i class="bi bi-shield-check text-success me-1"></i>Tất cả thiết bị đều là hàng chính hãng 100%</span>
                            <a asp-controller="Product" asp-action="Index" class="btn btn-sm btn-primary px-3 rounded-pill">Xem tất cả sản phẩm <i class="bi bi-arrow-right ms-1"></i></a>
                        </div>
                    </div>
                </div>

                <!-- 6 DANH MỤC TRỤ CỘT TRỰC QUAN -->
                @foreach (var category in categories)
                {
                    <a asp-area=""
                       asp-controller="Product"
                       asp-action="Index"
                       asp-route-category="@category.Key"
                       class="category-nav-item">
                        <i class="bi @category.Icon" aria-hidden="true"></i>
                        <span>@category.Name</span>
                    </a>
                }
            </div>
        </div>
    </nav>

    <!-- 4. MOBILE DRAWER COLLAPSE -->
    <div class="collapse" id="mobileCategories">
        <nav class="mobile-category-menu" aria-label="Menu trên điện thoại">

            <div class="mobile-menu-user-card">
                @if (isAuthenticated)
                {
                    <div class="mobile-user-header">
                        <span class="dropdown-user-avatar">
                            @if (!string.IsNullOrWhiteSpace(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="@displayName" class="header-avatar-img" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                <span class="header-avatar-fallback" style="display: none;">@avatarLetter</span>
                            }
                            else
                            {
                                <span class="header-avatar-fallback">@avatarLetter</span>
                            }
                        </span>
                        <div>
                            <strong>@displayName</strong>
                            <small class="d-block text-muted">Thành viên EMUA</small>
                        </div>
                    </div>
                    <div class="mobile-user-links">
                        <a asp-area="" asp-controller="Account" asp-action="Profile">
                            <i class="bi bi-person-badge me-2" aria-hidden="true"></i>Hồ sơ của tôi
                        </a>
                        <a asp-area="" asp-controller="Favorite" asp-action="Index">
                            <i class="bi bi-heart me-2" aria-hidden="true"></i>Sản phẩm yêu thích
                        </a>
                        <a asp-area="" asp-controller="Account" asp-action="ChangePassword">
                            <i class="bi bi-key me-2" aria-hidden="true"></i>Đổi mật khẩu
                        </a>

                        @if (isStaff)
                        {
                            <a asp-area="Staff" asp-controller="Dashboard" asp-action="Index" class="text-primary fw-bold">
                                <i class="bi bi-grid-1x2-fill me-2" aria-hidden="true"></i>Khu vực nhân viên
                            </a>
                        }

                        @if (isAdmin)
                        {
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="text-warning fw-bold">
                                <i class="bi bi-shield-lock-fill me-2" aria-hidden="true"></i>Khu vực quản trị
                            </a>
                        }

                        <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post" class="mt-2 mb-0">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="mobile-logout-btn">
                                <i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Đăng xuất
                            </button>
                        </form>
                    </div>
                }
                else
                {
                    <div class="mobile-guest-actions">
                        <a asp-area="" asp-controller="Auth" asp-action="Login" class="btn-emua-dropdown primary">
                            <i class="bi bi-box-arrow-in-right me-1" aria-hidden="true"></i>Đăng nhập
                        </a>
                        <a asp-area="" asp-controller="Auth" asp-action="Register" class="btn-emua-dropdown secondary">
                            <i class="bi bi-person-plus me-1" aria-hidden="true"></i>Đăng ký
                        </a>
                    </div>
                }
            </div>

            <div class="mobile-categories-heading">
                <span>DANH MỤC THIẾT BỊ</span>
            </div>

            <div class="mobile-category-grid">
                @foreach (var category in categories)
                {
                    <a asp-area=""
                       asp-controller="Product"
                       asp-action="Index"
                       asp-route-category="@category.Key"
                       class="mobile-cat-link">
                        <i class="bi @category.Icon" aria-hidden="true"></i>
                        <span>@category.Name</span>
                    </a>
                }
            </div>

            <div class="mobile-menu-footer-links">
                <a asp-area="" asp-controller="Home" asp-action="StoreLocations">
                    <i class="bi bi-geo-alt-fill me-2 text-primary" aria-hidden="true"></i>Bản đồ hệ thống cửa hàng
                </a>
                <a asp-area="" asp-controller="Home" asp-action="Franchise">
                    <i class="bi bi-award-fill me-2 text-warning" aria-hidden="true"></i>Hợp tác nhượng quyền
                </a>
                <div class="mobile-hotline-strip">
                    <i class="bi bi-headset me-2 text-success" aria-hidden="true"></i>
                    <span>Tư vấn miễn phí: <strong>1800 2005</strong> (7:30 - 22:00)</span>
                </div>
            </div>

        </nav>
    </div>

</header>


<script>
    // Không gửi form nếu từ khóa rỗng hoặc chỉ có khoảng trắng.
    function validateEmuaSearch(form) {
        const input = form.querySelector('input[name="keyword"]');
        if (!input) return false;

        const keyword = input.value.trim();
        if (!keyword) {
            input.value = '';
            return false;
        }

        input.value = keyword;
        return true;
    }

    // =========================================================================
    // TÍNH NĂNG GỢI Ý TÌM KIẾM NHANH (LIVE SEARCH SUGGESTIONS / AUTOCOMPLETE)
    // =========================================================================
    document.addEventListener('DOMContentLoaded', function () {
        const containers = document.querySelectorAll('.emua-search-container');
        if (!containers.length) return;

        // Escape HTML để tránh XSS
        function escapeHtml(text) {
            if (!text) return '';
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        // Highlight từ khóa khớp với người dùng đang gõ
        function highlightMatch(name, term) {
            if (!name || !term) return escapeHtml(name);
            const escapedName = escapeHtml(name);
            const escapedTerm = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            try {
                const regex = new RegExp(`(${escapedTerm})`, 'gi');
                return escapedName.replace(regex, '<mark class="emua-search-highlight">$1</mark>');
            } catch (e) {
                return escapedName;
            }
        }

        containers.forEach(container => {
            const input = container.querySelector('.emua-search-input');
            const dropdown = container.querySelector('.emua-search-suggestions');
            if (!input || !dropdown) return;

            let debounceTimer = null;
            let currentAbortController = null;

            function hideDropdown() {
                dropdown.classList.add('d-none');
                dropdown.innerHTML = '';
            }

            function showDropdown(items, term) {
                if (!items || !items.length) {
                    dropdown.innerHTML = `
                        <div class="emua-suggestion-empty">
                            <i class="bi bi-search me-2"></i>Không tìm thấy sản phẩm nào khớp với "<strong>${escapeHtml(term)}</strong>"
                        </div>
                    `;
                    dropdown.classList.remove('d-none');
                    return;
                }

                let html = '<div class="emua-suggestion-list">';
                items.forEach(item => {
                    const highlightedName = highlightMatch(item.tenSanPham, term);
                    html += `
                        <a href="${item.url}" class="emua-suggestion-item">
                            <img src="${item.hinhAnh}" alt="${escapeHtml(item.tenSanPham)}" class="emua-suggestion-thumb" onerror="this.onerror=null;this.src='/images/no-image.png';" />
                            <div class="emua-suggestion-info">
                                <div class="emua-suggestion-title">${highlightedName}</div>
                                <div class="emua-suggestion-price">${item.giaFormat}</div>
                            </div>
                        </a>
                    `;
                });
                html += `
                    <div class="emua-suggestion-footer">
                        <button type="button" class="emua-suggestion-all-btn" onclick="this.closest('form, .emua-search-container').querySelector('form').submit()">
                            Xem tất cả kết quả cho "<strong>${escapeHtml(term)}</strong>" <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                    </div>
                `;
                html += '</div>';

                dropdown.innerHTML = html;
                dropdown.classList.remove('d-none');
            }

            // Lắng nghe sự kiện input với debounce 250ms
            input.addEventListener('input', function () {
                const term = this.value.trim();

                clearTimeout(debounceTimer);
                if (currentAbortController) {
                    currentAbortController.abort();
                }

                if (term.length < 2) {
                    hideDropdown();
                    return;
                }

                debounceTimer = setTimeout(async function () {
                    currentAbortController = new AbortController();
                    try {
                        const response = await fetch(`/Product/SearchSuggestions?term=${encodeURIComponent(term)}`, {
                            signal: currentAbortController.signal,
                            headers: { 'X-Requested-With': 'XMLHttpRequest' }
                        });

                        if (!response.ok) throw new Error('HTTP ' + response.status);
                        const data = await response.json();
                        showDropdown(data, term);
                    } catch (err) {
                        if (err.name !== 'AbortError') {
                            console.warn('Search suggestions error:', err);
                        }
                    }
                }, 250);
            });

            // Focus lại vào ô input nếu có text thì hiển thị lại
            input.addEventListener('focus', function () {
                const term = this.value.trim();
                if (term.length >= 2 && dropdown.innerHTML.trim() !== '') {
                    dropdown.classList.remove('d-none');
                }
            });

            // Bấm phím ESC để đóng dropdown
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    hideDropdown();
                }
            });
        });

        // Click ra ngoài thì đóng toàn bộ dropdown
        document.addEventListener('click', function (e) {
            containers.forEach(container => {
                if (!container.contains(e.target)) {
                    const dropdown = container.querySelector('.emua-search-suggestions');
                    if (dropdown) dropdown.classList.add('d-none');
                }
            });
        });
    });
</script>
