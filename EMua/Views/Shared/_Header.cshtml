@{
    var displayName = User.Identity?.Name ?? "Tài khoản";

    var avatarLetter = string.IsNullOrWhiteSpace(displayName)
        ? "U"
        : displayName.Trim()[..1].ToUpperInvariant();

    var isAuthenticated = User.Identity?.IsAuthenticated == true;

    var isAdmin = User.IsInRole("Admin")
        || User.IsInRole("Quản trị viên");

    var isStaff = User.IsInRole("NhanVien")
        || User.IsInRole("Nhân viên");

    var cartUrl = isAuthenticated
        ? Url.Action("Index", "Cart", new { area = "" })
        : Url.Action(
            "Login",
            "Auth",
            new { area = "", returnUrl = "/Cart" });

    var categories = new[]
    {
        new { Key = "Laptop", Name = "Laptop", Icon = "bi-laptop" },
        new { Key = "DienThoai", Name = "Điện thoại", Icon = "bi-phone" },
        new { Key = "Gaming", Name = "Gaming", Icon = "bi-controller" },
        new { Key = "PhuKien", Name = "Phụ kiện", Icon = "bi-box" },
        new { Key = "AmThanh", Name = "Âm thanh", Icon = "bi-headphones" },
        new
        {
            Key = "ThietBiThongMinh",
            Name = "Thiết bị thông minh",
            Icon = "bi-smartwatch"
        }
    };

    var stores = new[]
    {
        new
        {
            Name = "Cơ sở 1: Nguyễn Văn Linh",
            Address = "1020 Nguyễn Văn Linh, Đà Nẵng"
        },
        new
        {
            Name = "Cơ sở 2: Nguyễn Lương Bằng",
            Address = "540 Nguyễn Lương Bằng, Đà Nẵng"
        },
        new
        {
            Name = "Cơ sở 3: Tôn Thất Đạm",
            Address = "65 Tôn Thất Đạm, Đà Nẵng"
        },
        new
        {
            Name = "Cơ sở 4: Ngô Xuân Thu",
            Address = "76 Ngô Xuân Thu, Đà Nẵng"
        },
        new
        {
            Name = "Cơ sở Hà Nội: Ba Đình",
            Address = "13 Ba Đình, Hà Nội"
        }
    };
}

<header class="emua-site-header">

    <!-- TOPBAR -->
    <div class="emua-topbar">
        <div class="container-fluid emua-container">
            <div class="topbar-content">
                <span>🚀 Miễn phí vận chuyển đơn từ 500K</span>
                <span class="topbar-divider" aria-hidden="true">|</span>
                <span>Giao 2 giờ tại Đà Nẵng &amp; Hà Nội</span>
                <span class="topbar-divider" aria-hidden="true">|</span>
                <span>Hotline: <strong>1800 2005</strong></span>
            </div>
        </div>
    </div>

    <!-- MAIN HEADER -->
    <div class="emua-main-header">
        <div class="container-fluid emua-container">
            <div class="main-header-wrapper">

                <!-- LOGO -->
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="emua-logo"
                   aria-label="EMUA — Trang chủ">

                    <div class="emua-logo-text">
                        <img src="~/images/logo/logo.png"
                             asp-append-version="true"
                             alt="EMUA"
                             class="emua-wordmark" />

                        <span>Mua sắm điện tử</span>
                    </div>
                </a>

                <!-- SEARCH -->
                <form asp-area=""
                      asp-controller="Product"
                      asp-action="Search"
                      method="get"
                      role="search"
                      class="emua-search">

                    <i class="bi bi-search" aria-hidden="true"></i>

                    <input type="search"
                           name="keyword"
                           autocomplete="off"
                           aria-label="Tìm kiếm sản phẩm"
                           placeholder="Tìm kiếm laptop, điện thoại, gaming gear..." />
                </form>

                <!-- DESKTOP ACTIONS -->
                <div class="emua-header-actions">

                    <!-- ACCOUNT -->
                    <div class="dropdown">
                        <button type="button"
                                id="headerAccountMenu"
                                class="header-action-btn dropdown-toggle"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <i class="bi bi-person" aria-hidden="true"></i>
                            <span>
                                @(isAuthenticated? displayName : "Tài khoản")
                            </span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end account-dropdown"
                            aria-labelledby="headerAccountMenu">

                            @if (isAuthenticated)
                            {
                                <li>
                                    <a asp-area=""
                                       asp-controller="Account"
                                       asp-action="Profile"
                                       class="account-dropdown-profile">

                                        <span class="account-dropdown-avatar">
                                            @avatarLetter
                                        </span>

                                        <span class="account-dropdown-info">
                                            <strong>@displayName</strong>
                                            <small>Hồ sơ của tôi</small>
                                        </span>

                                        <i class="bi bi-chevron-right"
                                           aria-hidden="true"></i>
                                    </a>
                                </li>


                                @if (isStaff)
                                {
                                    <li>
                                        <a asp-area="Staff"
                                           asp-controller="Dashboard"
                                           asp-action="Index"
                                           class="account-dropdown-staff">

                                            <i class="bi bi-grid-1x2"
                                               aria-hidden="true"></i>
                                            <span>Khu vực nhân viên</span>
                                        </a>
                                    </li>
                                }

                                @if (isAdmin)
                                {
                                    <li>
                                        <a asp-area="Admin"
                                           asp-controller="Dashboard"
                                           asp-action="Index"
                                           class="account-dropdown-staff">

                                            <i class="bi bi-shield-lock-fill"
                                               aria-hidden="true"></i>
                                            <span>Khu vực quản trị</span>
                                        </a>
                                    </li>
                                }

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>
                                    <form asp-area=""
                                          asp-controller="Auth"
                                          asp-action="Logout"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="account-dropdown-logout">
                                            <i class="bi bi-box-arrow-right"
                                               aria-hidden="true"></i>
                                            <span>Đăng xuất</span>
                                        </button>
                                    </form>
                                </li>
                            }
                            else
                            {
                                <li>
                                    <a asp-area=""
                                       asp-controller="Auth"
                                       asp-action="Login"
                                       class="account-dropdown-profile">

                                        <i class="bi bi-box-arrow-in-right"
                                           aria-hidden="true"></i>
                                        <span>Đăng nhập</span>
                                    </a>
                                </li>

                                <li>
                                    <a asp-area=""
                                       asp-controller="Auth"
                                       asp-action="Register"
                                       class="account-dropdown-profile">

                                        <i class="bi bi-person-plus"
                                           aria-hidden="true"></i>
                                        <span>Đăng ký</span>
                                    </a>
                                </li>
                            }
                        </ul>
                    </div>

                    <!-- STORES -->
                    <div class="dropdown">
                        <button type="button"
                                id="headerStoreMenu"
                                class="header-action-btn dropdown-toggle"
                                data-bs-toggle="dropdown"
                                aria-expanded="false">

                            <i class="bi bi-shop" aria-hidden="true"></i>
                            <span>Cửa hàng</span>
                        </button>

                        <ul class="dropdown-menu dropdown-menu-end account-dropdown"
                            aria-labelledby="headerStoreMenu"
                            style="width:320px; max-width:calc(100vw - 24px); max-height:480px; overflow-y:auto;">

                            <li>
                                <div class="px-3 py-2">
                                    <small style="color:#a4a7b8; font-weight:700;">
                                        HỆ THỐNG CỬA HÀNG EMUA
                                    </small>
                                </div>
                            </li>

                            @foreach (var store in stores)
                            {
                                <li>
                                    <div class="px-3 py-2">
                                        <strong class="d-block"
                                                style="color:#eef0f7; font-size:13px;">
                                            <i class="bi bi-geo-alt"
                                               style="color:#91aaff;"
                                               aria-hidden="true"></i>
                                            @store.Name
                                        </strong>

                                        <small class="d-block mt-1"
                                               style="color:#b5b9cb;">
                                            @store.Address
                                        </small>
                                    </div>
                                </li>
                            }

                            <li>
                                <hr class="dropdown-divider" />
                            </li>

                            <li>
                                <a asp-area=""
                                   asp-controller="Home"
                                   asp-action="StoreLocations"
                                   class="account-dropdown-staff">

                                    <i class="bi bi-map" aria-hidden="true"></i>
                                    <span>Bản đồ hệ thống cửa hàng</span>
                                </a>
                            </li>

                            <li>
                                <a asp-area=""
                                   asp-controller="Home"
                                   asp-action="Franchise"
                                   class="account-dropdown-staff">

                                    <i class="bi bi-award" aria-hidden="true"></i>
                                    <span>Nhượng quyền cửa hàng</span>
                                </a>
                            </li>
                        </ul>
                    </div>

                    <!-- CART -->
                    <a href="@cartUrl"
                       class="header-action-btn cart-action">
                        <div class="header-icon-wrapper">
                            <i class="bi bi-cart3" aria-hidden="true"></i>
                        </div>
                        <span>Giỏ hàng</span>
                    </a>
                </div>

                <!-- MOBILE MENU BUTTON -->
                <button type="button"
                        class="mobile-menu-button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mobileCategories"
                        aria-controls="mobileCategories"
                        aria-expanded="false"
                        aria-label="Mở menu">

                    <i class="bi bi-list" aria-hidden="true"></i>
                </button>

            </div>
        </div>
    </div>

    <!-- DESKTOP CATEGORIES -->
    <nav class="emua-category-nav" aria-label="Danh mục sản phẩm">
        <div class="container-fluid emua-container">
            <div class="category-list">
                @foreach (var category in categories)
                {
                    <a asp-area=""
                       asp-controller="Product"
                       asp-action="Index"
                       asp-route-category="@category.Key">

                        <i class="bi @category.Icon" aria-hidden="true"></i>
                        <span>@category.Name</span>
                    </a>
                }
            </div>
        </div>
    </nav>

    <!-- MOBILE MENU -->
    <div class="collapse" id="mobileCategories">
        <nav class="mobile-category-menu" aria-label="Menu trên điện thoại">

            <div class="pb-3 mb-2"
                 style="border-bottom:1px solid #363849;">

                @if (isAuthenticated)
                {
                    <a asp-area=""
                       asp-controller="Account"
                       asp-action="Profile"
                       class="d-flex align-items-center gap-2">

                        <span class="account-dropdown-avatar">
                            @avatarLetter
                        </span>

                        <span class="account-dropdown-info">
                            <strong>@displayName</strong>
                            <small>Hồ sơ của tôi</small>
                        </span>
                    </a>

                    <a asp-area=""
                       asp-controller="Account"
                       asp-action="ChangePassword">
                        <i class="bi bi-key me-2" aria-hidden="true"></i>
                        Đổi mật khẩu
                    </a>

                    @if (isStaff)
                    {
                        <a asp-area="Staff"
                           asp-controller="Dashboard"
                           asp-action="Index">
                            <i class="bi bi-grid-1x2 me-2"
                               aria-hidden="true"></i>
                            Khu vực nhân viên
                        </a>
                    }

                    @if (isAdmin)
                    {
                        <a asp-area="Admin"
                           asp-controller="User"
                           asp-action="Index">
                            <i class="bi bi-shield-lock-fill me-2"
                               aria-hidden="true"></i>
                            Khu vực quản trị
                        </a>
                    }

                    <form asp-area=""
                          asp-controller="Auth"
                          asp-action="Logout"
                          method="post"
                          class="mt-2 mb-0">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="account-dropdown-logout">
                            <i class="bi bi-box-arrow-right"
                               aria-hidden="true"></i>
                            <span>Đăng xuất</span>
                        </button>
                    </form>
                }
                else
                {
                    <a asp-area=""
                       asp-controller="Auth"
                       asp-action="Login">
                        <i class="bi bi-box-arrow-in-right me-2"
                           aria-hidden="true"></i>
                        Đăng nhập
                    </a>

                    <a asp-area=""
                       asp-controller="Auth"
                       asp-action="Register">
                        <i class="bi bi-person-plus me-2"
                           aria-hidden="true"></i>
                        Đăng ký
                    </a>
                }
            </div>

            @foreach (var category in categories)
            {
                <a asp-area=""
                   asp-controller="Product"
                   asp-action="Index"
                   asp-route-category="@category.Key">

                    <i class="bi @category.Icon me-2"
                       aria-hidden="true"></i>
                    @category.Name
                </a>
            }

            <a href="@cartUrl">
                <i class="bi bi-cart3 me-2" aria-hidden="true"></i>
                Giỏ hàng
            </a>

            <a asp-area=""
               asp-controller="Home"
               asp-action="StoreLocations">
                <i class="bi bi-map me-2" aria-hidden="true"></i>
                Bản đồ hệ thống cửa hàng
            </a>

            <a asp-area=""
               asp-controller="Home"
               asp-action="Franchise">
                <i class="bi bi-award me-2" aria-hidden="true"></i>
                Nhượng quyền cửa hàng
            </a>
        </nav>
    </div>

</header>