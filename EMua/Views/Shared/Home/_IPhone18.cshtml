        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: duoTextShine 6s linear infinite;
    }



    .duo-content h2 {
        font-size: 26px;
        line-height: 1.35;
        font-weight: 500;
        color: #e7e7e7;
        max-width: 500px;
        margin-bottom: 18px;
