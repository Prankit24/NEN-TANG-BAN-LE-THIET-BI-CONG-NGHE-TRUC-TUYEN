           ANIMATIONS
        =============================================== */

    @@keyframes duoContentIn {

        from {
            opacity: 0;
            transform: translateX(-55px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }



    @@keyframes modelIn {

        from {
            opacity: 0;
            transform: translateX(70px) scale(.92);
        }

        to {
            opacity: 1;
            transform: translateX(0) scale(1);
        }
    }



    @@keyframes duoTextShine {

        0% {
            background-position: 250% center;
        }

        100% {
            background-position: -250% center;
        }
    }



    @@keyframes duoLabelGlow {

        from {
            text-shadow: 0 0 5px rgba( 94, 184, 255, .25 );
        }

        to {
            text-shadow: 0 0 20px rgba( 94, 184, 255, .8 );
        }
    }



    @@keyframes glowFloat1 {

        0%,
        100% {
            transform: translate( 0, 0 );
        }

        50% {
            transform: translate( -40px, 35px );
        }
    }



    @@keyframes glowFloat2 {

        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-50px);
        }
    }



    @@keyframes modelLight {

        from {
            opacity: .5;
            transform: scale(.9);
        }

        to {
            opacity: 1;
            transform: scale(1.1);
        }
    }



    @@keyframes dragTip {

        0%,
        100% {
            opacity: .55;
        }

        50% {
            opacity: 1;
        }
    }



