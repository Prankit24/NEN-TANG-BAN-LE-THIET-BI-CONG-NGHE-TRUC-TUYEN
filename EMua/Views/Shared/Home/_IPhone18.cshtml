        align-items: center;
        gap: 40px;
        position: relative;
        z-index: 2;
    }



    /* ===============================================
           BACKGROUND GLOW
        =============================================== */

    .duo-bg-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(90px);
        opacity: .22;
        pointer-events: none;
    }



    .glow-1 {
        width: 430px;
        height: 430px;
        background: #0071e3;
        right: 8%;
        top: 80px;
        animation: glowFloat1 8s ease-in-out infinite;
    }



    .glow-2 {
        width: 320px;
        height: 320px;
        background: #cc34ff;
        right: 30%;
        bottom: -130px;
        opacity: .15;
        animation: glowFloat2 10s ease-in-out infinite;
    }



    /* ===============================================
           CONTENT
        =============================================== */

    .duo-content {
        max-width: 580px;
        animation: duoContentIn 1s ease forwards;
    }



    .duo-label {
        display: inline-block;
        margin-bottom: 14px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 4px;
        color: #5eb8ff;
        text-transform: uppercase;
        animation: duoLabelGlow 2s ease-in-out infinite alternate;
    }



    .duo-content h1 {
        font-size: clamp( 50px, 6vw, 82px );
        font-weight: 700;
        line-height: .95;
        margin: 0 0 18px;
        letter-spacing: -4px;
        background: linear-gradient( 100deg, #ffffff 10%, #bcdcff 35%, #ffffff 55%, #d7baff 80% );
