            margin: 0 auto 27px;
        }


        .duo-feature {
            text-align: left;
        }


        .duo-actions {
            flex-direction: column;
            max-width: 320px;
            margin: 0 auto;
        }


        .duo-btn {
            width: 100%;
        }


        .duo-model-area {
            height: 400px;
        }


        .duo-drag-tip {
            bottom: 5px;
        }
    }

</style>