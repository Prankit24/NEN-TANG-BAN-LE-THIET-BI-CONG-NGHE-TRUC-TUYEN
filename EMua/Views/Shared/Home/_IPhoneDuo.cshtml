<section class="iphone-duo-section">

    <div class="duo-glow duo-glow-1"></div>
    <div class="duo-glow duo-glow-2"></div>

    <div class="duo-container">

        <!-- LEFT -->
        <div class="duo-content">

            <span class="duo-label">
                NEW 2026
            </span>

            <h1>
                iPhone Duo
            </h1>

            <h2>
                Mở ra một trải nghiệm hoàn toàn mới.
            </h2>

            <p>
                Thiết kế gập thế hệ mới kết hợp giữa sự nhỏ gọn
                và không gian hiển thị rộng hơn.
                Trải nghiệm công nghệ theo một cách hoàn toàn khác.
            </p>

            <div class="duo-features">

                <div class="duo-feature">

                    <i class="bi bi-phone"></i>

                    <div>
                        <strong>
                            Thiết kế gập
                        </strong>

                        <span>
                            Nhỏ gọn khi đóng
                        </span>
                    </div>

                </div>


                <div class="duo-feature">

                    <i class="bi bi-display"></i>

                    <div>
                        <strong>
                            Màn hình lớn
                        </strong>

                        <span>
                            Không gian rộng hơn
                        </span>
                    </div>

                </div>


                <div class="duo-feature">

                    <i class="bi bi-cpu"></i>

                    <div>
                        <strong>
                            Hiệu năng mạnh
                        </strong>

                        <span>
                            Mượt mà mọi tác vụ
                        </span>
                    </div>

                </div>

            </div>


            <div class="duo-actions">

                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-keyword="iPhone Duo"
                   class="duo-primary">

                    Khám phá ngay

                    <i class="bi bi-arrow-right"></i>

                </a>


                <a asp-controller="Product"
                   asp-action="Index"
                   asp-route-keyword="iPhone"
                   class="duo-secondary">

                    Xem dòng iPhone

                </a>

            </div>

        </div>


        <!-- RIGHT IMAGE -->
        <div class="duo-visual">

            <div class="duo-device-glow"></div>

            <div class="duo-circle duo-circle-1"></div>
            <div class="duo-circle duo-circle-2"></div>


            <img src="/images/apple2026/iphone-duo.png"
                 alt="iPhone Duo"
                 class="duo-phone-image" />


            <div class="duo-floating-card duo-card-1">

                <i class="bi bi-stars"></i>

                <span>
                    New Design
                </span>

            </div>


            <div class="duo-floating-card duo-card-2">

                <i class="bi bi-arrows-angle-expand"></i>

                <span>
                    Foldable
                </span>

            </div>


            <div class="duo-floating-card duo-card-3">

                <i class="bi bi-lightning-charge"></i>

                <span>
                    Pro Power
                </span>

            </div>

        </div>

    </div>

</section>


<style>

    .iphone-duo-section {
        position: relative;
        overflow: hidden;
        min-height: 680px;
        padding: 70px 0;
        color: white;
        background: radial-gradient( circle at 76% 44%, rgba(76, 118, 255, .26), transparent 31% ), radial-gradient( circle at 50% 110%, rgba(125, 77, 255, .18), transparent 38% ), linear-gradient( 135deg, #11132c 0%, #141735 50%, #0c0e22 100% );
    }


    .duo-container {
        width: min(1400px, 92%);
        min-height: 540px;
        margin: auto;
        display: grid;
        grid-template-columns: minmax(0, .95fr) minmax(0, 1.15fr);
        align-items: center;
        gap: 40px;
        position: relative;
        z-index: 3;
    }


    /* =========================
           LEFT
        ========================= */

    .duo-content {
        max-width: 600px;
        animation: duoContentIn .9s ease both;
    }


    .duo-label {
        display: inline-block;
        margin-bottom: 16px;
        color: #69b5ff;
        font-size: 12px;
        font-weight: 800;
        letter-spacing: 5px;
        animation: duoLabelGlow 2s ease-in-out infinite alternate;
    }


    .duo-content h1 {
        margin: 0 0 20px;
        font-size: clamp(58px, 6vw, 92px);
        font-weight: 500;
        line-height: .95;
        letter-spacing: -5px;
        background: linear-gradient( 100deg, #ffffff, #cfc7ff, #ffffff, #9fc5ff );
        background-size: 250%;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        animation: duoTextShine 6s linear infinite;
    }


    .duo-content h2 {
        margin: 0 0 18px;
        color: #f0f0f6;
        font-size: 26px;
        font-weight: 500;
        line-height: 1.4;
    }


    .duo-content > p {
        max-width: 550px;
        margin: 0 0 30px;
        color: #a9abbd;
        font-size: 16px;
        line-height: 1.8;
    }


    /* FEATURES */

    .duo-features {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        margin-bottom: 32px;
    }


    .duo-feature {
        min-width: 0;
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 11px;
        border: 1px solid rgba(255,255,255,.09);
        border-radius: 15px;
        background: rgba(255,255,255,.045);
        backdrop-filter: blur(14px);
        transition: .3s;
    }


        .duo-feature:hover {
            transform: translateY(-5px);
            border-color: rgba(105,181,255,.25);
            background: rgba(255,255,255,.08);
        }


        .duo-feature i {
            flex: 0 0 38px;
            width: 38px;
            height: 38px;
            border-radius: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #69b5ff;
            background: rgba(74,134,255,.13);
            font-size: 18px;
        }


        .duo-feature strong {
            display: block;
            color: #fff;
            font-size: 12px;
        }


        .duo-feature span {
            display: block;
            margin-top: 3px;
            color: #828598;
            font-size: 10px;
        }


    /* BUTTON */

    .duo-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 14px;
    }


    .duo-primary,
    .duo-secondary {
        min-height: 50px;
        padding: 0 26px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        text-decoration: none;
        transition: all .3s ease;
    }


    .duo-primary {
        color: #fff;
        background: linear-gradient( 135deg, #5b8cff, #7766ee );
        box-shadow: 0 13px 35px rgba(91,140,255,.26);
    }


        .duo-primary:hover {
            color: white;
            transform: translateY(-3px);
            box-shadow: 0 17px 45px rgba(91,140,255,.42);
        }


    .duo-secondary {
        color: white;
        border: 1px solid rgba(255,255,255,.20);
        background: rgba(255,255,255,.045);
        backdrop-filter: blur(12px);
    }


        .duo-secondary:hover {
            color: #17172a;
            background: white;
            transform: translateY(-3px);
        }


    /* =========================
           RIGHT VISUAL
        ========================= */

    .duo-visual {
        position: relative;
        height: 570px;
        display: flex;
        align-items: center;
        justify-content: center;
        perspective: 1000px;
    }


    .duo-phone-image {
        position: relative;
        z-index: 4;
        display: block;
        width: min(90%, 650px);
        max-height: 520px;
        object-fit: contain;
        filter: drop-shadow( 0 40px 55px rgba(0,0,0,.38) );
        animation: duoPhoneFloat 5s ease-in-out infinite;
        transition: transform .4s ease, filter .4s ease;
    }


    .duo-visual:hover
    .duo-phone-image {
        transform: rotateY(-5deg) rotateX(3deg) scale(1.035);
        filter: drop-shadow( 0 48px 70px rgba(0,0,0,.46) );
    }


    .duo-device-glow {
        position: absolute;
        z-index: 1;
        width: 72%;
        height: 72%;
        border-radius: 50%;
        background: radial-gradient( circle, rgba(82,142,255,.26), rgba(99,87,224,.12) 35%, transparent 70% );
        filter: blur(30px);
        animation: duoGlowPulse 4s ease-in-out infinite alternate;
    }


    .duo-circle {
        position: absolute;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,.07);
    }


    .duo-circle-1 {
        width: 450px;
        height: 450px;
        animation: duoCircleRotate 18s linear infinite;
    }


    .duo-circle-2 {
        width: 330px;
        height: 330px;
        border-style: dashed;
        animation: duoCircleRotateReverse 14s linear infinite;
    }


    /* FLOATING LABELS */

    .duo-floating-card {
        position: absolute;
        z-index: 6;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 14px;
        border-radius: 13px;
        border: 1px solid rgba(255,255,255,.12);
        background: rgba(21,23,51,.56);
        color: rgba(255,255,255,.85);
        backdrop-filter: blur(18px);
        box-shadow: 0 12px 35px rgba(0,0,0,.18);
        font-size: 11px;
    }


        .duo-floating-card i {
            color: #6ab4ff;
        }


    .duo-card-1 {
        top: 90px;
        left: 0;
        animation: duoMiniFloatOne 4s ease-in-out infinite;
    }


    .duo-card-2 {
        right: 0;
        top: 235px;
        animation: duoMiniFloatTwo 5s ease-in-out infinite;
    }


    .duo-card-3 {
        left: 60px;
        bottom: 80px;
        animation: duoMiniFloatOne 5.5s ease-in-out infinite;
    }


    /* GLOWS */

    .duo-glow {
        position: absolute;
        border-radius: 50%;
        filter: blur(100px);
        pointer-events: none;
    }


    .duo-glow-1 {
        width: 450px;
        height: 450px;
        right: 5%;
        top: 50px;
        opacity: .16;
        background: #578cff;
    }


    .duo-glow-2 {
        width: 330px;
        height: 330px;
        right: 35%;
        bottom: -150px;
        opacity: .12;
        background: #8d59f5;
    }


    /* =========================
           ANIMATION
        ========================= */

    @@keyframes duoContentIn {

        from {
            opacity: 0;
            transform: translateX(-40px);
        }

        to {
            opacity: 1;
            transform: translateX(0);
        }
    }


    @@keyframes duoTextShine {

        from {
            background-position: 250% center;
        }

        to {
            background-position: -250% center;
        }
    }


    @@keyframes duoLabelGlow {

        from {
            text-shadow: 0 0 4px rgba(105,181,255,.25);
        }

        to {
            text-shadow: 0 0 18px rgba(105,181,255,.8);
        }
    }


    @@keyframes duoPhoneFloat {

        0%,
        100% {
            transform: translateY(0) rotate(-1deg);
        }

        50% {
            transform: translateY(-20px) rotate(1.5deg);
        }
    }


    @@keyframes duoGlowPulse {

        from {
            opacity: .45;
            transform: scale(.88);
        }

        to {
            opacity: 1;
            transform: scale(1.09);
        }
    }


    @@keyframes duoCircleRotate {

        from {
            transform: rotate(0deg);
        }

        to {
            transform: rotate(360deg);
        }
    }


    @@keyframes duoCircleRotateReverse {

        from {
            transform: rotate(360deg);
        }

        to {
            transform: rotate(0deg);
        }
    }


    @@keyframes duoMiniFloatOne {

        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(-12px);
        }
    }


    @@keyframes duoMiniFloatTwo {

        0%,
        100% {
            transform: translateY(0);
        }

        50% {
            transform: translateY(14px);
        }
    }


    /* =========================
           TABLET
        ========================= */

    @@media(max-width: 950px) {

        .duo-container {
            grid-template-columns: 1fr;
        }


        .duo-content {
            margin: auto;
            text-align: center;
        }


            .duo-content > p {
                margin-left: auto;
                margin-right: auto;
            }


        .duo-actions {
            justify-content: center;
        }


        .duo-visual {
            height: 500px;
        }
    }


    /* =========================
           MOBILE
        ========================= */

    @@media(max-width: 650px) {

        .iphone-duo-section {
            padding: 55px 0 35px;
        }


        .duo-content h1 {
            font-size: 54px;
            letter-spacing: -3px;
        }


        .duo-content h2 {
            font-size: 21px;
        }


        .duo-features {
            grid-template-columns: 1fr;
            max-width: 390px;
            margin: 0 auto 28px;
        }


        .duo-feature {
            text-align: left;
        }


        .duo-actions {
            flex-direction: column;
            max-width: 330px;
            margin: auto;
        }


        .duo-primary,
        .duo-secondary {
            width: 100%;
        }


        .duo-visual {
            height: 390px;
        }


        .duo-phone-image {
            width: 95%;
            max-height: 360px;
        }


        .duo-floating-card {
            display: none;
        }


        .duo-circle-1 {
            width: 330px;
            height: 330px;
        }


        .duo-circle-2 {
            width: 240px;
            height: 240px;
        }
    }

</style>