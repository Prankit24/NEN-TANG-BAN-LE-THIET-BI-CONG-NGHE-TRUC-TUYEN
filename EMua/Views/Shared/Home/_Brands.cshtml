@model IEnumerable<EMua.Models.Database.ThuongHieu>
@using System.Linq

<!-- MONOCHROME MINIMALIST BRAND BAR (Đúng 8 thương hiệu hàng đầu, tông xám trung tính tinh tế) -->
<section class="ep-section ep-brands-section" aria-label="Thương hiệu đối tác">
    <div class="ep-container">
        <div class="ep-brands-monochrome-bar">
            @{
                var topBrands = new[]
                {
                    new { Name = "Apple", Keyword = "Apple", Icon = "bi-apple" },
                    new { Name = "Samsung", Keyword = "Samsung", Icon = "bi-phone" },
                    new { Name = "Sony", Keyword = "Sony", Icon = "bi-headphones" },
                    new { Name = "ASUS", Keyword = "ASUS", Icon = "bi-laptop" },
                    new { Name = "Lenovo", Keyword = "Lenovo", Icon = "bi-pc-display" },
                    new { Name = "Dell", Keyword = "Dell", Icon = "bi-display" },
                    new { Name = "Razer", Keyword = "Razer", Icon = "bi-controller" },
                    new { Name = "Logitech", Keyword = "Logitech", Icon = "bi-mouse3" }
                };
            }

            @foreach (var b in topBrands)
            {
                <a class="ep-brand-mono-item" asp-area="" asp-controller="Product" asp-action="Index" asp-route-keyword="@b.Keyword" title="Khám phá thiết bị @b.Name">
                    <i class="bi @b.Icon me-2"></i>
                    <span>@b.Name</span>
                </a>
            }
        </div>
    </div>
</section>
