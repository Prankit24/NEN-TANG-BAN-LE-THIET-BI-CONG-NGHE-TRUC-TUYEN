<section class="ep-section" aria-label="Bộ sưu tập công nghệ nổi bật">
    <div class="ep-container">
        <header class="ep-heading">
            <div>
                <span class="ep-eyebrow">BỘ SƯU TẬP TIÊU BIỂU</span>
                <h2>Sản phẩm định hình phong cách</h2>
                <p>Khám phá những thiết bị công nghệ đỉnh cao được yêu thích nhất tại EMUA.</p>
            </div>
            <a class="ep-text-link" asp-area="" asp-controller="Product" asp-action="Index">
                Xem tất cả thiết bị <i class="bi bi-chevron-right" aria-hidden="true"></i>
            </a>
        </header>

        <div class="ep-showcase-grid">
            <!-- Khối 1: Laptop nổi bật (Lớn - 7 cột, Light) -->
            <a class="ep-showcase-card ep-showcase-card-lg ep-sc-light" asp-area="" asp-controller="Product" asp-action="Index" asp-route-category="Laptop">
                <div class="ep-sc-content">
                    <span class="ep-sc-tag">LAPTOP CHUYÊN NGHIỆP</span>
                    <h3 class="ep-sc-title">Ý tưởng lớn. Khởi đầu siêu việt.</h3>
                    <p class="ep-sc-desc">Sức mạnh xử lý AI và đồ họa bứt phá cho chuyên gia sáng tạo nội dung và lập trình.</p>
                    <span class="ep-sc-link">Khám phá các dòng Laptop <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                </div>
                <div class="ep-sc-media">
                    <img src="~/images/banners/macbook-pro-transparent.png" asp-append-version="true" alt="MacBook Pro" loading="lazy" />
                </div>
            </a>

            <!-- Khối 2: Smartphone nổi bật (Nhỏ - 5 cột, Dark) -->
            <a class="ep-showcase-card ep-showcase-card-sm ep-sc-dark" asp-area="" asp-controller="Product" asp-action="Index" asp-route-category="DienThoai">
                <div class="ep-sc-content">
                    <span class="ep-sc-tag">SMARTPHONE THẾ HỆ MỚI</span>
                    <h3 class="ep-sc-title">Kỷ nguyên AI thông minh</h3>
                    <p class="ep-sc-desc">Thiết kế titan bền bỉ cùng hệ thống camera tiềm vọng dẫn đầu xu thế.</p>
                    <span class="ep-sc-link">Xem Flagship <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                </div>
                <div class="ep-sc-media">
                    <img src="~/images/apple2026/iphone18-pro-max.png" asp-append-version="true" alt="iPhone Flagship" loading="lazy" />
                </div>
            </a>

            <!-- Khối 3: Phụ kiện & Âm thanh (Nhỏ - 5 cột, Light) -->
            <a class="ep-showcase-card ep-showcase-card-sm ep-sc-light" asp-area="" asp-controller="Product" asp-action="Index" asp-route-category="AmThanh">
                <div class="ep-sc-content">
                    <span class="ep-sc-tag">ÂM THANH ĐỈNH CAO</span>
                    <h3 class="ep-sc-title">Chất âm chuẩn studio</h3>
                    <p class="ep-sc-desc">Công nghệ chống ồn chủ động vượt trội, âm trường rộng mở từng giai điệu.</p>
                    <span class="ep-sc-link">Khám phá tai nghe <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                </div>
                <div class="ep-sc-media">
                    <img src="~/images/banners/sony-transparent.png" asp-append-version="true" alt="Sony Headphones" loading="lazy" />
                </div>
            </a>

            <!-- Khối 4: Gaming Gear (Lớn - 7 cột, Dark) -->
            <a class="ep-showcase-card ep-showcase-card-lg ep-sc-dark" asp-area="" asp-controller="Product" asp-action="Index" asp-route-category="Gaming">
                <div class="ep-sc-content">
                    <span class="ep-sc-tag">GAMING & ĐỒ HỌA</span>
                    <h3 class="ep-sc-title">Chiến trường không giới hạn.</h3>
                    <p class="ep-sc-desc">Hệ thống tản nhiệt buồng hơi cải tiến cùng card đồ họa RTX series siêu mượt mà.</p>
                    <span class="ep-sc-link">Xem thiết bị Gaming <i class="bi bi-arrow-right" aria-hidden="true"></i></span>
                </div>
                <div class="ep-sc-media">
                    <img src="~/images/banners/gaming-transparent.png" asp-append-version="true" alt="Laptop Gaming" loading="lazy" />
                </div>
            </a>
        </div>
    </div>
</section>
