@model IEnumerable<EMua.Models.Database.DanhMucSanPham>


<section class="emua-category-section" id="categories">

    <div class="emua-category-container">

        <div class="emua-category-heading">
            <div class="cat-tag">DANH MỤC</div>
            <h2 class="cat-title">Bạn đang tìm gì?</h2>
            <p class="cat-sub">Khám phá các nhóm sản phẩm công nghệ tại EMUA.</p>
        </div>


        <div class="emua-category-grid">

            @foreach (var item in Model)
            {
                var icon = "bi-grid";
                var name = item.TenDanhMuc?.ToLower() ?? "";

                if (name.Contains("điện thoại"))       { icon = "bi-phone"; }
                else if (name.Contains("laptop"))       { icon = "bi-laptop"; }
                else if (name.Contains("gaming"))       { icon = "bi-controller"; }
                else if (name.Contains("tai nghe") || name.Contains("âm thanh")) { icon = "bi-headphones"; }
                else if (name.Contains("phụ kiện"))     { icon = "bi-usb-plug"; }
                else if (name.Contains("tablet"))       { icon = "bi-tablet"; }
                else if (name.Contains("màn hình"))     { icon = "bi-display"; }
                else if (name.Contains("thông minh"))   { icon = "bi-smartwatch"; }

                <a asp-controller="Product" asp-action="Index" asp-route-category="@item.TenDanhMuc"
                   class="emua-category-card">

                    <div class="emua-category-icon">
                        <i class="bi @icon"></i>
                    </div>

                    <strong>@item.TenDanhMuc</strong>

                    @if (!string.IsNullOrWhiteSpace(item.MoTa))
                    {
                        <small>@item.MoTa</small>
                    }

                    <div class="cat-arrow"><i class="bi bi-arrow-right"></i></div>

                </a>
            }

        </div>

    </div>

</section>


<style>

    .emua-category-section {
        padding: 80px 0;
        background: linear-gradient(180deg, #f2f4fb, #f8faff);
    }

    .emua-category-container {
        width: min(1400px, 92%);
        margin: auto;
    }

    .emua-category-heading { margin-bottom: 36px; }

    .cat-tag {
        display: inline-flex;
        padding: 4px 14px;
        border-radius: 999px;
        background: rgba(37,99,235,.07);
        color: #2563eb;
        font-size: 10.5px;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 10px;
    }

    .cat-title {
        margin: 0;
        font-size: clamp(24px, 3vw, 34px);
        font-weight: 900;
        color: #0f172a;
        letter-spacing: -0.8px;
    }

    .cat-sub {
        margin: 8px 0 0;
        color: #94a3b8;
        font-size: 14px;
    }

    .emua-category-grid {
        display: grid;
        grid-template-columns: repeat(6, 1fr);
        gap: 16px;
    }


    /* Card */
    .emua-category-card {
        position: relative;
        min-height: 170px;
        padding: 22px 14px 18px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        text-decoration: none;
        color: #1e293b;
        border-radius: 20px;
        border: 1px solid rgba(0,0,0,0.05);
        background: #fff;
        box-shadow: 0 2px 10px rgba(15,23,42,0.04);
        overflow: hidden;
        transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1),
                    box-shadow 0.3s ease,
                    border-color 0.25s ease;
    }

    .emua-category-card::before {
        content: '';
        position: absolute;
        inset: 0;
        background: linear-gradient(135deg, rgba(37,99,235,0.03), rgba(124,58,237,0.02));
        opacity: 0;
        transition: opacity 0.25s;
    }

    .emua-category-card:hover {
        color: #1e293b;
        transform: translateY(-6px);
        border-color: rgba(37,99,235,.18);
        box-shadow: 0 18px 48px rgba(37,99,235,0.12);
    }

    .emua-category-card:hover::before { opacity: 1; }


    /* Icon */
    .emua-category-icon {
        width: 68px; height: 68px;
        margin-bottom: 14px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #2563eb;
        font-size: 28px;
        background: linear-gradient(135deg, rgba(37,99,235,.1), rgba(124,58,237,.08));
        border: 1px solid rgba(37,99,235,0.12);
        transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1);
    }

    .emua-category-card:hover .emua-category-icon {
        transform: scale(1.12) rotate(-4deg);
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        color: #fff;
        border-color: transparent;
        box-shadow: 0 8px 24px rgba(37,99,235,0.4);
    }

    .emua-category-card strong {
        font-size: 13.5px;
        font-weight: 700;
        color: #1e293b;
        line-height: 1.3;
    }

    .emua-category-card small {
        display: -webkit-box;
        margin-top: 4px;
        overflow: hidden;
        color: #94a3b8;
        font-size: 10.5px;
        line-height: 1.4;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .cat-arrow {
        position: absolute;
        bottom: 12px;
        right: 14px;
        width: 24px; height: 24px;
        border-radius: 50%;
        background: rgba(37,99,235,.08);
        color: #2563eb;
        font-size: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transform: translateX(-4px);
        transition: all 0.2s ease;
    }

    .emua-category-card:hover .cat-arrow {
        opacity: 1;
        transform: translateX(0);
    }


    @@media (max-width: 1100px) {
        .emua-category-grid { grid-template-columns: repeat(4, 1fr); }
    }

    @@media (max-width: 750px) {
        .emua-category-grid { grid-template-columns: repeat(3, 1fr); gap: 12px; }
    }

    @@media (max-width: 500px) {
        .emua-category-grid { grid-template-columns: repeat(2, 1fr); }
        .emua-category-card { min-height: 145px; }
    }

</style>
