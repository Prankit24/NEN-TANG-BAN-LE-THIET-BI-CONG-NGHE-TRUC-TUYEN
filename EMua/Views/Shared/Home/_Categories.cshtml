@model IEnumerable<EMua.Models.Database.DanhMucSanPham>
@using System.Linq

<section class="ep-section" id="categories" aria-labelledby="cat-heading">
    <div class="ep-container">
        <header class="ep-heading">
            <div class="ep-heading-left">
                <span class="ep-eyebrow">
                    <i class="bi bi-grid-fill" aria-hidden="true"></i> DANH MỤC THIẾT BỊ
                </span>
                <h2 id="cat-heading">Khám phá theo ngành hàng</h2>
                <p>Thiết bị công nghệ chính hãng cho học tập, làm việc và giải trí.</p>
            </div>
            <a class="ep-text-link" asp-area="" asp-controller="Product" asp-action="Index">
                <span>Xem tất cả sản phẩm</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </header>

        <div class="ep-categories-grid">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    var name = item.TenDanhMuc?.ToLowerInvariant() ?? "";
                    var icon = name.Contains("điện thoại") ? "bi-phone"
                        : name.Contains("laptop") ? "bi-laptop"
                        : name.Contains("gaming") ? "bi-controller"
                        : name.Contains("tai nghe") || name.Contains("âm thanh") ? "bi-headphones"
                        : name.Contains("tablet") || name.Contains("máy tính bảng") ? "bi-tablet"
                        : name.Contains("màn hình") ? "bi-display"
                        : name.Contains("thông minh") || name.Contains("đồng hồ") ? "bi-smartwatch"
                        : name.Contains("sạc") || name.Contains("phụ kiện") ? "bi-plug"
                        : "bi-cpu";

                    <a class="ep-cat-card" asp-area="" asp-controller="Product" asp-action="Index" asp-route-category="@item.TenDanhMuc">
                        <div class="ep-cat-icon">
                            <i class="bi @icon" aria-hidden="true"></i>
                        </div>
                        <span class="ep-cat-title">@item.TenDanhMuc</span>
                    </a>
                }
            }
            else
            {
                <p class="ep-empty">Danh mục đang được cập nhật.</p>
            }
        </div>
    </div>
</section>
