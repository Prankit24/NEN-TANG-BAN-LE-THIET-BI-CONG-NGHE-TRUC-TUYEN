@model IEnumerable<EMua.Models.Database.SanPham>
@using System.Linq
@using System.Collections.Generic
@using System
@using EMua.Helpers
@{
    var products = Model?.ToList() ?? new List<EMua.Models.Database.SanPham>();
    var viCulture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<section class="ep-section" id="featured-products" aria-labelledby="feat-heading">
    <div class="ep-container">
        <header class="ep-heading">
            <div class="ep-heading-left">
                <span class="ep-eyebrow">
                    <i class="bi bi-fire" aria-hidden="true"></i> BÁN CHẠY NHẤT
                </span>
                <h2 id="feat-heading">Sản phẩm nổi bật</h2>
                <p>Những thiết bị dẫn đầu doanh số và được khách hàng đánh giá cao nhất.</p>
            </div>
            <a class="ep-text-link" asp-area="" asp-controller="Product" asp-action="Index" asp-route-sort="popular">
                <span>Xem tất cả</span>
                <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </a>
        </header>

        @if (products.Count == 0)
        {
            <p class="ep-empty">Sản phẩm đang được cập nhật. Bạn vui lòng quay lại sau.</p>
        }
        else
        {
            <div class="ep-products">
                @foreach (var item in products)
                {
                    var available = item.BienTheSanPhams?.Where(x => x.SoLuong > 0 && x.TrangThai == "Còn hàng").OrderBy(x => x.Gia).FirstOrDefault();
                    var variant = available ?? item.BienTheSanPhams?.OrderBy(x => x.Gia).FirstOrDefault();
                    var image = ImageUrlHelper.ResolveProductImage(item, variant, checkPhysicalFile: true);
                    var price = variant?.Gia ?? item.GiaGoc ?? 0;
                    var name = string.IsNullOrWhiteSpace(item.TenSanPham) ? "Sản phẩm" : item.TenSanPham;
                    var detail = string.Join(" · ", new[] { variant?.PhienBan, variant?.MauSac }.Where(x => !string.IsNullOrWhiteSpace(x)));

                    var originalPrice = item.GiaGoc;
                    var hasDiscount = originalPrice.HasValue && originalPrice.Value > price && price > 0;
                    var discountPercent = hasDiscount ? (int)Math.Round((1m - (price / originalPrice!.Value)) * 100m) : 0;
                    var isStock = available != null && available.SoLuong > 0;

                    <article class="ep-card">
                        <a class="ep-picture" asp-area="" asp-controller="Product" asp-action="Details" asp-route-id="@item.MaSanPham" aria-label="Xem @name">
                            @if (hasDiscount)
                            {
                                <span class="ep-chip ep-chip-discount">-@discountPercent%</span>
                            }
                            else
                            {
                                <span class="ep-chip ep-chip-blue">Nổi bật</span>
                            }

                            <img src="@image" alt="@name" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/no-image.png';" />
                        </a>
                        <div class="ep-card-body">
                            <div class="ep-card-meta">
                                <span class="ep-brand">@(item.MaThuongHieuNavigation?.TenThuongHieu ?? "EMUA")</span>
                                <span class="ep-stock-status @(isStock ? "" : "ep-stock-out")">
                                    <span class="ep-stock-dot"></span>
                                    @(isStock ? "Còn hàng" : "Hết hàng")
                                </span>
                            </div>
                            <a class="ep-product-name" asp-area="" asp-controller="Product" asp-action="Details" asp-route-id="@item.MaSanPham" title="@name">@name</a>
                            <p class="ep-spec">@(string.IsNullOrWhiteSpace(detail) ? "Cấu hình chuẩn · Chính hãng" : detail)</p>
                            <div class="ep-buy">
                                <div class="ep-price-block">
                                    <div class="ep-price-row">
                                        <span class="ep-price">@(price > 0 ? price.ToString("N0", viCulture) + " ₫" : "Liên hệ")</span>
                                        @if (hasDiscount)
                                        {
                                            <span class="ep-original-price">@originalPrice!.Value.ToString("N0", viCulture) ₫</span>
                                        }
                                    </div>
                                </div>
                                <div class="ep-card-actions">
                                    @if (available != null && price > 0)
                                    {
                                        <button type="button" class="ep-btn-cart" onclick="homeAddCart(@available.MaBienThe, this)" aria-label="Thêm @name vào giỏ">
                                            <i class="bi bi-cart-plus" aria-hidden="true"></i>
                                            <span>Thêm vào giỏ</span>
                                        </button>
                                    }
                                    else if (available != null)
                                    {
                                        <a class="ep-btn-cart" asp-area="" asp-controller="Product" asp-action="Details" asp-route-id="@item.MaSanPham">
                                            <span>Chi tiết</span>
                                        </a>
                                    }
                                    else
                                    {
                                        <button type="button" class="ep-btn-cart" disabled>Hết hàng</button>
                                    }
                                    <a class="ep-btn-view" asp-area="" asp-controller="Product" asp-action="Details" asp-route-id="@item.MaSanPham" title="Chi tiết sản phẩm">
                                        <i class="bi bi-arrow-right" aria-hidden="true"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <div class="ep-section-footer text-center mt-4 pt-2">
                <a class="btn btn-outline-primary px-4 py-2 fw-semibold rounded-pill" asp-area="" asp-controller="Product" asp-action="Index" asp-route-sort="popular">
                    <span>Xem tất cả sản phẩm nổi bật</span>
                    <i class="bi bi-arrow-right ms-1" aria-hidden="true"></i>
                </a>
            </div>
        }
    </div>
</section>
