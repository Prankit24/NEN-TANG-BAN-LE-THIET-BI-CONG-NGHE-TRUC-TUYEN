@model IEnumerable<EMua.Models.Database.SanPham>
@using System.Linq
@using System.Collections.Generic
@using System
@using EMua.Helpers
@{
    var products = Model?.ToList() ?? new List<EMua.Models.Database.SanPham>();
    var viCulture = System.Globalization.CultureInfo.GetCultureInfo("vi-VN");
}

<section class="ep-section ep-tabbed-section" id="featured-products" aria-labelledby="feat-heading">
    <div class="ep-container">
        <header class="ep-heading ep-tabbed-header">
            <div class="ep-heading-left">
                <h2 id="feat-heading" class="ep-section-title">Sản phẩm nổi bật</h2>
            </div>

            <!-- TAB LỌC DẠNG SEGMENTED CONTROL TINH TẾ -->
            <div class="ep-segmented-control" role="tablist" aria-label="Lọc sản phẩm nổi bật">
                <button type="button" class="ep-segment-btn active" data-filter="all">Tất cả</button>
                <button type="button" class="ep-segment-btn" data-filter="phone">Điện thoại</button>
                <button type="button" class="ep-segment-btn" data-filter="laptop">Laptop</button>
                <button type="button" class="ep-segment-btn" data-filter="audio">Âm thanh</button>
                <button type="button" class="ep-segment-btn" data-filter="gaming">Gaming</button>
            </div>
        </header>

        @if (products.Count == 0)
        {
            <p class="ep-empty">Sản phẩm đang được cập nhật. Bạn vui lòng quay lại sau.</p>
        }
        else
        {
            <!-- GRID ĐÚNG 8 SẢN PHẨM (2 HÀNG X 4 CỘT) -->
            <div class="ep-products ep-tabbed-grid" id="epTabbedProducts">
                @foreach (var item in products.Take(8))
                {
                    var available = item.BienTheSanPhams?.Where(x => x.SoLuong > 0 && x.TrangThai == "Còn hàng").OrderBy(x => x.Gia).FirstOrDefault();
                    var variant = available ?? item.BienTheSanPhams?.OrderBy(x => x.Gia).FirstOrDefault();
                    var image = ImageUrlHelper.ResolveProductImage(item, variant, checkPhysicalFile: true);
                    var price = variant?.Gia ?? item.GiaGoc ?? 0;
                    var name = string.IsNullOrWhiteSpace(item.TenSanPham) ? "Sản phẩm" : item.TenSanPham;
                    var nameLower = name.ToLowerInvariant();

                    var categoryTag = "all";
                    if (nameLower.Contains("iphone") || nameLower.Contains("galaxy") || nameLower.Contains("xiaomi") || nameLower.Contains("điện thoại") || nameLower.Contains("phone"))
                    {
                        categoryTag = "phone";
                    }
                    else if (nameLower.Contains("macbook") || nameLower.Contains("laptop") || nameLower.Contains("thinkpad") || nameLower.Contains("dell") || nameLower.Contains("asus") || nameLower.Contains("hp") || nameLower.Contains("acer"))
                    {
                        categoryTag = "laptop";
                    }
                    else if (nameLower.Contains("sony") || nameLower.Contains("airpods") || nameLower.Contains("tai nghe") || nameLower.Contains("loa") || nameLower.Contains("wh-") || nameLower.Contains("jbl") || nameLower.Contains("marshall"))
                    {
                        categoryTag = "audio";
                    }
                    else if (nameLower.Contains("gaming") || nameLower.Contains("rog") || nameLower.Contains("razer") || nameLower.Contains("chuột") || nameLower.Contains("bàn phím") || nameLower.Contains("rtx"))
                    {
                        categoryTag = "gaming";
                    }

                    var originalPrice = item.GiaGoc;
                    var hasDiscount = originalPrice.HasValue && originalPrice.Value > price && price > 0;
                    var discountPercent = hasDiscount ? (int)Math.Round((1m - (price / originalPrice!.Value)) * 100m) : 0;

                    var ratingScore = (4.8 - ((item.MaSanPham % 3) * 0.1)).ToString("0.0");
                    var reviewCount = 24 + ((item.MaSanPham * 13) % 150);

                    <article class="ep-card ep-flagship-card" data-category="@categoryTag">
                        <a class="ep-picture" asp-area="" asp-controller="Product" asp-action="Details" asp-route-id="@item.MaSanPham" aria-label="Xem @name">
                            @if (hasDiscount)
                            {
                                <span class="ep-chip ep-chip-discount">-@discountPercent%</span>
                            }
                            <img src="@image" alt="@name" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/images/no-image.webp';" />
                        </a>
                        <div class="ep-card-body">
                            <a class="ep-product-name" asp-area="" asp-controller="Product" asp-action="Details" asp-route-id="@item.MaSanPham" title="@name">@name</a>

                            <div class="ep-buy">
                                <div class="ep-price-block">
                                    <div class="ep-price-row">
                                        <span class="ep-price">@(price > 0 ? price.ToString("N0", viCulture) + " ₫" : "Liên hệ")</span>
                                        @if (hasDiscount)
                                        {
                                            <span class="ep-original-price">@originalPrice!.Value.ToString("N0", viCulture) ₫</span>
                                        }
                                    </div>
                                </div>

                                <div class="ep-card-bottom-row">
                                    <div class="ep-stars-simple">
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <span class="ep-score">@ratingScore</span>
                                        <span class="ep-rev-count">(@reviewCount)</span>
                                    </div>

                                    @if (available != null && price > 0)
                                    {
                                        <button type="button" class="ep-quick-cart-btn" onclick="homeAddCart(@available.MaBienThe, this)" title="Thêm vào giỏ hàng" aria-label="Thêm vào giỏ">
                                            <i class="bi bi-bag-plus"></i>
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <!-- Nút điều hướng sang Cửa hàng -->
            <div class="ep-section-footer text-center mt-4 pt-2">
                <a class="ep-btn-more-products" asp-area="" asp-controller="Product" asp-action="Index">
                    <span>Xem tất cả sản phẩm</span>
                    <i class="bi bi-arrow-right ms-2" aria-hidden="true"></i>
                </a>
            </div>
        }
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const segBtns = document.querySelectorAll('.ep-segment-btn');
        const cards = document.querySelectorAll('#epTabbedProducts .ep-card');
        if (!segBtns.length || !cards.length) return;

        segBtns.forEach(btn => {
            btn.addEventListener('click', function () {
                segBtns.forEach(b => b.classList.remove('active'));
                this.classList.add('active');

                const filter = this.getAttribute('data-filter');

                cards.forEach(card => {
                    const category = card.getAttribute('data-category');
                    if (filter === 'all' || category === filter) {
                        card.style.display = 'flex';
                    } else {
                        card.style.display = 'none';
                    }
                });
            });
        });
    });
</script>
