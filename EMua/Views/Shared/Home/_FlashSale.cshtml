@model IEnumerable<EMua.Models.Database.SanPham>


<section class="emua-flash-section">

    <div class="emua-flash-container">

        <div class="emua-flash-header">

            <div class="flash-header-left">
                <div class="flash-label-pill">
                    <span class="flash-flame">🔥</span>
                    ƯU ĐÃI HÔM NAY
                </div>
                <h2>Flash Sale</h2>
            </div>

            <div class="emua-flash-time">
                <div class="flash-time-label">Kết thúc sau</div>
                <div class="flash-time-blocks">
                    <div class="flash-time-block">
                        <span id="flashHour">05</span>
                        <small>GIỜ</small>
                    </div>
                    <div class="flash-time-sep">:</div>
                    <div class="flash-time-block">
                        <span id="flashMinute">00</span>
                        <small>PHÚT</small>
                    </div>
                    <div class="flash-time-sep">:</div>
                    <div class="flash-time-block">
                        <span id="flashSecond">00</span>
                        <small>GIÂY</small>
                    </div>
                </div>
            </div>

        </div>


        <div class="emua-flash-grid">

            @foreach (var item in Model)
            {
                var variant = item.BienTheSanPhams
                .Where(x => x.SoLuong > 0)
                .OrderBy(x => x.Gia)
                .FirstOrDefault();

                var photo = item.SanPhamHinhAnhs
                .OrderByDescending(x => x.LaAnhChinh)
                .ThenBy(x => x.ThuTu)
                .FirstOrDefault();

                var image =
                photo?.DuongDanAnh
                ?? variant?.HinhAnh
                ?? "/images/no-image.png";

                var price =
                variant?.Gia
                ?? item.GiaGoc
                ?? 0;

                <article class="emua-flash-card">

                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.MaSanPham" class="emua-flash-image">

                        <span class="flash-badge">SALE</span>

                        <img src="@image" alt="@item.TenSanPham" loading="lazy" />

                    </a>


                    <div class="emua-flash-body">

                        <div class="flash-brand">
                            @(item.MaThuongHieuNavigation?.TenThuongHieu ?? "EMUA")
                        </div>

                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.MaSanPham" class="flash-name">
                            @item.TenSanPham
                        </a>

                        <div class="flash-variant">
                            @if (!string.IsNullOrWhiteSpace(variant?.PhienBan))
                            {
                                <span>@variant.PhienBan</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(variant?.MauSac))
                            {
                                <span>@variant.MauSac</span>
                            }
                        </div>

                        <div class="flash-price-row">
                            <div class="flash-price">@price.ToString("N0")₫</div>
                        </div>


                        @if (variant != null)
                        {
                            <button type="button"
                                    class="flash-cart"
                                    onclick="homeAddCart(@variant.MaBienThe)">
                                <i class="bi bi-cart-plus"></i>
                                Thêm vào giỏ
                            </button>
                        }

                    </div>

                </article>
            }

        </div>

    </div>

</section>


<style>

    .emua-flash-section {
        padding: 80px 0;
        background:
            radial-gradient(ellipse 60% 40% at 100% 0%, rgba(239,68,68,.05), transparent 50%),
            linear-gradient(180deg, #fafbff, #f4f5fb);
        position: relative;
    }

    .emua-flash-container {
        width: min(1400px, 92%);
        margin: auto;
    }


    /* Header */
    .emua-flash-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        margin-bottom: 36px;
    }

    .flash-label-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 5px 14px;
        border-radius: 999px;
        background: linear-gradient(135deg, rgba(239,68,68,.1), rgba(249,115,22,.08));
        border: 1px solid rgba(239,68,68,.2);
        color: #dc2626;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 2px;
        margin-bottom: 10px;
    }

    .flash-header-left h2 {
        margin: 0;
        font-size: clamp(26px, 3vw, 34px);
        font-weight: 900;
        color: #0f172a;
        letter-spacing: -0.8px;
    }


    /* Countdown */
    .emua-flash-time {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 8px;
    }

    .flash-time-label {
        color: #94a3b8;
        font-size: 11.5px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .flash-time-blocks {
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .flash-time-block {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 2px;
    }

    .flash-time-block span {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 52px;
        padding: 10px 8px;
        border-radius: 12px;
        color: #fff;
        font-size: 20px;
        font-weight: 800;
        background: linear-gradient(135deg, #0f172a, #1e293b);
        border: 1px solid rgba(255,255,255,0.05);
        font-variant-numeric: tabular-nums;
        box-shadow: 0 4px 16px rgba(0,0,0,0.2);
    }

    .flash-time-block small {
        color: #94a3b8;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: 1px;
    }

    .flash-time-sep {
        color: #0f172a;
        font-size: 22px;
        font-weight: 900;
        padding-bottom: 14px;
    }


    /* Grid */
    .emua-flash-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 20px;
    }


    /* Card */
    .emua-flash-card {
        min-width: 0;
        overflow: hidden;
        border-radius: 20px;
        border: 1px solid rgba(0,0,0,0.05);
        background: #fff;
        box-shadow: 0 2px 12px rgba(15,23,42,0.05);
        transition: transform 0.3s cubic-bezier(0.34,1.56,0.64,1),
                    box-shadow 0.3s ease;
    }

    .emua-flash-card:hover {
        transform: translateY(-6px);
        box-shadow: 0 20px 52px rgba(15,23,42,0.12);
    }


    /* Image area */
    .emua-flash-image {
        position: relative;
        display: block;
        height: 220px;
        padding: 24px;
        overflow: hidden;
        background: linear-gradient(145deg, #f8f9fd, #f1f2f9);
        text-decoration: none;
    }

    .emua-flash-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: contain;
        transition: transform 0.4s cubic-bezier(0.25,1,0.5,1);
    }

    .emua-flash-card:hover .emua-flash-image img {
        transform: scale(1.08);
    }


    /* Badge */
    .flash-badge {
        position: absolute;
        top: 14px; left: 14px;
        z-index: 2;
        padding: 5px 10px;
        border-radius: 8px;
        color: #fff;
        background: linear-gradient(135deg, #ef4444, #f97316);
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        box-shadow: 0 4px 12px rgba(239,68,68,0.4);
    }


    /* Body */
    .emua-flash-body { padding: 16px 18px 18px; }

    .flash-brand {
        margin-bottom: 4px;
        color: #94a3b8;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 1.5px;
        text-transform: uppercase;
    }

    .flash-name {
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
        overflow: hidden;
        font-size: 14px;
        font-weight: 700;
        color: #0f172a;
        text-decoration: none;
        line-height: 1.45;
        min-height: 40px;
        margin-bottom: 8px;
        transition: color 0.15s;
    }

    .flash-name:hover { color: #2563eb; }

    .flash-variant {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        min-height: 24px;
        margin-bottom: 10px;
    }

    .flash-variant span {
        padding: 3px 8px;
        border-radius: 6px;
        color: #64748b;
        background: #f1f5f9;
        font-size: 10.5px;
        font-weight: 500;
    }

    .flash-price-row {
        display: flex;
        align-items: baseline;
        gap: 8px;
        margin-bottom: 14px;
    }

    .flash-price {
        color: #ef4444;
        font-size: 20px;
        font-weight: 800;
        letter-spacing: -0.5px;
    }

    .flash-cart {
        width: 100%;
        min-height: 44px;
        border: 0;
        border-radius: 12px;
        color: white;
        cursor: pointer;
        font-size: 13.5px;
        font-weight: 700;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        background: linear-gradient(135deg, #2563eb, #7c3aed);
        box-shadow: 0 4px 16px rgba(37,99,235,0.3);
        transition: all 0.2s ease;
    }

    .flash-cart:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 28px rgba(37,99,235,0.45);
    }


    @@media (max-width: 1100px) {
        .emua-flash-grid { grid-template-columns: repeat(3, 1fr); }
    }

    @@media (max-width: 800px) {
        .emua-flash-header { flex-direction: column; align-items: flex-start; }
        .emua-flash-time { align-items: flex-start; }
        .emua-flash-grid { grid-template-columns: repeat(2, 1fr); gap: 14px; }
        .emua-flash-image { height: 175px; }
    }

    @@media (max-width: 480px) {
        .emua-flash-image { height: 155px; padding: 16px; }
        .emua-flash-body { padding: 12px 14px 14px; }
    }

</style>


<script>

    (() => {

        const hour = document.getElementById('flashHour');
        const minute = document.getElementById('flashMinute');
        const second = document.getElementById('flashSecond');

        if (!hour || !minute || !second) return;

        let remain = 5 * 60 * 60;

        function tick() {
            remain--;
            if (remain < 0) remain = 5 * 60 * 60;
            const h = Math.floor(remain / 3600);
            const m = Math.floor((remain % 3600) / 60);
            const s = remain % 60;
            hour.textContent = String(h).padStart(2, '0');
            minute.textContent = String(m).padStart(2, '0');
            second.textContent = String(s).padStart(2, '0');
        }

        setInterval(tick, 1000);

    })();

</script>
