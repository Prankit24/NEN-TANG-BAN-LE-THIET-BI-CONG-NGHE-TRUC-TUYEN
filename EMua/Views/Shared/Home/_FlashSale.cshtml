@model IEnumerable<EMua.Models.Database.SanPham>


<section class="emua-flash-section">

    <div class="emua-flash-container">

        <div class="emua-flash-header">

            <div>

                <span>
                    ƯU ĐÃI HÔM NAY
                </span>

                <h2>
                    🔥 Flash Sale
                </h2>

            </div>


            <div class="emua-flash-time">

                <small>
                    Kết thúc sau
                </small>

                <strong id="flashHour">
                    05
                </strong>

                <b>:</b>

                <strong id="flashMinute">
                    00
                </strong>

                <b>:</b>

                <strong id="flashSecond">
                    00
                </strong>

            </div>

        </div>


        <div class="emua-flash-grid">

            @foreach (var item in Model)
            {
                var variant = item.BienTheSanPhams
                .Where(x => x.SoLuong > 0)
                .OrderBy(x => x.Gia)
                .FirstOrDefault();


                var photo = item.SanPhamHinhAnhs
                .OrderByDescending(x => x.LaAnhChinh)
                .ThenBy(x => x.ThuTu)
                .FirstOrDefault();


                var image =
                photo?.DuongDanAnh
                ?? variant?.HinhAnh
                ?? "/images/no-image.png";


                var price =
                variant?.Gia
                ?? item.GiaGoc
                ?? 0;


                <article class="emua-flash-card">

                    <div class="emua-flash-image">

                        <span class="flash-badge">
                            SALE
                        </span>

                        <img src="@image"
                             alt="@item.TenSanPham" />

                    </div>


                    <div class="emua-flash-body">

                        <div class="flash-brand">

                            @(item.MaThuongHieuNavigation?.TenThuongHieu
                                                    ?? "EMUA")

                    </div>


                        <h3>
                            @item.TenSanPham
                        </h3>


                        <div class="flash-variant">

                        @if (!string.IsNullOrWhiteSpace(variant?.PhienBan))
                            {
                                <span>
                                    @variant.PhienBan
                                </span>
                            }

                            @if (!string.IsNullOrWhiteSpace(variant?.MauSac))
                            {
                                <span>
                                    @variant.MauSac
                                </span>
                            }

                        </div>


                        <div class="flash-price">

                            @price.ToString("N0")₫

                        </div>


                        @if (variant != null)
                        {
                            <button type="button"
                                    class="flash-cart"
                                    onclick="homeAddCart(@variant.MaBienThe)">

                                <i class="bi bi-cart-plus"></i>

                                Thêm vào giỏ

                            </button>
                        }

                    </div>

                </article>
            }

        </div>

    </div>

</section>


<style>

    .emua-flash-section {
        padding: 70px 0;
        background: radial-gradient( circle at 90% 15%, rgba(229,72,93,.06), transparent 25% ), linear-gradient( 180deg, #faf9fe, #f5f4fa );
    }


    .emua-flash-container {
        width: min(1400px,92%);
        margin: auto;
    }


    .emua-flash-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 28px;
    }


        .emua-flash-header > div:first-child > span {
            display: block;
            margin-bottom: 7px;
            color: #e5485d;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 3px;
        }


        .emua-flash-header h2 {
            margin: 0;
            color: #17172a;
            font-size: 30px;
            font-weight: 730;
        }


    .emua-flash-time {
        display: flex;
        align-items: center;
        gap: 6px;
    }


        .emua-flash-time small {
            margin-right: 4px;
            color: #747487;
        }


        .emua-flash-time strong {
            min-width: 40px;
            padding: 9px 8px;
            border-radius: 9px;
            text-align: center;
            color: #fff;
            background: linear-gradient( 135deg, #4d4a8d, #625db1 );
        }


    .emua-flash-grid {
        display: grid;
        grid-template-columns: repeat(4,minmax(0,1fr));
        gap: 18px;
    }


    .emua-flash-card {
        min-width: 0;
        overflow: hidden;
        border-radius: 19px;
        border: 1px solid rgba(77,74,141,.09);
        background: #fff;
        box-shadow: 0 5px 20px rgba(45,42,93,.045);
        transition: .3s;
    }


        .emua-flash-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 18px 45px rgba(68,63,133,.14);
        }


    .emua-flash-image {
        position: relative;
        height: 235px;
        padding: 22px;
        overflow: hidden;
        background: linear-gradient( 145deg, #fbfbfd, #f1f1f6 );
    }


        .emua-flash-image img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: contain;
            transition: .35s;
        }


    .emua-flash-card:hover
    .emua-flash-image img {
        transform: scale(1.06);
    }


    .flash-badge {
        position: absolute;
        top: 13px;
        left: 13px;
        z-index: 2;
        padding: 6px 10px;
        border-radius: 7px;
        color: #fff;
        background: linear-gradient( 135deg, #e5485d, #f06474 );
        font-size: 10px;
        font-weight: 800;
    }


    .emua-flash-body {
        padding: 17px;
    }


    .flash-brand {
        margin-bottom: 5px;
        color: #9595a6;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
    }


    .emua-flash-body h3 {
        min-height: 44px;
        margin: 0 0 9px;
        color: #202030;
        font-size: 15px;
        line-height: 1.45;
    }


    .flash-variant {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        min-height: 26px;
        margin-bottom: 8px;
    }


        .flash-variant span {
            padding: 4px 7px;
            border-radius: 6px;
            color: #6f7080;
            background: #f1f1f6;
            font-size: 10px;
        }


    .flash-price {
        margin-bottom: 14px;
        color: #d83d55;
        font-size: 19px;
        font-weight: 760;
    }


    .flash-cart {
        width: 100%;
        min-height: 42px;
        border: 0;
        border-radius: 9px;
        color: white;
        cursor: pointer;
        background: linear-gradient( 135deg, #4d4a8d, #625db1 );
        transition: .25s;
    }


        .flash-cart:hover {
            transform: translateY(-2px);
            background: linear-gradient( 135deg, #5d58a6, #716ad0 );
        }


    @@media(max-width:1050px) {

        .emua-flash-grid {
            grid-template-columns: repeat(3,1fr);
        }
    }


    @@media(max-width:750px) {

        .emua-flash-header {
            align-items: flex-start;
            flex-direction: column;
        }


        .emua-flash-grid {
            grid-template-columns: repeat(2,1fr);
        }


        .emua-flash-image {
            height: 180px;
        }
    }

</style>


<script>

    (() => {

        const hour =
            document.getElementById('flashHour');

        const minute =
            document.getElementById('flashMinute');

        const second =
            document.getElementById('flashSecond');


        if (!hour || !minute || !second)
            return;


        let remain =
            5 * 60 * 60;


        setInterval(() => {

            remain--;


            if (remain < 0)
                remain =
                    5 * 60 * 60;


            const h =
                Math.floor(remain / 3600);


            const m =
                Math.floor(
                    (remain % 3600) / 60
                );


            const s =
                remain % 60;


            hour.textContent =
                String(h).padStart(2,'0');


            minute.textContent =
                String(m).padStart(2,'0');


            second.textContent =
                String(s).padStart(2,'0');

        },1000);

    })();

</script>