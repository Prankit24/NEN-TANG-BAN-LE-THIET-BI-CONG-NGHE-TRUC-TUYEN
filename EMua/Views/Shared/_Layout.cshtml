<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EMUA</title>

    <!-- Biểu tượng trên tab trình duyệt -->
    
    <link rel="icon"
          type="image/png"
          href="~/images/logo/chicken.png"
          asp-append-version="true" />

    <link rel="apple-touch-icon"
          href="~/images/logo/chicken.png"
          asp-append-version="true" />

    <!-- Google Fonts -->
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap"
          rel="stylesheet" />

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- CSS chung -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/home/header.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/home/footer.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/ai-chat.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/home/categories.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />

    <style>
        .emua-floating-cart[hidden] {
            display: none !important;
        }
    </style>
</head>

<body>
    <div style="display:none">
        @Html.AntiForgeryToken()
    </div>

    <!-- Header -->
    <partial name="_Header" />

    <!-- Nội dung trang -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- Footer -->
    <partial name="_Footer" />

    <!-- AI Chat -->
    <partial name="_AIChat" />

    <!-- Giỏ hàng nổi -->
    <a href="@(User.Identity?.IsAuthenticated == true
                       ? "/Cart"
                       : "/Auth/Login?returnUrl=%2FCart")"
       id="emuaFloatingCart"
       class="emua-floating-cart"
       hidden
       aria-label="Giỏ hàng"
       title="Giỏ hàng">

        <i class="bi bi-cart3" aria-hidden="true"></i>
        <span class="cart-count floating-cart-count">0</span>
    </a>

    <!-- Thư viện JavaScript -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Giỏ hàng dùng chung -->
    <script>
        window.EMUA_IS_AUTHENTICATED =
            @(User.Identity?.IsAuthenticated == true ? "true" : "false");

        window.EMUA_GUEST_CART_KEY = 'emuaGuestCart';

        window.getGuestCart = function () {
            try {
                const raw = localStorage.getItem(
                    window.EMUA_GUEST_CART_KEY
                );

                const parsed = raw ? JSON.parse(raw) : [];

                return Array.isArray(parsed) ? parsed : [];
            } catch {
                return [];
            }
        };

        window.saveGuestCart = function (items) {
            localStorage.setItem(
                window.EMUA_GUEST_CART_KEY,
                JSON.stringify(items || [])
            );

            if (
                !window.EMUA_IS_AUTHENTICATED &&
                typeof window.setGlobalCartCount === 'function'
            ) {
                window.setGlobalCartCount(
                    window.getGuestCartCount(),
                    false
                );
            }
        };

        window.getGuestCartCount = function () {
            return window.getGuestCart().reduce(function (sum, item) {
                return sum + (Number.parseInt(item.quantity, 10) || 0);
            }, 0);
        };

        window.addToGuestCart = function (variantId, quantity = 1) {
            variantId = Number.parseInt(variantId, 10);
            quantity = Number.parseInt(quantity, 10) || 1;

            if (!variantId || quantity <= 0) return 0;

            const items = window.getGuestCart();

            const existing = items.find(function (item) {
                return Number.parseInt(item.variantId, 10) === variantId;
            });

            if (existing) {
                existing.quantity =
                    (Number.parseInt(existing.quantity, 10) || 0) +
                    quantity;
            } else {
                items.push({
                    variantId: variantId,
                    quantity: quantity
                });
            }

            window.saveGuestCart(items);

            const count = window.getGuestCartCount();

            window.setGlobalCartCount(count, true);

            return count;
        };

        window.getLoginUrl = function (returnUrl) {
            return '/Auth/Login?returnUrl=' +
                encodeURIComponent(returnUrl || '/Cart');
        };

        window.setGlobalCartCount = function (count, animate = false) {
            count = Math.max(
                0,
                Number.parseInt(count, 10) || 0
            );

            document.querySelectorAll('.cart-count')
                .forEach(function (badge) {
                    badge.textContent = count;
                    badge.style.display = count > 0 ? 'flex' : 'none';
                });

            const floatingCart = document.getElementById(
                'emuaFloatingCart'
            );

            if (floatingCart) {
                floatingCart.hidden = count === 0;
            }

            if (
                animate &&
                count > 0 &&
                typeof window.showCartAddedFeedback === 'function'
            ) {
                window.showCartAddedFeedback();
            }
        };

        window.showCartAddedFeedback = function () {
            document.querySelectorAll(
                '.cart-action, .emua-floating-cart'
            ).forEach(function (cartAction) {
                cartAction.classList.remove('cart-added-feedback');

                void cartAction.offsetWidth;

                cartAction.classList.add('cart-added-feedback');

                setTimeout(function () {
                    cartAction.classList.remove('cart-added-feedback');
                }, 850);
            });
        };

        async function syncCartCountFromServer() {
            if (!window.EMUA_IS_AUTHENTICATED) {
                window.setGlobalCartCount(
                    window.getGuestCartCount(),
                    false
                );

                return;
            }

            try {
                const response = await fetch('/Cart/Summary', {
                    method: 'GET',
                    headers: {
                        'Accept': 'application/json'
                    },
                    cache: 'no-store'
                });

                if (!response.ok) return;

                const result = await response.json();

                if (result && result.count !== undefined) {
                    window.setGlobalCartCount(result.count, false);
                }
            } catch (error) {
                console.debug(
                    'Không thể đồng bộ số lượng giỏ hàng.',
                    error
                );
            }
        }

        async function mergeGuestCartAfterLogin() {
            if (!window.EMUA_IS_AUTHENTICATED) return false;

            const guestItems = window.getGuestCart();

            if (!guestItems.length) return false;

            const tokenInput = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );

            if (!tokenInput) return false;

            try {
                const response = await fetch('/Cart/MergeGuest', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenInput.value,
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(guestItems)
                });

                if (!response.ok) return false;

                const result = await response.json();

                window.saveGuestCart([]);

                window.setGlobalCartCount(
                    result?.count ?? 0,
                    false
                );

                return true;
            } catch (error) {
                console.debug(
                    'Không thể gộp giỏ hàng khách.',
                    error
                );

                return false;
            }
        }

        window.emuaBuyNow = function (variantId, quantity = 1) {
            if (!window.EMUA_IS_AUTHENTICATED) {
                window.addToGuestCart(variantId, quantity);

                window.location.href = window.getLoginUrl('/Cart');

                return;
            }

            const tokenInput = document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );

            if (!tokenInput) {
                window.location.href = '/Cart';
                return;
            }

            fetch('/Cart/Add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': tokenInput.value
                },
                body: JSON.stringify({
                    variantId: variantId,
                    quantity: quantity
                })
            }).then(function (response) {
                if (response.ok) {
                    window.location.href = '/Cart';
                }
            });
        };

        document.addEventListener(
            'DOMContentLoaded',
            async function () {
                if (window.EMUA_IS_AUTHENTICATED) {
                    const merged = await mergeGuestCartAfterLogin();

                    if (
                        merged &&
                        window.location.pathname.toLowerCase() === '/cart'
                    ) {
                        window.location.reload();
                        return;
                    }
                }

                await syncCartCountFromServer();
            }
        );
    </script>

    <!-- JavaScript của website -->
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <script src="~/js/ai-chat.js"
            asp-append-version="true"></script>

    <!-- JavaScript riêng của từng view -->
    @await RenderSectionAsync("Scripts", required: false)
</body>

</html>