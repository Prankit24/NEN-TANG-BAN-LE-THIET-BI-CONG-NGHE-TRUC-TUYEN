<!DOCTYPE html>
<html lang="vi">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EMUA</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- CSS chung -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/header.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/footer.css"
          asp-append-version="true" />

    <!-- AI -->
    <link rel="stylesheet"
          href="~/css/ai-chat.css"
          asp-append-version="true" />

    <!-- HOME -->
    <link rel="stylesheet"
          href="~/css/home/categories.css"
          asp-append-version="true" />

    <!-- AUTH -->
    <link rel="stylesheet"
          href="~/css/auth.css"
          asp-append-version="true" />
</head>

<body>

    <div style="display:none">@Html.AntiForgeryToken()</div>

    <!-- HEADER -->
    <partial name="_Header" />


    <!-- PAGE CONTENT -->
    <main class="main-content">

        @RenderBody()

    </main>


    <!-- FOOTER -->
    <partial name="_Footer" />


    <!-- AI CHAT: CHỈ GỌI 1 LẦN -->
    <partial name="_AIChat" />

    <!-- GIỎ HÀNG NỔI: luôn nhìn thấy khi cuộn trang -->
    <a href="@(User.Identity?.IsAuthenticated == true ? "/Cart" : "/Auth/Login?returnUrl=%2FCart")"
       id="emuaFloatingCart"
       class="emua-floating-cart"
       aria-label="Giỏ hàng"
       title="Giỏ hàng">
        <i class="bi bi-cart3"></i>
        <span class="cart-count floating-cart-count">0</span>
    </a>


    <!-- LIBRARY -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>


    <!-- SITE JS -->
    <script src="~/js/site.js"
            asp-append-version="true"></script>


    <!-- AI JS: CHỈ LOAD 1 LẦN -->
    <script src="~/js/ai-chat.js"
            asp-append-version="true"></script>


    <!-- JS RIÊNG CỦA TỪNG VIEW -->
    @await RenderSectionAsync("Scripts", required: false)


    <script>
        window.EMUA_IS_AUTHENTICATED = @(User.Identity?.IsAuthenticated == true ? "true" : "false");
        window.EMUA_GUEST_CART_KEY = 'emuaGuestCart';

        window.getGuestCart = function () {
            try {
                const raw = localStorage.getItem(window.EMUA_GUEST_CART_KEY);
                const parsed = raw ? JSON.parse(raw) : [];
                return Array.isArray(parsed) ? parsed : [];
            } catch {
                return [];
            }
        };

        window.saveGuestCart = function (items) {
            localStorage.setItem(window.EMUA_GUEST_CART_KEY, JSON.stringify(items || []));
        };

        window.getGuestCartCount = function () {
            return window.getGuestCart().reduce(function (sum, item) {
                return sum + (Number.parseInt(item.quantity) || 0);
            }, 0);
        };

        window.addToGuestCart = function (variantId, quantity = 1) {
            variantId = Number.parseInt(variantId);
            quantity = Number.parseInt(quantity) || 1;

            if (!variantId || quantity <= 0) return 0;

            const items = window.getGuestCart();
            const existing = items.find(x => Number.parseInt(x.variantId) === variantId);

            if (existing) {
                existing.quantity = (Number.parseInt(existing.quantity) || 0) + quantity;
            } else {
                items.push({ variantId: variantId, quantity: quantity });
            }

            window.saveGuestCart(items);
            const count = window.getGuestCartCount();
            window.setGlobalCartCount(count, true);
            return count;
        };

        window.getLoginUrl = function (returnUrl) {
            return '/Auth/Login?returnUrl=' + encodeURIComponent(returnUrl || '/Cart');
        };

        // Chỉ đồng bộ badge của icon giỏ hàng trên header.
        // Không tạo thêm icon giỏ nổi ở góc phải dưới.
        window.setGlobalCartCount = function (count, animate = false) {
            count = Number.parseInt(count) || 0;

            document.querySelectorAll('.cart-count').forEach(function (badge) {
                badge.textContent = count;
                badge.style.display = count > 0 ? 'flex' : 'none';
            });

            if (animate && typeof window.showCartAddedFeedback === 'function') {
                window.showCartAddedFeedback();
            }
        };

        window.showCartAddedFeedback = function () {
            document.querySelectorAll('.cart-action, .emua-floating-cart').forEach(function (cartAction) {
                cartAction.classList.remove('cart-added-feedback');
                void cartAction.offsetWidth;
                cartAction.classList.add('cart-added-feedback');
                setTimeout(() => cartAction.classList.remove('cart-added-feedback'), 850);
            });
        };

        async function syncCartCountFromServer() {
            if (!window.EMUA_IS_AUTHENTICATED) {
                window.setGlobalCartCount(window.getGuestCartCount(), false);
                return;
            }

            try {
                const response = await fetch('/Cart/Summary', {
                    method: 'GET',
                    headers: { 'Accept': 'application/json' },
                    cache: 'no-store'
                });

                if (!response.ok) return;
                const result = await response.json();
                if (result && result.count !== undefined) {
                    window.setGlobalCartCount(result.count, false);
                }
            } catch (error) {
                console.debug('Không thể đồng bộ số lượng giỏ hàng.', error);
            }
        }

        async function mergeGuestCartAfterLogin() {
            if (!window.EMUA_IS_AUTHENTICATED) return false;

            const guestItems = window.getGuestCart();
            if (!guestItems.length) return false;

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!tokenInput) return false;

            try {
                const response = await fetch('/Cart/MergeGuest', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': tokenInput.value,
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify(guestItems)
                });

                if (!response.ok) return false;

                const result = await response.json();
                window.saveGuestCart([]);
                window.setGlobalCartCount(result?.count ?? 0, false);
                return true;
            } catch (error) {
                console.debug('Không thể gộp giỏ hàng khách.', error);
                return false;
            }
        }

        // Dùng cho nút "Mua ngay": khách chưa đăng nhập -> giữ sản phẩm tạm,
        // sang đăng nhập, sau đó đi thẳng tới giỏ hàng để mua.
        window.emuaBuyNow = function (variantId, quantity = 1) {
            if (!window.EMUA_IS_AUTHENTICATED) {
                window.addToGuestCart(variantId, quantity);
                window.location.href = window.getLoginUrl('/Cart');
                return;
            }

            const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
            if (!tokenInput) {
                window.location.href = '/Cart';
                return;
            }

            fetch('/Cart/Add', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': tokenInput.value
                },
                body: JSON.stringify({ variantId: variantId, quantity: quantity })
            }).then(r => {
                if (r.ok) window.location.href = '/Cart';
            });
        };

        document.addEventListener('DOMContentLoaded', async function () {
            if (window.EMUA_IS_AUTHENTICATED) {
                const merged = await mergeGuestCartAfterLogin();
                if (merged && window.location.pathname.toLowerCase() === '/cart') {
                    window.location.reload();
                    return;
                }
            }
            await syncCartCountFromServer();
        });
    </script>
</body>

</html>