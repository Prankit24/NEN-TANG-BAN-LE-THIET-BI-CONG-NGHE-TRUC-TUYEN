@model EMua.ViewModels.ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Name;

    string FixImageUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return "/images/no-image.png";

        url = url.Trim().Replace("\\", "/");

        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return url;
        }

        if (!url.StartsWith("/"))
        {
            url = "/" + url;
        }

        return url;
    }
}

<link rel="stylesheet" href="~/css/customer/product.css" asp-append-version="true" />

<div class="customer-page container py-4">
    <a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Tất cả sản phẩm</a>

    @if (TempData["Error"] != null)
    {
        <div class="customer-alert error">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="customer-alert success">@TempData["Success"]</div>
    }

    <div class="product-detail">
        <div class="detail-gallery">
            <div class="detail-main-image">
                <img id="mainProductImg"
                     src="@FixImageUrl(Model.ImageUrl)"
                     alt="@Model.Name"
                     onerror="this.onerror=null; this.src='/images/no-image.png';" />
            </div>

            <!-- THƯ VIỆN NHIỀU ẢNH THU NHỎ (THUMBNAILS) -->
            @if (Model.ImageUrls != null && Model.ImageUrls.Count > 1)
            {
                <div class="detail-thumbnails d-flex gap-2 mt-3 overflow-auto">
                    @foreach (var imgPath in Model.ImageUrls)
                    {
                        var fullUrl = FixImageUrl(imgPath);
                        <div class="thumb-item border rounded p-1"
                             style="width: 65px; height: 65px; cursor: pointer; flex-shrink: 0;"
                             onclick="changeMainImage('@fullUrl', this)">
                            <img src="@fullUrl" alt="Thumbnail" class="w-100 h-100" style="object-fit: contain;" />
                        </div>
                    }
                </div>
            }
        </div>

        <div class="detail-copy">
            <span class="eyebrow">@Model.Brand · @Model.Category</span>
            <h1>@Model.Name</h1>
            <div class="rating">
                @Model.AverageRating.ToString("0.0") <span>★★★★★</span>
                <small>(@Model.Reviews.Count đánh giá)</small>
            </div>

            <div class="detail-price" id="displayPrice">@Model.Price.ToString("N0") đ</div>
            <p>@Model.Description</p>

            <form asp-controller="Cart" asp-action="Add" method="post" class="buy-box">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <input type="hidden" name="productId" value="@Model.ProductId" />

                <label>
                    Phiên bản
                    <select name="variantId" id="variantSelect" required onchange="onVariantChange(this)">
                        @foreach (var variant in Model.Variants)
                        {
                            <option value="@variant.VariantId"
                                    data-price="@variant.Price"
                                    data-image="@FixImageUrl(variant.ImageUrl)"
                                    disabled="@(variant.Stock == 0)">
                                @variant.Label - @variant.Price.ToString("N0") đ · @(variant.Stock > 0 ? $"còn {variant.Stock}" : "Hết hàng")
                            </option>
                        }
                    </select>
                </label>

                <label>
                    Số lượng
                    <input name="quantity" type="number" min="1" max="@Math.Max(1, Model.Stock)" value="1" />
                </label>

                <button class="customer-button" type="submit" disabled="@(Model.Stock == 0)">
                    <i class="bi bi-bag-plus"></i> Thêm vào giỏ hàng
                </button>
                <button class="customer-button customer-button-buy" type="submit" name="buyNow" value="true" disabled="@(Model.Stock == 0)">
                    <i class="bi bi-lightning-charge"></i> Mua ngay
                </button>
            </form>

            <form asp-controller="Product" asp-action="Favorite" method="post" class="detail-favorite">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.ProductId" />
                <button class="customer-button customer-button-light" type="submit">
                    <i class="bi bi-heart"></i> Yêu thích
                </button>
            </form>

            <dl class="detail-specs">
                <dt>Bảo hành</dt>
                <dd>@(Model.Warranty ?? "Đang cập nhật")</dd>
                <dt>Thông số kỹ thuật</dt>
                <dd>@(Model.Specifications ?? "Đang cập nhật")</dd>
            </dl>
        </div>
    </div>

    <section class="reviews-section">
        <div class="section-heading">
            <div>
                <span class="eyebrow">CUSTOMER VOICE</span>
                <h2>Đánh giá sản phẩm</h2>
            </div>
        </div>

        @if (Model.Reviews.Count == 0)
        {
            <p class="muted">Chưa có đánh giá cho sản phẩm này.</p>
        }
        else
        {
            foreach (var review in Model.Reviews)
            {
                <article class="review-item">
                    <div>
                        <strong>@review.CustomerName</strong>
                        <span class="review-stars">@("★".PadRight(review.Rating, '★'))</span>
                    </div>
                    <p>@review.Comment</p>
                    <small>@review.CreatedAt?.ToString("dd/MM/yyyy")</small>
                </article>
            }
        }
    </section>
</div>

<script>
    function changeMainImage(src, element) {
        document.getElementById('mainProductImg').src = src;
        if (element) {
            document.querySelectorAll('.thumb-item').forEach(el => el.classList.remove('border-primary'));
            element.classList.add('border-primary');
        }
    }

    function onVariantChange(selectEl) {
        const selectedOption = selectEl.options[selectEl.selectedIndex];
        const price = selectedOption.getAttribute('data-price');
        const img = selectedOption.getAttribute('data-image');

        if (price) {
            document.getElementById('displayPrice').innerText = Number(price).toLocaleString('vi-VN') + ' đ';
        }
        if (img && img !== '/images/no-image.png') {
            changeMainImage(img, null);
        }
    }
</script>