@model EMua.ViewModels.ProductDetailsViewModel
@{
    ViewData["Title"] = Model.Name;

    string FixImageUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return "/images/no-image.png";

        url = url.Trim().Replace("\\", "/");

        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
        {
            return url;
        }

        if (!url.StartsWith("/"))
        {
            url = "/" + url;
        }

        return url;
    }
}

<link rel="stylesheet" href="~/css/customer/product.css" asp-append-version="true" />

<div class="customer-page container py-4">
    <a class="back-link" asp-action="Index"><i class="bi bi-arrow-left"></i> Tất cả sản phẩm</a>

    @if (TempData["Error"] != null)
    {
        <div class="customer-alert error">@TempData["Error"]</div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="customer-alert success">@TempData["Success"]</div>
    }

    <div class="product-detail">

        @{
            var galleryImages = new List<string>();

            if (Model.ImageUrls != null)
            {
                foreach (var path in Model.ImageUrls)
                {
                    var url = FixImageUrl(path);
                    if (url != "/images/no-image.png" &&
                    !galleryImages.Contains(url, StringComparer.OrdinalIgnoreCase))
                    {
                        galleryImages.Add(url);
                    }
                }
            }

            var mainImageUrl = FixImageUrl(Model.ImageUrl);

            if (mainImageUrl != "/images/no-image.png" &&
            !galleryImages.Contains(mainImageUrl, StringComparer.OrdinalIgnoreCase))
            {
                galleryImages.Insert(0, mainImageUrl);
            }

            // Bao gồm ảnh của các phiên bản để không phải thêm thumbnail bằng JavaScript.
            foreach (var variantImage in Model.Variants)
            {
                var variantUrl = FixImageUrl(variantImage.ImageUrl);
                if (variantUrl != "/images/no-image.png" &&
                !galleryImages.Contains(variantUrl, StringComparer.OrdinalIgnoreCase))
                {
                    galleryImages.Add(variantUrl);
                }
            }

            if (galleryImages.Count == 0)
            {
                galleryImages.Add("/images/no-image.png");
            }
        }

        <div class="detail-gallery" id="productGallery">

            <div class="detail-main-image product-gallery-main">

                <img id="mainProductImg"
                     src="@galleryImages[0]"
                     alt="@Model.Name"
                     loading="eager"
                     fetchpriority="high"
                     decoding="async"
                     width="600" height="600"
                     onerror="this.onerror=null;this.src='/images/no-image.png';" />

                @if (galleryImages.Count > 1)
                {
                    <button type="button"
                            class="gallery-arrow gallery-prev"
                            onclick="moveGallery(-1)"
                            aria-label="Ảnh trước">
                        <i class="bi bi-chevron-left"></i>
                    </button>

                    <button type="button"
                            class="gallery-arrow gallery-next"
                            onclick="moveGallery(1)"
                            aria-label="Ảnh tiếp theo">
                        <i class="bi bi-chevron-right"></i>
                    </button>

                    <div class="gallery-counter">
                        <span id="galleryCurrent">1</span> / @galleryImages.Count
                    </div>
                }
            </div>

            @if (galleryImages.Count > 1)
            {
                <div class="detail-thumbnails product-gallery-thumbs"
                     id="galleryThumbnails">

                    @for (int i = 0; i < galleryImages.Count; i++)
                    {
                        <button type="button"
                                class="thumb-item @(i == 0 ? "active" : "")"
                                data-index="@i"
                                aria-label="Xem ảnh @(i + 1)">

                            <img src="@galleryImages[i]"
                                 alt="@Model.Name - ảnh @(i + 1)"
                                 loading="lazy"
                                 onerror="this.onerror=null;this.src='/images/no-image.png';" />
                        </button>
                    }
                </div>
            }
        </div>


        <div class="detail-copy">
            <span class="eyebrow">@Model.Brand · @Model.Category</span>
            <h1>@Model.Name</h1>
            <div class="rating">
                @Model.AverageRating.ToString("0.0") <span>★★★★★</span>
                <small>(@Model.Reviews.Count đánh giá)</small>
            </div>

            <div class="detail-price" id="displayPrice">@Model.Price.ToString("N0") đ</div>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="emua-description">
                    <p id="productDescription"
                       class="emua-description-text is-collapsed">
                        @Model.Description
                    </p>

                    <button type="button"
                            id="descriptionToggle"
                            class="emua-description-toggle"
                            hidden
                            aria-expanded="false"
                            aria-controls="productDescription">
                        Xem thêm
                        <i class="bi bi-chevron-down"></i>
                    </button>
                </div>
            }

            <form asp-controller="Cart" asp-action="AddFromProduct" method="post" class="buy-box" id="productBuyForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                <input type="hidden" name="productId" value="@Model.ProductId" />

                <label>
                    Phiên bản
                    <select name="variantId" id="variantSelect" required onchange="onVariantChange(this)">
                        @foreach (var variant in Model.Variants)
                        {
                            <option value="@variant.VariantId"
                                    data-price="@variant.Price.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                    selected="@(variant.VariantId == Model.DefaultVariantId)"
                                    data-stock="@variant.Stock"
                                    data-image="@FixImageUrl(variant.ImageUrl)"
                                    disabled="@(variant.Stock <= 0 || variant.Price <= 0)">
                                @variant.Label - @variant.Price.ToString("N0") đ · @(variant.Stock > 0 ? $"còn {variant.Stock}" : "Hết hàng")
                            </option>
                        }
                    </select>
                </label>

                <label>
                    Số lượng
                    <input name="quantity" id="productQuantity" type="number" min="1" max="@Math.Max(1, Model.Stock)" value="1" />
                </label>

                <button class="customer-button" type="submit" disabled="@(Model.Stock <= 0 || Model.Price <= 0)">
                    <i class="bi bi-bag-plus"></i> Thêm vào giỏ hàng
                </button>
                <button class="customer-button customer-button-buy"
                        type="submit"
                        name="buyNow"
                        value="true"
                        disabled="@(Model.Stock <= 0 || Model.Price <= 0)">
                    <i class="bi bi-lightning-charge"></i>
                    Mua ngay
                </button>
            </form>

            <form asp-controller="Product" asp-action="Favorite" method="post" class="detail-favorite">
                @Html.AntiForgeryToken()
                <input type="hidden" name="productId" value="@Model.ProductId" />
                @{
                    var isFavorited = (bool)(ViewBag.IsFavorited ?? false);
                }
                <button class="customer-button @(isFavorited ? "customer-button-danger" : "customer-button-light")" type="submit">
                    <i class="bi @(isFavorited ? "bi-heart-fill" : "bi-heart")"></i>
                    @(isFavorited ? "Bỏ yêu thích" : "Yêu thích")
                </button>
            </form>

            <dl class="detail-specs">
                <dt>Bảo hành</dt>
                <dd>@(Model.Warranty ?? "Đang cập nhật")</dd>
                <dt>Thông số kỹ thuật</dt>
                <dd>@(Model.Specifications ?? "Đang cập nhật")</dd>
            </dl>
        </div>
    </div>

    <section class="reviews-section">
        <div class="section-heading">
            <div>
                <span class="eyebrow">CUSTOMER VOICE</span>
                <h2>Đánh giá sản phẩm</h2>
            </div>
        </div>

        @if (Model.Reviews.Count == 0)
        {
            <p class="muted">Chưa có đánh giá cho sản phẩm này.</p>
        }
        else
        {
            foreach (var review in Model.Reviews)
            {
                <article class="review-item">
                    <div>
                        <strong>@review.CustomerName</strong>
                        <span class="review-stars">@("★".PadRight(review.Rating, '★'))</span>
                    </div>
                    <p>@review.Comment</p>
                    <small>@review.CreatedAt?.ToString("dd/MM/yyyy")</small>
                </article>
            }
        }
    </section>
</div>


<script>
    (() => {
        "use strict";
        const images = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(galleryImages));
        const main = document.getElementById('mainProductImg');
        const thumbs = document.getElementById('galleryThumbnails');
        const current = document.getElementById('galleryCurrent');
        const fallback = '/images/no-image.png';
        let selected = 0;
        let sequence = 0;
        const cache = new Map();

        // Hai lop anh: anh cu luon hien thi cho den khi anh moi tai xong.
        const stage = main?.parentElement;
        const incoming = main ? document.createElement('img') : null;
        if (incoming) {
            incoming.className = 'gallery-incoming';
            incoming.alt = main.alt;
            incoming.decoding = 'async';
            incoming.setAttribute('aria-hidden', 'true');
            stage.appendChild(incoming);
        }

        function load(url) {
            if (cache.has(url)) return cache.get(url);
            const result = new Promise(resolve => {
                const img = new Image();
                img.onload = () => resolve(url);
                img.onerror = () => resolve(fallback);
                img.src = url;
                if (img.complete) resolve(img.naturalWidth > 0 ? url : fallback);
            });
            cache.set(url, result);
            return result;
        }

        function mark(index) {
            selected = index;
            if (current) current.textContent = String(index + 1);
            thumbs?.querySelectorAll('.thumb-item').forEach((button, i) => {
                button.classList.toggle('active', i === index);
                button.setAttribute('aria-pressed', String(i === index));
            });
        }

        async function choose(index) {
            if (!main || !images.length) return;
            const target = ((index % images.length) + images.length) % images.length;
            const token = ++sequence;
            mark(target); // Phan hoi ngay khi bam, khong doi mang.
            const url = images[target];
            if (main.getAttribute('src') === url && main.complete && main.naturalWidth > 0) return;
            const ready = await load(url);
            if (token !== sequence) return;
            if (ready === fallback && url !== fallback) {
                // Anh hong: hien placeholder, khong de trang trang.
                main.src = fallback;
                return;
            }
            if (!incoming) { main.src = ready; return; }
            incoming.src = ready;
            incoming.classList.add('visible');
            // Swap o frame tiep theo de khong nhay trang.
            requestAnimationFrame(() => {
                if (token !== sequence) return;
                main.src = ready;
                incoming.classList.remove('visible');
            });
            // Preload duy nhat anh ke tiep sau khi da chon.
            if (images.length > 1) load(images[(target + 1) % images.length]);
        }

        window.showGalleryImage = choose;
        window.moveGallery = step => choose(selected + step);
        window.changeMainImage = src => {
            if (!src || src === fallback) return;
            const index = images.findIndex(x => x.toLowerCase() === src.toLowerCase());
            if (index !== -1) choose(index);
        };

        window.onVariantChange = select => {
            const option = select.options[select.selectedIndex];
            if (!option) return;
            const price = Number(option.dataset.price);
            const stock = Number(option.dataset.stock || 0);
            const qty = document.getElementById('productQuantity');
            if (qty) {
                qty.max = String(Math.max(1, stock));
                if (Number(qty.value) > stock) qty.value = String(Math.max(1, stock));
            }
            document.querySelectorAll('.buy-box button[type="submit"]').forEach(btn => {
                btn.disabled = stock <= 0 || !Number.isFinite(price) || price <= 0;
            });
            const priceEl = document.getElementById('displayPrice');
            if (priceEl && Number.isFinite(price)) priceEl.textContent = price.toLocaleString('vi-VN') + ' đ';
            if (option.dataset.image && option.dataset.image !== fallback) {
                window.changeMainImage(option.dataset.image);
            }
        };

        function init() {
            thumbs?.querySelectorAll('.thumb-item').forEach((button, i) => {
                button.onclick = () => choose(i);
            });
            const select = document.getElementById('variantSelect');
            if (select) window.onVariantChange(select);
            // Cho phep vuot tren dien thoai.
            let touchX = null;
            stage?.addEventListener('touchstart', e => {
                touchX = e.changedTouches[0]?.screenX ?? null;
            }, { passive: true });
            stage?.addEventListener('touchend', e => {
                if (touchX === null) return;
                const diff = (e.changedTouches[0]?.screenX ?? touchX) - touchX;
                if (Math.abs(diff) > 45) choose(selected + (diff < 0 ? 1 : -1));
                touchX = null;
            }, { passive: true });
        }
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
        else init();
    })();
        const description = document.getElementById("productDescription");
    const toggle = document.getElementById("descriptionToggle");

    if (description && toggle) {
        const isOverflowing =
            description.scrollHeight > description.clientHeight + 2;

        if (isOverflowing) {
            toggle.hidden = false;
        }

        toggle.addEventListener("click", () => {
            const collapsed =
                description.classList.toggle("is-collapsed");

            toggle.innerHTML = collapsed
                ? 'Xem thêm <i class="bi bi-chevron-down"></i>'
                : 'Thu gọn <i class="bi bi-chevron-up"></i>';

            toggle.setAttribute(
                "aria-expanded",
                String(!collapsed)
            );
        });
    }
</script>
