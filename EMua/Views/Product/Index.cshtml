@model IEnumerable<EMua.Models.Database.SanPham>

@{
    ViewData["Title"] = "Sản phẩm";

    string? currentCategory = ViewBag.Category as string;
    string? currentKeyword = ViewBag.Keyword as string;
    string? currentSort = ViewBag.Sort as string;
}

@Html.AntiForgeryToken()


<section class="emua-product-page">

    <div class="emua-product-container">

        <!-- =========================
             HEADING
        ========================== -->

        <div class="emua-product-heading">

            <div>

                <span class="emua-product-label">
                    EMUA STORE
                </span>

                <h1>
                    Sản phẩm
                </h1>

                @if (!string.IsNullOrWhiteSpace(currentKeyword))
                {
                    <p>
                        Kết quả tìm kiếm cho:
                        <strong>
                            @currentKeyword
                        </strong>
                    </p>
                }
                else if (!string.IsNullOrWhiteSpace(currentCategory))
                {
                    <p>
                        Danh mục:
                        <strong>
                            @currentCategory
                        </strong>
                    </p>
                }
                else
                {
                    <p>
                        Khám phá các sản phẩm công nghệ tại EMUA.
                    </p>
                }

            </div>


            <div class="emua-product-count">

                <i class="bi bi-box-seam"></i>

                @Model.Count() sản phẩm

            </div>

        </div>



        <!-- =========================
             FILTER
        ========================== -->

        <div class="emua-filter-bar">


            <!-- SEARCH -->

            <form asp-controller="Product"
                  asp-action="Index"
                  method="get"
                  class="emua-product-search">

                @if (!string.IsNullOrWhiteSpace(currentCategory))
                {
                    <input type="hidden"
                           name="category"
                           value="@currentCategory" />
                }


                @if (!string.IsNullOrWhiteSpace(currentSort))
                {
                    <input type="hidden"
                           name="sort"
                           value="@currentSort" />
                }


                <div class="emua-search-input">

                    <i class="bi bi-search"></i>

                    <input type="text"
                           name="keyword"
                           value="@currentKeyword"
                           placeholder="Tìm iPhone, laptop, tai nghe..." />

                </div>


                <button type="submit">

                    Tìm kiếm

                </button>

            </form>



            <!-- SORT -->

            <form asp-controller="Product"
                  asp-action="Index"
                  method="get"
                  class="emua-sort-form">

                @if (!string.IsNullOrWhiteSpace(currentCategory))
                {
                    <input type="hidden"
                           name="category"
                           value="@currentCategory" />
                }


                @if (!string.IsNullOrWhiteSpace(currentKeyword))
                {
                    <input type="hidden"
                           name="keyword"
                           value="@currentKeyword" />
                }


                <select name="sort"
                        onchange="this.form.submit()">

                    @if (string.IsNullOrWhiteSpace(currentSort))
                    {
                        <option value="" selected>
                            Mới nhất
                        </option>
                    }
                    else
                    {
                        <option value="">
                            Mới nhất
                        </option>
                    }


                    @if (currentSort == "price-asc")
                    {
                        <option value="price-asc" selected>
                            Giá thấp → cao
                        </option>
                    }
                    else
                    {
                        <option value="price-asc">
                            Giá thấp → cao
                        </option>
                    }


                    @if (currentSort == "price-desc")
                    {
                        <option value="price-desc" selected>
                            Giá cao → thấp
                        </option>
                    }
                    else
                    {
                        <option value="price-desc">
                            Giá cao → thấp
                        </option>
                    }


                    @if (currentSort == "name-asc")
                    {
                        <option value="name-asc" selected>
                            Tên A → Z
                        </option>
                    }
                    else
                    {
                        <option value="name-asc">
                            Tên A → Z
                        </option>
                    }


                    @if (currentSort == "name-desc")
                    {
                        <option value="name-desc" selected>
                            Tên Z → A
                        </option>
                    }
                    else
                    {
                        <option value="name-desc">
                            Tên Z → A
                        </option>
                    }

                </select>

            </form>

        </div>



        <!-- =========================
             EMPTY
        ========================== -->
        @if (!Model.Any())
        {
            <div class="emua-empty-product">

                <div class="emua-empty-icon">

                    <i class="bi bi-box-seam"></i>

                </div>

                <h3>
                    Không tìm thấy sản phẩm
                </h3>

                <p>
                    Hãy thử đổi từ khóa hoặc chọn một danh mục khác.
                </p>

                <a asp-controller="Product"
                   asp-action="Index">

                    <i class="bi bi-arrow-left"></i>

                    Xem tất cả sản phẩm

                </a>

            </div>
        }

        else
        {

            <!-- =========================
                 PRODUCT GRID
            ========================== -->

            <div class="emua-product-grid">

                @foreach (var item in Model)
                {
                    /*
                    * Lấy biến thể còn hàng có giá thấp nhất.
                    */
                    var variant = item.BienTheSanPhams
                    .Where(x =>
                    x.SoLuong > 0 &&
                    (
                    string.IsNullOrEmpty(x.TrangThai) ||
                    x.TrangThai == "Còn hàng"
                    ))
                    .OrderBy(x => x.Gia)
                    .FirstOrDefault();


                    /*
                    * Nếu không tìm được variant theo trạng thái,
                    * vẫn lấy variant có số lượng > 0.
                    */
                    variant ??= item.BienTheSanPhams
                    .Where(x => x.SoLuong > 0)
                    .OrderBy(x => x.Gia)
                    .FirstOrDefault();


                    /*
                    * Ảnh chính.
                    */
                    var mainImage = item.SanPhamHinhAnhs
                    .OrderByDescending(x => x.LaAnhChinh)
                    .ThenBy(x => x.ThuTu)
                    .FirstOrDefault();


                    /*
                    * Ưu tiên:
                    * 1. Ảnh chính sản phẩm
                    * 2. Ảnh biến thể
                    * 3. no-image
                    */
                    var image =
                    mainImage?.DuongDanAnh
                    ?? variant?.HinhAnh
                    ?? "/images/no-image.png";


                    /*
                    * Giá.
                    */
                    var price =
                    variant?.Gia
                    ?? item.GiaGoc
                    ?? 0;


                    <article class="emua-product-card">


                        <!-- IMAGE -->

                        <a asp-controller="Product"
                           asp-action="Details"
                           asp-route-id="@item.MaSanPham"
                           class="emua-product-image">

                            <img src="@image"
                                 alt="@item.TenSanPham"
                                 loading="lazy" />

                        </a>



                        <!-- BODY -->

                        <div class="emua-product-body">


                            <!-- BRAND -->

                            <div class="emua-product-brand">

                                @(item.MaThuongHieuNavigation?.TenThuongHieu
                                                        ?? "EMUA")

                    </div>



                            <!-- NAME -->

                            <a asp-controller="Product"
                               asp-action="Details"
                               asp-route-id="@item.MaSanPham"
                               class="emua-product-name">

                                @item.TenSanPham

                            </a>



                            <!-- VARIANT -->

                            <div class="emua-product-variant">

                        @if (variant != null)
                                {
                                    @if (!string.IsNullOrWhiteSpace(variant.PhienBan))
                                    {
                                        <span>
                                            @variant.PhienBan
                                        </span>
                                    }


                                    @if (!string.IsNullOrWhiteSpace(variant.MauSac))
                                    {
                                        <span>
                                            @variant.MauSac
                                        </span>
                                    }
                                }
                                else
                                {
                                    <span>
                                        Mặc định
                                    </span>
                                }

                            </div>



                            <!-- PRICE -->

                            <div class="emua-product-price">

                                @price.ToString("N0")₫

                            </div>



                            <!-- STOCK -->
                            @if (variant != null && variant.SoLuong > 0)
                            {
                                <div class="emua-stock in-stock">

                                    <i class="bi bi-check-circle-fill"></i>

                                    Còn hàng

                                </div>
                            }
                            else
                            {
                                <div class="emua-stock out-stock">

                                    <i class="bi bi-x-circle-fill"></i>

                                    Hết hàng

                                </div>
                            }



                            <!-- ACTION -->

                            <div class="emua-product-actions">


                                <a asp-controller="Product"
                                   asp-action="Details"
                                   asp-route-id="@item.MaSanPham"
                                   class="emua-detail-btn">

                                    Xem chi tiết

                                </a>


                                @if (variant != null &&
                                                        variant.SoLuong > 0)
                                {
                                    <button type="button"
                                            class="emua-cart-btn"
                                            onclick="addProductToCart(this, @variant.MaBienThe)"
                                            title="Thêm vào giỏ hàng">

                                        <i class="bi bi-cart-plus"></i>

                                    </button>
                                }
                                else
                                {
                                    <button type="button"
                                            class="emua-cart-btn disabled"
                                            disabled>

                                        <i class="bi bi-cart-x"></i>

                                    </button>
                                }

                            </div>

                        </div>

                    </article>
                }

            </div>
        }

    </div>

</section>



<style>

    /* =========================================
           PAGE
        ========================================= */

    .emua-product-page {
        min-height: 75vh;
        padding: 55px 0 85px;
        background: linear-gradient( 180deg, #f7f7fc 0%, #f1f1f8 100% );
    }


    .emua-product-container {
        width: min(1400px, 92%);
        margin: 0 auto;
    }


    /* =========================================
           HEADING
        ========================================= */

    .emua-product-heading {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        gap: 20px;
        margin-bottom: 25px;
    }


    .emua-product-label {
        display: block;
        margin-bottom: 6px;
        color: #625db1;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 3px;
    }


    .emua-product-heading h1 {
        margin: 0;
        color: #17172a;
        font-size: 36px;
        font-weight: 760;
    }


    .emua-product-heading p {
        margin: 8px 0 0;
        color: #75768a;
        font-size: 14px;
    }


    .emua-product-count {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 14px;
        border-radius: 999px;
        color: #575391;
        background: #eae9f8;
        font-size: 12px;
        font-weight: 650;
    }


    /* =========================================
           FILTER
        ========================================= */

    .emua-filter-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        margin-bottom: 28px;
        padding: 15px;
        border-radius: 17px;
        border: 1px solid rgba(77,74,141,.08);
        background: #fff;
        box-shadow: 0 5px 20px rgba(50,47,100,.035);
    }


    .emua-product-search {
        display: flex;
        align-items: center;
        gap: 10px;
        flex: 1;
    }


    .emua-search-input {
        position: relative;
        flex: 1;
    }


        .emua-search-input i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #89899a;
            pointer-events: none;
        }


        .emua-search-input input {
            width: 100%;
            height: 44px;
            padding: 0 15px 0 43px;
            border: 1px solid #e2e2ea;
            border-radius: 10px;
            outline: none;
            color: #252538;
            background: #f9f9fc;
            transition: .2s;
        }


            .emua-search-input input:focus {
                border-color: #716ccc;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(98,93,177,.08);
            }


    .emua-product-search button {
        height: 44px;
        padding: 0 20px;
        border: 0;
        border-radius: 10px;
        color: #fff;
        cursor: pointer;
        background: linear-gradient( 135deg, #4d4a8d, #625db1 );
        transition: .25s;
    }


        .emua-product-search button:hover {
            transform: translateY(-2px);
        }


    .emua-sort-form select {
        min-width: 180px;
        height: 44px;
        padding: 0 13px;
        border: 1px solid #e2e2ea;
        border-radius: 10px;
        outline: none;
        color: #353548;
        background: #fff;
    }


    /* =========================================
           GRID
        ========================================= */

    .emua-product-grid {
        display: grid;
        grid-template-columns: repeat( 4, minmax(0,1fr) );
        gap: 19px;
    }


    /* =========================================
           CARD
        ========================================= */

    .emua-product-card {
        min-width: 0;
        overflow: hidden;
        border-radius: 19px;
        border: 1px solid rgba(77,74,141,.09);
        background: #fff;
        box-shadow: 0 5px 18px rgba(60,56,110,.035);
        transition: transform .28s ease, box-shadow .28s ease;
    }


        .emua-product-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 19px 44px rgba(72,67,137,.13);
        }


    /* IMAGE */

    .emua-product-image {
        display: block;
        width: 100%;
        height: 240px;
        padding: 20px;
        overflow: hidden;
        background: linear-gradient( 145deg, #fdfdfd, #f1f1f6 );
    }


        .emua-product-image img {
            display: block;
            width: 100%;
            height: 100%;
            max-width: 100%;
            object-fit: contain;
            transition: transform .35s ease;
        }


    .emua-product-card:hover
    .emua-product-image img {
        transform: scale(1.06);
    }


    /* BODY */

    .emua-product-body {
        padding: 17px;
    }


    .emua-product-brand {
        margin-bottom: 5px;
        color: #9999a9;
        font-size: 11px;
        font-weight: 650;
        letter-spacing: 1px;
        text-transform: uppercase;
    }


    .emua-product-name {
        display: -webkit-box;
        min-height: 44px;
        margin-bottom: 9px;
        overflow: hidden;
        color: #202030;
        text-decoration: none;
        font-size: 15px;
        font-weight: 650;
        line-height: 1.45;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 2;
    }


        .emua-product-name:hover {
            color: #5c57aa;
        }


    /* VARIANT */

    .emua-product-variant {
        display: flex;
        flex-wrap: wrap;
        gap: 5px;
        min-height: 26px;
        margin-bottom: 7px;
    }


        .emua-product-variant span {
            padding: 4px 7px;
            border-radius: 6px;
            color: #6d6d7d;
            background: #f1f1f6;
            font-size: 10px;
        }


    /* PRICE */

    .emua-product-price {
        margin-bottom: 6px;
        color: #d83d55;
        font-size: 19px;
        font-weight: 760;
    }


    /* STOCK */

    .emua-stock {
        display: flex;
        align-items: center;
        gap: 4px;
        min-height: 20px;
        margin-bottom: 12px;
        font-size: 10px;
        font-weight: 600;
    }


        .emua-stock.in-stock {
            color: #25965f;
        }


        .emua-stock.out-stock {
            color: #d34d59;
        }


    /* ACTION */

    .emua-product-actions {
        display: grid;
        grid-template-columns: 1fr 45px;
        gap: 8px;
    }


    .emua-detail-btn,
    .emua-cart-btn {
        min-height: 43px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: .25s;
    }


    .emua-detail-btn {
        color: #fff;
        text-decoration: none;
        background: linear-gradient( 135deg, #4d4a8d, #625db1 );
    }


        .emua-detail-btn:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 7px 17px rgba(77,74,141,.22);
        }


    .emua-cart-btn {
        border: 0;
        cursor: pointer;
        color: #514d9b;
        background: #ebeaf8;
        font-size: 18px;
    }


        .emua-cart-btn:hover {
            color: #fff;
            background: #5d58aa;
            transform: translateY(-2px);
        }


        .emua-cart-btn.disabled,
        .emua-cart-btn:disabled {
            color: #aaa;
            background: #eee;
            cursor: not-allowed;
            transform: none;
        }


    /* =========================================
           EMPTY
        ========================================= */

    .emua-empty-product {
        padding: 80px 20px;
        border-radius: 18px;
        text-align: center;
        border: 1px solid rgba(77,74,141,.08);
        background: #fff;
    }


    .emua-empty-icon {
        width: 75px;
        height: 75px;
        margin: 0 auto 18px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #736ebc;
        background: #eeedf9;
        font-size: 32px;
    }


    .emua-empty-product h3 {
        margin-bottom: 7px;
        color: #232336;
    }


    .emua-empty-product p {
        color: #88899a;
    }


    .emua-empty-product a {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 8px;
        padding: 11px 20px;
        border-radius: 999px;
        color: #fff;
        text-decoration: none;
        background: linear-gradient( 135deg, #4d4a8d, #625db1 );
    }


    /* =========================================
           TOAST
        ========================================= */




    











    /* =========================================
           RESPONSIVE
        ========================================= */

    @@media(max-width:1050px) {

        .emua-product-grid {
            grid-template-columns: repeat(3,1fr);
        }
    }


    @@media(max-width:780px) {

        .emua-product-heading {
            align-items: flex-start;
            flex-direction: column;
        }


        .emua-filter-bar {
            align-items: stretch;
            flex-direction: column;
        }


        .emua-product-grid {
            grid-template-columns: repeat(2,minmax(0,1fr));
            gap: 12px;
        }


        .emua-product-image {
            height: 190px;
        }


        .emua-sort-form select {
            width: 100%;
        }
    }


    @@media(max-width:480px) {

        .emua-product-page {
            padding: 35px 0 60px;
        }


        .emua-product-search {
            align-items: stretch;
            flex-direction: column;
        }


            .emua-product-search button {
                width: 100%;
            }


        .emua-product-image {
            height: 155px;
            padding: 13px;
        }


        .emua-product-body {
            padding: 12px;
        }


        .emua-product-name {
            font-size: 13px;
        }


        .emua-product-price {
            font-size: 16px;
        }


        .emua-product-actions {
            grid-template-columns: 1fr 40px;
        }


    
    }

</style>



<script>

    async function addProductToCart(
        button,
        variantId
    ) {

        // Chưa đăng nhập: thêm vào giỏ tạm, KHÔNG ép đăng nhập.
        if (!window.EMUA_IS_AUTHENTICATED) {
            window.addToGuestCart(variantId, 1);
            if (typeof showCartAddedFeedback === 'function') showCartAddedFeedback();
            return;
        }

        /*
         * Lấy antiforgery token được tạo bởi:
         * @Html.AntiForgeryToken()
         */
        const tokenInput =
            document.querySelector(
                'input[name="__RequestVerificationToken"]'
            );


        if (!tokenInput) {

            console.error(
                'Không tìm thấy AntiForgeryToken.'
            );

            alert(
                'Không tìm thấy mã bảo mật của trang.'
            );

            return;
        }


        /*
         * Khóa button tránh bấm liên tục.
         */
        const originalHtml =
            button.innerHTML;


        button.disabled =
            true;


        button.innerHTML =
            '<span class="spinner-border spinner-border-sm"></span>';


        try {

            const response =
                await fetch(
                    '/Cart/Add',
                    {

                        method:
                            'POST',

                        headers: {

                            'Content-Type':
                                'application/json',

                            /*
                             * Header quan trọng để:
                             * [ValidateAntiForgeryToken]
                             * chấp nhận request.
                             */
                            'RequestVerificationToken':
                                tokenInput.value

                        },


                        body:
                            JSON.stringify({

                                variantId:
                                    variantId,

                                quantity:
                                    1

                            })

                    }
                );


            /*
             * Chưa đăng nhập.
             */
            if (
                response.status === 401
                ||
                response.status === 403
            ) {

                window.location.href =
                    '/Auth/Login?returnUrl='
                    +
                    encodeURIComponent(
                        window.location.pathname
                        +
                        window.location.search
                    );

                return;
            }


            /*
             * Đọc JSON nếu controller trả JSON.
             */
            let result = null;


            const contentType =
                response.headers.get(
                    'content-type'
                );


            if (
                contentType &&
                contentType.includes(
                    'application/json'
                )
            ) {

                result =
                    await response.json();

            }


            /*
             * Request lỗi.
             */
            if (!response.ok) {

                console.error(
                    'Cart Add Error:',
                    result
                );


                alert(
                    result?.message
                    ||
                    'Không thể thêm sản phẩm vào giỏ hàng.'
                );

                return;
            }


            /*
             * Thành công: không hiện toast.
             * Chỉ nháy icon giỏ hàng và hiện +1.
             */
            if (typeof showCartAddedFeedback === 'function') {
                showCartAddedFeedback();
            }


            const newCount =
                result?.count
                ?? result?.cartCount
                ?? result?.totalQuantity;

            if (newCount !== undefined &&
                typeof setGlobalCartCount === 'function') {
                setGlobalCartCount(newCount, false);
            }

        }

        catch (error) {

            console.error(
                'Add cart exception:',
                error
            );


            alert(
                'Có lỗi xảy ra khi thêm sản phẩm vào giỏ hàng.'
            );

        }

        finally {

            /*
             * Khôi phục button.
             */
            button.disabled =
                false;


            button.innerHTML =
                originalHtml;

        }

    }

</script>