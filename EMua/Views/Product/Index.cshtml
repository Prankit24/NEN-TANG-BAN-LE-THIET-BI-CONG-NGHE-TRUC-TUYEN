@model IEnumerable<EMua.Models.Database.SanPham>
@{
    ViewData["Title"] = "Sản phẩm";
    var categories = ViewBag.Categories as IEnumerable<EMua.Models.Database.DanhMucSanPham>
        ?? Enumerable.Empty<EMua.Models.Database.DanhMucSanPham>();
    var brands = ViewBag.Brands as IEnumerable<EMua.Models.Database.ThuongHieu>
        ?? Enumerable.Empty<EMua.Models.Database.ThuongHieu>();
    int? categoryId = ViewBag.CategoryId is int c ? c : null;
    int? brandId = ViewBag.BrandId is int b ? b : null;
    string keyword = ViewBag.Keyword as string ?? "";
    string sort = ViewBag.Sort as string ?? "";
    var products = Model?.ToList() ?? new List<EMua.Models.Database.SanPham>();
}
<link rel="stylesheet" href="~/css/customer/product-index.css" asp-append-version="true" />
<section class="emua-product-page">
    <div class="emua-product-container">
        <div class="emua-product-toolbar">
            <form id="emuaProductFilter" asp-controller="Product" asp-action="Index" method="get"
                  class="emua-filter-form" role="search">
                <div class="emua-search-input">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input type="search" name="keyword" id="productKeyword" value="@keyword"
                           placeholder="Tìm sản phẩm..." aria-label="Tìm sản phẩm" />
                </div>
                <select id="productCategory" name="categoryId" aria-label="Danh mục">
                    <option value="" selected="@(!categoryId.HasValue)">Tất cả danh mục</option>
                    @foreach (var item in categories)
                    {
                        <option value="@item.MaDanhMuc" selected="@(categoryId == item.MaDanhMuc)">@item.TenDanhMuc</option>
                    }
                </select>
                <select id="productBrand" name="brandId" aria-label="Thương hiệu">
                    <option value="" selected="@(!brandId.HasValue)">Tất cả thương hiệu</option>
                    @foreach (var item in brands)
                    {
                        <option value="@item.MaThuongHieu" selected="@(brandId == item.MaThuongHieu)">@item.TenThuongHieu</option>
                    }
                </select>
                <select id="productSort" name="sort" aria-label="Sắp xếp">
                    <option value="" selected="@(sort == "")">Mới nhất</option>
                    <option value="price-asc" selected="@(sort == "price-asc")">Giá thấp → cao</option>
                    <option value="price-desc" selected="@(sort == "price-desc")">Giá cao → thấp</option>
                    <option value="name-asc" selected="@(sort == "name-asc")">Tên A → Z</option>
                    <option value="name-desc" selected="@(sort == "name-desc")">Tên Z → A</option>
                </select>
            </form>
            <div class="emua-product-count">
                <i class="bi bi-box-seam" aria-hidden="true"></i>
                <strong id="emuaProductCount">@products.Count</strong><span>sản phẩm</span>
            </div>
        </div>
        <div id="emuaFilterStatus" class="emua-filter-status" role="status" aria-live="polite"></div>
        <div id="emuaProductResults" aria-busy="false">
            <partial name="_ProductList" model="products" />
        </div>
    </div>
</section>
@section Scripts {
    <script src="~/js/customer/product-filter.js" asp-append-version="true"></script>
}
