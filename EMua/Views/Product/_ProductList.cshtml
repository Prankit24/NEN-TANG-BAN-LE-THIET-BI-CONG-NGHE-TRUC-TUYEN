@model IEnumerable<EMua.Models.Database.SanPham>
@{
    var products = Model?.ToList() ?? new List<EMua.Models.Database.SanPham>();
    int currentPage = ViewBag.CurrentPage is int cp ? cp : 1;
    int totalPages = ViewBag.TotalPages is int tp ? tp : 1;
    int totalItems = ViewBag.TotalItems is int ti ? ti : products.Count;
}
<input type="hidden" id="emuaTotalCount" value="@totalItems" />
<input type="hidden" id="emuaCurrentPage" value="@currentPage" />

@if (products.Count == 0)
{
    <div class="emua-empty-product">
        <div class="emua-empty-icon"><i class="bi bi-box-seam"></i></div>
        <h3>Không tìm thấy sản phẩm</h3>
        <p>Hãy thử từ khóa, khoảng giá, danh mục hoặc thương hiệu khác.</p>
    </div>
}
else
{
    <div class="emua-product-grid">
        @foreach (var item in products)
        {
            var variant = item.BienTheSanPhams
                .Where(x => x.SoLuong > 0 &&
                    (string.IsNullOrWhiteSpace(x.TrangThai) || x.TrangThai == "Còn hàng"))
                .OrderBy(x => x.Gia).FirstOrDefault();
            variant ??= item.BienTheSanPhams.Where(x => x.SoLuong > 0)
                .OrderBy(x => x.Gia).FirstOrDefault();
            var image = ImageUrlHelper.ResolveProductImage(item, variant, checkPhysicalFile: true);
            var price = variant?.Gia ?? item.GiaGoc ?? 0;
            <article class="emua-product-card">
                <a asp-controller="Product" asp-action="Details" asp-route-id="@item.MaSanPham"
                   class="emua-product-image">
                    <img src="@image" alt="@item.TenSanPham" loading="lazy" decoding="async"
                         onerror="this.onerror=null;this.src='/images/no-image.png';" />
                </a>
                <div class="emua-product-body">
                    <div class="emua-product-brand">@(item.MaThuongHieuNavigation?.TenThuongHieu ?? "EMUA")</div>
                    <a asp-controller="Product" asp-action="Details" asp-route-id="@item.MaSanPham"
                       class="emua-product-name">@item.TenSanPham</a>
                    <div class="emua-product-variant">
                        @if (variant != null)
                        {
                            if (!string.IsNullOrWhiteSpace(variant.PhienBan)) { <span>@variant.PhienBan</span> }
                            if (!string.IsNullOrWhiteSpace(variant.MauSac)) { <span>@variant.MauSac</span> }
                        }
                    </div>
                    <div class="emua-product-price">@price.ToString("N0") <span class="emua-currency">đ</span></div>
                    @if (variant != null && variant.SoLuong > 0)
                    {
                        <div class="emua-stock in-stock"><i class="bi bi-check-circle-fill"></i> Còn hàng</div>
                    }
                    else
                    {
                        <div class="emua-stock out-stock"><i class="bi bi-x-circle-fill"></i> Hết hàng</div>
                    }
                    <div class="emua-product-actions">
                        <a asp-controller="Product" asp-action="Details" asp-route-id="@item.MaSanPham"
                           class="emua-detail-btn">Xem chi tiết</a>
                        @if (variant != null && variant.SoLuong > 0)
                        {
                            <button type="button" class="emua-cart-btn"
                                    onclick="addProductToCart(this, @variant.MaBienThe)"
                                    aria-label="Thêm @item.TenSanPham vào giỏ hàng" title="Thêm vào giỏ hàng">
                                <i class="bi bi-cart-plus"></i>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="emua-cart-btn disabled" disabled title="Hết hàng">
                                <i class="bi bi-cart-x"></i>
                            </button>
                        }
                    </div>
                </div>
            </article>
        }
    </div>

    @if (totalPages > 1)
    {
        <nav class="emua-pagination" aria-label="Phân trang sản phẩm">
            @if (currentPage > 1)
            {
                <button type="button" class="emua-page-btn emua-page-nav prev" data-page="@(currentPage - 1)" aria-label="Trang trước">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i> <span>Trước</span>
                </button>
            }
            else
            {
                <button type="button" class="emua-page-btn emua-page-nav prev disabled" disabled aria-label="Trang trước">
                    <i class="bi bi-chevron-left" aria-hidden="true"></i> <span>Trước</span>
                </button>
            }

            <div class="emua-page-numbers">
                @{
                    int startPage = Math.Max(1, currentPage - 2);
                    int endPage = Math.Min(totalPages, currentPage + 2);

                    if (startPage > 1)
                    {
                        <button type="button" class="emua-page-btn @(currentPage == 1 ? "active" : "")" data-page="1">1</button>
                        if (startPage > 2)
                        {
                            <span class="emua-page-ellipsis">…</span>
                        }
                    }

                    for (int p = startPage; p <= endPage; p++)
                    {
                        <button type="button" class="emua-page-btn @(p == currentPage ? "active" : "")" data-page="@p">@p</button>
                    }

                    if (endPage < totalPages)
                    {
                        if (endPage < totalPages - 1)
                        {
                            <span class="emua-page-ellipsis">…</span>
                        }
                        <button type="button" class="emua-page-btn @(currentPage == totalPages ? "active" : "")" data-page="@totalPages">@totalPages</button>
                    }
                }
            </div>

            @if (currentPage < totalPages)
            {
                <button type="button" class="emua-page-btn emua-page-nav next" data-page="@(currentPage + 1)" aria-label="Trang sau">
                    <span>Sau</span> <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
            }
            else
            {
                <button type="button" class="emua-page-btn emua-page-nav next disabled" disabled aria-label="Trang sau">
                    <span>Sau</span> <i class="bi bi-chevron-right" aria-hidden="true"></i>
                </button>
            }
        </nav>
    }
}
