@model List<EMua.ViewModels.OrderListItemViewModel>
@{
    ViewData["Title"] = "Đơn hàng của tôi";

    string FixImageUrl(string? url)
    {
        if (string.IsNullOrWhiteSpace(url))
            return "/images/default-product.png";

        url = url.Trim().Replace("\\", "/");

        if (url.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            url.StartsWith("https://", StringComparison.OrdinalIgnoreCase))
            return url;

        if (!url.StartsWith("/"))
            url = "/" + url;

        return url;
    }
}

<link rel="stylesheet" href="~/css/order.css" asp-append-version="true" />

<div class="customer-page">
    <!-- Header nằm ngang trên cùng -->
    <div class="customer-heading-inline">
        <a asp-controller="Account" asp-action="Profile" class="btn-back-icon" title="Quay lại hồ sơ">
            <i class="bi bi-arrow-left"></i>
        </a>
        <h1>Đơn hàng của tôi</h1>
    </div>

    <!-- Nội dung: danh sách đơn hàng -->
    <div class="customer-content-right">
        @if (Model == null || Model.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-bag-x"></i>
                <h2>Chưa có đơn hàng nào</h2>
                <p>Bạn chưa thực hiện giao dịch nào trên hệ thống.</p>
                <a asp-controller="Product" asp-action="Index" class="customer-button btn-start-shopping">
                    <i class="bi bi-bag-plus me-2"></i>Bắt đầu mua sắm
                </a>
            </div>
        }
        else
        {
            <!-- Danh sách Card đơn hàng -->
            <div class="order-cards-container" id="orderCardsContainer">
                @foreach (var order in Model)
                {
                    string statusClass = order.Status switch
                    {
                        "Đã hoàn thành" => "status-completed",
                        "Chờ thanh toán" => "status-pending",
                        "Đã hủy" => "status-cancelled",
                        _ => "status-processing"
                    };

                    <div class="order-card-item">
                        <div class="order-card-header">
                            <div class="order-date">
                                <i class="bi bi-calendar3 me-1"></i>
                                <span>Ngày đặt: <strong>@order.OrderedAt?.ToString("dd/MM/yyyy HH:mm")</strong></span>
                            </div>
                            <span class="order-status-badge @statusClass">
                                @order.Status
                            </span>
                        </div>

                        <div class="order-card-body">
                            @if (order.Items != null && order.Items.Any())
                            {
                                @foreach (var item in order.Items)
                                {
                                    <div class="order-product-item">
                                        <a asp-action="Details" asp-route-id="@order.OrderId" class="product-thumb-link">
                                            <img src="@FixImageUrl(item.ProductImageUrl)"
                                                 alt="@item.ProductName"
                                                 class="product-thumb-img"
                                                 onerror="this.onerror=null; this.src='/images/default-product.png';" />
                                        </a>

                                        <div class="product-details">
                                            <a asp-action="Details" asp-route-id="@order.OrderId" class="product-title-link">
                                                @item.ProductName
                                            </a>
                                        </div>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="order-product-item">
                                    <a asp-action="Details" asp-route-id="@order.OrderId" class="product-thumb-link">
                                        <div class="product-thumb-placeholder">
                                            <i class="bi bi-box-seam"></i>
                                        </div>
                                    </a>
                                    <div class="product-details">
                                        <a asp-action="Details" asp-route-id="@order.OrderId" class="product-title-link">
                                            Sản phẩm trong đơn hàng
                                        </a>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="order-card-footer">
                            <div class="order-total-group">
                                <span class="total-label">Tổng thanh toán:</span>
                                <span class="total-amount">@order.Total.ToString("N0") đ</span>
                            </div>

                            <div class="order-actions">
                                <a asp-action="Details" asp-route-id="@order.OrderId" class="btn-detail-link">
                                    Xem chi tiết
                                    <i class="bi bi-arrow-right ms-1"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Phân trang -->
            <div class="pagination-container" id="paginationControls"></div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Số đơn hàng hiển thị mỗi trang.
            const itemsPerPage = 2;
            const container = document.getElementById("orderCardsContainer");
            if (!container) return;

            const cards = Array.from(container.getElementsByClassName("order-card-item"));
            const totalPages = Math.ceil(cards.length / itemsPerPage);
            const paginationContainer = document.getElementById("paginationControls");

            if (totalPages <= 1) {
                if (paginationContainer) paginationContainer.style.display = "none";
                return;
            }

            let currentPage = 1;

            function showPage(page) {
                currentPage = page;
                const start = (page - 1) * itemsPerPage;
                const end = start + itemsPerPage;

                cards.forEach((card, index) => {
                    card.style.display = (index >= start && index < end) ? "block" : "none";
                });

                renderPagination();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }

            // Trả về danh sách số trang cần hiển thị, có dấu "..." khi số trang lớn.
            // Ví dụ: 1 2 3 4 5 ... 12  hoặc  1 ... 5 6 7 ... 12
            function getPageNumbers() {
                const delta = 1; // số trang liền kề mỗi bên currentPage
                const range = [];
                const withDots = [];
                let lastPage = 0;

                for (let i = 1; i <= totalPages; i++) {
                    if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) {
                        range.push(i);
                    }
                }

                range.forEach(i => {
                    if (lastPage) {
                        if (i - lastPage === 2) {
                            withDots.push(lastPage + 1);
                        } else if (i - lastPage > 2) {
                            withDots.push("...");
                        }
                    }
                    withDots.push(i);
                    lastPage = i;
                });

                return withDots;
            }

            function renderPagination() {
                paginationContainer.innerHTML = "";

                const prevBtn = document.createElement("button");
                prevBtn.className = `page-btn ${currentPage === 1 ? 'disabled' : ''}`;
                prevBtn.innerHTML = '<i class="bi bi-chevron-left"></i>';
                prevBtn.onclick = () => { if (currentPage > 1) showPage(currentPage - 1); };
                paginationContainer.appendChild(prevBtn);

                getPageNumbers().forEach(item => {
                    const pageBtn = document.createElement("button");
                    if (item === "...") {
                        pageBtn.className = "page-btn ellipsis";
                        pageBtn.textContent = "...";
                        pageBtn.disabled = true;
                    } else {
                        pageBtn.className = `page-btn ${item === currentPage ? 'active' : ''}`;
                        pageBtn.textContent = item;
                        pageBtn.onclick = () => showPage(item);
                    }
                    paginationContainer.appendChild(pageBtn);
                });

                const nextBtn = document.createElement("button");
                nextBtn.className = `page-btn ${currentPage === totalPages ? 'disabled' : ''}`;
                nextBtn.innerHTML = '<i class="bi bi-chevron-right"></i>';
                nextBtn.onclick = () => { if (currentPage < totalPages) showPage(currentPage + 1); };
                paginationContainer.appendChild(nextBtn);
            }

            showPage(1);
        });
    </script>
}
