@model EMua.ViewModels.LoginViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Đăng nhập";

    var captchaId = Configuration["GeeTest:Login:CaptchaId"];
    var returnUrl = ViewData["ReturnUrl"]?.ToString();
}

<section class="auth-section">
    <div class="auth-page">

        <!-- LEFT -->
        <div class="auth-brand">
            <div class="brand-logo">EMUA</div>

            <p>
                Công nghệ trong<br />
                tầm tay bạn.
            </p>

            <span>
                Khám phá sản phẩm công nghệ chính hãng,
                giá tốt và trải nghiệm mua sắm hiện đại.
            </span>

            <ul class="auth-benefits">
                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Sản phẩm chính hãng
                </li>

                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Thanh toán an toàn
                </li>

                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Giao hàng nhanh chóng
                </li>
            </ul>
        </div>


        <!-- RIGHT -->
        <div class="auth-form-area">

            <form asp-controller="Auth"
                  asp-action="Login"
                  method="post"
                  class="auth-form"
                  id="loginForm">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="returnUrl"
                       value="@returnUrl" />

                <!-- CAPTCHA DATA -->
                <input type="hidden"
                       id="lotNumber"
                       name="lotNumber" />

                <input type="hidden"
                       id="captchaOutput"
                       name="captchaOutput" />

                <input type="hidden"
                       id="passToken"
                       name="passToken" />

                <input type="hidden"
                       id="genTime"
                       name="genTime" />


                <h1>Đăng nhập</h1>

                <p class="form-subtitle">
                    Đăng nhập để tiếp tục mua sắm tại EMUA
                </p>


                <!-- SUCCESS -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="success-message">
                        @TempData["SuccessMessage"]
                    </div>
                }


                <!-- VALIDATION -->
                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors">
                </div>


                <!-- EMAIL -->
                <div class="auth-field">
                    <i class="fa-solid fa-envelope"></i>

                    <input asp-for="Email"
                           type="email"
                           placeholder="Email"
                           autocomplete="email" />
                </div>

                <span asp-validation-for="Email"
                      class="field-validation-error">
                </span>


                <!-- PASSWORD -->
                <div class="auth-field">
                    <i class="fa-solid fa-lock"></i>

                    <input asp-for="Password"
                           type="password"
                           placeholder="Mật khẩu"
                           autocomplete="current-password" />
                </div>

                <span asp-validation-for="Password"
                      class="field-validation-error">
                </span>


                <!-- OPTIONS -->
                <div class="login-options">

                    <label class="check-row">
                        <input asp-for="RememberMe"
                               type="checkbox" />

                        <span>Ghi nhớ đăng nhập</span>
                    </label>

                    <a asp-controller="Auth"
                       asp-action="ForgotPassword"
                       class="forgot-password">
                        Quên mật khẩu?
                    </a>

                </div>


                <!-- CAPTCHA MESSAGE -->
                <div id="captchaMessage"
                     class="captcha-message">
                </div>


                <!-- LOGIN BUTTON -->
                <button type="submit"
                        class="primary-button"
                        id="loginButton">

                    Đăng nhập
                </button>


                <!-- REGISTER -->
                <p class="switch-auth">
                    Chưa có tài khoản?
                    <a asp-controller="Auth"
                       asp-action="Register">
                        Đăng ký ngay
                    </a>
                </p>

            </form>

        </div>
    </div>
</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <!-- GEETEST V4 -->
    <script src="https://static.geetest.com/v4/gt4.js"></script>

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const form = document.getElementById("loginForm");
            const button = document.getElementById("loginButton");
            const message = document.getElementById("captchaMessage");

            /*
             * Lấy CAPTCHA ID từ Render Environment Variables
             *
             * GeeTest__Login__CaptchaId
             *        ↓
             * GeeTest:Login:CaptchaId
             */
            const captchaId = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(captchaId ?? "")
                    );

        let captchaObj = null;
        let captchaReady = false;
        let verified = false;


            console.log("===== GEETEST LOGIN =====");
            console.log("CaptchaId:", captchaId);


            /*
             * KIỂM TRA CAPTCHA ID
             */
            if (!captchaId) {

                console.error(
                    "GeeTest Login CaptchaId chưa được cấu hình."
                );

                message.textContent =
                    "CAPTCHA chưa được cấu hình trên máy chủ.";

                button.disabled = true;

                return;
            }


            /*
             * KIỂM TRA SCRIPT GEETEST
             */
            if (typeof initGeetest4 !== "function") {

                console.error(
                    "Không tìm thấy initGeetest4."
                );

                message.textContent =
                    "Không thể tải CAPTCHA. Vui lòng tải lại trang.";

                return;
            }


            /*
             * KHỞI TẠO GEETEST
             */
            initGeetest4(
                {
                    captchaId: captchaId,

                    product: "bind",

                    riskType: "slide"
                },

                function (captcha) {

                    captchaObj = captcha;

                    console.log(
                        "GeeTest Login đã khởi tạo:",
                        captcha
                    );


                    /*
                     * CAPTCHA READY
                     */
                    captcha.onReady(function () {

                        captchaReady = true;

                        console.log(
                            "GeeTest Login READY"
                        );

                    });


                    /*
                     * CAPTCHA SUCCESS
                     */
                    captcha.onSuccess(function () {

                        console.log(
                            "GeeTest Login SUCCESS"
                        );

                        const result =
                            captcha.getValidate();


                        if (!result) {

                            console.error(
                                "Không lấy được kết quả CAPTCHA."
                            );

                            message.textContent =
                                "Không lấy được kết quả CAPTCHA.";

                            verified = false;

                            return;
                        }


                        /*
                         * ĐƯA KẾT QUẢ CAPTCHA VÀO FORM
                         */
                        document.getElementById("lotNumber").value =
                            result.lot_number || "";

                        document.getElementById("captchaOutput").value =
                            result.captcha_output || "";

                        document.getElementById("passToken").value =
                            result.pass_token || "";

                        document.getElementById("genTime").value =
                            result.gen_time || "";


                        verified = true;

                        message.textContent = "";

                        console.log(
                            "GeeTest data đã được thêm vào form."
                        );


                        /*
                         * GỬI FORM
                         */
                        form.submit();

                    });


                    /*
                     * CAPTCHA ERROR
                     */
                    captcha.onError(function (error) {

                        console.error(
                            "GeeTest Login ERROR:",
                            error
                        );

                        verified = false;

                        message.textContent =
                            "Không thể xác minh CAPTCHA. Vui lòng thử lại.";

                    });

                }
            );


            /*
             * SUBMIT FORM
             */
            form.addEventListener("submit", function (event) {

                /*
                 * Nếu CAPTCHA đã xác minh
                 * → cho form submit bình thường
                 */
                if (verified) {
                    return;
                }


                /*
                 * Chặn submit lần đầu
                 */
                event.preventDefault();


                /*
                 * Kiểm tra dữ liệu form
                 */
                if (!form.checkValidity()) {

                    form.reportValidity();

                    return;
                }


                /*
                 * CAPTCHA chưa khởi tạo
                 */
                if (!captchaObj) {

                    console.error(
                        "captchaObj chưa được khởi tạo."
                    );

                    message.textContent =
                        "CAPTCHA chưa sẵn sàng. Vui lòng tải lại trang.";

                    return;
                }


                /*
                 * CAPTCHA chưa READY
                 */
                if (!captchaReady) {

                    console.log(
                        "CAPTCHA chưa READY, đang chờ..."
                    );

                    message.textContent =
                        "CAPTCHA đang tải, vui lòng thử lại sau giây lát.";

                    return;
                }


                /*
                 * XÓA KẾT QUẢ CAPTCHA CŨ
                 */
                document.getElementById("lotNumber").value = "";
                document.getElementById("captchaOutput").value = "";
                document.getElementById("passToken").value = "";
                document.getElementById("genTime").value = "";


                /*
                 * HIỆN CAPTCHA
                 */
                console.log(
                    "Hiển thị GeeTest Login..."
                );

                captchaObj.showCaptcha();

            });


            /*
             * Nếu người dùng sửa Email / Password
             * sau khi CAPTCHA đã xác minh
             * → bắt xác minh lại.
             */
            form.querySelectorAll("input").forEach(function (input) {

                input.addEventListener("input", function () {

                    if (
                        input.name === "Email" ||
                        input.name === "Password"
                    ) {

                        verified = false;

                    }

                });

            });

        });

    </script>
}