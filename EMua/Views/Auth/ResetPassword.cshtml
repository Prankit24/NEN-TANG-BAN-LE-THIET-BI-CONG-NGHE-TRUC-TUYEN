@model EMua.ViewModels.ResetPasswordViewModel

@{
    ViewData["Title"] = "Đặt lại mật khẩu";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

<section class="auth-section">
    <div class="auth-page">

        <!-- LEFT BRAND SIDE -->
        <div class="auth-brand">
            <div class="brand-logo">EMUA</div>

            <p>
                Bảo mật tài khoản<br />
                của bạn.
            </p>

            <span>
                Tạo mật khẩu mới an toàn, đáp ứng tiêu chuẩn bảo mật để tiếp tục trải nghiệm mua sắm công nghệ tại EMUA.
            </span>

            <ul class="auth-benefits">
                <li>
                    <i class="fa-solid fa-lock" aria-hidden="true"></i>
                    Bảo mật chuẩn mã hóa mật khẩu PBKDF2
                </li>
                <li>
                    <i class="fa-solid fa-shield-check" aria-hidden="true"></i>
                    Vô hiệu hóa liên kết cũ ngay sau khi đổi
                </li>
                <li>
                    <i class="fa-solid fa-circle-check" aria-hidden="true"></i>
                    Đăng nhập ngay lập tức với mật khẩu mới
                </li>
            </ul>
        </div>

        <!-- RIGHT FORM SIDE -->
        <div class="auth-form-area">
            <form asp-controller="Auth"
                  asp-action="ResetPassword"
                  method="post"
                  class="auth-form"
                  id="resetPasswordForm"
                  novalidate>

                @Html.AntiForgeryToken()

                <input asp-for="Email" type="hidden" />
                <input asp-for="Token" type="hidden" />

                <!-- FORM HEADER -->
                <h1>Đặt lại mật khẩu</h1>
                <p class="form-subtitle">
                    Vui lòng nhập mật khẩu mới cho tài khoản của bạn.
                </p>

                <!-- VALIDATION SUMMARY -->
                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors"
                     role="alert"
                     aria-live="polite">
                </div>

                <!-- NEW PASSWORD -->
                <div class="field-group">
                    <label asp-for="NewPassword" class="field-label">Mật khẩu mới</label>
                    <div class="auth-field">
                        <i class="fa-solid fa-lock field-icon" aria-hidden="true"></i>
                        <input asp-for="NewPassword"
                               type="password"
                               id="newPassword"
                               placeholder="Nhập mật khẩu mới"
                               autocomplete="new-password"
                               aria-describedby="NewPassword-error"
                               required />

                        <button type="button"
                                class="field-toggle"
                                data-toggle-target="newPassword"
                                aria-label="Hiện mật khẩu"
                                aria-pressed="false">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="NewPassword" id="NewPassword-error" class="field-validation-error"></span>
                </div>

                <!-- CONFIRM PASSWORD -->
                <div class="field-group">
                    <label asp-for="ConfirmPassword" class="field-label">Xác nhận mật khẩu</label>
                    <div class="auth-field">
                        <i class="fa-solid fa-lock field-icon" aria-hidden="true"></i>
                        <input asp-for="ConfirmPassword"
                               type="password"
                               id="confirmPassword"
                               placeholder="Nhập lại mật khẩu mới"
                               autocomplete="new-password"
                               aria-describedby="ConfirmPassword-error"
                               required />

                        <button type="button"
                                class="field-toggle"
                                data-toggle-target="confirmPassword"
                                aria-label="Hiện mật khẩu"
                                aria-pressed="false">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" id="ConfirmPassword-error" class="field-validation-error"></span>
                </div>

                <!-- SUBMIT BUTTON -->
                <button type="submit" class="primary-button" id="resetButton">
                    <span class="button-spinner" aria-hidden="true"></span>
                    <span class="button-label">Cập nhật mật khẩu</span>
                </button>

                <!-- SWITCH AUTH -->
                <p class="switch-auth">
                    Nhớ mật khẩu hoặc muốn hủy?
                    <a asp-controller="Auth" asp-action="Login">
                        Quay lại đăng nhập
                    </a>
                </p>

            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            /* SHOW / HIDE PASSWORD TOGGLE */
            document.querySelectorAll(".field-toggle").forEach(function (toggle) {
                toggle.addEventListener("click", function () {
                    const targetId = toggle.getAttribute("data-toggle-target");
                    const input = document.getElementById(targetId);
                    const icon = toggle.querySelector("i");
                    if (!input) return;

                    const isHidden = input.type === "password";
                    input.type = isHidden ? "text" : "password";
                    toggle.setAttribute("aria-pressed", isHidden ? "true" : "false");
                    if (icon) {
                        icon.classList.toggle("fa-eye", !isHidden);
                        icon.classList.toggle("fa-eye-slash", isHidden);
                    }
                });
            });

            const form = document.getElementById("resetPasswordForm");
            const button = document.getElementById("resetButton");
            if (form && button) {
                form.addEventListener("submit", function () {
                    if (window.jQuery && $(form).length && !$(form).valid()) {
                        return;
                    }
                    button.classList.add("is-loading");
                    button.disabled = true;
                });
            }
        });
    </script>
}
