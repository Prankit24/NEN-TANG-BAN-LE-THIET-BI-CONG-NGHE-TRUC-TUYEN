@{
    ViewData["Title"] = "Không có quyền truy cập (403)";
    Layout = "_Layout";
}

<div class="container py-5 my-5 text-center" style="max-width: 600px;">
    <div class="mb-4">
        <i class="bi bi-shield-x text-danger" style="font-size: 72px;"></i>
    </div>
    <h1 class="h3 fw-bold mb-3" style="color: #172033;">403 - Giới hạn quyền truy cập</h1>
    <p class="text-muted mb-4" style="font-size: 15px; line-height: 1.6;">
        Tài khoản của bạn đã được xác thực nhưng không đủ quyền để truy cập vào tài nguyên hoặc chức năng này.
        Nếu bạn cho rằng đây là một sự nhầm lẫn, vui lòng liên hệ với Quản trị viên hệ thống.
    </p>
    <div class="d-flex justify-content-center gap-3">
        <a href="javascript:history.back()" class="btn btn-outline-secondary px-4 py-2">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
        @if (User.IsInRole("Admin") || User.IsInRole("Quản trị viên") || User.IsInRole("QuanTriVien"))
        {
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4 py-2">
                <i class="bi bi-grid-1x2 me-1"></i> Về trang Quản trị
            </a>
        }
        else if (User.IsInRole("Nhân viên") || User.IsInRole("NhanVien") || User.IsInRole("Staff"))
        {
            <a asp-area="Staff" asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-4 py-2">
                <i class="bi bi-grid-1x2 me-1"></i> Về trang Nhân viên
            </a>
        }
        else
        {
            <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-primary px-4 py-2">
                <i class="bi bi-house me-1"></i> Về Trang chủ
            </a>
        }
    </div>
</div>
