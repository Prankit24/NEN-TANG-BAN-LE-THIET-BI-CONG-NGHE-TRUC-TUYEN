@model EMua.ViewModels.ForgotPasswordViewModel
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Quên mật khẩu";
    var captchaId = Configuration["GeeTest:Login:CaptchaId"];
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

<section class="auth-section">
    <div class="auth-page">

        <!-- LEFT BRAND SIDE -->
        <div class="auth-brand">
            <div class="brand-logo">EMUA</div>

            <p>
                Khôi phục tài khoản<br />
                của bạn.
            </p>

            <span>
                Nhập địa chỉ email đã đăng ký để nhận liên kết đặt lại mật khẩu an toàn và tiếp tục trải nghiệm mua sắm tại EMUA.
            </span>

            <ul class="auth-benefits">
                <li>
                    <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                    Bảo mật chuẩn mã hóa HMAC 256
                </li>
                <li>
                    <i class="fa-solid fa-envelope-circle-check" aria-hidden="true"></i>
                    Xác thực liên kết qua email chính chủ
                </li>
                <li>
                    <i class="fa-solid fa-headset" aria-hidden="true"></i>
                    Hỗ trợ kỹ thuật EMUA 24/7
                </li>
            </ul>
        </div>

        <!-- RIGHT FORM SIDE -->
        <div class="auth-form-area">
            <form asp-controller="Auth"
                  asp-action="ForgotPassword"
                  method="post"
                  class="auth-form"
                  id="forgotPasswordForm"
                  novalidate>

                @Html.AntiForgeryToken()

                <!-- CAPTCHA DATA -->
                <input type="hidden" id="lotNumber" name="lotNumber" />
                <input type="hidden" id="captchaOutput" name="captchaOutput" />
                <input type="hidden" id="passToken" name="passToken" />
                <input type="hidden" id="genTime" name="genTime" />

                <!-- FORM HEADER -->
                <h1>Quên mật khẩu?</h1>
                <p class="form-subtitle">
                    Nhập email đã đăng ký để nhận liên kết khôi phục tài khoản.
                </p>

                <!-- SUCCESS MESSAGE -->
                @if (ViewBag.Notice != null)
                {
                    <div class="success-message" role="status">
                        <i class="fa-solid fa-circle-check me-2" aria-hidden="true"></i>
                        <span>@ViewBag.Notice</span>
                    </div>
                }

                <!-- VALIDATION SUMMARY -->
                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors"
                     role="alert"
                     aria-live="polite">
                </div>

                <!-- EMAIL FIELD -->
                <div class="field-group">
                    <label asp-for="Email" class="field-label">Địa chỉ email</label>
                    <div class="auth-field">
                        <i class="fa-solid fa-envelope field-icon" aria-hidden="true"></i>
                        <input asp-for="Email"
                               type="email"
                               id="forgotEmail"
                               placeholder="abc@gmail.com"
                               autocomplete="email"
                               aria-describedby="Email-error"
                               required />
                    </div>
                    <span asp-validation-for="Email" id="Email-error" class="field-validation-error"></span>
                </div>

                <!-- CAPTCHA MESSAGE -->
                <div id="captchaMessage" class="captcha-message" role="status" aria-live="polite"></div>

                <!-- SUBMIT BUTTON -->
                <button type="submit" class="primary-button" id="forgotButton">
                    <span class="button-spinner" aria-hidden="true"></span>
                    <span class="button-label">Gửi liên kết khôi phục</span>
                </button>

                <!-- SWITCH AUTH -->
                <p class="switch-auth">
                    Đã nhớ mật khẩu?
                    <a asp-controller="Auth" asp-action="Login">
                        Quay lại đăng nhập
                    </a>
                </p>

            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://static.geetest.com/v4/gt4.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("forgotPasswordForm");
            const button = document.getElementById("forgotButton");
            const message = document.getElementById("captchaMessage");

            const captchaId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(captchaId ?? ""));

            let captchaObj = null;
            let verified = false;

            function setLoading(isLoading) {
                if (!button) return;
                button.classList.toggle("is-loading", isLoading);
                button.disabled = isLoading;
            }

            function initCaptcha() {
                if (!captchaId || typeof initGeetest4 !== "function") {
                    return;
                }

                if (captchaObj && typeof captchaObj.destroy === "function") {
                    captchaObj.destroy();
                }

                initGeetest4(
                    {
                        captchaId: captchaId,
                        product: "bind",
                        riskType: "slide"
                    },
                    function (captcha) {
                        captchaObj = captcha;

                        captcha.onSuccess(function () {
                            const result = captcha.getValidate();
                            if (!result) {
                                setLoading(false);
                                return;
                            }

                            document.getElementById("lotNumber").value = result.lot_number || "";
                            document.getElementById("captchaOutput").value = result.captcha_output || "";
                            document.getElementById("passToken").value = result.pass_token || "";
                            document.getElementById("genTime").value = result.gen_time || "";

                            verified = true;
                            setLoading(true);
                            form.submit();
                        });

                        captcha.onClose(function () {
                            setLoading(false);
                        });

                        captcha.onError(function () {
                            setLoading(false);
                            if (message) message.textContent = "Không tải được CAPTCHA. Vui lòng thử lại sau.";
                        });
                    }
                );
            }

            initCaptcha();

            if (form) {
                form.addEventListener("submit", function (e) {
                    if (verified) return;

                    e.preventDefault();

                    if (window.jQuery && $(form).length && !$(form).valid()) {
                        return;
                    }

                    if (!captchaId || !captchaObj) {
                        // Nếu captcha không cấu hình hoặc không tải được, cho submit trực tiếp
                        verified = true;
                        setLoading(true);
                        form.submit();
                        return;
                    }

                    setLoading(true);
                    captchaObj.showCaptcha();
                });
            }
        });
    </script>
}
