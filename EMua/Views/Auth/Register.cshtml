@model EMua.ViewModels.RegisterViewModel
@inject IConfiguration Configuration
@{
    Layout = "_Layout"; ViewData["Title"] = "Đăng ký"; var captchaId = Configuration["GeeTest:Register:CaptchaId"];
}
<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
<section class="auth-section">
    <div class="auth-page">
        <aside class="auth-brand"><div class="brand-logo">EMUA</div><p>Mua sắm thông minh<br /><strong>cùng EMUA</strong></p><span>Khám phá hơn 10,000+ sản phẩm điện tử chính hãng với giá tốt nhất, giao hàng nhanh và đổi trả linh hoạt.</span><ul class="auth-benefits"><li><i class="bi bi-check-circle"></i> Hơn 500K khách hàng tin dùng</li><li><i class="bi bi-check-circle"></i> Bảo hành chính hãng 100%</li><li><i class="bi bi-check-circle"></i> Hoàn tiền trong 30 ngày</li><li><i class="bi bi-check-circle"></i> Hỗ trợ 24/7</li></ul></aside>
        <div class="auth-form-area">
            <form id="registerForm" asp-action="Register" method="post" class="auth-form">
                <h1>Tạo tài khoản</h1><p class="form-subtitle">Tham gia cộng đồng hơn 500K khách hàng.</p><div class="social-auth"><a asp-controller="Auth" asp-action="ExternalLogin" asp-route-provider="Google" class="social-auth-btn social-google-btn"><i class="bi bi-google"></i> Google</a><a asp-controller="Auth" asp-action="ExternalLogin" asp-route-provider="Facebook" class="social-auth-btn social-facebook-btn"><i class="bi bi-facebook"></i> Facebook</a></div><div class="auth-divider"><span></span><small>hoặc tiếp tục với email</small><span></span></div><div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                <div class="auth-field"><i class="bi bi-person"></i><input asp-for="FullName" autocomplete="name" placeholder="Họ và tên" /></div><span asp-validation-for="FullName"></span><div class="auth-field"><i class="bi bi-telephone"></i><input asp-for="PhoneNumber" autocomplete="tel" placeholder="Số điện thoại" /></div><span asp-validation-for="PhoneNumber"></span><div class="auth-field"><i class="bi bi-envelope"></i><input asp-for="Email" autocomplete="email" placeholder="Địa chỉ email" /></div><span asp-validation-for="Email"></span><div class="auth-field"><i class="bi bi-lock"></i><input asp-for="Password" autocomplete="new-password" placeholder="Mật khẩu" /></div><span asp-validation-for="Password"></span><div class="auth-field"><i class="bi bi-lock"></i><input asp-for="ConfirmPassword" autocomplete="new-password" placeholder="Xác nhận mật khẩu" /></div><span asp-validation-for="ConfirmPassword"></span>
                <label class="check-row"><input asp-for="AcceptTerms" /><span>Tôi đồng ý với <a href="#">Điều khoản dịch vụ</a> và <a href="#">Chính sách bảo mật</a></span></label><span asp-validation-for="AcceptTerms"></span>
                <input type="hidden" name="lotNumber" id="registerLotNumber" /><input type="hidden" name="captchaOutput" id="registerCaptchaOutput" /><input type="hidden" name="passToken" id="registerPassToken" /><input type="hidden" name="genTime" id="registerGenTime" /><div id="registerCaptchaMessage" class="captcha-message"></div><button type="submit" class="primary-button">Tạo tài khoản</button><p class="switch-auth">Đã có tài khoản? <a asp-action="Login">Đăng nhập</a></p>
            </form>
        </div>
    </div>
</section>
@section Scripts {
    <partial name="_ValidationScriptsPartial" /><script src="https://static.geetest.com/v4/gt4.js"></script>
    <script>
        (() => { const form=document.getElementById('registerForm'), msg=document.getElementById('registerCaptchaMessage'); let captcha; initGeetest4({ captchaId:'@captchaId', product:'bind', riskType:'slide' }, o => { captcha=o; o.onSuccess(() => { const r=o.getValidate(); document.getElementById('registerLotNumber').value=r.lot_number; document.getElementById('registerCaptchaOutput').value=r.captcha_output; document.getElementById('registerPassToken').value=r.pass_token; document.getElementById('registerGenTime').value=r.gen_time; form.dataset.verified='true'; form.submit(); }); }); form.addEventListener('submit', e => { if(form.dataset.verified==='true') return; e.preventDefault(); if(!form.checkValidity()){form.reportValidity();return;} if(!captcha){msg.textContent='CAPTCHA đang tải, vui lòng thử lại.';return;} captcha.showCaptcha(); }); })();
    </script>
}
