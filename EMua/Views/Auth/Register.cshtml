@model EMua.ViewModels.RegisterViewModel
@inject IConfiguration Configuration

@{
    ViewData["Title"] = "Đăng ký";
    var captchaId = Configuration["GeeTest:Register:CaptchaId"];
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />

<section class="auth-section">
    <div class="auth-page auth-page--single">
        <!-- FORM AREA -->
        <div class="auth-form-area">
            <form asp-controller="Auth"
                  asp-action="Register"
                  method="post"
                  class="auth-form"
                  id="registerForm"
                  novalidate>

                @Html.AntiForgeryToken()

                <!-- CAPTCHA DATA -->
                <input type="hidden" id="lotNumber" name="lotNumber" />
                <input type="hidden" id="captchaOutput" name="captchaOutput" />
                <input type="hidden" id="passToken" name="passToken" />
                <input type="hidden" id="genTime" name="genTime" />

                <!-- TITLE -->
                <div class="auth-header">
                    <h1 class="auth-title">TẠO TÀI KHOẢN</h1>
                    <p class="form-subtitle">
                        Đăng ký tài khoản EMUA miễn phí — chỉ mất chưa đến một phút.
                    </p>
                </div>

                <!-- SOCIAL REGISTER -->
                <div class="social-auth">
                    <a asp-controller="Auth"
                       asp-action="ExternalLogin"
                       asp-route-provider="Google"
                       class="social-auth-btn social-google">
                        <span class="social-icon google-icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path fill="#4285F4" d="M21.6 12.227c0-.709-.064-1.391-.182-2.045H12v3.873h5.382a4.6 4.6 0 0 1-1.995 3.018v2.509h3.227c1.889-1.736 2.986-4.3 2.986-7.355z" />
                                <path fill="#34A853" d="M12 22c2.7 0 4.964-.895 6.614-2.418l-3.227-2.509c-.895.6-2.041.955-3.387.955-2.605 0-4.809-1.759-5.6-4.123H3.064v2.591A9.996 9.996 0 0 0 12 22z" />
                                <path fill="#FBBC05" d="M6.4 13.905A6.02 6.02 0 0 1 6.086 12c0-.66.114-1.3.314-1.905V7.504H3.064A9.997 9.997 0 0 0 2 12c0 1.614.386 3.141 1.064 4.496L6.4 13.905z" />
                                <path fill="#EA4335" d="M12 5.973c1.468 0 2.786.505 3.823 1.496l2.864-2.864C16.959 2.995 14.695 2 12 2a9.996 9.996 0 0 0-8.936 5.504L6.4 10.095C7.191 7.732 9.395 5.973 12 5.973z" />
                            </svg>
                        </span>
                        <span>Google</span>
                    </a>

                    <a asp-controller="Auth"
                       asp-action="ExternalLogin"
                       asp-route-provider="Facebook"
                       class="social-auth-btn social-facebook">
                        <span class="social-icon facebook-icon" aria-hidden="true">
                            <i class="fa-brands fa-facebook-f"></i>
                        </span>
                        <span>Facebook</span>
                    </a>
                </div>

                <div class="auth-divider">
                    <span>hoặc</span>
                </div>

                <!-- VALIDATION SUMMARY -->
                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors"
                     role="alert"
                     aria-live="polite">
                </div>

                <!-- FULL NAME -->
                <div class="field-group">
                    <label asp-for="FullName" class="field-label">Họ và tên</label>
                    <div class="auth-field">
                        <i class="fa-solid fa-user field-icon" aria-hidden="true"></i>
                        <input asp-for="FullName"
                               type="text"
                               placeholder="Nguyễn Văn A"
                               autocomplete="name"
                               aria-describedby="FullName-error" />
                    </div>
                    <span asp-validation-for="FullName" id="FullName-error" class="field-validation-error"></span>
                </div>

                <!-- EMAIL -->
                <div class="field-group">
                    <label asp-for="Email" class="field-label">Email</label>
                    <div class="auth-field">
                        <i class="fa-solid fa-envelope field-icon" aria-hidden="true"></i>
                        <input asp-for="Email"
                               type="email"
                               placeholder="abc@gmail.com"
                               autocomplete="email"
                               aria-describedby="Email-error" />
                    </div>
                    <span asp-validation-for="Email" id="Email-error" class="field-validation-error"></span>
                </div>

                <!-- PHONE -->
                <div class="field-group">
                    <label asp-for="PhoneNumber" class="field-label">Số điện thoại</label>
                    <div class="auth-field">
                        <i class="fa-solid fa-phone field-icon" aria-hidden="true"></i>
                        <input asp-for="PhoneNumber"
                               type="tel"
                               placeholder="0xxx xxx xxx"
                               autocomplete="tel"
                               inputmode="tel"
                               aria-describedby="PhoneNumber-error" />
                    </div>
                    <span asp-validation-for="PhoneNumber" id="PhoneNumber-error" class="field-validation-error"></span>
                </div>

                <!-- PASSWORD -->
                <div class="field-group">
                    <label asp-for="Password" class="field-label">Mật khẩu</label>
                    <div class="auth-field">
                        <i class="fa-solid fa-lock field-icon" aria-hidden="true"></i>
                        <input asp-for="Password"
                               type="password"
                               id="registerPassword"
                               placeholder="Tối thiểu 8 ký tự"
                               autocomplete="new-password"
                               aria-describedby="Password-error password-hint" />

                        <button type="button"
                                class="field-toggle"
                                data-toggle-target="registerPassword"
                                aria-label="Hiện mật khẩu"
                                aria-pressed="false">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>

                    <!-- PASSWORD STRENGTH -->
                    <div class="password-strength" id="passwordStrength" data-level="0" aria-hidden="true">
                        <div class="strength-track">
                            <span class="strength-segment"></span>
                            <span class="strength-segment"></span>
                            <span class="strength-segment"></span>
                            <span class="strength-segment"></span>
                        </div>
                        <span class="strength-label" id="strengthLabel">&nbsp;</span>
                    </div>

                    <p class="field-hint" id="password-hint">
                        Dùng ít nhất 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt.
                    </p>
                    <span asp-validation-for="Password" id="Password-error" class="field-validation-error"></span>
                </div>

                <!-- CONFIRM PASSWORD -->
                <div class="field-group">
                    <label asp-for="ConfirmPassword" class="field-label">Nhập lại mật khẩu</label>
                    <div class="auth-field">
                        <i class="fa-solid fa-shield-halved field-icon" aria-hidden="true"></i>
                        <input asp-for="ConfirmPassword"
                               type="password"
                               id="registerConfirmPassword"
                               placeholder="Nhập lại mật khẩu"
                               autocomplete="new-password"
                               aria-describedby="ConfirmPassword-error" />

                        <button type="button"
                                class="field-toggle"
                                data-toggle-target="registerConfirmPassword"
                                aria-label="Hiện mật khẩu"
                                aria-pressed="false">
                            <i class="fa-solid fa-eye" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" id="ConfirmPassword-error" class="field-validation-error"></span>
                </div>

                <!-- TERMS -->
                <label class="check-row register-terms">
                    <input asp-for="AcceptTerms" type="checkbox" id="acceptTermsCheckbox" />
                    <span>Tôi đồng ý với <a asp-controller="Home" asp-action="Terms" target="_blank">điều khoản sử dụng</a> của EMUA.</span>
                </label>
                <span asp-validation-for="AcceptTerms" id="AcceptTerms-error" class="field-validation-error"></span>

                <!-- CAPTCHA MESSAGE -->
                <div id="captchaMessage" class="captcha-message" role="status" aria-live="polite"></div>

                <!-- REGISTER BUTTON -->
                <button type="submit" class="primary-button" id="registerButton">
                    <span class="button-spinner" aria-hidden="true"></span>
                    <span class="button-label">Đăng ký tài khoản</span>
                </button>

                <!-- LOGIN LINK -->
                <p class="switch-auth">
                    Đã có tài khoản?
                    <a asp-controller="Auth" asp-action="Login">Đăng nhập</a>
                </p>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="https://static.geetest.com/v4/gt4.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("registerForm");
            const button = document.getElementById("registerButton");
            const message = document.getElementById("captchaMessage");

            const captchaId = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(captchaId ?? ""));

            let captchaObj = null;
            let verified = false;

            /* SHOW / HIDE PASSWORD */
            document.querySelectorAll(".field-toggle").forEach(function (toggle) {
                toggle.addEventListener("click", function () {
                    const targetId = toggle.getAttribute("data-toggle-target");
                    const input = document.getElementById(targetId);
                    const icon = toggle.querySelector("i");
                    if (!input) return;

                    const isHidden = input.type === "password";
                    input.type = isHidden ? "text" : "password";
                    toggle.setAttribute("aria-pressed", isHidden ? "true" : "false");
                    if (icon) {
                        icon.classList.toggle("fa-eye", !isHidden);
                        icon.classList.toggle("fa-eye-slash", isHidden);
                    }
                });
            });

            function setLoading(isLoading) {
                if (!button) return;
                button.classList.toggle("is-loading", isLoading);
                button.disabled = isLoading;
            }

            function initCaptcha() {
                if (!captchaId || typeof initGeetest4 !== "function") {
                    if (message) message.textContent = "Chưa cấu hình CAPTCHA.";
                    return;
                }

                if (captchaObj && typeof captchaObj.destroy === "function") {
                    captchaObj.destroy();
                }

                initGeetest4(
                    {
                        captchaId: captchaId,
                        product: "bind",
                        riskType: "slide"
                    },
                    function (captcha) {
                        captchaObj = captcha;

                        captcha.onSuccess(function () {
                            const result = captcha.getValidate();
                            if (!result) {
                                setLoading(false);
                                return;
                            }

                            document.getElementById("lotNumber").value = result.lot_number || "";
                            document.getElementById("captchaOutput").value = result.captcha_output || "";
                            document.getElementById("passToken").value = result.pass_token || "";
                            document.getElementById("genTime").value = result.gen_time || "";

                            verified = true;
                            if (message) message.textContent = "";

                            setLoading(true);
                            form.submit();
                        });

                        captcha.onClose(function () {
                            setLoading(false);
                        });

                        captcha.onError(function (error) {
                            console.error("GeeTest Register ERROR:", error);
                            setLoading(false);
                        });
                    }
                );
            }

            initCaptcha();

            function validateRegistrationForm() {
                let isValid = true;
                let firstInvalidEl = null;

                function setError(inputEl, errorSpanId, message) {
                    const span = document.getElementById(errorSpanId);
                    if (span) {
                        span.textContent = message;
                        span.style.display = message ? "block" : "none";
                    }
                    if (inputEl) {
                        if (message) {
                            inputEl.classList.add("input-validation-error");
                            inputEl.setAttribute("aria-invalid", "true");
                            if (!firstInvalidEl) firstInvalidEl = inputEl;
                        } else {
                            inputEl.classList.remove("input-validation-error");
                            inputEl.removeAttribute("aria-invalid");
                        }
                    }
                    if (message) isValid = false;
                }

                // 1. Họ và tên
                const fullNameInput = document.querySelector('input[name="FullName"]');
                const fullNameVal = (fullNameInput?.value || "").trim();
                if (!fullNameVal) {
                    setError(fullNameInput, "FullName-error", "Vui lòng nhập họ và tên.");
                } else if (fullNameVal.length < 2 || fullNameVal.length > 100) {
                    setError(fullNameInput, "FullName-error", "Họ và tên phải từ 2 đến 100 ký tự.");
                } else {
                    setError(fullNameInput, "FullName-error", "");
                }

                // 2. Email
                const emailInput = document.querySelector('input[name="Email"]');
                const emailVal = (emailInput?.value || "").trim();
                const emailRegex = new RegExp("^[A-Za-z0-9](?:[A-Za-z0-9._%+\\-]*[A-Za-z0-9])?@@[A-Za-z0-9](?:[A-Za-z0-9\\-]*[A-Za-z0-9])?(?:\\.[A-Za-z0-9](?:[A-Za-z0-9\\-]*[A-Za-z0-9])?)*\\.[A-Za-z]{2,}$");
                if (!emailVal) {
                    setError(emailInput, "Email-error", "Vui lòng nhập email.");
                } else if (!emailRegex.test(emailVal)) {
                    setError(emailInput, "Email-error", "Email không đúng định dạng hợp lệ.");
                } else {
                    setError(emailInput, "Email-error", "");
                }

                // 3. Số điện thoại (Việt Nam: 10 số, bắt đầu bằng 0 hoặc +84)
                const phoneInput = document.querySelector('input[name="PhoneNumber"]');
                const phoneVal = (phoneInput?.value || "").trim().replace(/\s+/g, "");
                const phoneRegex = /^(0|\+84)(3|5|7|8|9)[0-9]{8}$/;
                if (!phoneVal) {
                    setError(phoneInput, "PhoneNumber-error", "Vui lòng nhập số điện thoại.");
                } else if (!phoneRegex.test(phoneVal)) {
                    setError(phoneInput, "PhoneNumber-error", "Số điện thoại Việt Nam không hợp lệ (10 số, bắt đầu bằng 0).");
                } else {
                    setError(phoneInput, "PhoneNumber-error", "");
                }

                // 4. Mật khẩu
                const passInput = document.getElementById("registerPassword");
                const passVal = passInput?.value || "";
                if (!passVal) {
                    setError(passInput, "Password-error", "Vui lòng nhập mật khẩu.");
                } else if (passVal.length < 8 || passVal.length > 64) {
                    setError(passInput, "Password-error", "Mật khẩu phải từ 8 đến 64 ký tự.");
                } else {
                    setError(passInput, "Password-error", "");
                }

                // 5. Xác nhận mật khẩu
                const confirmPassInput = document.getElementById("registerConfirmPassword");
                const confirmPassVal = confirmPassInput?.value || "";
                if (!confirmPassVal) {
                    setError(confirmPassInput, "ConfirmPassword-error", "Vui lòng xác nhận mật khẩu.");
                } else if (confirmPassVal !== passVal) {
                    setError(confirmPassInput, "ConfirmPassword-error", "Xác nhận mật khẩu không trùng khớp.");
                } else {
                    setError(confirmPassInput, "ConfirmPassword-error", "");
                }

                // 6. Điều khoản sử dụng
                const termsCheckbox = document.getElementById("acceptTermsCheckbox");
                if (!termsCheckbox || !termsCheckbox.checked) {
                    setError(termsCheckbox, "AcceptTerms-error", "Bạn cần đồng ý với điều khoản sử dụng của EMUA.");
                } else {
                    setError(termsCheckbox, "AcceptTerms-error", "");
                }

                // Nếu có jQuery Validation thì kết hợp validate
                if (window.jQuery && window.jQuery.validator && !window.jQuery(form).valid()) {
                    isValid = false;
                }

                if (!isValid && firstInvalidEl) {
                    try {
                        firstInvalidEl.focus();
                        firstInvalidEl.scrollIntoView({ behavior: "smooth", block: "center" });
                    } catch (e) { }
                }

                return isValid;
            }

            // Gắn lắng nghe real-time để xóa thông báo lỗi khi người dùng sửa
            ["FullName", "Email", "PhoneNumber"].forEach(name => {
                const el = document.querySelector(`input[name="${name}"]`);
                if (el) {
                    el.addEventListener("input", function () {
                        const span = document.getElementById(`${name}-error`);
                        if (span && el.value.trim()) {
                            span.textContent = "";
                            el.classList.remove("input-validation-error");
                        }
                    });
                }
            });

            const passInput = document.getElementById("registerPassword");
            const confirmPassInput = document.getElementById("registerConfirmPassword");
            const termsCheckbox = document.getElementById("acceptTermsCheckbox");

            if (passInput) {
                passInput.addEventListener("input", () => {
                    const span = document.getElementById("Password-error");
                    if (span && passInput.value.length >= 8) {
                        span.textContent = "";
                        passInput.classList.remove("input-validation-error");
                    }
                });
            }

            if (confirmPassInput) {
                confirmPassInput.addEventListener("input", () => {
                    const span = document.getElementById("ConfirmPassword-error");
                    if (span && confirmPassInput.value === passInput?.value) {
                        span.textContent = "";
                        confirmPassInput.classList.remove("input-validation-error");
                    }
                });
            }

            if (termsCheckbox) {
                termsCheckbox.addEventListener("change", () => {
                    const span = document.getElementById("AcceptTerms-error");
                    if (span && termsCheckbox.checked) {
                        span.textContent = "";
                        termsCheckbox.classList.remove("input-validation-error");
                    }
                });
            }

            // Lắng nghe submit và click nút
            button?.addEventListener("click", function (event) {
                if (verified) return;

                const isValid = validateRegistrationForm();
                if (!isValid) {
                    event.preventDefault();
                    event.stopPropagation();
                    if (typeof event.stopImmediatePropagation === "function") {
                        event.stopImmediatePropagation();
                    }
                    return false;
                }
            });

            form.addEventListener("submit", function (event) {
                if (verified) return;

                event.preventDefault();
                event.stopPropagation();
                if (typeof event.stopImmediatePropagation === "function") {
                    event.stopImmediatePropagation();
                }

                // Chạy kiểm tra toàn diện Client-side validation
                const isValid = validateRegistrationForm();
                if (!isValid) {
                    return;
                }

                if (!captchaObj) {
                    if (message) message.textContent = "Hệ thống bảo vệ CAPTCHA đang tải. Vui lòng thử lại sau giây lát.";
                    return;
                }

                setLoading(true);
                captchaObj.showCaptcha();
            });
        });
    </script>
}