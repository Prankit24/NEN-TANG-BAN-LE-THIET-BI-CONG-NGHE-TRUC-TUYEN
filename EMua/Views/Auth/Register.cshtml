@model EMua.ViewModels.RegisterViewModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Đăng ký";

    var captchaId = Configuration["GeeTest:Register:CaptchaId"];
}


<section class="auth-section">

    <div class="auth-page">

        <!-- LEFT -->
        <div class="auth-brand">

            <div class="brand-logo">
                EMUA
            </div>

            <p>
                Bắt đầu hành trình<br />
                công nghệ của bạn.
            </p>

            <span>
                Tạo tài khoản EMUA để khám phá,
                mua sắm và quản lý sản phẩm công nghệ
                một cách dễ dàng.
            </span>

            <ul class="auth-benefits">

                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Sản phẩm chính hãng
                </li>

                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Giá cả minh bạch
                </li>

                <li>
                    <i class="fa-solid fa-circle-check"></i>
                    Mua sắm an toàn
                </li>

            </ul>

        </div>


        <!-- RIGHT -->
        <div class="auth-form-area">

            <form asp-controller="Auth"
                  asp-action="Register"
                  method="post"
                  class="auth-form"
                  id="registerForm">

                @Html.AntiForgeryToken()


                <!-- CAPTCHA DATA -->

                <input type="hidden"
                       id="lotNumber"
                       name="lotNumber" />

                <input type="hidden"
                       id="captchaOutput"
                       name="captchaOutput" />

                <input type="hidden"
                       id="passToken"
                       name="passToken" />

                <input type="hidden"
                       id="genTime"
                       name="genTime" />


                <h1>
                    Tạo tài khoản
                </h1>

                <p class="form-subtitle">
                    Đăng ký tài khoản EMUA miễn phí
                </p>


                <!-- VALIDATION -->

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary-errors">
                </div>


                <!-- FULL NAME -->

                <div class="auth-field">

                    <i class="fa-solid fa-user"></i>

                    <input asp-for="FullName"
                           type="text"
                           placeholder="Họ và tên"
                           autocomplete="name" />

                </div>

                <span asp-validation-for="FullName"
                      class="field-validation-error">
                </span>


                <!-- EMAIL -->

                <div class="auth-field">

                    <i class="fa-solid fa-envelope"></i>

                    <input asp-for="Email"
                           type="email"
                           placeholder="Email"
                           autocomplete="email" />

                </div>

                <span asp-validation-for="Email"
                      class="field-validation-error">
                </span>


                <!-- PHONE -->

                <div class="auth-field">

                    <i class="fa-solid fa-phone"></i>

                    <input asp-for="PhoneNumber"
                           type="tel"
                           placeholder="Số điện thoại"
                           autocomplete="tel" />

                </div>

                <span asp-validation-for="PhoneNumber"
                      class="field-validation-error">
                </span>


                <!-- PASSWORD -->

                <div class="auth-field">

                    <i class="fa-solid fa-lock"></i>

                    <input asp-for="Password"
                           type="password"
                           placeholder="Mật khẩu"
                           autocomplete="new-password" />

                </div>

                <span asp-validation-for="Password"
                      class="field-validation-error">
                </span>


                <!-- CONFIRM PASSWORD -->

                <div class="auth-field">

                    <i class="fa-solid fa-shield-halved"></i>

                    <input asp-for="ConfirmPassword"
                           type="password"
                           placeholder="Nhập lại mật khẩu"
                           autocomplete="new-password" />

                </div>

                <span asp-validation-for="ConfirmPassword"
                      class="field-validation-error">
                </span>


                <!-- TERMS -->

                <label class="check-row">

                    <input asp-for="AcceptTerms"
                           type="checkbox" />

                    <span>
                        Tôi đồng ý với
                        <a href="#">
                            điều khoản sử dụng
                        </a>
                        của EMUA.
                    </span>

                </label>

                <span asp-validation-for="AcceptTerms"
                      class="field-validation-error">
                </span>


                <!-- CAPTCHA MESSAGE -->

                <div id="captchaMessage"
                     class="captcha-message">
                </div>


                <!-- REGISTER -->

                <button type="submit"
                        class="primary-button"
                        id="registerButton">

                    Đăng ký tài khoản

                </button>


                <!-- LOGIN -->

                <p class="switch-auth">

                    Đã có tài khoản?

                    <a asp-controller="Auth"
                       asp-action="Login">

                        Đăng nhập

                    </a>

                </p>

            </form>

        </div>

    </div>

</section>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />


    <!-- GEETEST V4 -->

    <script src="https://static.geetest.com/v4/gt4.js"></script>


    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const form =
                document.getElementById("registerForm");

            const button =
                document.getElementById("registerButton");

            const message =
                document.getElementById("captchaMessage");


            /*
             * Lấy CAPTCHA ID từ Render
             *
             * GeeTest__Register__CaptchaId
             *        ↓
             * GeeTest:Register:CaptchaId
             */

            const captchaId = @Html.Raw(
                            System.Text.Json.JsonSerializer.Serialize(captchaId ?? "")
                    );


        let captchaObj = null;

            let captchaReady = false;

            let verified = false;


            console.log("===== GEETEST REGISTER =====");

            console.log(
                "CaptchaId:",
                captchaId
            );


            /*
             * KIỂM TRA CAPTCHA ID
             */

            if (!captchaId) {

                console.error(
                    "GeeTest Register CaptchaId chưa được cấu hình."
                );

                message.textContent =
                    "CAPTCHA chưa được cấu hình trên máy chủ.";

                button.disabled = true;

                return;
            }


            /*
             * KIỂM TRA SCRIPT
             */

            if (typeof initGeetest4 !== "function") {

                console.error(
                    "Không tìm thấy initGeetest4."
                );

                message.textContent =
                    "Không thể tải CAPTCHA. Vui lòng tải lại trang.";

                return;
            }


            /*
             * KHỞI TẠO GEETEST
             */

            initGeetest4(

                {
                    captchaId: captchaId,

                    product: "bind",

                    riskType: "slide"
                },

                function (captcha) {

                    captchaObj = captcha;


                    console.log(
                        "GeeTest Register đã khởi tạo:",
                        captcha
                    );


                    /*
                     * CAPTCHA READY
                     */

                    captcha.onReady(function () {

                        captchaReady = true;

                        console.log(
                            "GeeTest Register READY"
                        );

                    });


                    /*
                     * CAPTCHA SUCCESS
                     */

                    captcha.onSuccess(function () {

                        console.log(
                            "GeeTest Register SUCCESS"
                        );


                        const result =
                            captcha.getValidate();


                        if (!result) {

                            console.error(
                                "Không lấy được kết quả CAPTCHA."
                            );

                            message.textContent =
                                "Không lấy được kết quả CAPTCHA.";

                            verified = false;

                            return;
                        }


                        /*
                         * ĐƯA DATA CAPTCHA VÀO FORM
                         */

                        document.getElementById("lotNumber").value =
                            result.lot_number || "";

                        document.getElementById("captchaOutput").value =
                            result.captcha_output || "";

                        document.getElementById("passToken").value =
                            result.pass_token || "";

                        document.getElementById("genTime").value =
                            result.gen_time || "";


                        verified = true;

                        message.textContent = "";


                        console.log(
                            "GeeTest data đã được thêm vào form."
                        );


                        /*
                         * SUBMIT FORM
                         */

                        form.submit();

                    });


                    /*
                     * CAPTCHA ERROR
                     */

                    captcha.onError(function (error) {

                        console.error(
                            "GeeTest Register ERROR:",
                            error
                        );


                        verified = false;


                        message.textContent =
                            "Không thể xác minh CAPTCHA. Vui lòng thử lại.";

                    });

                }

            );


            /*
             * SUBMIT FORM
             */

            form.addEventListener("submit", function (event) {


                /*
                 * CAPTCHA ĐÃ XÁC MINH
                 */

                if (verified) {

                    return;

                }


                /*
                 * CHẶN SUBMIT
                 */

                event.preventDefault();


                /*
                 * KIỂM TRA FORM
                 */

                if (!form.checkValidity()) {

                    form.reportValidity();

                    return;

                }


                /*
                 * CAPTCHA CHƯA INIT
                 */

                if (!captchaObj) {

                    console.error(
                        "captchaObj chưa được khởi tạo."
                    );

                    message.textContent =
                        "CAPTCHA chưa sẵn sàng. Vui lòng tải lại trang.";

                    return;

                }


                /*
                 * CAPTCHA CHƯA READY
                 */

                if (!captchaReady) {

                    console.log(
                        "CAPTCHA chưa READY."
                    );

                    message.textContent =
                        "CAPTCHA đang tải, vui lòng thử lại sau giây lát.";

                    return;

                }


                /*
                 * XÓA CAPTCHA CŨ
                 */

                document.getElementById("lotNumber").value = "";

                document.getElementById("captchaOutput").value = "";

                document.getElementById("passToken").value = "";

                document.getElementById("genTime").value = "";


                /*
                 * HIỆN CAPTCHA
                 */

                console.log(
                    "Hiển thị GeeTest Register..."
                );


                captchaObj.showCaptcha();

            });


            /*
             * NẾU USER THAY ĐỔI THÔNG TIN
             * → BẮT CAPTCHA LẠI
             */

            form.querySelectorAll("input").forEach(function (input) {

                input.addEventListener("input", function () {

                    if (

                        input.name === "FullName" ||

                        input.name === "Email" ||

                        input.name === "PhoneNumber" ||

                        input.name === "Password" ||

                        input.name === "ConfirmPassword"

                    ) {

                        verified = false;

                    }

                });

            });

        });

    </script>
}