@model EMua.ViewModels.RegisterViewModel
@inject IConfiguration Configuration

@{
    Layout = "_Layout";
    ViewData["Title"] = "Đăng ký";

    var captchaId = Configuration["GeeTest:Register:CaptchaId"];
}

<link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />

<section class="auth-section">
    <div class="auth-page">

        <aside class="auth-brand">

            <div class="brand-logo">
                EMUA
            </div>

            <p>
                Mua sắm thông minh<br />
                <strong>cùng EMUA</strong>
            </p>

            <span>
                Khám phá hơn 10,000+ sản phẩm điện tử chính hãng
                với giá tốt nhất, giao hàng nhanh và đổi trả linh hoạt.
            </span>

            <ul class="auth-benefits">

                <li>
                    <i class="bi bi-check-circle"></i>
                    Hơn 500K khách hàng tin dùng
                </li>

                <li>
                    <i class="bi bi-check-circle"></i>
                    Bảo hành chính hãng 100%
                </li>

                <li>
                    <i class="bi bi-check-circle"></i>
                    Hoàn tiền trong 30 ngày
                </li>

                <li>
                    <i class="bi bi-check-circle"></i>
                    Hỗ trợ 24/7
                </li>

            </ul>

        </aside>

        <div class="auth-form-area">

            <form id="registerForm"
                  asp-action="Register"
                  method="post"
                  class="auth-form">

                <h1>Tạo tài khoản</h1>

                <p class="form-subtitle">
                    Tham gia cộng đồng hơn 500K khách hàng.
                </p>

                <div class="social-auth">

                    <a asp-controller="Auth"
                       asp-action="ExternalLogin"
                       asp-route-provider="Google"
                       class="social-auth-btn social-google-btn">

                        <i class="bi bi-google"></i>
                        Google

                    </a>

                    <a asp-controller="Auth"
                       asp-action="ExternalLogin"
                       asp-route-provider="Facebook"
                       class="social-auth-btn social-facebook-btn">

                        <i class="bi bi-facebook"></i>
                        Facebook

                    </a>

                </div>

                <div class="auth-divider">
                    <span></span>
                    <small>hoặc tiếp tục với email</small>
                    <span></span>
                </div>

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary">
                </div>

                <div class="auth-field">

                    <i class="bi bi-person"></i>

                    <input asp-for="FullName"
                           autocomplete="name"
                           placeholder="Họ và tên" />

                </div>

                <span asp-validation-for="FullName"></span>

                <div class="auth-field">

                    <i class="bi bi-telephone"></i>

                    <input asp-for="PhoneNumber"
                           autocomplete="tel"
                           placeholder="Số điện thoại" />

                </div>

                <span asp-validation-for="PhoneNumber"></span>

                <div class="auth-field">

                    <i class="bi bi-envelope"></i>

                    <input asp-for="Email"
                           autocomplete="email"
                           placeholder="Địa chỉ email" />

                </div>

                <span asp-validation-for="Email"></span>

                <div class="auth-field">

                    <i class="bi bi-lock"></i>

                    <input asp-for="Password"
                           autocomplete="new-password"
                           placeholder="Mật khẩu" />

                </div>

                <span asp-validation-for="Password"></span>

                <div class="auth-field">

                    <i class="bi bi-lock"></i>

                    <input asp-for="ConfirmPassword"
                           autocomplete="new-password"
                           placeholder="Xác nhận mật khẩu" />

                </div>

                <span asp-validation-for="ConfirmPassword"></span>

                <label class="check-row">

                    <input asp-for="AcceptTerms" />

                    <span>
                        Tôi đồng ý với
                        <a href="#">Điều khoản dịch vụ</a>
                        và
                        <a href="#">Chính sách bảo mật</a>
                    </span>

                </label>

                <span asp-validation-for="AcceptTerms"></span>

                <!-- GeeTest -->
                <input type="hidden"
                       name="lotNumber"
                       id="registerLotNumber" />

                <input type="hidden"
                       name="captchaOutput"
                       id="registerCaptchaOutput" />

                <input type="hidden"
                       name="passToken"
                       id="registerPassToken" />

                <input type="hidden"
                       name="genTime"
                       id="registerGenTime" />

                <div id="registerCaptchaMessage"
                     class="captcha-message">
                </div>

                <button type="submit"
                        class="primary-button">
                    Tạo tài khoản
                </button>

                <p class="switch-auth">
                    Đã có tài khoản?
                    <a asp-action="Login">
                        Đăng nhập
                    </a>
                </p>

            </form>

        </div>
    </div>
</section>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

    <!-- GeeTest v4 -->
    <script src="https://static.geetest.com/v4/gt4.js"></script>

    <script>
        (() => {

            const form =
                document.getElementById("registerForm");

            const msg =
                document.getElementById(
                    "registerCaptchaMessage"
                );

            let captcha = null;

            const captchaId = "@captchaId";

            // Kiểm tra cấu hình CAPTCHA
            if (!captchaId) {

                console.error(
                    "GeeTest Register CaptchaId chưa được cấu hình."
                );

                msg.textContent =
                    "CAPTCHA chưa được cấu hình trên máy chủ.";

                return;
            }

            initGeetest4(
                {
                    captchaId: captchaId,
                    product: "bind",
                    riskType: "slide"
                },
                (captchaObj) => {

                    captcha = captchaObj;

                    captchaObj.onSuccess(() => {

                        const result =
                            captchaObj.getValidate();

                        if (!result) {

                            msg.textContent =
                                "Không lấy được kết quả CAPTCHA.";

                            return;
                        }

                        document.getElementById(
                            "registerLotNumber"
                        ).value = result.lot_number;

                        document.getElementById(
                            "registerCaptchaOutput"
                        ).value = result.captcha_output;

                        document.getElementById(
                            "registerPassToken"
                        ).value = result.pass_token;

                        document.getElementById(
                            "registerGenTime"
                        ).value = result.gen_time;

                        form.dataset.verified = "true";

                        // Submit sau khi CAPTCHA thành công
                        form.submit();
                    });
                }
            );

            form.addEventListener("submit", (event) => {

                // CAPTCHA đã xác minh
                if (form.dataset.verified === "true") {
                    return;
                }

                event.preventDefault();

                // Kiểm tra dữ liệu form
                if (!form.checkValidity()) {

                    form.reportValidity();

                    return;
                }

                // CAPTCHA chưa tải
                if (!captcha) {

                    msg.textContent =
                        "CAPTCHA đang tải, vui lòng thử lại.";

                    return;
                }

                msg.textContent = "";

                // Hiển thị CAPTCHA
                captcha.showCaptcha();
            });

        })();
    </script>
}