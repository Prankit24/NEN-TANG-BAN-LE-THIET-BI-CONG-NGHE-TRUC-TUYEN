@model EMua.ViewModels.AccountProfileViewModel

@{
    ViewData["Title"] = "Hồ sơ của tôi";

    var nextTierAmount = Model.NextTierAmount ?? Model.TotalSpending;

    var progressPercent = nextTierAmount <= 0
        ? 100
        : Math.Min(
            100,
            (int)Math.Round(
                Model.TotalSpending / nextTierAmount * 100));
}

<link rel="stylesheet"
      href="~/css/account.css"
      asp-append-version="true" />

<section class="account-page">
    <div class="container account-container">
        <aside class="account-sidebar">
            <div class="account-user-card">
                @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                {
                    <img src="@Model.AvatarUrl"
                         class="account-avatar account-avatar-image"
                         alt="Ảnh đại diện của @Model.FullName" />
                }
                else
                {
                    <div class="account-avatar">@Model.Initial</div>
                }

                <div class="account-user-info">
                    <strong>@Model.FullName</strong>

                    @if (!Model.IsCustomer)
                    {
                        <small>@Model.Email</small>

                        <span class="role-badge">
                            <i class="bi bi-shield-check"></i>
                            @Model.RoleName
                        </span>
                    }
                </div>

                @if (Model.IsCustomer)
                {
                    <button type="button"
                            class="membership-summary @Model.MembershipCssClass"
                            id="membershipToggle"
                            aria-expanded="false">
                        <span class="membership-tier">
                            <i class="bi bi-award-fill"></i>
                            Hạng @Model.MembershipTier
                        </span>

                        <strong>
                            @Model.TotalSpending.ToString("N0") đ /
                            @nextTierAmount.ToString("N0") đ
                        </strong>

                        <i class="bi bi-chevron-down membership-chevron"></i>
                    </button>

                    <div class="membership-progress-panel"
                         id="membershipProgressPanel">
                        <div class="membership-progress-title">
                            <span>Tiến trình thăng hạng</span>
                            <strong>@progressPercent%</strong>
                        </div>

                        <div class="membership-progress-track">
                            <div class="membership-progress-value"
                                 style="width: @progressPercent%"></div>
                        </div>

                        @if (Model.NextTierAmount != null)
                        {
                            <small>
                                Còn @((Model.NextTierAmount.Value -
                                                        Model.TotalSpending)
                                                        .ToString("N0")) đ
                        để lên hạng tiếp theo.
                    </small>
                                        }
                        else
                        {
                            <small>
                                Bạn đang ở hạng cao nhất của EMUA.
                            </small>
                        }
                    </div>
                }
            </div>

            <nav class="account-menu">
                <a class="active"
                   asp-controller="Account"
                   asp-action="Profile">
                    <i class="bi bi-person"></i>
                    Hồ sơ của tôi
                </a>

                <a asp-controller="Account"
                   asp-action="Edit">
                    <i class="bi bi-pencil-square"></i>
                    Chỉnh sửa hồ sơ
                </a>

                @if (Model.IsCustomer)
                {
                    <a asp-controller="Order" asp-action="Index">
                        <i class="bi bi-box-seam"></i>
                        Đơn hàng
                    </a>

                    <a asp-controller="Favorite" asp-action="Index">
                        <i class="bi bi-heart"></i>
                        Yêu thích
                    </a>
                }
                else if (!Model.IsStaff)
                {
                    <a asp-controller="Product" asp-action="Index">
                        <i class="bi bi-box-seam"></i>
                        Quản lý sản phẩm
                    </a>

                    <a asp-controller="Order" asp-action="Index">
                        <i class="bi bi-receipt"></i>
                        Quản lý đơn hàng
                    </a>
                }
                else
                {
                    <a asp-area="Staff" asp-controller="Dashboard" asp-action="Index">
                        <i class="bi bi-grid-1x2"></i>
                        Khu vực nhân viên
                    </a>
                }

                <form asp-controller="Auth"
                      asp-action="Logout"
                      method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="account-logout">
                        <i class="bi bi-box-arrow-right"></i>
                        Đăng xuất
                    </button>
                </form>
            </nav>
        </aside>

        <div class="profile-card">
            <div class="profile-card-heading">
                <div>
                    <h1>Hồ sơ của tôi</h1>
                    <p>Quản lý thông tin cá nhân của tài khoản EMUA.</p>
                </div>

                <a asp-action="Edit" class="profile-edit-button">
                    <i class="bi bi-pencil"></i>
                    Chỉnh sửa
                </a>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="modal fade"
                     id="profileSuccessModal"
                     tabindex="-1"
                     aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-sm">
                        <div class="modal-content profile-success-modal">
                            <div class="modal-body text-center">
                                <div class="profile-success-icon">
                                    <i class="bi bi-check-lg"></i>
                                </div>

                                <h5>Cập nhật thành công!</h5>
                                <p>@TempData["SuccessMessage"]</p>

                                <button type="button"
                                        class="profile-success-button"
                                        data-bs-dismiss="modal">
                                    Đã hiểu
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="profile-details">
                <div class="profile-detail">
                    <span>Họ và tên</span>
                    <strong>@Model.FullName</strong>
                </div>

                <div class="profile-detail">
                    <span>Email</span>
                    <strong>@Model.Email</strong>
                </div>

                <div class="profile-detail">
                    <span>Số điện thoại</span>
                    <strong>@(Model.PhoneNumber ?? "Chưa cập nhật")</strong>
                </div>

                <div class="profile-detail">
                    <span>Vai trò</span>
                    <strong>@Model.RoleName</strong>
                </div>

                <div class="profile-detail">
                    <span>Địa chỉ</span>
                    <strong>@(Model.Address ?? "Chưa cập nhật")</strong>
                </div>

                <div class="profile-detail">
                    <span>Thành viên từ</span>
                    <strong>
                        @(Model.MemberSince?.ToString("MM/yyyy")
                                                ?? "Chưa cập nhật")
                    </strong>
                </div>
            </div>

            <div class="profile-stats">
                <div>
                    <strong>@Model.OrderCount</strong>
                    <span>
                        @(Model.IsCustomer
                                                ? "Đơn hàng"
                                                : "Đơn liên quan")
                    </span>
                </div>

                <div>
                    <strong>@Model.FavoriteCount</strong>
                    <span>Yêu thích</span>
                </div>
            </div>
        </div>
    </div>
</section>

