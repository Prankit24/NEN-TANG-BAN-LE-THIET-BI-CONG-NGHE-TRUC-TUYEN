@model EMua.ViewModels.AccountProfileViewModel
@{
    ViewData["Title"] = "Hồ sơ của tôi";
}

<link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />

<section class="account-page">
    <div class="container account-container">

        <!-- SIDEBAR -->
        <aside class="account-sidebar">
            <div class="account-user-card">
                <div class="account-avatar-wrapper">
                    @if (!string.IsNullOrWhiteSpace(Model.AvatarUrl))
                    {
                        <img src="@Model.AvatarUrl" class="account-avatar account-avatar-image" alt="@Model.FullName" />
                    }
                    else
                    {
                        <div class="account-avatar">@Model.Initial</div>
                    }
                    <span class="account-online-dot"></span>
                </div>

                <div class="account-user-info">
                    <strong>@Model.FullName</strong>
                    <small>@Model.Email</small>
                </div>

                <span class="membership-badge tier-@Model.MembershipTier?.ToLower().Replace(" ", "-")">
                    <i class="bi bi-gem"></i>
                    <span>@Model.MembershipTier</span>
                </span>
            </div>

            <div class="account-menu-title">TÀI KHOẢN</div>

            <nav class="account-menu">
                <a class="active" asp-controller="Account" asp-action="Profile">
                    <span class="menu-icon"><i class="bi bi-person"></i></span>
                    <span>Hồ sơ của tôi</span>
                </a>

                <a asp-controller="Account" asp-action="Edit">
                    <span class="menu-icon"><i class="bi bi-pencil-square"></i></span>
                    <span>Chỉnh sửa hồ sơ</span>
                </a>

                @if (Model.IsCustomer)
                {
                    <a asp-controller="Order" asp-action="Index">
                        <span class="menu-icon"><i class="bi bi-box-seam"></i></span>
                        <span>Đơn hàng của tôi</span>
                    </a>

                    <a asp-controller="Favorite" asp-action="Index">
                        <span class="menu-icon"><i class="bi bi-heart"></i></span>
                        <span>Sản phẩm yêu thích</span>
                    </a>
                }
                else if (!Model.IsStaff)
                {
                    <a asp-controller="Product" asp-action="Index">
                        <span class="menu-icon"><i class="bi bi-box-seam"></i></span>
                        <span>Quản lý sản phẩm</span>
                    </a>

                    <a asp-controller="Order" asp-action="Index">
                        <span class="menu-icon"><i class="bi bi-receipt"></i></span>
                        <span>Quản lý đơn hàng</span>
                    </a>
                }
                else
                {
                    <a asp-area="Staff" asp-controller="Dashboard" asp-action="Index">
                        <span class="menu-icon"><i class="bi bi-grid-1x2"></i></span>
                        <span>Khu vực nhân viên</span>
                    </a>
                }

                <div class="account-menu-divider"></div>

                <form asp-controller="Auth" asp-action="Logout" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="account-logout">
                        <span class="menu-icon"><i class="bi bi-box-arrow-right"></i></span>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </nav>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="profile-card">
            <!-- HEADER -->
            <div class="profile-card-heading">
                <div>
                    <h1>Hồ sơ của tôi</h1>
                    <p>Quản lý thông tin cá nhân và bảo mật tài khoản</p>
                </div>

                <a asp-action="Edit" class="profile-edit-button">
                    <i class="bi bi-pencil-square"></i>
                    <span>Chỉnh sửa hồ sơ</span>
                </a>
            </div>

            <!-- SUCCESS MODAL -->
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="modal fade" id="profileSuccessModal" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered modal-sm">
                        <div class="modal-content profile-success-modal">
                            <div class="modal-body text-center">
                                <div class="profile-success-icon">
                                    <i class="bi bi-check-lg"></i>
                                </div>
                                <h5>Cập nhật thành công!</h5>
                                <p>@TempData["SuccessMessage"]</p>
                                <button type="button" class="profile-success-button" data-bs-dismiss="modal">
                                    Đóng
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- QUICK STATS -->
            <section class="profile-stats">
                <a asp-controller="Order" asp-action="Index" class="profile-stat-card">
                    <div class="stat-icon icon-orders">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div>
                        <strong>@Model.OrderCount</strong>
                        <span>@(Model.IsCustomer ? "Đơn hàng đã mua" : "Đơn hàng liên quan")</span>
                    </div>
                </a>

                <a asp-controller="Favorite" asp-action="Index" class="profile-stat-card">
                    <div class="stat-icon icon-favorites">
                        <i class="bi bi-heart"></i>
                    </div>
                    <div>
                        <strong>@Model.FavoriteCount</strong>
                        <span>Sản phẩm đã thích</span>
                    </div>
                </a>
            </section>

            <!-- PERSONAL INFORMATION -->
            <section class="profile-information">
                <div class="section-heading">
                    <h3>Thông tin cá nhân</h3>
                    <span class="verified-badge">
                        <i class="bi bi-patch-check-fill"></i> Đã xác minh
                    </span>
                </div>

                <div class="profile-details-grid">
                    <div class="profile-detail-item">
                        <span class="detail-label"><i class="bi bi-person"></i> Họ và tên</span>
                        <strong class="detail-value">@Model.FullName</strong>
                    </div>

                    <div class="profile-detail-item">
                        <span class="detail-label"><i class="bi bi-envelope"></i> Email</span>
                        <strong class="detail-value">@Model.Email</strong>
                    </div>

                    <div class="profile-detail-item">
                        <span class="detail-label"><i class="bi bi-telephone"></i> Số điện thoại</span>
                        <strong class="detail-value">@(Model.PhoneNumber ?? "Chưa cập nhật")</strong>
                    </div>

                    <div class="profile-detail-item">
                        <span class="detail-label"><i class="bi bi-shield-check"></i> Vai trò</span>
                        <strong class="detail-value">@Model.RoleName</strong>
                    </div>

                    <div class="profile-detail-item">
                        <span class="detail-label"><i class="bi bi-geo-alt"></i> Địa chỉ giao hàng</span>
                        <strong class="detail-value">@(Model.Address ?? "Chưa cập nhật")</strong>
                    </div>

                    <div class="profile-detail-item">
                        <span class="detail-label"><i class="bi bi-calendar3"></i> Ngày tham gia</span>
                        <strong class="detail-value">@(Model.MemberSince?.ToString("dd/MM/yyyy") ?? "Chưa cập nhật")</strong>
                    </div>
                </div>
            </section>

            <!-- FOOTER SECURITY NOTE -->
            <div class="profile-security-note">
                <i class="bi bi-shield-lock security-icon"></i>
                <p>
                    <strong>Bảo mật tài khoản:</strong> Không chia sẻ mật khẩu hoặc thông tin đăng nhập của bạn với bất kỳ ai để đảm bảo an toàn cho tài khoản.
                </p>
            </div>
        </main>
    </div>
</section>

@section Scripts {
    @if (TempData["SuccessMessage"] != null)
    {
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const modalElement = document.getElementById("profileSuccessModal");
                if (modalElement && typeof bootstrap !== "undefined") {
                    const modal = new bootstrap.Modal(modalElement);
                    modal.show();
                }
            });
        </script>
    }
}