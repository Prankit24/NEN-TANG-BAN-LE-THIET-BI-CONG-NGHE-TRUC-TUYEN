@model EMua.ViewModels.EditAccountProfileViewModel
@{
    ViewData["Title"] = "Chỉnh sửa hồ sơ";
}

<link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />

<section class="account-page profile-editor-page">
    <div class="container profile-editor-container">
        <form id="profileEditForm"
              asp-controller="Account"
              asp-action="Edit"
              method="post"
              enctype="multipart/form-data"
              class="profile-editor-card">

            @Html.AntiForgeryToken()

            <header class="profile-editor-header">
                <a asp-action="Profile" class="editor-back-link">
                    <i class="bi bi-arrow-left"></i>
                    <span>Hồ sơ của tôi</span>
                </a>

                <div class="editor-heading">
                    <p>Thông tin tài khoản</p>
                    <h1>Chỉnh sửa hồ sơ</h1>
                </div>

                <button type="submit" class="editor-save-button">
                    <i class="bi bi-check2"></i>
                    Lưu thay đổi
                </button>
            </header>

            <div asp-validation-summary="All" class="editor-validation"></div>

            <div class="profile-editor-content">
                <aside class="editor-avatar-side">
                    <div class="editor-section-heading">
                        <i class="bi bi-image"></i>
                        <div>
                            <h2>Ảnh đại diện</h2>
                            <p>Đây là ảnh mọi người sẽ thấy trên hồ sơ của bạn.</p>
                        </div>
                    </div>

                    <div class="editor-avatar-preview-wrap">
                        <div class="editor-avatar-ring"></div>
                        @if (!string.IsNullOrWhiteSpace(Model.CurrentAvatarUrl))
                        {
                            <img id="avatarPreview"
                                 src="@Model.CurrentAvatarUrl"
                                 class="editor-avatar-preview"
                                 alt="Ảnh đại diện" />
                        }
                        else
                        {
                            <div id="avatarPreview" class="editor-avatar-placeholder">
                                <i class="bi bi-person"></i>
                            </div>
                        }

                        <label for="AvatarFile" class="editor-upload-circle" title="Tải ảnh từ máy">
                            <i class="bi bi-camera-fill"></i>
                        </label>

                        <input asp-for="AvatarFile"
                               accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp"
                               class="editor-file-input" />
                    </div>

                    <label for="AvatarFile" class="editor-upload-link">
                        <i class="bi bi-upload"></i>
                        Tải ảnh khác từ máy
                    </label>

                    <small class="editor-upload-note">
                        JPG, PNG hoặc WEBP · Tối đa 2 MB
                    </small>

                    <span asp-validation-for="AvatarFile" class="editor-field-error"></span>

                    <div class="editor-avatar-divider">
                        <span>hoặc chọn ảnh có sẵn</span>
                    </div>

                    <div class="editor-avatar-gallery">
                        <label class="editor-avatar-choice">
                            <input type="radio"
                                   name="SelectedAvatar"
                                   value="/images/avatar/conbo.jpg"
                                   @(Model.SelectedAvatar == "/images/avatar/conbo.jpg" ? "checked" : "") />
                            <img src="~/images/avatar/conbo.jpg" alt="Avatar bò" />
                            <i class="bi bi-check-circle-fill editor-avatar-check"></i>
                        </label>

                        <label class="editor-avatar-choice">
                            <input type="radio"
                                   name="SelectedAvatar"
                                   value="/images/avatar/conchoo.jpg"
                                   @(Model.SelectedAvatar == "/images/avatar/conchoo.jpg" ? "checked" : "") />
                            <img src="~/images/avatar/conchoo.jpg" alt="Avatar chó" />
                            <i class="bi bi-check-circle-fill editor-avatar-check"></i>
                        </label>

                        <label class="editor-avatar-choice">
                            <input type="radio"
                                   name="SelectedAvatar"
                                   value="/images/avatar/conkhi.jpg"
                                   @(Model.SelectedAvatar == "/images/avatar/conkhi.jpg" ? "checked" : "") />
                            <img src="~/images/avatar/conkhi.jpg" alt="Avatar khỉ" />
                            <i class="bi bi-check-circle-fill editor-avatar-check"></i>
                        </label>

                        <label class="editor-avatar-choice">
                            <input type="radio"
                                   name="SelectedAvatar"
                                   value="/images/avatar/convit.jpg"
                                   @(Model.SelectedAvatar == "/images/avatar/convit.jpg" ? "checked" : "") />
                            <img src="~/images/avatar/convit.jpg" alt="Avatar vịt" />
                            <i class="bi bi-check-circle-fill editor-avatar-check"></i>
                        </label>

                        <label class="editor-avatar-choice">
                            <input type="radio"
                                   name="SelectedAvatar"
                                   value="/images/avatar/conhuu.jpg"
                                   @(Model.SelectedAvatar == "/images/avatar/conhuu.jpg" ? "checked" : "") />
                            <img src="~/images/avatar/conhuu.jpg" alt="Avatar hươu" />
                            <i class="bi bi-check-circle-fill editor-avatar-check"></i>
                        </label>
                    </div>

                    <span asp-validation-for="SelectedAvatar" class="editor-field-error"></span>
                </aside>

                <main class="editor-info-side">
                    <div class="editor-section-heading">
                        <i class="bi bi-person-vcard"></i>
                        <div>
                            <h2>Thông tin cá nhân</h2>
                            <p>Thông tin chính xác giúp đơn hàng đến tay bạn nhanh hơn.</p>
                        </div>
                    </div>

                    <div class="editor-fields-grid">
                        <div class="editor-input-group editor-input-wide">
                            <label asp-for="FullName">Họ và tên</label>
                            <div class="editor-field-shell">
                                <i class="bi bi-person"></i>
                                <input asp-for="FullName" autocomplete="name" placeholder="Nhập họ và tên đầy đủ" />
                            </div>
                            <span asp-validation-for="FullName" class="editor-field-error"></span>
                        </div>

                        <div class="editor-input-group">
                            <label>
                                Email
                                <small>Không thể đổi</small>
                            </label>
                            <div class="editor-field-shell editor-field-locked">
                                <i class="bi bi-envelope"></i>
                                <input value="@Model.Email" readonly />
                                <i class="bi bi-lock-fill editor-field-lock-icon"></i>
                            </div>
                        </div>

                        <div class="editor-input-group">
                            <label asp-for="PhoneNumber">Số điện thoại</label>
                            <div class="editor-field-shell">
                                <i class="bi bi-telephone"></i>
                                <input asp-for="PhoneNumber" autocomplete="tel" placeholder="0901234567" />
                            </div>
                            <span asp-validation-for="PhoneNumber" class="editor-field-error"></span>
                        </div>

                        <div class="editor-input-group editor-input-wide">
                            <label asp-for="Address">Địa chỉ nhận hàng mặc định</label>
                            <div class="editor-field-shell editor-field-shell-textarea">
                                <i class="bi bi-geo-alt"></i>
                                <textarea asp-for="Address" rows="3" placeholder="Số nhà, đường, phường/xã, quận/huyện, tỉnh/thành"></textarea>
                            </div>
                            <span asp-validation-for="Address" class="editor-field-error"></span>
                        </div>
                    </div>

                    <p class="editor-security-note">
                        <i class="bi bi-shield-check"></i>
                        Mọi thông tin của bạn được bảo mật tại EMUA.
                    </p>
                </main>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const avatarFile = document.getElementById("AvatarFile");
        const avatarRadios = document.querySelectorAll('input[name="SelectedAvatar"]');

        function setAvatarPreview(imageSource) {
            const oldPreview = document.getElementById("avatarPreview");
            const image = document.createElement("img");
            image.id = "avatarPreview";
            image.className = "editor-avatar-preview";
            image.alt = "Ảnh đại diện";
            image.src = imageSource;

            if (oldPreview) {
                oldPreview.replaceWith(image);
            }
        }

        avatarFile?.addEventListener("change", function (event) {
            const file = event.target.files?.[0];
            if (!file) return;

            avatarRadios.forEach(function (radio) {
                radio.checked = false;
            });

            const reader = new FileReader();
            reader.onload = function (result) {
                setAvatarPreview(result.target.result);
            };
            reader.readAsDataURL(file);
        });

        avatarRadios.forEach(function (radio) {
            radio.addEventListener("change", function () {
                if (!radio.checked) return;
                if (avatarFile) avatarFile.value = "";
                setAvatarPreview(radio.value);
            });
        });

        // Hàm tạo Dialog thông báo có màu sắc chuẩn UI
        function showProfileDialog(title, message, isError = false, onSuccessRedirect = false) {
            const dialog = document.createElement("div");
            dialog.className = "profile-ajax-dialog-backdrop";
            dialog.style.cssText = "position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(15, 23, 42, 0.4); backdrop-filter: blur(4px); display: flex; align-items: center; justify-content: center; z-index: 9999; opacity: 0; transition: opacity 0.25s ease;";

            const iconBg = isError ? "#fee2e2" : "#dcfce7";
            const iconColor = isError ? "#dc2626" : "#16a34a";
            const iconClass = isError ? "bi-exclamation-lg" : "bi-check-lg";

            dialog.innerHTML =
                '<div style="background: #ffffff; padding: 28px 24px; border-radius: 20px; width: 90%; max-width: 350px; text-align: center; box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);">' +
                    '<div style="width: 60px; height: 60px; margin: 0 auto 16px; border-radius: 50%; background: ' + iconBg + '; color: ' + iconColor + '; display: flex; align-items: center; justify-content: center; font-size: 30px;">' +
                        '<i class="bi ' + iconClass + '"></i>' +
                    '</div>' +
                    '<h3 style="margin: 0 0 8px; font-size: 18px; font-weight: 700; color: #0f172a;">' + title + '</h3>' +
                    '<p style="margin: 0 0 20px; font-size: 14px; color: #64748b; line-height: 1.5;">' + message + '</p>' +
                    '<button type="button" id="btnDialogClose" style="width: 100%; padding: 12px; border: none; border-radius: 10px; background: #4f46e5; color: #ffffff; font-weight: 600; font-size: 14px; cursor: pointer;">Ok</button>' +
                '</div>';

            document.body.appendChild(dialog);

            dialog.querySelector("#btnDialogClose").addEventListener("click", function () {
                dialog.remove();
                if (onSuccessRedirect) {
                    window.location.href = '@Url.Action("Profile", "Account")';
                }
            });

            requestAnimationFrame(function () {
                dialog.style.opacity = "1";
            });
        }

        document.getElementById("profileEditForm")?.addEventListener("submit", async function (event) {
            event.preventDefault();

            const form = event.currentTarget;
            const submitButton = form.querySelector('button[type="submit"]');
            const originalHtml = submitButton.innerHTML;

            submitButton.disabled = true;
            submitButton.innerHTML = '<span class="spinner-border spinner-border-sm"></span> Đang lưu';

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    headers: {
                        "X-Requested-With": "XMLHttpRequest"
                    },
                    body: new FormData(form)
                });

                const result = await response.json();

                if (!response.ok || !result.success) {
                    showProfileDialog(
                        "Không thể lưu thay đổi",
                        result.message ?? "Vui lòng kiểm tra lại thông tin.",
                        true,
                        false
                    );
                    return;
                }

                showProfileDialog(
                    "Đã lưu thay đổi",
                    result.message ?? "Hồ sơ của bạn đã được cập nhật thành công.",
                    false,
                    true
                );
            }
            catch {
                showProfileDialog(
                    "Lỗi kết nối",
                    "Không thể kết nối đến máy chủ. Vui lòng thử lại.",
                    true,
                    false
                );
            }
            finally {
                submitButton.disabled = false;
                submitButton.innerHTML = originalHtml;
            }
        });
    </script>
}