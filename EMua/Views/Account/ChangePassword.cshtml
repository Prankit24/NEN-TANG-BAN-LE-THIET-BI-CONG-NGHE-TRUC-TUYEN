@model EMua.ViewModels.ChangePasswordViewModel
@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject EMua.Data.EMuaDbContext Db

@{
    ViewData["Title"] = "Đổi mật khẩu";

    var userIdText = User.FindFirstValue(ClaimTypes.NameIdentifier);

    EMua.Models.Database.NguoiDung? currentUser = null;

    if (int.TryParse(userIdText, out var userId))
    {
        currentUser = await Db.NguoiDungs
            .AsNoTracking()
            .Include(x => x.MaQuyenNavigation)
            .FirstOrDefaultAsync(x => x.MaNguoiDung == userId);
    }

    var fullName = currentUser?.TenNguoiDung ?? "Người dùng";
    var email = currentUser?.Email ?? string.Empty;
    var avatarUrl = currentUser?.AnhDaiDien;
    var initial = string.IsNullOrWhiteSpace(fullName)
        ? "U"
        : fullName.Trim()[..1].ToUpperInvariant();

    var role = currentUser?.MaQuyenNavigation?.TenQuyen
        ?? User.FindFirstValue(ClaimTypes.Role)
        ?? string.Empty;

    var isCustomer = role is "KhachHang" or "Khách hàng";
    var isAdmin = role is "Admin" or "Quản trị viên";
    var workArea = isAdmin ? "Admin" : "Staff";

    var roleLabel = role switch
    {
        "KhachHang" => "Khách hàng",
        "NhanVien" => "Nhân viên",
        "Admin" => "Quản trị viên",
        "" => "Tài khoản",
        _ => role
    };
}

<link rel="stylesheet"
      href="~/css/account.css"
      asp-append-version="true" />

<section class="account-page password-account-page">
    <div class="container account-container">

        <!-- MENU TÀI KHOẢN -->
        <aside class="account-sidebar">
            <div class="account-user-card">
                <div class="account-avatar-wrapper">
                    @if (!string.IsNullOrWhiteSpace(avatarUrl))
                    {
                        <img src="@avatarUrl"
                             class="account-avatar account-avatar-image"
                             alt="@fullName" />
                    }
                    else
                    {
                        <div class="account-avatar">@initial</div>
                    }

                    <span class="account-online-dot"></span>
                </div>

                <div class="account-user-info">
                    <strong>@fullName</strong>
                    <small>@email</small>
                </div>

                <span class="role-badge">
                    <i class="bi bi-person-check" aria-hidden="true"></i>
                    <span>@roleLabel</span>
                </span>
            </div>

            <div class="account-menu-title">TÀI KHOẢN</div>

            <nav class="account-menu" aria-label="Menu tài khoản">
                <a asp-area=""
                   asp-controller="Account"
                   asp-action="Profile">
                    <span class="menu-icon">
                        <i class="bi bi-person" aria-hidden="true"></i>
                    </span>
                    <span>Hồ sơ của tôi</span>
                </a>

                <a asp-area=""
                   asp-controller="Account"
                   asp-action="ChangePassword"
                   class="active"
                   aria-current="page">
                    <span class="menu-icon">
                        <i class="bi bi-key" aria-hidden="true"></i>
                    </span>
                    <span>Đổi mật khẩu</span>
                </a>

                @if (isCustomer)
                {
                    <a asp-area=""
                       asp-controller="Order"
                       asp-action="Index">
                        <span class="menu-icon">
                            <i class="bi bi-box-seam" aria-hidden="true"></i>
                        </span>
                        <span>Đơn hàng của tôi</span>
                    </a>

                    <a asp-area=""
                       asp-controller="Favorite"
                       asp-action="Index">
                        <span class="menu-icon">
                            <i class="bi bi-heart" aria-hidden="true"></i>
                        </span>
                        <span>Sản phẩm yêu thích</span>
                    </a>
                }
                else if (role is "NhanVien" or "Nhân viên"
                or "Admin" or "Quản trị viên")
                {
                    <a asp-area="@workArea"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        <span class="menu-icon">
                            <i class="bi bi-grid-1x2" aria-hidden="true"></i>
                        </span>
                        <span>Khu vực làm việc</span>
                    </a>

                    <a asp-area=""
                       asp-controller="Product"
                       asp-action="Index">
                        <span class="menu-icon">
                            <i class="bi bi-box-seam" aria-hidden="true"></i>
                        </span>
                        <span>Quản lý sản phẩm</span>
                    </a>

                    <a asp-area=""
                       asp-controller="Order"
                       asp-action="Index">
                        <span class="menu-icon">
                            <i class="bi bi-receipt" aria-hidden="true"></i>
                        </span>
                        <span>Quản lý đơn hàng</span>
                    </a>
                }

                <div class="account-menu-divider"></div>

                <form asp-area=""
                      asp-controller="Auth"
                      asp-action="Logout"
                      method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="account-logout">
                        <span class="menu-icon">
                            <i class="bi bi-box-arrow-right"
                               aria-hidden="true"></i>
                        </span>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </nav>
        </aside>

        <!-- NỘI DUNG BÊN PHẢI -->
        <main class="profile-card password-content">
            <form asp-area=""
                  asp-controller="Account"
                  asp-action="ChangePassword"
                  method="post"
                  class="password-form">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="editor-validation"
                     role="alert"></div>

                <div class="editor-fields-grid">
                    <div class="editor-input-group">
                        <label asp-for="CurrentPassword">
                            Mật khẩu hiện tại
                        </label>

                        <div class="editor-field-shell">
                            <i class="bi bi-key" aria-hidden="true"></i>

                            <input asp-for="CurrentPassword"
                                   type="password"
                                   value=""
                                   autocomplete="current-password"
                                   placeholder="Nhập mật khẩu hiện tại"
                                   aria-describedby="currentError" />

                            <button type="button"
                                    class="password-toggle"
                                    data-account-password
                                    aria-controls="CurrentPassword"
                                    aria-label="Hiện mật khẩu hiện tại"
                                    aria-pressed="false">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>

                        <span asp-validation-for="CurrentPassword"
                              id="currentError"
                              class="editor-field-error"></span>
                    </div>

                    <div class="editor-input-group">
                        <label asp-for="NewPassword">
                            Mật khẩu mới
                        </label>

                        <div class="editor-field-shell">
                            <i class="bi bi-lock" aria-hidden="true"></i>

                            <input asp-for="NewPassword"
                                   type="password"
                                   value=""
                                   autocomplete="new-password"
                                   placeholder="Nhập mật khẩu mới"
                                   aria-describedby="newHint newError" />

                            <button type="button"
                                    class="password-toggle"
                                    data-account-password
                                    aria-controls="NewPassword"
                                    aria-label="Hiện mật khẩu mới"
                                    aria-pressed="false">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>

                        <span id="newHint" class="editor-field-hint">
                            Từ 8 đến 100 ký tự, khác mật khẩu hiện tại.
                        </span>

                        <span asp-validation-for="NewPassword"
                              id="newError"
                              class="editor-field-error"></span>
                    </div>

                    <div class="editor-input-group">
                        <label asp-for="ConfirmPassword">
                            Nhập lại mật khẩu mới
                        </label>

                        <div class="editor-field-shell">
                            <i class="bi bi-lock-fill" aria-hidden="true"></i>

                            <input asp-for="ConfirmPassword"
                                   type="password"
                                   value=""
                                   autocomplete="new-password"
                                   placeholder="Nhập lại mật khẩu mới"
                                   aria-describedby="confirmError" />

                            <button type="button"
                                    class="password-toggle"
                                    data-account-password
                                    aria-controls="ConfirmPassword"
                                    aria-label="Hiện mật khẩu xác nhận"
                                    aria-pressed="false">
                                <i class="bi bi-eye" aria-hidden="true"></i>
                            </button>
                        </div>

                        <span asp-validation-for="ConfirmPassword"
                              id="confirmError"
                              class="editor-field-error"></span>
                    </div>
                </div>

                <div class="password-actions">
                    <button type="submit" class="profile-save-button">
                        <i class="bi bi-check2" aria-hidden="true"></i>
                        Lưu mật khẩu mới
                    </button>

                    <a asp-area=""
                       asp-controller="Account"
                       asp-action="Profile"
                       class="profile-cancel-button">
                        Hủy
                    </a>
                </div>

                <div class="profile-security-note">
                    <i class="bi bi-info-circle security-icon"
                       aria-hidden="true"></i>
                    <p>
                        Sau khi đổi mật khẩu thành công,
                        bạn sẽ cần đăng nhập lại.
                    </p>
                </div>
            </form>
        </main>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.querySelectorAll('[data-account-password]')
            .forEach(function (button) {
                const originalLabel = button.getAttribute('aria-label');

                button.addEventListener('click', function () {
                    const input = document.getElementById(
                        button.getAttribute('aria-controls')
                    );

                    if (!input) return;

                    const show = input.type === 'password';
                    input.type = show ? 'text' : 'password';

                    button.setAttribute('aria-pressed', String(show));
                    button.setAttribute(
                        'aria-label',
                        show
                            ? originalLabel.replace('Hiện', 'Ẩn')
                            : originalLabel
                    );

                    const icon = button.querySelector('i');

                    if (icon) {
                        icon.className = show
                            ? 'bi bi-eye-slash'
                            : 'bi bi-eye';
                    }
                });
            });
    </script>
}
