@model EMua.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Thay đổi mật khẩu";
}

<link rel="stylesheet" href="~/css/account.css" asp-append-version="true" />

<section class="account-page profile-editor-page">
    <div class="container profile-editor-container">
        <form asp-controller="Account"
              asp-action="ChangePassword"
              method="post"
              class="profile-editor-card">

            @Html.AntiForgeryToken()

            <header class="profile-editor-header">
                <a asp-action="Profile" class="editor-back-link">
                    <i class="bi bi-arrow-left"></i>
                    <span>Hồ sơ của tôi</span>
                </a>

                <div class="editor-heading">
                    <p>Bảo mật tài khoản</p>
                    <h1>Thay đổi mật khẩu</h1>
                </div>

                <button type="submit" class="editor-save-button">
                    <i class="bi bi-shield-check"></i>
                    Cập nhật
                </button>
            </header>

            @if (TempData["SuccessMessage"] is string successMessage)
            {
                <div class="alert alert-success m-4 mb-0" role="status">@successMessage</div>
            }

            <div asp-validation-summary="All" class="editor-validation"></div>

            <div class="profile-editor-content password-editor-content">
                <main class="editor-info-side">
                    <div class="editor-section-heading">
                        <i class="bi bi-shield-lock"></i>
                        <div>
                            <h2>Mật khẩu đăng nhập</h2>
                            <p>Nhập mật khẩu hiện tại để xác nhận thay đổi.</p>
                        </div>
                    </div>

                    <div class="editor-fields-grid">
                        <div class="editor-input-group editor-input-wide">
                            <label asp-for="CurrentPassword">Mật khẩu hiện tại</label>
                            <div class="editor-field-shell">
                                <i class="bi bi-lock"></i>
                                <input asp-for="CurrentPassword" autocomplete="current-password" />
                            </div>
                            <span asp-validation-for="CurrentPassword" class="editor-field-error"></span>
                        </div>

                        <div class="editor-input-group editor-input-wide">
                            <label asp-for="NewPassword">Mật khẩu mới</label>
                            <div class="editor-field-shell">
                                <i class="bi bi-key"></i>
                                <input asp-for="NewPassword" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="NewPassword" class="editor-field-error"></span>
                        </div>

                        <div class="editor-input-group editor-input-wide">
                            <label asp-for="ConfirmPassword">Xác nhận mật khẩu mới</label>
                            <div class="editor-field-shell">
                                <i class="bi bi-check2-circle"></i>
                                <input asp-for="ConfirmPassword" autocomplete="new-password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="editor-field-error"></span>
                        </div>
                    </div>

                    <p class="editor-security-note">
                        <i class="bi bi-shield-check"></i>
                        Mật khẩu mới cần có ít nhất 8 ký tự.
                    </p>
                </main>
            </div>
        </form>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}