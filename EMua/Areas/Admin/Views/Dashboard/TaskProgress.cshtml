@model EMua.Areas.Admin.Models.ViewModels.TaskProgressViewModel
@{
    ViewData["Title"] = "Tiến độ chức năng Admin";
}

<div class="admin-task-progress-page">
    <div class="d-flex justify-content-end align-items-center mb-3">
        <button type="button" class="btn btn-primary btn-sm px-3 py-2 fw-semibold d-flex align-items-center gap-1" data-bs-toggle="modal" data-bs-target="#addTaskModal">
            <i class="bi bi-plus-lg"></i> Thêm hạng mục mới
        </button>
    </div>

    <!-- Cột bảng Trello Board Column -->
    <div class="trello-board-column">
        @foreach (var task in Model.Tasks)
        {
            <div class="trello-card @(task.IsCompleted ? "completed-card" : "")">
                <div class="card-title-row">
                    <i class="bi @(task.IsCompleted ? "bi-check-circle-fill text-success" : "bi-circle") card-status-icon"></i>
                    <span class="card-title-text">@task.Title</span>
                </div>
                <div class="card-meta-row">
                    <i class="bi bi-check2-square"></i>
                    <span>@task.CompletedCount / @task.TotalCount</span>
                </div>
            </div>
        }

        <!-- Nút Add a card -->
        <button type="button" class="trello-add-card-btn" data-bs-toggle="modal" data-bs-target="#addTaskModal">
            <i class="bi bi-plus-lg"></i> Add a card
        </button>
    </div>
</div>

<!-- Modal thêm task/card mới (Phục vụ mở rộng tương lai) -->
<div class="modal fade" id="addTaskModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold">Thêm thẻ công việc mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Tên chức năng / hạng mục</label>
                        <input type="text" class="form-control" placeholder="Ví dụ: Quản lý mã giảm giá..." required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-bold">Số lượng tiêu chí (Total tasks)</label>
                        <input type="number" class="form-control" value="5" min="1" required />
                    </div>
                    <div class="text-end">
                        <button type="button" class="btn btn-light  px-4" data-bs-dismiss="modal">Hủy</button>
                        <button type="submit" class="btn btn-primary  px-4">Thêm thẻ</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-task-progress.css" asp-append-version="true" />
}