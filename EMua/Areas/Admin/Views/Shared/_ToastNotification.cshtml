@{
    var successMsg = TempData["Success"]?.ToString() ?? TempData["SuccessMessage"]?.ToString();
    var errorMsg = TempData["Error"]?.ToString() ?? TempData["ErrorMessage"]?.ToString();
    var warningMsg = TempData["Warning"]?.ToString() ?? TempData["WarningMessage"]?.ToString();
}

@if (!string.IsNullOrEmpty(successMsg) || !string.IsNullOrEmpty(errorMsg) || !string.IsNullOrEmpty(warningMsg))
{
    <style>
        .emua-toast-container {
            position: fixed;
            top: 20px;
            right: 20px;
            z-index: 1099;
            display: flex;
            flex-direction: column;
            gap: 10px;
            pointer-events: none;
            max-width: 420px;
            width: calc(100vw - 40px);
        }
        .emua-toast {
            pointer-events: auto;
            background: #ffffff;
            border: 1px solid #DCE3ED;
            border-radius: 0 !important;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.08);
            display: flex;
            align-items: flex-start;
            gap: 12px;
            padding: 14px 16px;
            transition: opacity 0.3s ease, transform 0.3s ease;
        }
        .emua-toast.emua-toast-success {
            border-left: 4px solid #16803C;
        }
        .emua-toast.emua-toast-error {
            border-left: 4px solid #DC2626;
        }
        .emua-toast.emua-toast-warning {
            border-left: 4px solid #D97706;
        }
        .emua-toast-icon {
            font-size: 20px;
            line-height: 1;
            flex-shrink: 0;
            margin-top: 1px;
        }
        .emua-toast-body {
            flex: 1 1 auto;
            min-width: 0;
        }
        .emua-toast-title {
            font-size: 13.5px;
            font-weight: 700;
            color: #172033;
            margin-bottom: 2px;
            line-height: 1.3;
        }
        .emua-toast-message {
            font-size: 13px;
            color: #475569;
            line-height: 1.45;
            word-break: break-word;
        }
        .emua-toast-close {
            background: transparent;
            border: none;
            color: #94A3B8;
            font-size: 18px;
            line-height: 1;
            padding: 0;
            cursor: pointer;
            flex-shrink: 0;
            transition: color 0.15s ease;
        }
        .emua-toast-close:hover {
            color: #172033;
        }
    </style>

    <div class="emua-toast-container" id="emuaToastContainer" aria-live="polite" aria-atomic="true">
        @if (!string.IsNullOrEmpty(successMsg))
        {
            <div class="emua-toast emua-toast-success" role="alert" data-autohide="true" data-delay="4500">
                <i class="bi bi-check-circle-fill emua-toast-icon text-success"></i>
                <div class="emua-toast-body">
                    <div class="emua-toast-title">Thành công</div>
                    <div class="emua-toast-message">@successMsg</div>
                </div>
                <button type="button" class="emua-toast-close" aria-label="Đóng" onclick="this.closest('.emua-toast').remove();">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        }
        @if (!string.IsNullOrEmpty(errorMsg))
        {
            <div class="emua-toast emua-toast-error" role="alert" data-autohide="true" data-delay="5000">
                <i class="bi bi-exclamation-triangle-fill emua-toast-icon text-danger"></i>
                <div class="emua-toast-body">
                    <div class="emua-toast-title">Lỗi</div>
                    <div class="emua-toast-message">@errorMsg</div>
                </div>
                <button type="button" class="emua-toast-close" aria-label="Đóng" onclick="this.closest('.emua-toast').remove();">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        }
        @if (!string.IsNullOrEmpty(warningMsg))
        {
            <div class="emua-toast emua-toast-warning" role="alert" data-autohide="true" data-delay="4500">
                <i class="bi bi-exclamation-circle-fill emua-toast-icon text-warning"></i>
                <div class="emua-toast-body">
                    <div class="emua-toast-title">Cảnh báo</div>
                    <div class="emua-toast-message">@warningMsg</div>
                </div>
                <button type="button" class="emua-toast-close" aria-label="Đóng" onclick="this.closest('.emua-toast').remove();">
                    <i class="bi bi-x"></i>
                </button>
            </div>
        }
    </div>

    <script>
        (function () {
            document.querySelectorAll('#emuaToastContainer .emua-toast').forEach(function (toast) {
                var delay = parseInt(toast.getAttribute('data-delay') || '4500', 10);
                setTimeout(function () {
                    if (toast && toast.parentNode) {
                        toast.style.opacity = '0';
                        toast.style.transform = 'translateY(-8px)';
                        setTimeout(function () {
                            if (toast && toast.parentNode) {
                                toast.remove();
                            }
                        }, 300);
                    }
                }, delay);
            });
        })();
    </script>
}
