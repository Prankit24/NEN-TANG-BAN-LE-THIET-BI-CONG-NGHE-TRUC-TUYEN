@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject EMua.Data.EMuaDbContext DbContext
@{
    var displayName = User.Identity?.Name ?? "Admin";

    var avatarLetter = string.IsNullOrWhiteSpace(displayName)
        ? "A"
        : displayName[..1].ToUpperInvariant();

    string? avatarUrl = null;
    var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (int.TryParse(userIdClaim, out var adminUserId))
    {
        var adminUser = DbContext.NguoiDungs.AsNoTracking().FirstOrDefault(u => u.MaNguoiDung == adminUserId);
        if (adminUser != null && !string.IsNullOrWhiteSpace(adminUser.AnhDaiDien))
        {
            avatarUrl = adminUser.AnhDaiDien;
        }
    }

    var currentController =
        ViewContext.RouteData.Values["Controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EMUA Admin</title>

    <link rel="icon"
          type="image/png"
          href="~/images/logo/chicken.png"
          asp-append-version="true" />
    <link rel="apple-touch-icon"
          href="~/images/logo/chicken.png"
          asp-append-version="true" />
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/admin/admin-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-flat.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="emua-admin">
    <div class="admin-shell">

        <div class="admin-sidebar-backdrop"
             id="adminSidebarBackdrop"></div>

        <!-- SIDEBAR -->
        <aside class="admin-sidebar"
               id="adminSidebar">

            <!-- GIỮ LOGO HIỆN TẠI -->
            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="admin-logo"
               title="EMUA Admin">

                <span class="admin-logo-text">
                    <img src="~/images/logo/icon-logo.png"
                         asp-append-version="true"
                         alt="EMUA"
                         class="admin-brand-image" />
                </span>

                <span class="admin-logo-mini">
                    <img src="~/images/logo/chicken.png"
                         asp-append-version="true"
                         alt="EMUA"
                         class="admin-brand-icon" />
                </span>
            </a>

            <!-- MENU -->
            <nav class="admin-nav"
                 aria-label="Menu quản trị">

                <span class="admin-nav-label">
                    Tổng quan
                </span>

                <a class="@(currentController == "Dashboard" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   title="Tổng quan"
                   aria-label="Tổng quan"
                   aria-current="@(currentController == "Dashboard" ? "page" : null)">

                    <i class="bi bi-grid-1x2"></i>
                    <span>Tổng quan</span>
                </a>

                <span class="admin-nav-label">
                    Quản lý cửa hàng
                </span>

                <a class="@(currentController == "Category" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Category"
                   asp-action="Index"
                   title="Danh mục"
                   aria-label="Danh mục"
                   aria-current="@(currentController == "Category" ? "page" : null)">

                    <i class="bi bi-folder2"></i>
                    <span>Danh mục</span>
                </a>

                <a class="@(currentController == "Brand" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Brand"
                   asp-action="Index"
                   title="Thương hiệu"
                   aria-label="Thương hiệu"
                   aria-current="@(currentController == "Brand" ? "page" : null)">

                    <i class="bi bi-award"></i>
                    <span>Thương hiệu</span>
                </a>

                <a class="@(currentController == "ImportOrder" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="ImportOrder"
                   asp-action="Index"
                   title="Duyệt nhập hàng"
                   aria-label="Duyệt nhập hàng"
                   aria-current="@(currentController == "ImportOrder" ? "page" : null)">

                    <i class="bi bi-box-arrow-in-down"></i>
                    <span>Duyệt nhập hàng</span>
                </a>

                <a class="@(currentController == "User" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   title="Người dùng"
                   aria-label="Người dùng"
                   aria-current="@(currentController == "User" ? "page" : null)">

                    <i class="bi bi-people"></i>
                    <span>Người dùng</span>
                </a>

                <span class="admin-nav-label">
                    Quản trị
                </span>

                <a class="@(currentController == "Role" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Role"
                   asp-action="Index"
                   title="Phân quyền"
                   aria-label="Phân quyền"
                   aria-current="@(currentController == "Role" ? "page" : null)">

                    <i class="bi bi-shield-lock"></i>
                    <span>Phân quyền</span>
                </a>

                <a class="@(currentController == "Report" || currentController == "BaoCao" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Report"
                   asp-action="Index"
                   title="Báo cáo"
                   aria-label="Báo cáo"
                   aria-current="@(currentController == "Report" || currentController == "BaoCao" ? "page" : null)">

                    <i class="bi bi-bar-chart"></i>
                    <span>Báo cáo</span>
                </a>

                <a class="@(currentController == "System" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="System"
                   asp-action="Index"
                   title="Hệ thống"
                   aria-label="Hệ thống"
                   aria-current="@(currentController == "System" ? "page" : null)">

                    <i class="bi bi-hdd-stack"></i>
                    <span>Hệ thống</span>
                </a>
            </nav>

            <!-- MENU DƯỚI -->
            <div class="admin-sidebar-bottom">
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="admin-bottom-link"
                   title="Xem website"
                   aria-label="Xem website">

                    <i class="bi bi-eye"></i>
                    <span>Xem website</span>
                </a>

                <form asp-area=""
                      asp-controller="Auth"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="admin-bottom-link logout"
                            title="Đăng xuất"
                            aria-label="Đăng xuất">

                        <i class="bi bi-box-arrow-right"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- NỘI DUNG CHÍNH -->
        <main class="admin-main">
            <header class="admin-header">

                <div class="admin-header-left">
                    <button type="button"
                            class="admin-menu-toggle"
                            id="adminMenuToggle"
                            aria-label="Thu gọn menu"
                            aria-controls="adminSidebar"
                            aria-expanded="true">

                        <i class="bi bi-list"></i>
                    </button>

                    <div>
                        <h1>@ViewData["Title"]</h1>

                        <p>
                            EMUA Admin —
                            @DateTime.Now.ToString("dd/MM/yyyy")
                        </p>
                    </div>
                </div>

                <div class="admin-header-actions">
                    <button type="button"
                            class="admin-header-link admin-notification-link"
                            title="Thông báo"
                            aria-label="Thông báo">

                        <i class="bi bi-bell"></i>
                        <span>Thông báo</span>
                    </button>

                    <a href="mailto:phuonganhdt73@gmail.com?subject=Yêu cầu hỗ trợ EMUA"
                       class="admin-header-link admin-help-link"
                       title="Trợ giúp"
                       aria-label="Trợ giúp">

                        <i class="bi bi-question-circle"></i>
                        <span>Trợ giúp</span>
                    </a>

                    <a asp-area="Admin"
                       asp-controller="System"
                       asp-action="Index"
                       class="admin-header-link @(currentController == "System" ? "active" : "")"
                       title="Hệ thống"
                       aria-label="Hệ thống">

                        <i class="bi bi-hdd-stack"></i>
                        <span>Hệ thống</span>
                    </a>

                    <div class="admin-user"
                         title="@displayName">

                        <div class="admin-avatar">
                            @if (!string.IsNullOrWhiteSpace(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="@displayName" class="admin-avatar-img" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                <span class="admin-avatar-fallback" style="display: none;">@avatarLetter</span>
                            }
                            else
                            {
                                <span class="admin-avatar-fallback">@avatarLetter</span>
                            }
                        </div>

                        <div class="admin-account-info">
                            <strong>@displayName</strong>
                            <small>Quản trị viên</small>
                        </div>
                    </div>
                </div>
            </header>

            <section class="admin-content">
                @RenderBody()
            </section>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            const sidebar =
                document.getElementById("adminSidebar");

            const backdrop =
                document.getElementById("adminSidebarBackdrop");

            const menuToggle =
                document.getElementById("adminMenuToggle");

            const storageKey =
                "emua_admin_sidebar_collapsed";

            const mobileQuery =
                window.matchMedia("(max-width: 850px)");

            function readCollapsedState() {
                try {
                    return localStorage.getItem(storageKey) === "true";
                } catch {
                    return false;
                }
            }

            function saveCollapsedState(value) {
                try {
                    localStorage.setItem(
                        storageKey,
                        String(value)
                    );
                } catch {
                    // Menu vẫn hoạt động khi lưu trữ bị chặn.
                }
            }

            function updateToggle(expanded, label) {
                menuToggle.setAttribute(
                    "aria-expanded",
                    String(expanded)
                );

                menuToggle.setAttribute(
                    "aria-label",
                    label
                );
            }

            function closeMobileSidebar() {
                sidebar.classList.remove("is-open");
                backdrop.classList.remove("is-visible");

                if (mobileQuery.matches) {
                    updateToggle(false, "Mở menu");
                }
            }

            function applySidebarState() {
                closeMobileSidebar();

                if (mobileQuery.matches) {
                    document.body.classList.remove(
                        "admin-sidebar-collapsed"
                    );

                    updateToggle(false, "Mở menu");
                    return;
                }

                const collapsed = readCollapsedState();

                document.body.classList.toggle(
                    "admin-sidebar-collapsed",
                    collapsed
                );

                updateToggle(
                    !collapsed,
                    collapsed
                        ? "Mở rộng menu"
                        : "Thu gọn menu"
                );
            }

            menuToggle.addEventListener("click", function () {
                if (mobileQuery.matches) {
                    const open =
                        sidebar.classList.toggle("is-open");

                    backdrop.classList.toggle(
                        "is-visible",
                        open
                    );

                    updateToggle(
                        open,
                        open ? "Đóng menu" : "Mở menu"
                    );

                    return;
                }

                const collapsed =
                    document.body.classList.toggle(
                        "admin-sidebar-collapsed"
                    );

                saveCollapsedState(collapsed);

                updateToggle(
                    !collapsed,
                    collapsed
                        ? "Mở rộng menu"
                        : "Thu gọn menu"
                );
            });

            backdrop.addEventListener(
                "click",
                closeMobileSidebar
            );

            sidebar.querySelectorAll("a").forEach(function (link) {
                link.addEventListener("click", function () {
                    if (mobileQuery.matches) {
                        closeMobileSidebar();
                    }
                });
            });

            document.addEventListener("keydown", function (event) {
                if (
                    event.key === "Escape" &&
                    mobileQuery.matches &&
                    sidebar.classList.contains("is-open")
                ) {
                    closeMobileSidebar();
                    menuToggle.focus();
                }
            });

            mobileQuery.addEventListener(
                "change",
                applySidebarState
            );

            applySidebarState();
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
