@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject EMua.Data.EMuaDbContext DbContext
@{
    var displayName = User.Identity?.Name ?? "Admin";

    var avatarLetter = string.IsNullOrWhiteSpace(displayName)
        ? "A"
        : displayName[..1].ToUpperInvariant();

    string? avatarUrl = null;
    var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);
    if (int.TryParse(userIdClaim, out var adminUserId))
    {
        var adminUser = DbContext.NguoiDungs.AsNoTracking().FirstOrDefault(u => u.MaNguoiDung == adminUserId);
        if (adminUser != null && !string.IsNullOrWhiteSpace(adminUser.AnhDaiDien))
        {
            avatarUrl = adminUser.AnhDaiDien;
        }
    }

    var currentController =
        ViewContext.RouteData.Values["Controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EMUA Admin</title>

    <link rel="icon"
          type="image/png"
          href="~/images/logo/chicken.webp"
          asp-append-version="true" />
    <link rel="apple-touch-icon"
          href="~/images/logo/chicken.webp"
          asp-append-version="true" />
    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet" href="~/css/admin/admin-layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-base.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/shared/design-system.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/admin/admin-flat.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="emua-admin">
    <div class="admin-shell">

        <div class="admin-sidebar-backdrop"
             id="adminSidebarBackdrop"></div>

        <!-- SIDEBAR -->
        <aside class="admin-sidebar"
               id="adminSidebar">

            <!-- GIỮ LOGO HIỆN TẠI -->
            <a asp-area="Admin"
               asp-controller="Dashboard"
               asp-action="Index"
               class="admin-logo"
               title="EMUA Admin">

                <span class="admin-logo-text">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0 0 180 62"
                         role="img"
                         aria-label="EMUA"
                         class="admin-brand-image"
                         style="height: 38px; width: auto; display: block;">
                        <!-- Chữ EMUA màu trắng -->
                        <text x="4" y="49"
                              fill="#ffffff"
                              font-family="system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif"
                              font-weight="900"
                              font-size="46"
                              letter-spacing="-1">EMUA</text>

                        <!-- Icon đà điểu xanh -->
                        <g fill="#3b82f6">
                            <path d="M148 28 C149 20, 151 12, 156 10 C159 9, 162 10, 163 12 L169 13.5 L162 15.5 C159 17, 158 23, 158 30 Z" />
                            <path d="M122 33 C123 23, 142 22, 158 29 C164 33, 162 42, 151 44 C138 46, 125 42, 122 36 L114 38 L119 33 Z" />
                            <path d="M134 42 L127 51 L117 56 L119 58 L129 53 L138 43 Z" />
                            <path d="M146 43 L151 51 L161 52 L160 55 L149 53 L143 44 Z" />
                        </g>
                    </svg>
                </span>

                <span class="admin-logo-mini">
                    <img src="~/images/logo/chicken.webp"
                         asp-append-version="true"
                         alt="EMUA"
                         class="admin-brand-icon" />
                </span>
            </a>

            <!-- MENU -->
            <nav class="admin-nav"
                 aria-label="Menu quản trị">

                <span class="admin-nav-label">
                    Tổng quan
                </span>

                <a class="@(currentController == "Dashboard" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Dashboard"
                   asp-action="Index"
                   title="Tổng quan"
                   aria-label="Tổng quan"
                   aria-current="@(currentController == "Dashboard" ? "page" : null)">

                    <i class="bi bi-grid-1x2"></i>
                    <span>Tổng quan</span>
                </a>

                <span class="admin-nav-label">
                    Quản lý cửa hàng
                </span>

                <a class="@(currentController == "Category" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Category"
                   asp-action="Index"
                   title="Danh mục"
                   aria-label="Danh mục"
                   aria-current="@(currentController == "Category" ? "page" : null)">

                    <i class="bi bi-folder2"></i>
                    <span>Danh mục</span>
                </a>

                <a class="@(currentController == "Brand" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Brand"
                   asp-action="Index"
                   title="Thương hiệu"
                   aria-label="Thương hiệu"
                   aria-current="@(currentController == "Brand" ? "page" : null)">

                    <i class="bi bi-award"></i>
                    <span>Thương hiệu</span>
                </a>

                <a class="@(currentController == "Order" ? "active" : "")"
                   asp-area="Staff"
                   asp-controller="Order"
                   asp-action="Index"
                   title="Quản lý đơn hàng & Đổi trả"
                   aria-label="Quản lý đơn hàng & Đổi trả">

                    <i class="bi bi-bag-check"></i>
                    <span>Đơn hàng & Đổi trả</span>
                </a>

                @* <a class="@(currentController == "Invoice" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Invoice"
                   asp-action="Index"
                   title="Quản lý hóa đơn"
                   aria-label="Quản lý hóa đơn">

                    <i class="bi bi-file-earmark-text"></i>
                    <span>Hóa đơn</span>
                </a> *@

                <a class="@(currentController == "ImportOrder" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="ImportOrder"
                   asp-action="Index"
                   title="Duyệt nhập hàng"
                   aria-label="Duyệt nhập hàng"
                   aria-current="@(currentController == "ImportOrder" ? "page" : null)">

                    <i class="bi bi-box-arrow-in-down"></i>
                    <span>Duyệt nhập hàng</span>
                </a>

                <span class="admin-nav-label">
                    Quản trị
                </span>

                <a class="@(currentController == "User" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="User"
                   asp-action="Index"
                   title="Người dùng"
                   aria-label="Người dùng"
                   aria-current="@(currentController == "User" ? "page" : null)">

                    <i class="bi bi-people"></i>
                    <span>Người dùng</span>
                </a>

                <a class="@(currentController == "Role" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Role"
                   asp-action="Index"
                   title="Phân quyền"
                   aria-label="Phân quyền"
                   aria-current="@(currentController == "Role" ? "page" : null)">

                    <i class="bi bi-shield-lock"></i>
                    <span>Phân quyền</span>
                </a>

                <a class="@(currentController == "Review" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Review"
                   asp-action="Index"
                   title="Đánh giá sản phẩm"
                   aria-label="Đánh giá sản phẩm"
                   aria-current="@(currentController == "Review" ? "page" : null)">

                    <i class="bi bi-star"></i>
                    <span>Đánh giá</span>
                </a>

                <a class="@(currentController == "Report" || currentController == "BaoCao" ? "active" : "")"
                   asp-area="Admin"
                   asp-controller="Report"
                   asp-action="Index"
                   title="Báo cáo"
                   aria-label="Báo cáo"
                   aria-current="@(currentController == "Report" || currentController == "BaoCao" ? "page" : null)">

                    <i class="bi bi-bar-chart"></i>
                    <span>Báo cáo</span>
                </a>
            </nav>

            <!-- MENU DƯỚI -->
            <div class="admin-sidebar-bottom">
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="admin-bottom-link"
                   title="Xem website"
                   aria-label="Xem website">

                    <i class="bi bi-eye"></i>
                    <span>Xem website</span>
                </a>

                <form asp-area=""
                      asp-controller="Auth"
                      asp-action="Logout"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="admin-bottom-link logout"
                            title="Đăng xuất"
                            aria-label="Đăng xuất">

                        <i class="bi bi-box-arrow-right"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- NỘI DUNG CHÍNH -->
        <main class="admin-main">
            <header class="admin-header">

                <div class="admin-header-left">
                    <button type="button"
                            class="admin-menu-toggle"
                            id="adminMenuToggle"
                            aria-label="Thu gọn menu"
                            aria-controls="adminSidebar"
                            aria-expanded="true">

                        <i class="bi bi-list"></i>
                    </button>

                    <div>
                        <h1>@ViewData["Title"]</h1>

                        <p>
                            EMUA Admin —
                            @DateTime.Now.ToString("dd/MM/yyyy")
                        </p>
                    </div>
                </div>

                <div class="admin-header-actions">
                    <button type="button"
                            class="admin-header-link admin-notification-link"
                            title="Thông báo"
                            aria-label="Thông báo">

                        <i class="bi bi-bell"></i>
                        <span>Thông báo</span>
                    </button>

                    <a href="mailto:phuonganhdt73@gmail.com?subject=Yêu cầu hỗ trợ EMUA"
                       class="admin-header-link admin-help-link"
                       title="Trợ giúp"
                       aria-label="Trợ giúp">

                        <i class="bi bi-question-circle"></i>
                        <span>Trợ giúp</span>
                    </a>

                    <a asp-area="Admin"
                       asp-controller="System"
                       asp-action="Index"
                       class="admin-header-link @(currentController == "System" ? "active" : "")"
                       title="Hệ thống"
                       aria-label="Hệ thống">

                        <i class="bi bi-hdd-stack"></i>
                        <span>Hệ thống</span>
                    </a>

                    <button type="button"
                            class="admin-header-link"
                            data-bs-toggle="modal"
                            data-bs-target="#switchStaffModal"
                            title="Chuyển sang giao diện Nhân viên"
                            aria-label="Chuyển sang giao diện Nhân viên"
                            style="border: 1px dashed rgba(255,255,255,0.4); border-radius: 4px; padding: 4px 10px;">
                        <i class="bi bi-person-badge"></i>
                        <span>Giao diện Nhân viên</span>
                    </button>

                    <div class="admin-user"
                         title="@displayName">

                        <div class="admin-avatar">
                            @if (!string.IsNullOrWhiteSpace(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="@displayName" class="admin-avatar-img" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                <span class="admin-avatar-fallback" style="display: none;">@avatarLetter</span>
                            }
                            else
                            {
                                <span class="admin-avatar-fallback">@avatarLetter</span>
                            }
                        </div>

                        <div class="admin-account-info">
                            <strong>@displayName</strong>
                            <small>Quản trị viên</small>
                        </div>
                    </div>
                </div>
            </header>

            <section class="admin-content">
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success border mb-3 py-2 d-flex align-items-center gap-2">
                        <i class="bi bi-check-circle-fill"></i>
                        <span>@TempData["SuccessMessage"]</span>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger border mb-3 py-2 d-flex align-items-center gap-2">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                        <span>@TempData["ErrorMessage"]</span>
                    </div>
                }
                @await Html.PartialAsync("_ToastNotification")
                @RenderBody()
            </section>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            const sidebar =
                document.getElementById("adminSidebar");

            const backdrop =
                document.getElementById("adminSidebarBackdrop");

            const menuToggle =
                document.getElementById("adminMenuToggle");

            const storageKey =
                "emua_admin_sidebar_collapsed";

            const mobileQuery =
                window.matchMedia("(max-width: 850px)");

            function readCollapsedState() {
                try {
                    return localStorage.getItem(storageKey) === "true";
                } catch {
                    return false;
                }
            }

            function saveCollapsedState(value) {
                try {
                    localStorage.setItem(
                        storageKey,
                        String(value)
                    );
                } catch {
                    // Menu vẫn hoạt động khi lưu trữ bị chặn.
                }
            }

            function updateToggle(expanded, label) {
                menuToggle.setAttribute(
                    "aria-expanded",
                    String(expanded)
                );

                menuToggle.setAttribute(
                    "aria-label",
                    label
                );
            }

            function closeMobileSidebar() {
                sidebar.classList.remove("is-open");
                backdrop.classList.remove("is-visible");

                if (mobileQuery.matches) {
                    updateToggle(false, "Mở menu");
                }
            }

            function applySidebarState() {
                closeMobileSidebar();

                if (mobileQuery.matches) {
                    document.body.classList.remove(
                        "admin-sidebar-collapsed"
                    );

                    updateToggle(false, "Mở menu");
                    return;
                }

                const collapsed = readCollapsedState();

                document.body.classList.toggle(
                    "admin-sidebar-collapsed",
                    collapsed
                );

                updateToggle(
                    !collapsed,
                    collapsed
                        ? "Mở rộng menu"
                        : "Thu gọn menu"
                );
            }

            menuToggle.addEventListener("click", function () {
                if (mobileQuery.matches) {
                    const open =
                        sidebar.classList.toggle("is-open");

                    backdrop.classList.toggle(
                        "is-visible",
                        open
                    );

                    updateToggle(
                        open,
                        open ? "Đóng menu" : "Mở menu"
                    );

                    return;
                }

                const collapsed =
                    document.body.classList.toggle(
                        "admin-sidebar-collapsed"
                    );

                saveCollapsedState(collapsed);

                updateToggle(
                    !collapsed,
                    collapsed
                        ? "Mở rộng menu"
                        : "Thu gọn menu"
                );
            });

            backdrop.addEventListener(
                "click",
                closeMobileSidebar
            );

            sidebar.querySelectorAll("a").forEach(function (link) {
                link.addEventListener("click", function () {
                    if (mobileQuery.matches) {
                        closeMobileSidebar();
                    }
                });
            });

            document.addEventListener("keydown", function (event) {
                if (
                    event.key === "Escape" &&
                    mobileQuery.matches &&
                    sidebar.classList.contains("is-open")
                ) {
                    closeMobileSidebar();
                    menuToggle.focus();
                }
            });

            mobileQuery.addEventListener(
                "change",
                applySidebarState
            );

            applySidebarState();
        })();
    </script>

    <!-- MODAL XÁC THỰC CHUYỂN SANG GIAO DIỆN NHÂN VIÊN -->
    <div class="modal fade" id="switchStaffModal" tabindex="-1" aria-labelledby="switchStaffModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 440px;">
            <div class="modal-content border">
                <div class="modal-header border-bottom py-3">
                    <h5 class="modal-title fw-bold fs-6 d-flex align-items-center gap-2" id="switchStaffModalLabel" style="color: #172033;">
                        <i class="bi bi-shield-lock text-primary"></i>
                        Xác thực chuyển sang giao diện Nhân viên
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <form asp-area="Admin" asp-controller="System" asp-action="SwitchToStaffMode" method="post">
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-4">
                        <p class="text-muted small mb-3">
                            Để đảm bảo an toàn nghiệp vụ, vui lòng nhập lại mật khẩu Quản trị viên để chuyển sang chế độ làm việc với giao diện Nhân viên.
                        </p>
                        <div class="mb-3">
                            <label class="form-label fw-semibold" style="font-size: 13px;">Mật khẩu xác nhận <span class="text-danger">*</span></label>
                            <input type="password" name="password" class="form-control" placeholder="Nhập mật khẩu hiện tại của bạn" required autofocus style="height: 40px; font-size: 14px;" />
                        </div>
                    </div>
                    <div class="modal-footer border-top py-2 px-3 d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-outline-secondary px-3" data-bs-dismiss="modal" style="height: 38px; font-size: 13px;">Hủy bỏ</button>
                        <button type="submit" class="btn btn-primary px-3 d-flex align-items-center gap-1" style="height: 38px; font-size: 13px; font-weight: 600;">
                            <i class="bi bi-arrow-repeat"></i> Xác nhận chuyển đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <script src="~/js/shared/emua-notify.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
