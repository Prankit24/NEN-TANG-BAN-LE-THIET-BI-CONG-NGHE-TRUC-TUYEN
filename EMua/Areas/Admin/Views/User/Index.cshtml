@model IEnumerable<EMua.Models.Database.NguoiDung>
@using EMua.Models.Database
@{
    ViewData["Title"] = "Quản lý người dùng";

    var roles = (List<PhanQuyen>)ViewBag.DanhSachQuyen;
    int? currentUserId = ViewBag.CurrentUserId;
    int adminCount = ViewBag.AdminCount;
    int page = ViewBag.Page;
    int totalPages = ViewBag.TotalPages;

    string InitialsOf(string? name)
    {
        if (string.IsNullOrWhiteSpace(name)) return "?";
        var parts = name.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return parts.Length == 1 ? parts[0][..1].ToUpper() : $"{parts[0][0]}{parts[^1][0]}".ToUpper();
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-users.css" asp-append-version="true" />
}

<div class="users-page">
    <!-- TIÊU ĐỀ & NÚT THÊM TÀI KHOẢN -->
    <div class="users-page-heading d-flex align-items-center justify-content-between flex-wrap gap-3 mb-3">
        <div>
            <h2 class="users-page-title mb-1">Quản lý tài khoản người dùng</h2>
            <p class="users-page-subtitle mb-0">Tìm kiếm, phân quyền và kiểm soát trạng thái tài khoản toàn hệ thống</p>
        </div>
        <a asp-action="Create" class="btn btn-primary users-primary-action d-inline-flex align-items-center gap-2 fw-semibold px-3">
            <i class="bi bi-person-plus-fill"></i>
            Thêm tài khoản mới
        </a>
    </div>

    <!-- THỐNG KÊ NHANH -->
    <div class="row g-3 mb-3 users-stats">
        <div class="col-6 col-lg-3">
            <div class="mini-stat bg-white p-3 border d-flex align-items-center gap-3">
                <div class="mini-stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-people-fill"></i></div>
                <div>
                    <div class="mini-stat-value fw-bold text-dark">@ViewBag.TotalUsers</div>
                    <div class="mini-stat-label text-muted">Tổng tài khoản</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="mini-stat bg-white p-3 border d-flex align-items-center gap-3">
                <div class="mini-stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-check-circle-fill"></i></div>
                <div>
                    <div class="mini-stat-value fw-bold text-dark">@ViewBag.ActiveUsers</div>
                    <div class="mini-stat-label text-muted">Đang hoạt động</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="mini-stat bg-white p-3 border d-flex align-items-center gap-3">
                <div class="mini-stat-icon bg-danger bg-opacity-10 text-danger"><i class="bi bi-lock-fill"></i></div>
                <div>
                    <div class="mini-stat-value fw-bold text-dark">@ViewBag.LockedUsers</div>
                    <div class="mini-stat-label text-muted">Đã khóa</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="mini-stat bg-white p-3 border d-flex align-items-center gap-3">
                <div class="mini-stat-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-shield-fill-check"></i></div>
                <div>
                    <div class="mini-stat-value fw-bold text-dark">@adminCount</div>
                    <div class="mini-stat-label text-muted">Quản trị viên</div>
                </div>
            </div>
        </div>
    </div>

    <!-- BỘ LỌC TÌM KIẾM -->
    <div class="filter-bar bg-white border mb-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center" onsubmit="return false;">
            <div class="col-md-5">
                <div class="input-group users-search-group">
                    <span class="input-group-text bg-light border-end-0 ps-3"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="searchString" name="searchString" value="@ViewBag.SearchString" class="form-control bg-light border-start-0" placeholder="Tìm tên, email, SĐT, tên đăng nhập...">
                </div>
            </div>
            <div class="col-md-3">
                <select id="maQuyen" name="maQuyen" class="form-select bg-light">
                    <option value="">Tất cả phân quyền</option>
                    @foreach (var r in roles)
                    {
                        <option value="@r.MaQuyen" selected="@(ViewBag.SelectedRole == r.MaQuyen)">@r.TenQuyen</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select id="trangThai" name="trangThai" class="form-select bg-light">
                    <option value="">Tất cả trạng thái</option>
                    <option value="true" selected="@(ViewBag.SelectedStatus == true)">Đang hoạt động</option>
                    <option value="false" selected="@(ViewBag.SelectedStatus == false)">Đã khóa</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="button" id="btnResetFilter" class="btn btn-outline-secondary w-100 d-flex align-items-center justify-content-center gap-1">
                    <i class="bi bi-arrow-counterclockwise"></i> Đặt lại
                </button>
            </div>
        </form>
    </div>

    <!-- BẢNG DỮ LIỆU TÀI KHOẢN -->
    <div id="userTableContainer">
        <div class="users-table-panel border bg-white mb-3">
            <div class="table-responsive users-table-scroll">
                <table class="table align-middle mb-0">
                    <thead class="table-light text-secondary">
                        <tr>
                            <th class="py-3 ps-4" style="min-width: 240px;">Tài khoản</th>
                            <th class="py-3" style="width: 150px;">Tên đăng nhập</th>
                            <th class="py-3" style="width: 140px;">Số điện thoại</th>
                            <th class="py-3 text-center" style="width: 140px;">Phân quyền</th>
                            <th class="py-3 text-center" style="width: 130px;">Trạng thái</th>
                            <th class="py-3 text-end pe-4" style="width: 160px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                bool isSelf = currentUserId == item.MaNguoiDung;
                                bool isAdmin = item.MaQuyenNavigation?.TenQuyen == "Admin";
                                bool isLastAdmin = isAdmin && item.TrangThai && adminCount <= 1;
                                bool lockDisabled = isSelf || isLastAdmin;

                                <tr class="@(isSelf ? "table-active" : "")">
                                    <td class="ps-4 py-3">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="avatar-circle bg-primary bg-opacity-10 text-primary fw-bold d-flex align-items-center justify-content-center">
                                                @InitialsOf(item.TenNguoiDung)
                                            </div>
                                            <div>
                                                <div class="fw-semibold text-dark d-flex align-items-center gap-2">
                                                    @(item.TenNguoiDung ?? "Chưa cập nhật")
                                                    @if (isSelf)
                                                    {
                                                        <span class="badge" style="background:#EBF1FF; color:#315EFB; font-size:11px;">Bạn</span>
                                                    }
                                                </div>
                                                <small class="text-muted">@item.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td><code class="text-dark bg-light px-2 py-1">@item.TenDangNhap</code></td>
                                    <td style="font-size:13px;">@(item.SoDienThoai ?? "—")</td>
                                    <td class="text-center">
                                        <span class="badge" style="background:@(isAdmin ? "#FEF3C7" : "#F1F5F9"); color:@(isAdmin ? "#B45309" : "#475569"); font-size:12px; font-weight:600; padding:5px 10px;">
                                            @(item.MaQuyenNavigation?.TenQuyen ?? "Khách hàng")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (item.TrangThai)
                                        {
                                            <span class="badge" style="background:#DCFCE7; color:#15803D; font-size:12px; font-weight:600; padding:5px 10px;">Hoạt động</span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background:#FEE2E2; color:#B91C1C; font-size:12px; font-weight:600; padding:5px 10px;">Đã khóa</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2">
                                            <a asp-action="Edit" asp-route-id="@item.MaNguoiDung" class="btn btn-sm btn-outline-secondary px-2 py-1 d-flex align-items-center gap-1">
                                                <i class="bi bi-pencil-square"></i> Sửa
                                            </a>
                                            <form asp-action="ToggleStatus" asp-route-id="@item.MaNguoiDung" method="post" class="d-inline"
                                                  onsubmit="return confirm('Xác nhận đổi trạng thái tài khoản #@item.MaNguoiDung ?');">
                                                @Html.AntiForgeryToken()
                                                <button type="submit"
                                                        class="btn btn-sm @(item.TrangThai ? "btn-outline-danger" : "btn-outline-success") px-2 py-1"
                                                        title="@(lockDisabled ? (isSelf ? "Không thể tự khóa tài khoản đang đăng nhập" : "Đây là quản trị viên cuối cùng") : "Đổi trạng thái")"
                                                        @(lockDisabled ? "disabled" : "")>
                                                    @(item.TrangThai ? "Khóa" : "Mở")
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="bi bi-folder2-open fs-2 d-block mb-2"></i> Không tìm thấy tài khoản người dùng nào phù hợp.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- Phân trang -->
            @if (totalPages > 1)
            {
                <div class="d-flex justify-content-between align-items-center p-3 bg-white border-top">
                    <span class="text-muted small">Trang @(page) / @totalPages</span>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            @for (int p = 1; p <= totalPages; p++)
                            {
                                <li class="page-item @(p == page ? "active" : "")">
                                    <a class="page-link ajax-page-link mx-1 @(p == page ? "bg-primary text-white border-primary" : "text-dark")"
                                       href="javascript:void(0);"
                                       data-page="@p">@p</a>
                                </li>
                            }
                        </ul>
                    </nav>
                </div>
            }
        </div>
    </div>

    <!-- Lưu ý hệ thống -->
    <div class="users-security-note alert alert-light border p-3 text-muted small d-flex align-items-center mb-0">
        <i class="bi bi-shield-lock-fill text-primary fs-5 me-2"></i>
        <span>Quy tắc an toàn: Quản trị viên không thể tự khóa tài khoản của chính mình. Hệ thống luôn đảm bảo duy trì ít nhất một tài khoản Quản trị viên hoạt động.</span>
    </div>
</div>

<!-- Modal Dialog Thông báo thành công -->
<div class="modal fade" id="successDialogModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border text-center p-4">
            <div class="mb-3 text-success">
                <i class="bi bi-check-circle-fill display-4"></i>
            </div>
            <h5 class="fw-bold mb-2">Thành công!</h5>
            <p class="text-muted small mb-4" id="successDialogMessage">Thao tác thực hiện thành công.</p>
            <button type="button" class="btn btn-primary w-100 py-2" data-bs-dismiss="modal">Đóng</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            @if (TempData["SuccessMessage"] != null)
            {
                    <text>
                    document.getElementById("successDialogMessage").textContent = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["SuccessMessage"]?.ToString() ?? ""));
                    var successModal = new bootstrap.Modal(document.getElementById('successDialogModal'));
                    successModal.show();
                    </text>
            }

            const searchInput = document.getElementById("searchString");
            const roleSelect = document.getElementById("maQuyen");
            const statusSelect = document.getElementById("trangThai");
            const btnResetFilter = document.getElementById("btnResetFilter");
            const tableContainer = document.getElementById("userTableContainer");

            let currentPage = 1;

            function fetchFilteredData(page = 1) {
                currentPage = page;
                const search = searchInput.value;
                const maQuyen = roleSelect.value;
                const trangThai = statusSelect.value;

                const url = `@Url.Action("Index")?searchString=${encodeURIComponent(search)}&maQuyen=${maQuyen}&trangThai=${trangThai}&page=${page}&isAjax=true`;

                fetch(url)
                    .then(response => response.text())
                    .then(html => {
                        const parser = new DOMParser();
                        const doc = parser.parseFromString(html, 'text/html');
                        const newContainer = doc.querySelector('#userTableContainer');

                        if (newContainer && tableContainer) {
                            tableContainer.innerHTML = newContainer.innerHTML;
                            attachPaginationEvents();
                        }
                    })
                    .catch(error => console.error('Lỗi khi lọc dữ liệu:', error));
            }

            function attachPaginationEvents() {
                document.querySelectorAll('.ajax-page-link').forEach(link => {
                    link.addEventListener('click', function (e) {
                        e.preventDefault();
                        const p = this.getAttribute('data-page');
                        fetchFilteredData(p);
                    });
                });
            }

            let debounceTimer;
            searchInput.addEventListener("input", function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(() => fetchFilteredData(1), 300);
            });

            roleSelect.addEventListener("change", () => fetchFilteredData(1));
            statusSelect.addEventListener("change", () => fetchFilteredData(1));

            btnResetFilter.addEventListener("click", function () {
                searchInput.value = "";
                roleSelect.value = "";
                statusSelect.value = "";
                fetchFilteredData(1);
            });

            attachPaginationEvents();
        });
    </script>
}
