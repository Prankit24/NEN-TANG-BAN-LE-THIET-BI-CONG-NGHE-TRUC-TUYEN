@model EMua.Models.ViewModels.BaoCaoDashboardViewModel
@using EMua.Models.ViewModels
@{
    ViewData["Title"] = "Báo cáo tài chính & Thống kê";

    var cur = Model.Current;
    var prev = Model.Previous;

    decimal profitGrowth = BaoCaoDashboardViewModel.Growth(cur.NetProfit, prev.NetProfit);
    decimal profitDiff = cur.NetProfit - prev.NetProfit;

    // Trạng thái tổng quát để hiển thị banner
    string verdictClass = cur.NetProfit < 0 ? "loss" : profitGrowth > 0 ? "up" : profitGrowth < 0 ? "down" : "flat";
    string verdictIcon = verdictClass switch
    {
        "loss" => "bi-exclamation-octagon-fill",
        "up" => "bi-arrow-up-right-circle-fill",
        "down" => "bi-arrow-down-right-circle-fill",
        _ => "bi-dash-circle-fill"
    };
    string verdictTitle = verdictClass switch
    {
        "loss" => $"{cur.Label}: kinh doanh đang lỗ {Math.Abs(cur.NetProfit).ToString("N0")} đ",
        "up" => $"Lợi nhuận tăng {Math.Abs(profitGrowth).ToString("0.#")}% so với {prev.Label}",
        "down" => $"Lợi nhuận giảm {Math.Abs(profitGrowth).ToString("0.#")}% so với {prev.Label}",
        _ => $"Lợi nhuận không đổi so với {prev.Label}"
    };
    string verdictSub = verdictClass == "flat"
        ? "Chưa có biến động đáng kể giữa hai kỳ đối chiếu."
        : $"Chênh lệch {(profitDiff >= 0 ? "+" : "−")}{Math.Abs(profitDiff).ToString("N0")} đ · Biên lợi nhuận {cur.Margin.ToString("0.#")}%";

    // Chip hiển thị tăng/giảm. isCost = true thì tăng là xấu (đỏ), giảm là tốt (xanh)
    void Chip(decimal growth, bool isCost = false)
    {
        string dir = growth > 0 ? "up" : growth < 0 ? "down" : "flat";
        string tone = growth == 0 ? "flat" : ((growth > 0) != isCost) ? "good" : "bad";
        string icon = growth > 0 ? "bi-caret-up-fill" : growth < 0 ? "bi-caret-down-fill" : "bi-dash";
        <span class="trend-chip @tone" title="So với @prev.Label">
            <i class="bi @icon"></i> @Math.Abs(growth).ToString("0.#")%
        </span>
    }

    // 1 dòng của bảng so sánh
    void CompareRow(string name, decimal now, decimal before, bool isCost = false, bool strong = false, string suffix = " đ")
    {
        decimal g = BaoCaoDashboardViewModel.Growth(now, before);
        decimal d = now - before;
        <tr class="@(strong ? "row-strong" : "")">
            <td>@name</td>
            <td class="text-end fw-semibold">@now.ToString("N0")@suffix</td>
            <td class="text-end text-muted">@before.ToString("N0")@suffix</td>
            <td class="text-end">@(d > 0 ? "+" : d < 0 ? "−" : "")@Math.Abs(d).ToString("N0")@suffix</td>
            <td class="text-end">
                @{
                    Chip(g, isCost);
                }
            </td>
        </tr>
    }
}

@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-report.css" asp-append-version="true" />
}

<div class="report-page">
    <!-- SECTION 1: HEADER & TOOLBAR -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h2 class="mb-1" style="font-size: 20px; font-weight: 700; color: #172033;">Báo cáo kinh doanh</h2>
            <p class="text-muted small mb-0">Đối chiếu <strong>@cur.Label</strong> và <strong>@prev.Label</strong> · Các khoản ước tính không thay thế báo cáo kế toán hoặc hóa đơn thuế.</p>
        </div>
        <button type="button" class="btn btn-outline-secondary d-inline-flex align-items-center gap-2 no-print" onclick="window.print()" style="height:38px; font-size:13px;">
            <i class="bi bi-printer"></i> In báo cáo
        </button>
    </div>

    <!-- BỘ LỌC THỜI GIAN -->
    <div class="report-filter-card no-print mb-3 bg-white border">
        <form method="get" asp-action="Index" class="row g-2 align-items-end">
            <div class="col-md-3">
                <label class="form-label" style="font-size:13px; font-weight:500;">Kỳ báo cáo</label>
                <select name="filterType" id="filterTypeSelect" class="form-select" style="height:40px; font-size:13.5px;" onchange="toggleFilterType(this.value)">
                    <option value="month" selected="@(Model.FilterType == "month")">Theo Tháng</option>
                    <option value="quarter" selected="@(Model.FilterType == "quarter")">Theo Quý</option>
                </select>
            </div>

            <div class="col-md-3" id="monthFilterBox" style="display:@(Model.FilterType == "month" ? "block" : "none")">
                <label class="form-label" style="font-size:13px; font-weight:500;">Chọn tháng</label>
                <select name="month" class="form-select" style="height:40px; font-size:13.5px;">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i" selected="@(Model.Month == i)">Tháng @i</option>
                    }
                </select>
            </div>

            <div class="col-md-3" id="quarterFilterBox" style="display:@(Model.FilterType == "quarter" ? "block" : "none")">
                <label class="form-label" style="font-size:13px; font-weight:500;">Chọn quý</label>
                <select name="quarter" class="form-select" style="height:40px; font-size:13.5px;">
                    <option value="1" selected="@(Model.Quarter == 1)">Quý 1 (Tháng 1 - 3)</option>
                    <option value="2" selected="@(Model.Quarter == 2)">Quý 2 (Tháng 4 - 6)</option>
                    <option value="3" selected="@(Model.Quarter == 3)">Quý 3 (Tháng 7 - 9)</option>
                    <option value="4" selected="@(Model.Quarter == 4)">Quý 4 (Tháng 10 - 12)</option>
                </select>
            </div>

            <div class="col-md-3">
                <label class="form-label" style="font-size:13px; font-weight:500;">Năm tài chính</label>
                <select name="year" class="form-select" style="height:40px; font-size:13.5px;">
                    @for (int y = 2024; y <= DateTime.Now.Year; y++)
                    {
                        <option value="@y" selected="@(Model.Year == y)">Năm @y</option>
                    }
                </select>
            </div>

            <div class="col-md-3">
                <button type="submit" class="btn btn-primary w-100 d-flex align-items-center justify-content-center gap-2" style="height:40px; font-size:13px; font-weight:600;">
                    <i class="bi bi-funnel"></i> Áp dụng bộ lọc
                </button>
            </div>
        </form>
    </div>

    <!-- TỔNG KẾT BIẾN ĐỘNG -->
    <div class="verdict-banner @verdictClass mb-3 border d-flex align-items-center gap-2">
        <div class="verdict-icon fs-3"><i class="bi @verdictIcon"></i></div>
        <div>
            <div class="verdict-title fw-bold" style="font-size: 15px;">@verdictTitle</div>
            <div class="verdict-sub text-muted small">@verdictSub</div>
        </div>
    </div>

    <!-- 4 CHỈ SỐ TÀI CHÍNH QUAN TRỌNG -->
    <div class="row g-2 mb-3 report-kpi-grid">
        <div class="col-xl-3 col-md-6">
            <div class="kpi-card revenue bg-white border">
                <div class="kpi-label d-flex align-items-center gap-2 text-muted small mb-2"><i class="bi bi-cash-stack text-primary"></i> Doanh thu thực tế</div>
                <div class="kpi-value fw-bold" style="font-size: 24px; color: #172033; letter-spacing: -0.5px;">@cur.Revenue.ToString("N0") đ</div>
                <div class="kpi-foot d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                    @{
                        Chip(BaoCaoDashboardViewModel.Growth(cur.Revenue, prev.Revenue));
                    }
                    <span class="text-muted small">Kỳ trước: @(prev.Revenue >= 1000000 ? (prev.Revenue / 1000000m).ToString("0.#") + " tr" : prev.Revenue.ToString("N0") + " đ")</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="kpi-card profit @(cur.NetProfit < 0 ? "is-loss" : "") bg-white border">
                <div class="kpi-label d-flex align-items-center gap-2 text-muted small mb-2"><i class="bi bi-graph-up-arrow text-success"></i> Lợi nhuận ròng</div>
                <div class="kpi-value fw-bold" style="font-size: 24px; color: @(cur.NetProfit < 0 ? "#DC2626" : "#16803C"); letter-spacing: -0.5px;">@cur.NetProfit.ToString("N0") đ</div>
                <div class="kpi-foot d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                    @{
                        Chip(profitGrowth);
                    }
                    <span class="text-muted small">Biên LN: @cur.Margin.ToString("0.#")%</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="kpi-card expense bg-white border">
                <div class="kpi-label d-flex align-items-center gap-2 text-muted small mb-2"><i class="bi bi-receipt-cutoff text-danger"></i> Chi phí & Khấu trừ</div>
                <div class="kpi-value fw-bold" style="font-size: 24px; color: #172033; letter-spacing: -0.5px;">@cur.TotalCost.ToString("N0") đ</div>
                <div class="kpi-foot d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                    @{
                        Chip(BaoCaoDashboardViewModel.Growth(cur.TotalCost, prev.TotalCost), isCost: true);
                    }
                    <span class="text-muted small">Kỳ trước: @(prev.TotalCost >= 1000000 ? (prev.TotalCost / 1000000m).ToString("0.#") + " tr" : prev.TotalCost.ToString("N0") + " đ")</span>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="kpi-card orders bg-white border">
                <div class="kpi-label d-flex align-items-center gap-2 text-muted small mb-2"><i class="bi bi-bag-check-fill text-info"></i> Đơn hoàn thành</div>
                <div class="kpi-value fw-bold" style="font-size: 24px; color: #172033; letter-spacing: -0.5px;">@cur.Orders.ToString("N0") đơn</div>
                <div class="kpi-foot d-flex align-items-center justify-content-between mt-2 pt-2 border-top">
                    @{
                        Chip(BaoCaoDashboardViewModel.Growth(cur.Orders, prev.Orders));
                    }
                    <span class="text-muted small">@Model.TotalUsers.ToString("N0") người dùng</span>
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 2: BIỂU ĐỒ TÀI CHÍNH -->
    <div class="row g-2 mb-3">
        <div class="col-lg-8">
            <div class="panel h-100 bg-white border">
                <div class="panel-head mb-2 pb-2 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0" style="font-size: 15px; color: #172033;">Xu hướng Doanh thu & Lợi nhuận năm @Model.Year</h5>
                    <span class="text-muted small">Doanh thu (cột) · Lợi nhuận (đường)</span>
                </div>
                <div class="panel-body chart-box">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="panel h-100 bg-white border">
                <div class="panel-head mb-2 pb-2 border-bottom">
                    <h5 class="fw-bold mb-0" style="font-size: 15px; color: #172033;">Cơ cấu chi phí và lợi nhuận ước tính</h5>
                </div>
                <div class="panel-body chart-box">
                    @if (cur.Revenue > 0)
                    {
                        <canvas id="structureChart"></canvas>
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center h-100 text-muted small">
                            Kỳ đối chiếu chưa phát sinh doanh thu.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- SECTION 3: BẢNG BÁO CÁO ĐỐI CHIẾU CHI TIẾT & BÁO CÁO ĐÃ LƯU -->
    <div class="row g-2 mb-3">
        <div class="col-lg-7">
            <div class="panel h-100 bg-white border">
                <div class="panel-head px-3 py-2 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0" style="font-size: 15px; color: #172033;">Đối chiếu: @cur.Label với @prev.Label</h5>
                    <span class="badge" style="background:#EBF1FF; color:#315EFB; font-weight:600;">Báo cáo nội bộ</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-financial align-middle mb-0">
                        <thead class="table-light text-secondary text-uppercase" style="font-size: 11.5px; font-weight: 600;">
                            <tr>
                                <th class="ps-3 py-3">Khoản mục</th>
                                <th class="text-end py-3">Kỳ này</th>
                                <th class="text-end py-3">Kỳ trước</th>
                                <th class="text-end py-3">Chênh lệch</th>
                                <th class="text-end pe-3 py-3">Biến động</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                CompareRow("Doanh thu bán hàng", cur.Revenue, prev.Revenue, strong: true);
                                CompareRow("Số đơn thành công", cur.Orders, prev.Orders, suffix: " đơn");
                                CompareRow("Giá trị đơn trung bình (AOV)", cur.AvgOrderValue, prev.AvgOrderValue);
                                CompareRow("Thuế VAT (giá trị ước tính từ hệ thống)", cur.Tax, prev.Tax, isCost: true);
                                CompareRow("Lương nhân sự vận hành", cur.Salary, prev.Salary, isCost: true);
                                CompareRow("Giá vốn & vận hành (ước tính)", cur.Operating, prev.Operating, isCost: true);
                                CompareRow("Lợi nhuận ròng cuối kỳ", cur.NetProfit, prev.NetProfit, strong: true);
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="panel h-100 bg-white border">
                <div class="panel-head px-3 py-2 border-bottom d-flex align-items-center justify-content-between">
                    <h5 class="fw-bold mb-0" style="font-size: 15px; color: #172033;">Báo cáo đã lưu</h5>
                    <span class="text-muted small">Cơ sở dữ liệu</span>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light text-secondary text-uppercase" style="font-size: 11.5px; font-weight: 600;">
                            <tr>
                                <th class="ps-3 py-3">Mã báo cáo</th>
                                <th class="py-3">Phân loại</th>
                                <th class="text-end pe-3 py-3">Ngày lập</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.BaoCaoLuuTru.Any())
                            {
                                foreach (var bc in Model.BaoCaoLuuTru)
                                {
                                    <tr>
                                        <td class="ps-3"><code class="text-dark bg-light px-2 py-1">#@bc.MaBaoCao</code></td>
                                        <td><strong>@(bc.LoaiBaoCao ?? "Báo cáo tài chính định kỳ")</strong></td>
                                        <td class="text-end pe-3 text-muted">@(bc.NgayBaoCao?.ToString("dd/MM/yyyy") ?? "—")</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="3" class="text-center text-muted py-4">Chưa có bản lưu trữ báo cáo định kỳ nào.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        function toggleFilterType(val) {
            document.getElementById('monthFilterBox').style.display = val === 'month' ? 'block' : 'none';
            document.getElementById('quarterFilterBox').style.display = val === 'quarter' ? 'block' : 'none';
        }

        (function () {
            const fmt = v => new Intl.NumberFormat('vi-VN').format(v) + ' đ';
            const compact = v => {
                const a = Math.abs(v);
                if (a >= 1e9) return (v / 1e9).toFixed(1) + ' tỷ';
                if (a >= 1e6) return (v / 1e6).toFixed(0) + ' tr';
                if (a >= 1e3) return (v / 1e3).toFixed(0) + ' k';
                return v;
            };

            // --- Xu hướng 12 tháng (Clean Blue & Neutral Theme — No Purple) ---
            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendLabels));
            const revenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendRevenue));
            const profit = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TrendProfit));

            const isMonth = '@Model.FilterType' === 'month';
            const first = isMonth ? @(Model.Month - 1) : @((Model.Quarter - 1) * 3);
            const last = isMonth ? first : first + 2;
            const barColors = labels.map((_, i) => (i >= first && i <= last) ? '#315EFB' : '#CBD5E1');

            if (typeof Chart === "undefined") {
                document.querySelectorAll(".chart-box").forEach(box => { box.textContent = "Không tải được thư viện biểu đồ. Vui lòng kiểm tra kết nối mạng."; });
                return;
            }
            new Chart(document.getElementById('trendChart'), {
                data: {
                    labels,
                    datasets: [
                        { type: 'bar', label: 'Doanh thu', data: revenue, backgroundColor: barColors, borderRadius: 0, order: 2 },
                        { type: 'line', label: 'Lợi nhuận ròng', data: profit, borderColor: '#16803C', backgroundColor: '#16803C',
                          tension: 0.2, borderWidth: 2, pointRadius: 3, order: 1 }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, font: { family: 'Inter', size: 12 } } },
                        tooltip: { callbacks: { label: c => ' ' + c.dataset.label + ': ' + fmt(c.parsed.y) } }
                    },
                    scales: {
                        y: { ticks: { callback: compact, font: { family: 'Inter', size: 11 } }, grid: { color: '#F1F5F9' } },
                        x: { grid: { display: false }, ticks: { font: { family: 'Inter', size: 11 } } }
                    }
                }
            });

            // --- Cơ cấu doanh thu (Clean Functional Palette — No Purple) ---
            const el = document.getElementById('structureChart');
            if (el) {
                const rev = @cur.Revenue.ToString(System.Globalization.CultureInfo.InvariantCulture);
                const parts = [
                    { name: 'Thuế VAT', v: @cur.Tax.ToString(System.Globalization.CultureInfo.InvariantCulture), c: '#D97706' },
                    { name: 'Lương nhân sự', v: @cur.Salary.ToString(System.Globalization.CultureInfo.InvariantCulture), c: '#64748B' },
                    { name: 'Giá vốn & Vận hành', v: @cur.Operating.ToString(System.Globalization.CultureInfo.InvariantCulture), c: '#DC2626' },
                    { name: 'Lợi nhuận ròng', v: Math.max(@cur.NetProfit.ToString(System.Globalization.CultureInfo.InvariantCulture), 0), c: '#16803C' }
                ];
                if (parts.every(p => p.v <= 0)) {
                    el.parentElement.textContent = "Chưa có dữ liệu dương để hiển thị cơ cấu.";
                    return;
                }
                new Chart(el, {
                    type: 'doughnut',
                    data: {
                        labels: parts.map(p => p.name),
                        datasets: [{ data: parts.map(p => p.v), backgroundColor: parts.map(p => p.c), borderWidth: 2, borderColor: '#fff' }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '65%',
                        plugins: {
                            legend: { position: 'bottom', labels: { usePointStyle: true, boxWidth: 8, font: { family: 'Inter', size: 11 } } },
                            tooltip: { callbacks: { label: c => ' ' + c.label + ': ' + fmt(c.parsed) + ' (' + (rev > 0 ? (c.parsed / rev * 100).toFixed(1) : '0') + '%)' } }
                        }
                    }
                });
            }
        })();
    </script>
}
