@model IEnumerable<EMua.Models.Database.PhanQuyen>
@{
    ViewData["Title"] = "Quản lý phân quyền";
    string adminRoleName = ViewBag.AdminRoleName ?? "Admin";
    var roles = Model?.ToList() ?? new List<EMua.Models.Database.PhanQuyen>();
    var successMessage = TempData["SuccessMessage"]?.ToString();
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-users.css" asp-append-version="true" />
    <style>
        .role-panel {
            background: #fff;
            border: 1px solid #e2e8f0;
            padding: 22px
        }

        .role-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            flex-wrap: wrap;
            margin-bottom: 20px
        }

        .role-stat {
            background: #f8faff;
            border: 1px solid #e2e8f0;
            padding: 18px;
            display: flex;
            align-items: center;
            gap: 15px;
            height: 100%
        }

        .role-icon {
            width: 48px;
            height: 48px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #eaf0ff;
            color: #315cff;
            font-size: 22px
        }

        .role-card-custom {
            border: 1px solid #e2e8f0;
            padding: 20px;
            height: 100%;
            display: flex;
            flex-direction: column;
            background: white
        }

            .role-card-custom.is-protected {
                border-color: #e9cf91
            }

        .role-actions {
            margin-top: auto;
            border-top: 1px solid #e2e8f0;
            padding-top: 15px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 10px;
            flex-wrap: wrap
        }

            .role-actions form {
                margin: 0
            }

        @@media(max-width:767.98px) {
            .role-panel {
                padding: 14px
            }

            .role-header .btn {
                width: 100%
            }
        }
    </style>
}
<div class="users-page">
    <div class="role-panel">
        <div class="role-header">
            <div>
                <h5 class="fw-bold mb-1">Danh sách nhóm quyền</h5>
                <span class="text-muted small">Quản lý phân quyền hệ thống EMUA</span>
            </div>
            <button type="button" class="btn btn-primary d-flex align-items-center justify-content-center gap-2" data-bs-toggle="modal" data-bs-target="#createRoleModal">
                <i class="bi bi-plus-lg"></i> Thêm nhóm quyền
            </button>
        </div>
        <div class="row g-3 mb-4">
            <div class="col-12 col-md-6"><div class="role-stat"><div class="role-icon"><i class="bi bi-diagram-3-fill"></i></div><div><div class="fw-bold fs-4">@ViewBag.TotalRoles</div><div class="small text-muted">Nhóm quyền</div></div></div></div>
            <div class="col-12 col-md-6"><div class="role-stat"><div class="role-icon"><i class="bi bi-people-fill"></i></div><div><div class="fw-bold fs-4">@ViewBag.TotalUsers</div><div class="small text-muted">Tài khoản đã phân quyền</div></div></div></div>
        </div>
        <div class="row g-3">
            @foreach (var role in roles)
            {
                int userCount = role.NguoiDungs?.Count ?? 0;
                bool isProtected = role.TenQuyen == adminRoleName;
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="role-card-custom @(isProtected ? "is-protected" : "")">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="role-icon"><i class="bi @(isProtected ? "bi-shield-fill-exclamation" : "bi-shield-fill-check")"></i></div>
                            <div>
                                <div class="fw-bold">@role.TenQuyen @if(isProtected){
                                <span class="badge bg-warning text-dark">Hệ thống</span>
                            }
</div>
                            <small class="text-muted">Mã định danh: #@role.MaQuyen</small>
                        </div>
                    </div>
                    <p class="small text-muted mb-4">@(isProtected ? "Quyền quản trị cao nhất. Không thể đổi tên hoặc xóa." : "Nhóm phân quyền vận hành cửa hàng EMUA.")</p>
                    <div class="role-actions">
                        <span class="badge bg-light text-dark px-3 py-2"><i class="bi bi-people-fill text-primary me-1"></i>@userCount tài khoản</span>
                        <div class="d-flex gap-2">
                            <button type="button" class="btn btn-sm btn-outline-primary px-3" data-bs-toggle="modal" data-bs-target="#editRoleModal-@role.MaQuyen" disabled="@isProtected" title="@(isProtected ? "Không thể sửa quyền hệ thống" : "Sửa")"><i class="bi bi-pencil-square"></i></button>
                            <form asp-action="Delete" method="post" onsubmit="return confirm('Bạn có chắc muốn xóa nhóm quyền này?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maQuyen" value="@role.MaQuyen" />
                                <button type="submit" class="btn btn-sm btn-outline-danger px-3" disabled="@(isProtected || userCount > 0)" title="@(isProtected ? "Quyền hệ thống" : userCount > 0 ? "Còn tài khoản sử dụng" : "Xóa")"><i class="bi bi-trash"></i></button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
                        }
        </div>
        @if (!roles.Any())
        {
            <div class="text-center text-muted py-5">Chưa có nhóm quyền nào.</div>
        }
        <div class="alert alert-light border mt-4 mb-0 small"><i class="bi bi-shield-lock-fill text-primary me-2"></i>Nhóm quyền <strong>@adminRoleName</strong> được hệ thống bảo vệ, không thể đổi tên hoặc xóa.</div>
    </div>
</div>
@foreach (var role in roles)
{
    if (role.TenQuyen != adminRoleName)
    {
        <div class="modal fade" id="editRoleModal-@role.MaQuyen" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maQuyen" value="@role.MaQuyen" />
                        <div class="modal-header"><h5 class="modal-title fw-bold">Sửa nhóm quyền</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
                        <div class="modal-body"><label class="form-label fw-semibold" for="role-name-@role.MaQuyen">Tên nhóm quyền <span class="text-danger">*</span></label><input id="role-name-@role.MaQuyen" type="text" name="tenQuyen" class="form-control" value="@role.TenQuyen" required /></div>
                        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button><button type="submit" class="btn btn-primary"><i class="bi bi-save me-1"></i>Lưu thay đổi</button></div>
                    </form>
                </div>
            </div>
        </div>
    }
}
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header"><h5 class="modal-title fw-bold">Thêm nhóm quyền mới</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
                <div class="modal-body"><label class="form-label fw-semibold" for="new-role-name">Tên nhóm quyền <span class="text-danger">*</span></label><input id="new-role-name" type="text" name="tenQuyen" class="form-control" placeholder="Ví dụ: Nhân viên bán hàng" required /></div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button><button type="submit" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Thêm mới</button></div>
            </form>
        </div>
    </div>
</div>
<div class="modal fade" id="successDialogModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border-0 text-center p-4">
            <div class="mb-3 text-success"><i class="bi bi-check-circle-fill display-4"></i></div>
            <h5 class="fw-bold mb-2">Thành công!</h5>
            <p class="text-muted small mb-4" id="successDialogMessage">Thao tác thực hiện thành công.</p>
            <button type="button" class="btn btn-primary w-100" data-bs-dismiss="modal">Đóng</button>
        </div>
    </div>
</div>
@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const message = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage));
            if (message) {
                document.getElementById("successDialogMessage").textContent = message;
                new bootstrap.Modal(document.getElementById("successDialogModal")).show();
            }
        });
    </script>
}
