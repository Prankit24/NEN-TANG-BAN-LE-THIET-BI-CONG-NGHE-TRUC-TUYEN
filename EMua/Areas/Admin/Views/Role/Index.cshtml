@model IEnumerable<EMua.Models.Database.PhanQuyen>
@{
    ViewData["Title"] = "Quản lý phân quyền";
    string adminRoleName = ViewBag.AdminRoleName ?? "Admin";
    var roles = Model?.ToList() ?? new List<EMua.Models.Database.PhanQuyen>();
    var successMessage = TempData["SuccessMessage"]?.ToString();
    var errorMessage = TempData["ErrorMessage"]?.ToString();
}
@section Styles {
    <link rel="stylesheet" href="~/css/admin/admin-users.css" asp-append-version="true" />
}

<div class="users-page">
    <!-- TIÊU ĐỀ & NÚT THÊM NHÓM QUYỀN -->
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
        <div>
            <h2 class="mb-1" style="font-size: 20px; font-weight: 700; color: #172033;">Quản lý phân quyền hệ thống</h2>
            <p class="text-muted small mb-0">Thiết lập các nhóm vai trò và phạm vi quyền hạn tài khoản trong EMUA</p>
        </div>
        <button type="button" class="btn btn-primary d-inline-flex align-items-center gap-2 fw-semibold px-3" style="height:40px; font-size:13px;" data-bs-toggle="modal" data-bs-target="#createRoleModal">
            <i class="bi bi-shield-plus"></i> Thêm nhóm quyền mới
        </button>
    </div>

    @if (!string.IsNullOrWhiteSpace(errorMessage))
    {
        <div class="alert alert-danger border mb-4 d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-octagon-fill fs-5"></i>
            <div>@errorMessage</div>
        </div>
    }

    <!-- THỐNG KÊ TỔNG QUAN PHÂN QUYỀN -->
    <div class="row g-3 mb-4">
        <div class="col-md-6">
            <div class="p-3 bg-white border d-flex align-items-center gap-3">
                <div class="d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: #EBF1FF; color: #315EFB; font-size: 20px;">
                    <i class="bi bi-shield-lock-fill"></i>
                </div>
                <div>
                    <div class="fw-bold" style="font-size: 22px; color: #172033; line-height: 1.2;">@ViewBag.TotalRoles</div>
                    <small class="text-muted" style="font-size: 12px;">Tổng số nhóm quyền được cấu hình</small>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="p-3 bg-white border d-flex align-items-center gap-3">
                <div class="d-flex align-items-center justify-content-center" style="width: 44px; height: 44px; background: #F0FDF4; color: #16803C; font-size: 20px;">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <div class="fw-bold" style="font-size: 22px; color: #172033; line-height: 1.2;">@ViewBag.TotalUsers</div>
                    <small class="text-muted" style="font-size: 12px;">Tổng số người dùng đã được gán quyền</small>
                </div>
            </div>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH NHÓM QUYỀN HỆ THỐNG -->
    <div class="border bg-white mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light text-secondary text-uppercase" style="font-size:12px; font-weight:600;">
                    <tr>
                        <th class="py-3 ps-4" style="width: 100px;">Mã</th>
                        <th class="py-3" style="min-width: 200px;">Tên nhóm quyền</th>
                        <th class="py-3" style="min-width: 250px;">Mô tả phạm vi</th>
                        <th class="py-3 text-center" style="width: 160px;">Số tài khoản</th>
                        <th class="py-3 text-center" style="width: 140px;">Loại quyền</th>
                        <th class="py-3 text-end pe-4" style="width: 150px;">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (roles.Any())
                    {
                        foreach (var role in roles)
                        {
                            int userCount = role.NguoiDungs?.Count ?? 0;
                            bool isProtected = role.TenQuyen.Equals(adminRoleName, StringComparison.OrdinalIgnoreCase);

                            <tr>
                                <td class="ps-4 py-3">
                                    <code class="text-dark bg-light px-2 py-1" style="font-size:12px;">#@role.MaQuyen</code>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="bi @(isProtected ? "bi-shield-fill-check text-warning" : "bi-shield text-primary")" style="font-size:16px;"></i>
                                        <span class="fw-semibold text-dark" style="font-size:14px;">@role.TenQuyen</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted small">
                                        @(isProtected 
                                            ? "Quyền quản trị cao nhất toàn hệ thống. Có toàn quyền cấu hình, quản lý nhân viên và duyệt nhập hàng." 
                                            : (role.TenQuyen.Contains("Nhân viên") || role.TenQuyen.Contains("Staff") 
                                                ? "Quyền nhân sự vận hành cửa hàng, xử lý đơn hàng, nhập kho và xuất hóa đơn." 
                                                : "Quyền khách hàng mua sắm và quản lý thông tin cá nhân."))
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="badge" style="background:#F1F5F9; color:#475569; font-size:12px; font-weight:600; padding:5px 12px;">
                                        <i class="bi bi-people me-1"></i>@userCount tài khoản
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (isProtected)
                                    {
                                        <span class="badge" style="background:#FEF3C7; color:#B45309; font-size:12px; font-weight:600; padding:5px 10px;">
                                            <i class="bi bi-lock-fill me-1"></i>Hệ thống
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#EBF1FF; color:#315EFB; font-size:12px; font-weight:600; padding:5px 10px;">
                                            Tùy biến
                                        </span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-outline-secondary px-2 py-1 d-flex align-items-center gap-1"
                                                style="font-size:12px; height:32px;"
                                                data-bs-toggle="modal"
                                                data-bs-target="#editRoleModal-@role.MaQuyen"
                                                disabled="@isProtected"
                                                title="@(isProtected ? "Quyền hệ thống được bảo vệ" : "Sửa tên nhóm quyền")">
                                            <i class="bi bi-pencil-square"></i> Sửa
                                        </button>
                                        <form asp-action="Delete" method="post" onsubmit="return confirm('Xác nhận xóa nhóm quyền @role.TenQuyen?');" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="maQuyen" value="@role.MaQuyen" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger px-2 py-1"
                                                    style="font-size:12px; height:32px;"
                                                    disabled="@(isProtected || userCount > 0)"
                                                    title="@(isProtected ? "Không thể xóa quyền hệ thống" : userCount > 0 ? "Vẫn còn tài khoản trực thuộc" : "Xóa nhóm quyền")">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center py-5 text-muted">
                                Chưa có nhóm quyền nào trong hệ thống.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Lưu ý an toàn -->
    <div class="alert alert-light border p-3 text-muted small d-flex align-items-center mb-0">
        <i class="bi bi-shield-check text-primary fs-5 me-2"></i>
        <span>Quy chuẩn hệ thống: Nhóm quyền <strong>@adminRoleName</strong> được bảo vệ vĩnh viễn, không thể đổi tên hoặc xóa nhằm bảo toàn khả năng quản trị EMUA.</span>
    </div>
</div>

<!-- Modal Sửa nhóm quyền -->
@foreach (var role in roles)
{
    if (!role.TenQuyen.Equals(adminRoleName, StringComparison.OrdinalIgnoreCase))
    {
        <div class="modal fade" id="editRoleModal-@role.MaQuyen" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border">
                    <form asp-action="Edit" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="maQuyen" value="@role.MaQuyen" />
                        <div class="modal-header border-bottom">
                            <h5 class="modal-title fw-bold" style="font-size:16px;">Sửa tên nhóm quyền #@role.MaQuyen</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                        </div>
                        <div class="modal-body p-4">
                            <label class="form-label" for="role-name-@role.MaQuyen" style="font-size:13px; font-weight:500;">Tên nhóm quyền <span class="text-danger">*</span></label>
                            <input id="role-name-@role.MaQuyen" type="text" name="tenQuyen" class="form-control" style="height:40px; font-size:14px;" value="@role.TenQuyen" required />
                            <small class="text-muted d-block mt-2">Thay đổi tên nhóm quyền sẽ áp dụng ngay cho tất cả tài khoản trực thuộc.</small>
                        </div>
                        <div class="modal-footer border-top">
                            <button type="button" class="btn btn-outline-secondary" style="height:38px; font-size:13px;" data-bs-dismiss="modal">Hủy bỏ</button>
                            <button type="submit" class="btn btn-primary" style="height:38px; font-size:13px; font-weight:600;">
                                <i class="bi bi-check-lg me-1"></i>Lưu thay đổi
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }
}

<!-- Modal Thêm nhóm quyền mới -->
<div class="modal fade" id="createRoleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header border-bottom">
                    <h5 class="modal-title fw-bold" style="font-size:16px;">Thêm nhóm quyền mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
                </div>
                <div class="modal-body p-4">
                    <label class="form-label" for="new-role-name" style="font-size:13px; font-weight:500;">Tên nhóm quyền <span class="text-danger">*</span></label>
                    <input id="new-role-name" type="text" name="tenQuyen" class="form-control" style="height:40px; font-size:14px;" placeholder="Ví dụ: Kế toán trưởng, Quản lý kho..." required />
                    <small class="text-muted d-block mt-2">Tên nhóm quyền không được trùng lặp với các nhóm đã có.</small>
                </div>
                <div class="modal-footer border-top">
                    <button type="button" class="btn btn-outline-secondary" style="height:38px; font-size:13px;" data-bs-dismiss="modal">Hủy bỏ</button>
                    <button type="submit" class="btn btn-primary" style="height:38px; font-size:13px; font-weight:600;">
                        <i class="bi bi-plus-lg me-1"></i>Thêm mới
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Thông báo thành công -->
<div class="modal fade" id="successDialogModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content border text-center p-4">
            <div class="mb-3 text-success">
                <i class="bi bi-check-circle-fill display-4"></i>
            </div>
            <h5 class="fw-bold mb-2">Thành công!</h5>
            <p class="text-muted small mb-4" id="successDialogMessage">Thao tác thực hiện thành công.</p>
            <button type="button" class="btn btn-primary w-100" data-bs-dismiss="modal">Đóng</button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const message = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage));
            if (message) {
                document.getElementById("successDialogMessage").textContent = message;
                new bootstrap.Modal(document.getElementById("successDialogModal")).show();
            }
        });
    </script>
}
