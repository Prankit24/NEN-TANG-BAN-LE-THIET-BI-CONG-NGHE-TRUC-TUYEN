@model EMua.Areas.Staff.Models.InvoiceCreateViewModel
@{
    ViewData["Title"] = $"Lập hóa đơn bán hàng - Đơn #DH-{Model.MaDonHang:D5}";
}

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h4 class="fw-bold mb-1"><i class="bi bi-file-earmark-diff text-primary me-2"></i>Lập &amp; Xem trước hóa đơn bán hàng</h4>
            <span class="text-muted small">Khởi tạo chứng từ xuất kho và thanh toán cho đơn hàng <strong>#DH-@Model.MaDonHang.ToString("D5")</strong></span>
        </div>
        <div class="d-flex gap-2">
            <a asp-area="Staff" asp-controller="Order" asp-action="Details" asp-route-id="@Model.MaDonHang" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay lại chi tiết đơn
            </a>
        </div>
    </div>

    <form id="invoiceCreateForm" asp-area="Staff" asp-controller="Invoice" asp-action="Create" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaDonHang" />
        <input type="hidden" asp-for="NgayDatHang" />
        <input type="hidden" asp-for="TrangThaiDonHang" />
        <input type="hidden" asp-for="PhuongThucThanhToan" />
        <input type="hidden" asp-for="PhuongThucVanChuyen" />
        <input type="hidden" asp-for="MaVoucher" />
        <input type="hidden" asp-for="PhiVanChuyen" />
        <input type="hidden" asp-for="GiamGiaVoucher" />
        <input type="hidden" asp-for="TongThanhToan" />

        <div class="row g-3">
            <!-- CỘT TRÁI: THÔNG TIN CHỨNG TỪ & KHÁCH HÀNG -->
            <div class="col-lg-4">
                <div class="card border mb-3 shadow-sm">
                    <div class="card-header bg-light py-2">
                        <strong class="text-dark"><i class="bi bi-info-circle me-1"></i> Thông tin chứng từ</strong>
                    </div>
                    <div class="card-body py-2">
                        <div class="mb-2">
                            <span class="text-muted small d-block">Đơn hàng tham chiếu:</span>
                            <span class="fw-bold text-primary">#DH-@Model.MaDonHang.ToString("D5")</span>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted small d-block">Ngày đặt hàng:</span>
                            <span>@Model.NgayDatHang.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted small d-block">Trạng thái đơn:</span>
                            <span class="badge bg-info text-dark">@Model.TrangThaiDonHang</span>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted small d-block">Nhân viên lập hóa đơn:</span>
                            <span class="fw-semibold text-dark"><i class="bi bi-person-badge me-1"></i>@(Model.TenNguoiLap ?? "Chưa có thông tin người lập")</span>
                        </div>
                        <div class="mb-2">
                            <span class="text-muted small d-block">Phương thức thanh toán:</span>
                            <span class="badge bg-light text-dark border">@Model.PhuongThucThanhToan</span>
                        </div>
                        <div>
                            <span class="text-muted small d-block">Phương thức vận chuyển:</span>
                            <span class="badge bg-light text-dark border">@Model.PhuongThucVanChuyen</span>
                        </div>
                    </div>
                </div>

                <div class="card border mb-3 shadow-sm">
                    <div class="card-header bg-light py-2">
                        <strong class="text-dark"><i class="bi bi-person me-1"></i> Thông tin khách hàng &amp; Giao nhận</strong>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label asp-for="HoTenKhachHang" class="form-label small fw-semibold">Họ tên người nhận <span class="text-danger">*</span></label>
                            <input asp-for="HoTenKhachHang" class="form-control form-control-sm" required />
                            <span asp-validation-for="HoTenKhachHang" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="SoDienThoai" class="form-label small fw-semibold">Số điện thoại <span class="text-danger">*</span></label>
                            <input asp-for="SoDienThoai" class="form-control form-control-sm" required />
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>
                        <div class="mb-3">
                            <label asp-for="DiaChiGiaoHang" class="form-label small fw-semibold">Địa chỉ giao hàng <span class="text-danger">*</span></label>
                            <textarea asp-for="DiaChiGiaoHang" rows="2" class="form-control form-control-sm" required></textarea>
                            <span asp-validation-for="DiaChiGiaoHang" class="text-danger small"></span>
                        </div>
                        <div>
                            <label asp-for="GhiChu" class="form-label small fw-semibold">Ghi chú xuất hóa đơn</label>
                            <textarea asp-for="GhiChu" rows="2" class="form-control form-control-sm" placeholder="Ghi chú nội bộ hoặc yêu cầu xuất hóa đơn..."></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI: BẢNG SẢN PHẨM & TÍNH TOÁN THANH TOÁN -->
            <div class="col-lg-8">
                <div class="card border mb-3 shadow-sm">
                    <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
                        <strong class="text-dark"><i class="bi bi-cart-check me-1"></i> Danh sách mặt hàng xuất bán</strong>
                        <span class="badge bg-secondary">@(Model.Items?.Count ?? 0) mặt hàng</span>
                    </div>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th class="text-center" style="width: 70px;">SL</th>
                                    <th class="text-end" style="width: 130px;">Đơn giá</th>
                                    <th class="text-center" style="width: 120px;">Thuế VAT</th>
                                    <th class="text-end" style="width: 140px;">Thành tiền</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < Model.Items.Count; i++)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-semibold text-dark">@Model.Items[i].TenSanPham</div>
                                            @if (!string.IsNullOrEmpty(Model.Items[i].BienThe))
                                            {
                                                <small class="text-muted d-block">@Model.Items[i].BienThe</small>
                                            }
                                        </td>
                                        <td class="text-center fw-bold">
                                            @Model.Items[i].SoLuong
                                        </td>
                                        <td class="text-end">
                                            <span>@Model.Items[i].DonGiaGoc.ToString("N0")</span> đ
                                        </td>
                                        <td class="text-center">
                                            <span class="badge bg-light text-muted border">Chưa xác định</span>
                                        </td>
                                        <td class="text-end fw-bold text-dark">
                                            <span>@Model.Items[i].ThanhTien.ToString("N0")</span> đ
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- TỔNG KẾT TÀI CHÍNH -->
                <div class="card border shadow-sm">
                    <div class="card-body p-3">
                        <div class="row">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <div class="p-3 bg-light border rounded">
                                    <h6 class="fw-bold mb-2 text-dark"><i class="bi bi-shield-check text-success me-1"></i> Quy định tính hóa đơn nội bộ</h6>
                                    <ul class="text-muted small ps-3 mb-0">
                                        <li>Đơn giá và thành tiền mặt hàng được tính chuẩn xác từ đơn hàng gốc.</li>
                                        <li>Giá bán niêm yết trên đơn là giá đã bao gồm các loại thuế phí theo quy chế thương mại điện tử.</li>
                                        <li>Thuế VAT: hiển thị "Chưa xác định" do hệ thống chưa có cấu hình thuế suất riêng cho từng danh mục/sản phẩm.</li>
                                        <li>Tổng thanh toán đối soát khớp tuyệt đối với số tiền thanh toán của đơn hàng.</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Tổng tiền hàng:</span>
                                    <strong class="text-dark">@Model.TongTienHang.ToString("N0") đ</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Thuế VAT:</span>
                                    <span class="text-muted fst-italic">Chưa xác định</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Phí vận chuyển:</span>
                                    <strong class="text-dark">
                                        @if (Model.PhiVanChuyen > 0)
                                        {
                                            <span>@Model.PhiVanChuyen.ToString("N0") đ</span>
                                        }
                                        else
                                        {
                                            <span class="text-success">0 đ (Miễn phí)</span>
                                        }
                                    </strong>
                                </div>
                                @if (Model.GiamGiaVoucher > 0)
                                {
                                    <div class="d-flex justify-content-between mb-2 text-success">
                                        <span>Giảm giá Voucher (@(Model.MaVoucher ?? "Áp dụng")):</span>
                                        <strong>-@Model.GiamGiaVoucher.ToString("N0") đ</strong>
                                    </div>
                                }
                                <hr class="my-2" />
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <span class="fw-bold fs-6">Tổng thanh toán:</span>
                                    <h4 class="text-primary fw-bold mb-0">@Model.TongThanhToan.ToString("N0") đ</h4>
                                </div>

                                <div class="d-grid gap-2">
                                    <button type="button" class="btn btn-primary btn-lg" onclick="confirmSubmitInvoice()">
                                        <i class="bi bi-check-circle-fill me-1"></i> Xác nhận lập hóa đơn
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function confirmSubmitInvoice() {
            if (window.StaffDialog && window.StaffDialog.confirm) {
                window.StaffDialog.confirm({
                    title: 'Xác nhận lập hóa đơn',
                    message: 'Bạn có chắc chắn muốn phát hành hóa đơn nội bộ cho đơn hàng này? Số tiền thanh toán là @Model.TongThanhToan.ToString("N0") đ.',
                    confirmText: 'Xác nhận lập',
                    cancelText: 'Xem lại',
                    type: 'primary'
                }).then(result => {
                    if (result) {
                        document.getElementById('invoiceCreateForm').submit();
                    }
                });
            } else {
                if (confirm('Bạn có chắc chắn muốn lập hóa đơn nội bộ cho đơn hàng này?')) {
                    document.getElementById('invoiceCreateForm').submit();
                }
            }
        }
    </script>
}
