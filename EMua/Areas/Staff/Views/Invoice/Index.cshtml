@model IEnumerable<EMua.Models.Database.HoaDon>
@{
    ViewData["Title"] = "Quản lý hóa đơn";
    var currentPage = ViewBag.CurrentPage ?? 1;
    var totalPages = ViewBag.TotalPages ?? 1;
    var search = ViewBag.Search as string;
    var selectedStatus = ViewBag.SelectedStatus as string;
    var statusList = ViewBag.StatusList as List<string> ?? new List<string>();
}
<style>
    .invoice-row {
        cursor: pointer;
    }

    .invoice-row:hover {
        background-color: rgba(13, 110, 253, .06);
    }

    .invoice-row:focus-visible {
        outline: 2px solid #0d6efd;
        outline-offset: -2px;
    }
</style>
<!-- Form tìm kiếm và lọc trạng thái -->
<form method="get" class="staff-filter mb-4">
    <div class="row g-2">
        <div class="col-md-5">
            <input type="text" name="q" value="@search" class="form-control" placeholder="Tìm mã hóa đơn hoặc mã đơn hàng..." />
        </div>
        <div class="col-md-4">
            <select name="status" class="form-select">
                <option value="">-- Tất cả trạng thái --</option>
                @foreach (var st in statusList)
                {
                    <option value="@st" selected="@(selectedStatus == st ? "selected" : null)">@st</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Tìm kiếm</button>
        </div>
    </div>
</form>

<section class="staff-card">
    <div class="staff-card-title d-flex justify-content-between align-items-center">
        <div>
            <h2>Danh sách hóa đơn</h2>
            <span>Hóa đơn mới nhất và đơn hàng mới mua luôn được hiển thị lên đầu</span>
        </div>
    </div>

    <div class="table-responsive mt-3">
        <table class="staff-table table table-hover align-middle">
            <thead>
                <tr>
                    <th>Mã hóa đơn</th>
                    <th>Mã đơn hàng</th>
                    <th>Ngày lập</th>
                    <th>Tổng tiền</th>
                    <th>Trạng thái</th>
                    <th class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var invoice in Model)
                {
                    <tr class="invoice-row" tabindex="0" title="Xem chi tiết hóa đơn"
                        data-href="@Url.Action("Details", new { id = invoice.MaHoaDon })"
                        onclick="window.location.href = this.dataset.href"
                        onkeydown="if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); window.location.href = this.dataset.href; }">
                        <td>
                            <strong>#HD-@invoice.MaHoaDon.ToString("D5")</strong>
                        </td>
                        <td>#DH-@invoice.MaDonHang.ToString("D5")</td>
                        <td>
                            @(invoice.NgayLapHoaDon?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                        </td>
                        <td>
                            <span class="text-success fw-bold">@((invoice.TongTien ?? 0).ToString("N0")) đ</span>
                        </td>
                        <td>
                            @if (invoice.TrangThaiHoaDon == "Đã thanh toán")
                            {
                                <span class="staff-badge badge bg-success">@invoice.TrangThaiHoaDon</span>
                            }
                            else
                            {
                                <span class="staff-badge badge bg-warning text-dark">@(invoice.TrangThaiHoaDon ?? "Đã lập")</span>
                            }
                        </td>
                        <td class="text-end">
                            <!-- QUAN TRỌNG: Thêm asp-area="Staff" để nhận đúng đường dẫn vào Staff Area -->
                            <a asp-area="Staff" asp-controller="Invoice" asp-action="Details" asp-route-id="@invoice.MaHoaDon" class="btn btn-sm btn-outline-info" title="Xem chi tiết">
                                <i class="bi bi-eye"></i> Chi tiết
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">Không tìm thấy hóa đơn nào phù hợp.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- Phân trang -->
    @if (totalPages > 1)
    {
        <nav class="d-flex justify-content-center mt-4">
            <ul class="pagination">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-q="@search" asp-route-status="@selectedStatus">Trước</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(currentPage == i ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-q="@search" asp-route-status="@selectedStatus">@i</a>
                    </li>
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-q="@search" asp-route-status="@selectedStatus">Sau</a>
                </li>
            </ul>
        </nav>
    }
</section>