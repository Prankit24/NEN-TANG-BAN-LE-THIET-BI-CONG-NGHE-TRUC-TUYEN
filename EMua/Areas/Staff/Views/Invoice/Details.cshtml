@model EMua.Models.Database.HoaDon
@{
    ViewData["Title"] = $"Chi tiết hóa đơn #HD-{Model.MaHoaDon:D5}";
    var order = Model.MaDonHangNavigation;
}

<div class="container-fluid px-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Chi tiết hóa đơn #HD-@Model.MaHoaDon.ToString("D5")</h2>
            <span class="text-muted">Thuộc đơn hàng: <strong>#DH-@Model.MaDonHang.ToString("D5")</strong></span>
        </div>
        <a asp-area="Staff" asp-controller="Invoice" asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Quay lại danh sách
        </a>
    </div>

    <div class="row">
        <!-- Thông tin hóa đơn & thanh toán -->
        <div class="col-md-4">
            <div class="staff-card mb-4 p-4 shadow-sm bg-white rounded">
                <h4 class="mb-3">Thông tin hóa đơn</h4>
                <p><strong>Ngày lập:</strong> @(Model.NgayLapHoaDon?.ToString("dd/MM/yyyy HH:mm") ?? "—")</p>
                <p><strong>Trạng thái hóa đơn:</strong> <span class="badge bg-success">@(Model.TrangThaiHoaDon ?? "Đã lập")</span></p>
                <p><strong>Trạng thái đơn hàng:</strong> <span class="badge bg-info">@(order?.TrangThaiDonHang ?? "Chờ xử lý")</span></p>
                <hr />
                <h5 class="text-danger fw-bold">Tổng tiền: @((Model.TongTien ?? 0).ToString("N0")) đ</h5>
            </div>

            <div class="staff-card p-4 shadow-sm bg-white rounded">
                <h4 class="mb-3">Thông tin nhận hàng</h4>
                <p><strong>Họ tên:</strong> @order?.HoTenNhanHang</p>
                <p><strong>Điện thoại:</strong> @order?.SoDienThoaiNhanHang</p>
                <p><strong>Địa chỉ:</strong> @order?.DiaChiNhanHang</p>
                <p><strong>Ghi chú:</strong> @(string.IsNullOrEmpty(order?.GhiChu) ? "Không có" : order.GhiChu)</p>
            </div>
        </div>

        <!-- Danh sách sản phẩm trong hóa đơn -->
        <div class="col-md-8">
            <div class="staff-card p-4 shadow-sm bg-white rounded">
                <h4 class="mb-3">Sản phẩm mua</h4>
                <div class="table-responsive">
                    <table class="table align-middle">
                        <thead>
                            <tr>
                                <th>Sản phẩm</th>
                                <th>Đơn giá</th>
                                <th>Số lượng</th>
                                <th class="text-end">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (order?.ChiTietDonHangs != null)
                            {
                                @foreach (var item in order.ChiTietDonHangs)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center">
                                                @if (!string.IsNullOrEmpty(item.MaBienTheNavigation?.HinhAnh))
                                                {
                                                    <img src="@item.MaBienTheNavigation.HinhAnh" alt="img" style="width: 50px; height: 50px; object-fit: cover;" class="rounded me-2" />
                                                }
                                                <div>
                                                    <h6 class="mb-0">@(item.MaBienTheNavigation?.MaSanPhamNavigation?.TenSanPham ?? "Sản phẩm")</h6>
                                                    <small class="text-muted">@item.MaBienTheNavigation?.MauSac - @item.MaBienTheNavigation?.PhienBan</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td>@(item.DonGia.ToString("N0")) đ</td>
                                        <td>@item.SoLuong</td>
                                        <td class="text-end fw-bold">@((item.ThanhTien).ToString("N0")) đ</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>