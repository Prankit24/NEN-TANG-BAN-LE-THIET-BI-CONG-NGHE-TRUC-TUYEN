@model EMua.Models.Database.HoaDon
@using EMua.Services
@{
    ViewData["Title"] = $"Chi tiết hóa đơn #HD-{Model.MaHoaDon:D5}";
    var order = Model.MaDonHangNavigation;
    var hasSnapshot = Model.ChiTietHoaDons != null && Model.ChiTietHoaDons.Any();
    var legacyDetails = ViewBag.LegacyDetails as List<EMua.Models.Database.ChiTietDonHang>;
    var digitalSig = ViewBag.DigitalSignature as DigitalSignatureVerificationResult;

    var nguoiLap = !string.IsNullOrWhiteSpace(Model.TenNguoiLap)
        ? Model.TenNguoiLap
        : (Model.MaNguoiLapNavigation != null
            ? (!string.IsNullOrWhiteSpace(Model.MaNguoiLapNavigation.TenNguoiDung) ? Model.MaNguoiLapNavigation.TenNguoiDung : Model.MaNguoiLapNavigation.TenDangNhap)
            : "Chưa xác định");

    decimal finalTotal = Model.TongTien ?? (order?.TongTien ?? 0m);

    decimal itemsTotal = hasSnapshot
        ? (Model.ChiTietHoaDons?.Sum(x => x.ThanhTien) ?? 0m)
        : (legacyDetails?.Sum(x => x.ThanhTien) ?? 0m);

    decimal shippingFee = Model.PhiVanChuyen ?? Math.Max(0m, finalTotal - itemsTotal);
    decimal vatTotal = Model.TienThueVat ?? (hasSnapshot ? (Model.ChiTietHoaDons?.Sum(x => x.TienThueVat) ?? 0m) : 0m);
    decimal netTotal = Model.TienTruocThue ?? (itemsTotal - vatTotal);
}

<style>
    .emua-invoice-detail .card,
    .emua-invoice-detail .btn,
    .emua-invoice-detail .badge,
    .emua-invoice-detail .alert {
        border-radius: 0 !important;
        box-shadow: none !important;
    }

    .emua-invoice-detail .invoice-page-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        align-items: center;
        padding: 10px 14px;
        margin-bottom: 14px;
        border: 1px solid #dfe5ed;
        background: #fff;
    }

    .emua-invoice-detail .card {
        border: 1px solid #dfe5ed !important;
    }

    .emua-invoice-detail .table th {
        background-color: #f8fafc;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .025em;
        color: #475569;
        white-space: nowrap;
    }

    .emua-invoice-detail .table td {
        font-size: 13px;
        color: #172033;
    }
</style>

<div class="emua-invoice-detail">
    <!-- CẢNH BÁO MÔ PHỎNG -->
    <div class="alert alert-warning d-flex align-items-center gap-2 mb-3">
        <i class="bi bi-shield-exclamation fs-4 text-warning"></i>
        <div>
            <strong>BẢN MÔ PHỎNG – KHÔNG CÓ GIÁ TRỊ PHÁP LÝ.</strong> Mã số thuế của EMUA và chứng từ này chỉ phục vụ mục đích kiểm thử và trình diễn đồ án khóa luận tốt nghiệp, không được sử dụng để kê khai hoặc gửi đến Tổng cục Thuế.
        </div>
    </div>

    <!-- ACTION TOOLBAR -->
    <div class="invoice-page-actions justify-content-between">
        <div class="d-flex align-items-center gap-2">
            <span class="badge bg-primary px-2 py-1">HÓA ĐƠN #HD-@Model.MaHoaDon.ToString("D5")</span>
            <span class="text-muted small">Ngày lập: <strong>@(Model.NgayLapHoaDon?.ToString("dd/MM/yyyy HH:mm") ?? "—")</strong></span>
            @if (Model.TrangThaiHoaDon == "Đã thanh toán")
            {
                <span class="badge bg-success"><i class="bi bi-check2-circle me-1"></i>Đã thanh toán</span>
            }
            else
            {
                <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>@(Model.TrangThaiHoaDon ?? "Chờ thanh toán")</span>
            }
        </div>
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i> Quay lại danh sách
            </a>
            <a asp-action="Print" asp-route-id="@Model.MaHoaDon" target="_blank" class="btn btn-sm btn-outline-primary px-3">
                <i class="bi bi-printer me-1"></i> In hóa đơn / Lưu PDF
            </a>
        </div>
    </div>

    <div class="row g-3">
        <!-- CỘT TRÁI: THÔNG TIN BÊN BÁN & BÊN MUA -->
        <div class="col-lg-6">
            <div class="card bg-white p-3 h-100">
                <h6 class="fw-bold border-bottom pb-2 mb-3 text-primary"><i class="bi bi-building me-1"></i> ĐƠN VỊ BÁN HÀNG (EMUA STORE)</h6>
                <table class="table table-borderless table-sm small mb-4">
                    <tr>
                        <td class="text-muted" style="width: 140px;">Tên người bán:</td>
                        <td class="fw-bold">CÔNG TY CỔ PHẦN CÔNG NGHỆ EMUA (DEMO)</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Mã số thuế bán:</td>
                        <td><span class="badge bg-light text-danger border font-monospace">0109999999-DEMO</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Địa chỉ:</td>
                        <td>Số 1 Đại Cồ Việt, P. Bách Khoa, Q. Hai Bà Trưng, Hà Nội</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Nhân viên lập HĐ:</td>
                        <td class="fw-bold"><i class="bi bi-person-badge me-1"></i>@nguoiLap</td>
                    </tr>
                </table>

                <h6 class="fw-bold border-bottom pb-2 mb-3 text-primary"><i class="bi bi-person me-1"></i> KHÁCH HÀNG / NGƯỜI NHẬN HÀNG</h6>
                <table class="table table-borderless table-sm small mb-0">
                    <tr>
                        <td class="text-muted" style="width: 140px;">Họ tên khách:</td>
                        <td class="fw-bold">@(Model.HoTenKhachHang ?? order?.HoTenNhanHang ?? "Khách hàng")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Số điện thoại:</td>
                        <td>@(Model.SoDienThoai ?? order?.SoDienThoaiNhanHang ?? "—")</td>
                    </tr>
                    <tr>
                        <td class="text-muted">Địa chỉ nhận:</td>
                        <td>@(Model.DiaChiGiaoHang ?? order?.DiaChiNhanHang ?? "—")</td>
                    </tr>
                </table>
            </div>
        </div>

        <!-- CỘT PHẢI: CHỨNG TỪ & CHỮ KÝ SỐ KỸ THUẬT -->
        <div class="col-lg-6">
            <div class="card bg-white p-3 h-100">
                <h6 class="fw-bold border-bottom pb-2 mb-3 text-primary"><i class="bi bi-shield-check me-1"></i> CHỨNG TỪ &amp; CHỮ KÝ SỐ KỸ THUẬT</h6>
                <table class="table table-borderless table-sm small mb-3">
                    <tr>
                        <td class="text-muted" style="width: 160px;">Đơn hàng gốc:</td>
                        <td class="fw-bold">
                            <a asp-controller="Order" asp-action="Details" asp-route-id="@Model.MaDonHang" class="text-decoration-none">
                                #DH-@Model.MaDonHang.ToString("D5")
                            </a>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted">Phương thức thanh toán:</td>
                        <td><span class="badge bg-secondary">@(Model.PhuongThucThanhToan ?? "COD")</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted">Trạng thái thanh toán:</td>
                        <td>
                            @if (Model.TrangThaiHoaDon == "Đã thanh toán")
                            {
                                <span class="badge bg-success">Đã thanh toán</span>
                            }
                            else
                            {
                                <span class="badge bg-warning text-dark">Chờ thanh toán</span>
                            }
                        </td>
                    </tr>
                </table>

                <!-- THÔNG TIN CHỮ KÝ SỐ KỸ THUẬT DEMO -->
                <div class="border p-2 bg-light">
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <span class="fw-bold text-success small"><i class="bi bi-patch-check-fill me-1"></i> THÔNG TIN KÝ SỐ KỸ THUẬT</span>
                        <span class="badge bg-secondary font-monospace" style="font-size: 10px;">X.509 TECHNICAL</span>
                    </div>
                    @if (digitalSig != null && digitalSig.IsSigned)
                    {
                        <table class="w-100 small" style="font-size: 11.5px;">
                            <tr>
                                <td class="text-muted" style="width: 110px;">Chủ thể ký:</td>
                                <td class="fw-semibold text-truncate" title="@digitalSig.CertificateSubject">@digitalSig.CertificateSubject</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Tổ chức cấp:</td>
                                <td class="text-truncate" title="@digitalSig.CertificateIssuer">@digitalSig.CertificateIssuer</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Serial / Thuật toán:</td>
                                <td>@digitalSig.SerialNumber (@digitalSig.SignatureAlgorithm)</td>
                            </tr>
                            <tr>
                                <td class="text-muted">Phân loại:</td>
                                <td class="text-primary fw-semibold">@digitalSig.CertificateTypeDescription</td>
                            </tr>
                        </table>
                    }
                    else
                    {
                        <div class="small text-muted fst-italic">Chứng thư số demo đã sẵn sàng cho thao tác ký duyệt kỹ thuật.</div>
                    }
                </div>
            </div>
        </div>

        <!-- BẢNG MẶT HÀNG TÍNH THUẾ -->
        <div class="col-12">
            <div class="card bg-white p-3">
                <h6 class="fw-bold border-bottom pb-2 mb-3"><i class="bi bi-box-seam me-1"></i> CHI TIẾT SẢN PHẨM &amp; THUẾ SUẤT VAT</h6>
                <div class="table-responsive">
                    <table class="table table-bordered align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="text-center" style="width: 40px;">STT</th>
                                <th>Mặt hàng / Quy cách</th>
                                <th class="text-center" style="width: 60px;">SL</th>
                                <th class="text-end" style="width: 140px;">Đơn giá chưa thuế</th>
                                <th class="text-center" style="width: 110px;">Thuế suất</th>
                                <th class="text-end" style="width: 130px;">Tiền thuế VAT</th>
                                <th class="text-end" style="width: 140px;">Đơn giá sau thuế</th>
                                <th class="text-end" style="width: 150px;">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (hasSnapshot)
                            {
                                int idx = 1;
                                @foreach (var item in Model.ChiTietHoaDons)
                                {
                                    <tr>
                                        <td class="text-center text-muted">@(idx++)</td>
                                        <td>
                                            <div class="fw-bold text-dark">@item.TenSanPham</div>
                                            @if (!string.IsNullOrEmpty(item.BienThe))
                                            {
                                                <small class="text-muted">Phân loại: @item.BienThe</small>
                                            }
                                        </td>
                                        <td class="text-center fw-bold">@item.SoLuong</td>
                                        <td class="text-end text-muted">@item.DonGiaChuaThue.ToString("N0") ₫</td>
                                        <td class="text-center">
                                            <span class="badge bg-info text-dark">@item.ThueSuatVat.ToString("G29")%</span>
                                        </td>
                                        <td class="text-end text-success fw-semibold">@item.TienThueVat.ToString("N0") ₫</td>
                                        <td class="text-end">@item.DonGiaSauThue.ToString("N0") ₫</td>
                                        <td class="text-end fw-bold text-dark">@item.ThanhTien.ToString("N0") ₫</td>
                                    </tr>
                                }
                            }
                            else if (legacyDetails != null && legacyDetails.Any())
                            {
                                int idx = 1;
                                @foreach (var item in legacyDetails)
                                {
                                    var sp = item.MaBienTheNavigation?.MaSanPhamNavigation;
                                    var rule = VatConfigService.DetermineVatRate(sp?.MaDanhMucNavigation?.TenDanhMuc, sp?.TenSanPham, Model.NgayLapHoaDon ?? DateTime.Now);
                                    decimal lVat = VatConfigService.CalculateVatAmount(item.ThanhTien, rule.RatePercent);
                                    decimal lNet = item.ThanhTien - lVat;
                                    decimal uNet = Math.Round(lNet / item.SoLuong, 2);

                                    <tr>
                                        <td class="text-center text-muted">@(idx++)</td>
                                        <td>
                                            <div class="fw-bold text-dark">@(sp?.TenSanPham ?? "Sản phẩm")</div>
                                            <small class="text-muted">@item.MaBienTheNavigation?.MauSac @item.MaBienTheNavigation?.PhienBan</small>
                                        </td>
                                        <td class="text-center fw-bold">@item.SoLuong</td>
                                        <td class="text-end text-muted">@uNet.ToString("N0") ₫</td>
                                        <td class="text-center"><span class="badge bg-info text-dark">@rule.RatePercent.ToString("G29")%</span></td>
                                        <td class="text-end text-success fw-semibold">@lVat.ToString("N0") ₫</td>
                                        <td class="text-end">@item.DonGia.ToString("N0") ₫</td>
                                        <td class="text-end fw-bold text-dark">@item.ThanhTien.ToString("N0") ₫</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <!-- TỔNG KẾT TÀI CHÍNH -->
                <div class="d-flex justify-content-end mt-3">
                    <div style="width: 400px;" class="border p-3 bg-light">
                        <table class="w-100 small">
                            <tr>
                                <td class="py-1 text-muted">Tổng tiền hàng:</td>
                                <td class="py-1 text-end fw-semibold">@itemsTotal.ToString("N0") ₫</td>
                            </tr>
                            <tr>
                                <td class="py-1 text-muted">Trong đó: Tiền trước thuế:</td>
                                <td class="py-1 text-end">@netTotal.ToString("N0") ₫</td>
                            </tr>
                            <tr>
                                <td class="py-1 text-muted">Trong đó: Tiền thuế GTGT (VAT):</td>
                                <td class="py-1 text-end text-success fw-bold">@vatTotal.ToString("N0") ₫</td>
                            </tr>
                            <tr>
                                <td class="py-1 text-muted">Phí vận chuyển:</td>
                                <td class="py-1 text-end fw-semibold">@(shippingFee > 0 ? $"{shippingFee:N0} ₫" : "0 ₫ (Miễn phí)")</td>
                            </tr>
                            @if (Model.TienGiamGia.HasValue && Model.TienGiamGia > 0)
                            {
                                <tr>
                                    <td class="py-1 text-danger">Giảm giá Coupon (@(Model.MaKhm ?? "Áp dụng")):</td>
                                    <td class="py-1 text-end text-danger fw-semibold">-@Model.TienGiamGia.GetValueOrDefault().ToString("N0") ₫</td>
                                </tr>
                            }
                            <tr class="border-top">
                                <td class="pt-2 fw-bold fs-6">TỔNG THANH TOÁN:</td>
                                <td class="pt-2 text-end fw-bold text-primary fs-5">@finalTotal.ToString("N0") ₫</td>
                            </tr>
                        </table>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.GhiChu))
                {
                    <div class="mt-3 p-2 border bg-light small">
                        <strong>Ghi chú:</strong> @Model.GhiChu
                    </div>
                }
            </div>
        </div>
    </div>
</div>
