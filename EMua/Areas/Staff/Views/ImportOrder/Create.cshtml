@model EMua.Areas.Staff.Models.ImportOrderCreateViewModel
@{
    ViewData["Title"] = "Lập phiếu đề nghị nhập hàng";
    var suppliers = ViewBag.Suppliers as List<EMua.Models.Database.NhaCungCap> ?? new List<EMua.Models.Database.NhaCungCap>();
}
<style>
    .staff-card, .btn, .form-control, .form-select, .badge, .alert, .table {
        border-radius: 0 !important;
        box-shadow: none !important;
    }

    #createImportOrderForm {
        width: 100% !important;
        max-width: 100% !important;
    }

    .form-control.is-invalid, .form-select.is-invalid, .input-group.is-invalid > .form-control, .input-group.is-invalid > .form-select {
        border-color: #DC2626 !important;
        background-color: #FEF2F2 !important;
    }

    .field-validation-error {
        color: #DC2626 !important;
        font-size: 12px;
        margin-top: 4px;
        display: block;
        font-weight: 500;
    }

    /* ===== Tối ưu cho laptop ===== */
    .io-page {
        font-size: 0.875rem;
    }

        .io-page .form-label {
            margin-bottom: .2rem;
            font-size: .82rem;
        }

        .io-page .io-table-wrap {
            max-height: calc(100vh - 470px);
            min-height: 200px;
            overflow: auto;
        }

            .io-page .io-table-wrap thead th {
                position: sticky;
                top: 0;
                z-index: 2;
                background: #f8f9fa;
                white-space: nowrap;
                font-size: .78rem;
            }

        .io-page #importItemsTable > :not(caption) > * > * {
            padding: .3rem .4rem;
        }

        .io-page #importItemsTable .form-control-sm,
        .io-page #importItemsTable .form-select-sm {
            padding: .2rem .35rem;
            font-size: .8rem;
        }

        .io-page #importItemsTable .variant-select {
            min-width: 190px;
            max-width: 280px;
        }

        .io-page #importItemsTable .badge {
            font-size: .7rem;
        }

        .io-page .io-summary {
            font-size: .85rem;
        }

            .io-page .io-summary > div {
                padding-top: .2rem !important;
                padding-bottom: .2rem !important;
            }

        .io-page .io-actions {
            position: sticky;
            bottom: 0;
            z-index: 5;
            background: #fff;
            border-top: 1px solid #dee2e6;
            margin: 0 -1rem -1rem;
            padding: .6rem 1rem;
        }

    @@media (max-width: 991.98px) {
        .io-page .io-table-wrap {
            max-height: none;
        }
    }
</style>
<div class="io-page">
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div><h5 class="fw-bold mb-1">Lập phiếu đề nghị nhập hàng</h5>
            <small class="text-muted">Một phiếu cho một nhà cung cấp. Duyệt phiếu chưa cộng tồn; kiểm nhận hàng mới cộng kho.</small></div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Quay lại danh sách</a>
    </div>
    <partial name="~/Views/Shared/_ImportOrderMessages.cshtml" />
    <div id="importClientError" class="alert alert-danger d-none" role="alert"></div>
    <form asp-action="Create" method="post" id="createImportOrderForm" class="staff-card p-3 bg-white border"
          data-quotation-url="@Url.Action("CompareQuotations", "ImportOrder", new { area = "Staff" })"
          data-supplier-url="@Url.Action("CreateSupplierAjax", "ImportOrder", new { area = "Staff" })">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="MaYeuCau" />
        <input type="hidden" asp-for="MaNhaCungCap" id="MaNhaCungCapHidden" />
        <div class="row g-3 mb-3">
            <div class="col-lg-4">
                <label class="form-label fw-bold" for="supplierSelect">Nhà cung cấp</label>
                <div class="input-group input-group-sm mb-1">
                    <select id="supplierSelect" class="form-select">
                        <option value="">-- Chọn nhà cung cấp --</option>
                        @foreach (var s in suppliers)
                        {
                            <option value="@s.MaNhaCungCap" data-name="@s.TenNhaCungCap" selected="@(Model.MaNhaCungCap == s.MaNhaCungCap)">@s.TenNhaCungCap</option>
                        }
                    </select>
                    <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#addSupplierModal">Thêm NCC</button>
                </div>
                <input asp-for="NhaCungCap" id="NhaCungCapInput" maxlength="200" required class="form-control form-control-sm" placeholder="Hoặc nhập tên nhà cung cấp mới" />
            </div>
            <div class="col-lg-4">
                <label asp-for="LyDoNhap" class="form-label fw-bold">Lý do nhập hàng</label>
                <input asp-for="LyDoNhap" maxlength="255" required class="form-control form-control-sm" />
            </div>
            <div class="col-lg-4">
                <label asp-for="DienGiai" class="form-label fw-bold">Diễn giải</label>
                <textarea asp-for="DienGiai" maxlength="500" rows="2" class="form-control form-control-sm"></textarea>
            </div>
        </div>
        <div class="d-flex justify-content-between align-items-center mb-2 gap-2 flex-wrap">
            <h6 class="fw-bold mb-0">Sản phẩm / biến thể cần nhập</h6>
            <button type="button" id="addImportLine" class="btn btn-sm btn-outline-primary">+ Thêm dòng</button>
        </div>
        <div class="small text-muted mb-2">Nhập giá trước VAT và thuế suất; giá sau VAT được tính tự động. Chiết khấu dòng tính trên <strong>một sản phẩm sau VAT</strong>. Giá gợi ý 70% giá bán chỉ là ước tính, cần đối chiếu báo giá nhà cung cấp. Tỷ suất lợi nhuận chưa phân bổ phí toàn phiếu.</div>
        <div class="table-responsive border io-table-wrap">
            <table class="table table-sm align-middle mb-0" id="importItemsTable">
                <thead class="table-light"><tr>
                    <th style="min-width:240px">Sản phẩm / biến thể</th><th>Tồn</th><th style="min-width:80px">SL</th>
                    <th style="min-width:120px">Giá trước VAT</th><th style="min-width:80px">VAT</th>
                    <th style="min-width:120px">Giá sau VAT</th><th style="min-width:115px">CK / SP</th>
                    <th style="min-width:110px">Giá bán hiện tại</th><th style="min-width:85px">LN gộp ước tính</th><th style="min-width:130px">Thành tiền</th><th>Thao tác</th>
                </tr></thead>
                <tbody id="importItemsBody"></tbody>
            </table>
        </div>
        <div class="row g-3 mt-1">
            <div class="col-lg-6">
                <label asp-for="GhiChu" class="form-label">Ghi chú phiếu</label>
                <textarea asp-for="GhiChu" rows="3" maxlength="500" class="form-control form-control-sm"></textarea>
                <div class="small text-muted mt-2">Số tiền là dự kiến của đề nghị nhập hàng, chưa phải chứng từ thanh toán hoặc hóa đơn thuế của nhà cung cấp.</div>
            </div>
            <div class="col-lg-6">
                <div class="border bg-light p-3 io-summary">
                    <div class="d-flex justify-content-between"><span>Tiền hàng trước VAT:</span><strong id="totalNetAmount">0 ₫</strong></div>
                    <div class="d-flex justify-content-between"><span>VAT dự kiến:</span><strong id="totalVatAmount">0 ₫</strong></div>
                    <div class="d-flex justify-content-between"><span>Chiết khấu từng dòng:</span><strong id="totalLineDiscount">0 ₫</strong></div>
                    <div class="d-flex align-items-center justify-content-between gap-3 mt-2"><label asp-for="ChiPhiVanChuyen" class="mb-0">Phí vận chuyển:</label><input asp-for="ChiPhiVanChuyen" type="number" min="0" max="1000000000" step="0.01" class="form-control form-control-sm text-end import-cost" style="width:170px" /></div>
                    <div class="d-flex align-items-center justify-content-between gap-3 mt-2"><label asp-for="ChiPhiKhac" class="mb-0">Chi phí khác:</label><input asp-for="ChiPhiKhac" type="number" min="0" max="1000000000" step="0.01" class="form-control form-control-sm text-end import-cost" style="width:170px" /></div>
                    <div class="d-flex align-items-center justify-content-between gap-3 mt-2"><label asp-for="ChietKhauTong" class="mb-0">Chiết khấu toàn phiếu:</label><input asp-for="ChietKhauTong" type="number" min="0" max="1000000000000" step="0.01" class="form-control form-control-sm text-end import-cost" style="width:170px" /></div>
                    <div class="d-flex justify-content-between border-top mt-3 pt-2"><strong>Tổng thanh toán dự kiến:</strong><strong id="totalPaymentAmount" class="text-primary">0 ₫</strong></div>
                </div>
            </div>
        </div>
        <div class="io-actions d-flex justify-content-end gap-2 mt-3">
            <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Hủy bỏ</a>
            <button type="submit" id="submitImportOrder" class="btn btn-sm btn-primary">Gửi đề nghị phê duyệt</button>
        </div>
    </form>
</div>

<div class="modal fade" id="addSupplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content border">
        <form id="quickSupplierForm">
            <div class="modal-header"><h6 class="modal-title">Thêm nhà cung cấp</h6><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
            <div class="modal-body">
                <div id="supplierError" class="text-danger small mb-2" role="alert"></div>
                <label class="form-label" for="modalSupplierName">Tên nhà cung cấp</label><input id="modalSupplierName" maxlength="200" required class="form-control form-control-sm mb-2" />
                <label class="form-label" for="modalSupplierPhone">Số điện thoại</label><input id="modalSupplierPhone" maxlength="20" class="form-control form-control-sm mb-2" />
                <label class="form-label" for="modalSupplierTax">Mã số thuế</label><input id="modalSupplierTax" maxlength="50" class="form-control form-control-sm mb-2" />
                <label class="form-label" for="modalSupplierEmail">Email</label><input id="modalSupplierEmail" type="email" maxlength="100" class="form-control form-control-sm mb-2" />
                <label class="form-label" for="modalSupplierAddress">Địa chỉ</label><input id="modalSupplierAddress" maxlength="255" class="form-control form-control-sm mb-2" />
                <label class="form-label" for="modalSupplierNote">Ghi chú</label><textarea id="modalSupplierNote" maxlength="500" class="form-control form-control-sm"></textarea>
            </div>
            <div class="modal-footer"><button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Đóng</button><button type="submit" class="btn btn-sm btn-primary">Lưu và chọn NCC</button></div>
        </form>
    </div></div>
</div>
<div class="modal fade" id="quotationCompareModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered"><div class="modal-content border">
        <div class="modal-header"><h6 class="modal-title">Báo giá đáp ứng số lượng cần nhập</h6><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <div class="modal-body"><div id="quotationCompareContent"></div><div class="small text-muted mt-2">Chi phí vận chuyển trong báo giá là ước tính trên một sản phẩm. Phí vận chuyển của toàn phiếu cần nhập riêng theo thỏa thuận.</div></div>
    </div></div>
</div>
<div class="modal fade" id="importConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content border">
        <div class="modal-header"><h6 class="modal-title">Gửi đề nghị nhập hàng</h6><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button></div>
        <div class="modal-body">Gửi phiếu này đến Admin phê duyệt? Tồn kho chỉ được cộng sau bước kiểm nhận hàng thực tế.</div>
        <div class="modal-footer"><button type="button" class="btn btn-sm btn-outline-secondary" data-bs-dismiss="modal">Kiểm tra lại</button><button type="button" id="confirmImportSubmit" class="btn btn-sm btn-primary">Gửi đề nghị</button></div>
    </div></div>
</div>
<script type="application/json" id="importVariantsData">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.AllVariants))</script>
<script type="application/json" id="importInitialItems">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Items))</script>
@section Scripts {
    <script src="~/js/staff/import-order.js" asp-append-version="true"></script>
}
