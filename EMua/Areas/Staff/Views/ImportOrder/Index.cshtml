@model IEnumerable<EMua.Models.Database.PhieuNhapHang>
@{
    ViewData["Title"] = "Quản lý đề nghị nhập hàng";
    string status = ViewBag.Status as string ?? "all";
    string search = ViewBag.Search as string ?? "";
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? 0;
}

<!-- Thanh công cụ tìm kiếm, lọc và tạo phiếu đồng bộ -->
<style>
    .import-toolbar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        padding: 12px;
        margin-bottom: 14px;
        border: 1px solid #dfe5ed;
        background: #fff;
    }
    .import-toolbar .form-control,
    .import-toolbar .form-select,
    .import-toolbar .btn {
        height: 40px;
        font-size: 13px;
        border-radius: 0 !important;
    }
    .import-toolbar .btn {
        padding: 0 16px;
        white-space: nowrap;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }
    .staff-card .btn,
    .staff-card .badge,
    .staff-card .page-link {
        border-radius: 0 !important;
    }
    @@media (max-width: 767.98px) {
        .import-toolbar > div {
            width: 100% !important;
            flex: 1 1 100% !important;
        }
    }
</style>

<form method="get" asp-action="Index" class="import-toolbar">
    <div style="flex: 1 1 300px; min-width: 200px;">
        <input type="search" name="search" value="@search" class="form-control" placeholder="Tìm theo mã chứng từ, nhà cung cấp, lý do..." aria-label="Tìm kiếm phiếu nhập" />
    </div>
    <div style="flex: 0 1 200px; min-width: 160px;">
        <select name="status" class="form-select" aria-label="Trạng thái phiếu nhập">
            <option value="all" selected="@(status == "all")">Tất cả trạng thái</option>
            <option value="Chờ duyệt" selected="@(status == "Chờ duyệt")">Chờ duyệt</option>
            <option value="Đã duyệt" selected="@(status == "Đã duyệt")">Đã duyệt (Chờ nhận)</option>
            <option value="Đã nhập kho" selected="@(status == "Đã nhập kho")">Đã nhập kho</option>
            <option value="Từ chối" selected="@(status == "Từ chối")">Từ chối</option>
        </select>
    </div>
    <div class="d-flex align-items-center gap-2 flex-wrap ms-auto">
        <button type="submit" class="btn btn-primary">
            <i class="bi bi-search"></i> Tìm kiếm
        </button>
        @if (!string.IsNullOrWhiteSpace(search) || (status != "all" && !string.IsNullOrWhiteSpace(status)))
        {
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-counterclockwise"></i> Đặt lại
            </a>
        }
        <a asp-action="Create" class="btn btn-outline-primary">
            <i class="bi bi-plus-lg"></i> Lập phiếu mới
        </a>
    </div>
</form>

<!-- Bảng danh sách phiếu -->
<div class="staff-card bg-white border p-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 130px;">Mã chứng từ</th>
                    <th style="min-width: 200px;">Nhà cung cấp</th>
                    <th style="min-width: 200px;">Lý do nhập</th>
                    <th style="width: 120px;" class="text-center">Số mặt hàng</th>
                    <th style="width: 150px;" class="text-end">Tổng tiền dự kiến</th>
                    <th style="width: 130px;" class="text-center">Trạng thái</th>
                    <th style="width: 140px;">Người lập / Ngày</th>
                    <th style="width: 100px;" class="text-end">Chi tiết</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        var itemCount = item.ChiTietPhieuNhapHangs?.Count ?? 0;
                        <tr>
                            <td>
                                <span class="badge bg-light text-primary border font-monospace">@item.MaChungTu</span>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.NhaCungCap</div>
                            </td>
                            <td>
                                <div class="text-dark">@item.LyDoNhap</div>
                                @if (!string.IsNullOrWhiteSpace(item.LyDoTuChoi))
                                {
                                    <div class="small text-danger"><i class="bi bi-info-circle me-1"></i>Lý do từ chối: @item.LyDoTuChoi</div>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">@itemCount dòng</span>
                            </td>
                            <td class="text-end fw-bold text-dark">
                                @item.TongTienDuKien.ToString("N0") ₫
                            </td>
                            <td class="text-center">
                                @if (item.TrangThai == "Chờ duyệt")
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>
                                }
                                else if (item.TrangThai == "Đã duyệt")
                                {
                                    <span class="badge bg-info text-dark"><i class="bi bi-check2-circle me-1"></i>Đã duyệt</span>
                                }
                                else if (item.TrangThai == "Đã nhập kho")
                                {
                                    <span class="badge bg-success"><i class="bi bi-box-seam me-1"></i>Đã nhập kho</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>@item.TrangThai</span>
                                }
                            </td>
                            <td>
                                <div class="fw-semibold small">@(item.MaNguoiTaoNavigation?.TenNguoiDung ?? "Nhân viên")</div>
                                <div class="text-muted small">@item.NgayTao.ToString("dd/MM/yyyy HH:mm")</div>
                            </td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@item.MaPhieuNhap" class="btn btn-sm btn-outline-primary py-1 px-2" title="Xem chi tiết phiếu">
                                    <i class="bi bi-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Chưa có phiếu đề nghị nhập hàng nào.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @if (totalPages > 1)
    {
        <div class="d-flex align-items-center justify-content-between p-3 border-top">
            <span class="small text-muted">Trang @currentPage / @totalPages (Tổng @totalItems phiếu)</span>
            <ul class="pagination pagination-sm mb-0">
                @for (int p = 1; p <= totalPages; p++)
                {
                    <li class="page-item @(p == currentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-status="@status" asp-route-search="@search">@p</a>
                    </li>
                }
            </ul>
        </div>
    }
</div>
