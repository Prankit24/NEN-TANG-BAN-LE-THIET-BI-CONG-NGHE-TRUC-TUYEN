@model EMua.Models.Database.PhieuNhapHang
@{
    ViewData["Title"] = $"Chi tiết phiếu nhập {Model.MaChungTu}";
}

<style>
    /* ===== Tối ưu cho laptop ===== */
    .po-page {
        font-size: 0.875rem;
    }

        .po-page .po-side {
            position: sticky;
            top: 8px;
        }

        .po-page .po-table-wrap {
            max-height: calc(100vh - 230px);
            min-height: 200px;
            overflow: auto;
        }

            .po-page .po-table-wrap thead th {
                position: sticky;
                top: 0;
                z-index: 2;
                background: #f8f9fa;
            }

            .po-page .po-table-wrap tfoot td {
                position: sticky;
                bottom: 0;
                z-index: 2;
                background: #f8f9fa;
            }

        .po-page .table > :not(caption) > * > * {
            padding: .4rem .6rem;
        }

        .po-page .po-info-item {
            margin-bottom: .5rem;
        }

            .po-page .po-info-item .badge {
                font-size: .8rem !important;
            }

    @@media (max-width: 991.98px) {
        .po-page .po-side {
            position: static;
        }

        .po-page .po-table-wrap {
            max-height: none;
        }
    }
</style>

<div class="po-page">
    <div class="d-flex align-items-center justify-content-between mb-2 flex-wrap gap-2">
        <div class="text-muted small">
            Mã chứng từ: <strong class="text-primary">@Model.MaChungTu</strong> | Ngày lập: <strong>@Model.NgayTao.ToString("dd/MM/yyyy HH:mm")</strong> | Người lập: <strong>@(Model.MaNguoiTaoNavigation?.TenNguoiDung ?? "Nhân viên")</strong>
        </div>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>

    <div class="row g-2">
        <div class="col-lg-4 col-xl-3">
            <div class="po-side">
                <div class="staff-card bg-white border p-2">
                    <h6 class="fw-bold border-bottom pb-2 mb-2 small text-uppercase">Thông tin chứng từ</h6>
                    <div class="po-info-item">
                        <span class="text-muted small d-block">Trạng thái phiếu:</span>
                        @if (Model.TrangThai == "Chờ duyệt")
                        {
                            <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>
                        }
                        else if (Model.TrangThai == "Đã duyệt")
                        {
                            <span class="badge bg-info text-dark"><i class="bi bi-check2-circle me-1"></i>Đã duyệt (Chờ nhận hàng)</span>
                        }
                        else if (Model.TrangThai == "Đã nhập kho")
                        {
                            <span class="badge bg-success"><i class="bi bi-box-seam me-1"></i>Đã nhập kho thành công</span>
                        }
                        else
                        {
                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>@Model.TrangThai</span>
                        }
                    </div>

                    <div class="po-info-item">
                        <span class="text-muted small d-block">Nhà cung cấp:</span>
                        <span class="fw-bold text-dark">@Model.NhaCungCap</span>
                    </div>

                    <div class="po-info-item">
                        <span class="text-muted small d-block">Lý do nhập hàng:</span>
                        <span class="text-dark">@Model.LyDoNhap</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.DienGiai))
                    {
                        <div class="po-info-item">
                            <span class="text-muted small d-block">Diễn giải:</span>
                            <span class="text-muted">@Model.DienGiai</span>
                        </div>
                    }

                    <div class="po-info-item border-top pt-2">
                        <span class="text-muted small d-block">Tổng giá trị dự kiến:</span>
                        <span class="fw-bold text-primary fs-5">@Model.TongTienDuKien.ToString("N0") ₫</span>
                    </div>

                    @if (Model.MaNguoiDuyetNavigation != null)
                    {
                        <div class="po-info-item border-top pt-2">
                            <span class="text-muted small d-block">Người phê duyệt:</span>
                            <span class="fw-semibold">@Model.MaNguoiDuyetNavigation.TenNguoiDung</span>
                            <span class="small text-muted ms-1">@Model.NgayDuyet?.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.LyDoTuChoi))
                    {
                        <div class="alert alert-danger mt-2 mb-2 p-2 small">
                            <strong>Lý do từ chối:</strong> @Model.LyDoTuChoi
                        </div>
                    }

                    @if (Model.NgayNhapKho.HasValue)
                    {
                        <div class="po-info-item border-top pt-2">
                            <span class="text-muted small d-block">Xác nhận nhập kho lúc:</span>
                            <span class="text-success fw-bold">@Model.NgayNhapKho.Value.ToString("dd/MM/yyyy HH:mm")</span>
                            @if (Model.MaNguoiNhapKhoNavigation != null)
                            {
                                <div class="small text-muted">Bởi: @Model.MaNguoiNhapKhoNavigation.TenNguoiDung</div>
                            }
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
                    {
                        <div class="small border-top pt-2 mb-2"><strong>Ghi chú / kiểm nhận:</strong> @Model.GhiChu</div>
                    }
                    @if (Model.TrangThai == "Đã duyệt")
                    {
                        <p class="small text-muted border-top pt-2 mb-2">Phiếu đã duyệt chưa làm tăng tồn kho. Kiểm đếm hàng rồi xác nhận bên dưới.</p>
                        <a asp-area="Staff" asp-controller="ImportOrder" asp-action="Receive" asp-route-id="@Model.MaPhieuNhap" class="btn btn-primary btn-sm w-100">
                            <i class="bi bi-box-seam me-1"></i> Kiểm nhận nhập kho
                        </a>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-8 col-xl-9">
            <div class="staff-card bg-white border p-0">
                <div class="px-3 py-2 border-bottom">
                    <h6 class="fw-bold mb-0 small text-uppercase">Danh sách sản phẩm &amp; biến thể yêu cầu nhập</h6>
                </div>
                <div class="table-responsive po-table-wrap">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Sản phẩm / Biến thể</th>
                                <th class="text-center" style="width: 90px;">Tồn hiện tại</th>
                                <th class="text-center" style="width: 90px;">SL Đề nghị</th>
                                <th class="text-end" style="width: 120px;">Đơn giá dự kiến</th>
                                <th class="text-end" style="width: 130px;">Thành tiền</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.ChiTietPhieuNhapHangs)
                            {
                                var variant = item.MaBienTheNavigation;
                                var prod = variant?.MaSanPhamNavigation;
                                <tr>
                                    <td>
                                        <div class="fw-bold text-dark">@(prod?.TenSanPham ?? "Sản phẩm")</div>
                                        <small class="text-muted">Phân loại: @(variant?.MauSac ?? "—") - @(variant?.PhienBan ?? "—")</small>
                                        @if (!string.IsNullOrWhiteSpace(item.GhiChu))
                                        {
                                            <div class="small text-muted">@item.GhiChu</div>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(variant?.SoLuong == 0 ? "bg-danger" : (variant?.SoLuong <= 10 ? "bg-warning text-dark" : "bg-secondary"))">
                                            @(variant?.SoLuong ?? 0)
                                        </span>
                                    </td>
                                    <td class="text-center fw-bold text-primary">@item.SoLuongNhap</td>
                                    <td class="text-end">@item.DonGiaNhapDuKien.ToString("N0") ₫</td>
                                    <td class="text-end fw-bold text-dark">@((item.SoLuongNhap * item.DonGiaNhapDuKien).ToString("N0")) ₫</td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Tổng cộng:</td>
                                <td class="text-end fw-bold text-primary">@Model.TongTienDuKien.ToString("N0") ₫</td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
