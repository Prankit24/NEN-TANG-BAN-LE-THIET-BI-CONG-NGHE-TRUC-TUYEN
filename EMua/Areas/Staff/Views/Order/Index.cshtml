@model IEnumerable<DonHang>
@{
    ViewData["Title"] = "Quản lý đơn hàng";
    var statuses = (string[])ViewBag.Statuses;
    var selected = (string)(ViewBag.Status ?? "all");
    var search = ViewBag.Search as string ?? "";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    int totalItems = ViewBag.TotalItems ?? Model.Count();

    int totalOrders = ViewBag.TotalOrders ?? totalItems;
    int pendingCount = ViewBag.PendingCount ?? 0;
    int returnCount = ViewBag.ReturnCount ?? 0;
    int shippingCount = ViewBag.ShippingCount ?? 0;

    bool hasFilter = !string.IsNullOrWhiteSpace(search) || (selected != "all" && !string.IsNullOrWhiteSpace(selected));
}

<style>
    /* Reset & layout scoped to Staff Order Index */
    .staff-order-page,
    .staff-order-page * {
        box-sizing: border-box;
    }

    .staff-order-page {
        width: 100%;
    }

    /* 1. Thanh tabs trạng thái */
    .order-status-tabs {
        display: flex;
        gap: 6px;
        overflow-x: auto;
        padding-bottom: 2px;
        margin-bottom: 12px;
    }

    .order-tab-btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        color: #4b5563;
        background: transparent;
        border: 1px solid #e5e7eb;
        border-radius: 0 !important;
        white-space: nowrap;
        transition: all .15s ease;
    }

    .order-tab-btn:hover {
        background: #f9fafb;
        color: #111827;
        border-color: #d1d5db;
    }

    .order-tab-btn.active {
        background: #315efb;
        color: #ffffff;
        border-color: #315efb;
    }

    .order-tab-badge {
        display: inline-block;
        padding: 1px 6px;
        font-size: 11px;
        font-weight: 600;
        background: #f3f4f6;
        color: #4b5563;
    }

    .order-tab-btn.active .order-tab-badge {
        background: rgba(255, 255, 255, 0.22);
        color: #ffffff;
    }

    /* 2. Thanh tìm kiếm & lọc: Nằm trực tiếp trên nền trang, không khung viền ngoài */
    .order-filter-bar {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        padding: 0;
        margin-bottom: 14px;
        background: transparent;
        border: none;
    }

    .order-filter-search {
        flex: 1 1 320px;
        min-width: 200px;
    }

    .order-filter-status {
        flex: 0 1 210px;
        min-width: 170px;
    }

    .order-filter-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .order-filter-bar .form-control,
    .order-filter-bar .form-select,
    .order-filter-bar .btn {
        height: 38px;
        font-size: 13px;
        border-radius: 0 !important;
    }

    .order-filter-bar .form-control,
    .order-filter-bar .form-select {
        background-color: #ffffff;
        border: 1px solid #d1d5db;
    }

    .order-filter-bar .form-control:focus,
    .order-filter-bar .form-select:focus {
        border-color: #315efb;
        box-shadow: none;
    }

    .order-filter-bar .btn {
        padding: 0 14px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        font-weight: 500;
        white-space: nowrap;
    }

    .order-filter-bar .btn-primary {
        background-color: #315efb;
        border-color: #315efb;
        color: #ffffff;
    }

    .order-filter-bar .btn-primary:hover {
        background-color: #254bce;
        border-color: #254bce;
    }

    .order-filter-bar .btn-outline-secondary {
        border-color: #d1d5db;
        color: #4b5563;
        background: #ffffff;
    }

    .order-filter-bar .btn-outline-secondary:hover {
        background: #f3f4f6;
        color: #111827;
    }

    /* 3. Bảng đơn hàng: Nền trắng sạch, không khung viền bao quanh toàn bộ, đường phân cách nhẹ */
    .order-table-container {
        width: 100%;
        background: #ffffff;
        overflow-x: auto;
        border: none;
    }

    .staff-order-tbl {
        width: 100%;
        margin-bottom: 0;
        border-collapse: collapse;
        background: #ffffff;
    }

    .staff-order-tbl thead th {
        background: #f9fafb;
        color: #4b5563;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .03em;
        padding: 10px 14px;
        border-top: 1px solid #e5e7eb;
        border-bottom: 1px solid #e5e7eb;
        white-space: nowrap;
    }

    .staff-order-tbl tbody td {
        padding: 11px 14px;
        font-size: 13px;
        vertical-align: middle;
        border-bottom: 1px solid #f3f4f6;
        background: #ffffff !important; /* Tuyệt đối không tô màu nền cho dòng */
    }

    .staff-order-tbl tbody tr:hover td {
        background: #fafafa !important;
    }

    /* Mã đơn hiển thị 1 dòng duy nhất */
    .order-code {
        font-weight: 600;
        color: #315efb;
        white-space: nowrap;
        letter-spacing: .01em;
        text-decoration: none;
    }

    /* Khách hàng */
    .customer-name {
        font-weight: 500;
        color: #111827;
        line-height: 1.35;
    }

    .customer-contact {
        font-size: 12px;
        color: #6b7280;
    }

    /* Tổng tiền căn phải, chữ rõ nhưng không quá đậm */
    .order-total {
        font-weight: 600;
        color: #1f2937;
        white-space: nowrap;
    }

    /* 4. Badge trạng thái đơn hàng: Màu nhẹ, tinh tế, không chói */
    .order-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 8px;
        font-size: 12px;
        font-weight: 500;
        white-space: nowrap;
        border: 1px solid transparent;
        border-radius: 0 !important;
    }

    .order-status-badge.status-completed {
        background: #ecfdf5;
        color: #065f46;
        border-color: #a7f3d0;
    }

    .order-status-badge.status-cancelled {
        background: #f3f4f6;
        color: #4b5563;
        border-color: #e5e7eb;
    }

    .order-status-badge.status-pending {
        background: #fffbeb;
        color: #92400e;
        border-color: #fde68a;
    }

    .order-status-badge.status-shipping {
        background: #eff6ff;
        color: #1d4ed8;
        border-color: #bfdbfe;
    }

    .order-status-badge.status-return {
        background: #fef2f2;
        color: #b91c1c;
        border-color: #fecaca;
    }

    /* 5. Cột thao tác: Tách biệt rõ ràng */
    .order-actions-cell {
        white-space: nowrap;
    }

    .order-action-group {
        display: inline-flex;
        align-items: center;
        gap: 8px;
    }

    .btn-detail {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 500;
        color: #315efb;
        background: #ffffff;
        border: 1px solid #315efb;
        border-radius: 0 !important;
        text-decoration: none;
        white-space: nowrap;
    }

    .btn-detail:hover {
        background: #315efb;
        color: #ffffff;
    }

    .status-update-form {
        display: inline-flex;
        align-items: center;
        margin: 0;
    }

    .status-update-select {
        height: 32px;
        font-size: 12.5px;
        padding: 2px 28px 2px 10px;
        width: 175px;
        min-width: 165px;
        background-color: #ffffff;
        border: 1px solid #d1d5db;
        border-radius: 0 !important;
        color: #374151;
        cursor: pointer;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .status-update-select:focus {
        border-color: #315efb;
        box-shadow: none;
    }

    /* 6. Phân trang */
    .order-pagination-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-top: 1px solid #e5e7eb;
        background: transparent;
    }

    .order-pagination-bar .page-link {
        border-radius: 0 !important;
        font-size: 12px;
        color: #4b5563;
        border: 1px solid #e5e7eb;
        padding: 4px 10px;
    }

    .order-pagination-bar .page-item.active .page-link {
        background: #315efb;
        border-color: #315efb;
        color: #ffffff;
    }

    @@media (max-width: 767.98px) {
        .order-filter-search,
        .order-filter-status {
            flex: 1 1 100%;
            min-width: 0;
        }

        .order-filter-actions {
            width: 100%;
            justify-content: flex-start;
        }

        .status-update-select {
            width: 120px;
        }
    }
</style>

<div class="staff-order-page">
    <!-- 1. Tabs lọc theo tình trạng xử lý -->
    <div class="order-status-tabs mt-1">
        <a asp-action="Index" asp-route-status="all" asp-route-q="@search" class="order-tab-btn @(selected == "all" ? "active" : "")">
            Tất cả <span class="order-tab-badge">@totalOrders</span>
        </a>
        <a asp-action="Index" asp-route-status="Chờ xử lý" asp-route-q="@search" class="order-tab-btn @(selected == "Chờ xử lý" ? "active" : "")">
            <i class="bi bi-hourglass-split"></i> Chờ xử lý <span class="order-tab-badge">@pendingCount</span>
        </a>
        <a asp-action="Index" asp-route-status="Yêu cầu đổi trả" asp-route-q="@search" class="order-tab-btn @(selected == "Yêu cầu đổi trả" ? "active" : "")">
            <i class="bi bi-arrow-counterclockwise"></i> Yêu cầu đổi trả <span class="order-tab-badge">@returnCount</span>
        </a>
        <a asp-action="Index" asp-route-status="Đang xử lý" asp-route-q="@search" class="order-tab-btn @(selected == "Đang xử lý" ? "active" : "")">
            <i class="bi bi-box-seam"></i> Đang xử lý <span class="order-tab-badge">@shippingCount</span>
        </a>
        <a asp-action="Index" asp-route-status="Đã hoàn thành" asp-route-q="@search" class="order-tab-btn @(selected == "Đã hoàn thành" ? "active" : "")">
            <i class="bi bi-check2-circle"></i> Đã hoàn thành
        </a>
        <a asp-action="Index" asp-route-status="Đã hủy" asp-route-q="@search" class="order-tab-btn @(selected == "Đã hủy" ? "active" : "")">
            <i class="bi bi-x-circle"></i> Đã hủy
        </a>
    </div>

    <!-- 2. Thanh tìm kiếm nằm trực tiếp trên nền trang, không khung viền bao quanh -->
    <form method="get" asp-action="Index" class="order-filter-bar">
        <div class="order-filter-search">
            <input type="search" name="q" value="@search" class="form-control" placeholder="Tìm theo mã đơn (#DH-00001), khách hàng, SĐT..." aria-label="Tìm kiếm đơn hàng" />
        </div>
        <div class="order-filter-status">
            <select name="status" class="form-select" aria-label="Trạng thái đơn hàng">
                <option value="all" selected="@(selected == "all")">Tất cả trạng thái</option>
                @foreach (var st in statuses)
                {
                    <option value="@st" selected="@(selected == st)">@st</option>
                }
            </select>
        </div>
        <div class="order-filter-actions">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-search"></i> Tìm kiếm
            </button>
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i> Đặt lại
                </a>
            }
        </div>
    </form>

    <!-- 3. Bảng danh sách đơn hàng -->
    <div class="order-table-container">
        <table class="staff-order-tbl">
            <thead>
                <tr>
                    <th style="width: 120px;">Mã đơn</th>
                    <th style="min-width: 200px;">Khách hàng</th>
                    <th style="width: 130px;">Số điện thoại</th>
                    <th style="width: 140px;">Ngày đặt</th>
                    <th style="width: 130px;" class="text-end">Tổng tiền</th>
                    <th style="width: 150px;" class="text-center">Trạng thái</th>
                    <th style="width: 285px;" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    var st = order.TrangThaiDonHang ?? "";
                    var isReturn = st.Contains("đổi trả", StringComparison.OrdinalIgnoreCase);
                    var isFailed = st.Contains("thất bại", StringComparison.OrdinalIgnoreCase);
                    var isCancelled = st.Contains("hủy", StringComparison.OrdinalIgnoreCase) || st.Contains("huỷ", StringComparison.OrdinalIgnoreCase);
                    var isCompleted = st == "Đã hoàn thành" || st == "Đã giao";
                    var isShipping = st == "Đang xử lý" || st == "Đang giao" || st == "Đang giao hàng";

                    string badgeClass = isCompleted ? "status-completed" :
                                        isCancelled ? "status-cancelled" :
                                        (isReturn || isFailed) ? "status-return" :
                                        isShipping ? "status-shipping" : "status-pending";

                    <tr>
                        <td>
                            <!-- Mã đơn 1 dòng duy nhất, không xuống hàng -->
                            <a asp-action="Details" asp-route-id="@order.MaDonHang" class="order-code">#DH-@order.MaDonHang.ToString("D5")</a>
                        </td>
                        <td>
                            <div class="customer-name">@(order.HoTenNhanHang ?? order.MaNguoiDungNavigation?.TenNguoiDung ?? "Khách hàng")</div>
                            <div class="customer-contact">@(order.MaNguoiDungNavigation?.Email ?? "—")</div>
                        </td>
                        <td>
                            <span class="text-muted">@(order.SoDienThoaiNhanHang ?? "—")</span>
                        </td>
                        <td>
                            <span class="text-muted">@(order.NgayDat?.ToString("dd/MM/yyyy HH:mm") ?? "—")</span>
                        </td>
                        <td class="text-end">
                            <span class="order-total">@((order.TongTien ?? 0).ToString("N0")) đ</span>
                        </td>
                        <td class="text-center">
                            <span class="order-status-badge @badgeClass">
                                @if (isCompleted)
                                {
                                    <i class="bi bi-check-circle"></i>
                                }
                                else if (isReturn || isFailed)
                                {
                                    <i class="bi bi-exclamation-circle"></i>
                                }
                                else if (isShipping)
                                {
                                    <i class="bi bi-truck"></i>
                                }
                                else if (isCancelled)
                                {
                                    <i class="bi bi-x-circle"></i>
                                }
                                else
                                {
                                    <i class="bi bi-clock"></i>
                                }
                                @(string.IsNullOrWhiteSpace(order.TrangThaiDonHang) ? "Chờ xử lý" : order.TrangThaiDonHang)
                            </span>
                        </td>
                        <td class="text-end order-actions-cell">
                            <div class="order-action-group">
                                <a asp-action="Details" asp-route-id="@order.MaDonHang" class="btn-detail" title="Xem chi tiết đơn hàng">
                                    <i class="bi bi-eye"></i> Chi tiết
                                </a>

                                <form asp-action="UpdateStatus" method="post" class="status-update-form">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@order.MaDonHang" />
                                    <select name="status" class="form-select form-select-sm status-update-select" onchange="this.form.submit()" title="Thay đổi trạng thái đơn hàng">
                                        @foreach (var s in statuses)
                                        {
                                            <option value="@s" selected="@(order.TrangThaiDonHang == s)">@s</option>
                                        }
                                    </select>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                            Không tìm thấy đơn hàng nào phù hợp với điều kiện tìm kiếm.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <!-- 4. Phân trang -->
    @if (totalPages > 1)
    {
        <div class="order-pagination-bar">
            <span class="text-muted small">Hiển thị @Model.Count() / @totalItems đơn hàng (Trang @currentPage / @totalPages)</span>
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-q="@search" asp-route-status="@selected">Trước</a>
                </li>
                @for (int i = 1; i <= totalPages; i++)
                {
                    if (i == 1 || i == totalPages || (i >= currentPage - 2 && i <= currentPage + 2))
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-q="@search" asp-route-status="@selected">@i</a>
                        </li>
                    }
                    else if (i == currentPage - 3 || i == currentPage + 3)
                    {
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    }
                }
                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-q="@search" asp-route-status="@selected">Sau</a>
                </li>
            </ul>
        </div>
    }
</div>
