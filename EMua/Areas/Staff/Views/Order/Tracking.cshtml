@model EMua.Areas.Staff.Models.OrderTrackingViewModel

@{
    ViewData["Title"] = "Theo dõi đơn hàng #" + Model.OrderId;
    Layout = "_StaffLayout"; // Hoặc Layout chung của Staff

    // Xác định bước hiện tại trên thanh tiến trình
    var steps = new[] { "Chờ xác nhận", "Đã xác nhận", "Đang giao hàng", "Đã giao hàng" };
    var isCancelled = Model.CurrentStatus == "Đã hủy";
    var currentIndex = Array.IndexOf(steps, Model.CurrentStatus);
    if (currentIndex < 0) currentIndex = 0;
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff/staff-order-tracking.css" asp-append-version="true" />
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-left me-1"></i>Quay lại danh sách</a>
    </div>

    <!-- ===== Thanh tiến trình trực quan ===== -->
    <div class="card border-0   mb-4">
        <div class="card-body p-4">
            @if (isCancelled)
            {
                <div class="alert alert-danger mb-0 d-flex align-items-center gap-2">
                    <i class="bi bi-x-octagon-fill fs-4"></i>
                    <div><strong>Đơn hàng đã bị hủy.</strong> @Model.CurrentStatus</div>
                </div>
            }
            else
            {
                <div class="delivery-tracker" id="deliveryTracker" data-current-index="@currentIndex">
                    <div class="tracker-progress" id="trackerProgress"></div>
                    <div class="truck-runner" id="truckRunner"><i class="bi bi-truck"></i></div>

                    <div class="tracker-step @(currentIndex > 0 ? "done" : "active")">
                        <div class="icon-circle"><i class="bi bi-hourglass-split"></i></div>
                        <div class="step-label">Chờ xác nhận</div>
                    </div>
                    <div class="tracker-step @(currentIndex > 1 ? "done" : currentIndex == 1 ? "active" : "")">
                        <div class="icon-circle"><i class="bi bi-box-seam"></i></div>
                        <div class="step-label">Đang đóng gói</div>
                    </div>
                    <div class="tracker-step @(currentIndex > 2 ? "done" : currentIndex == 2 ? "active" : "")">
                        <div class="icon-circle"><i class="bi bi-truck"></i></div>
                        <div class="step-label">Đang giao hàng</div>
                    </div>
                    <div class="tracker-step @(currentIndex >= 3 ? "done" : "")">
                        <div class="icon-circle"><i class="bi bi-house-check-fill"></i></div>
                        <div class="step-label">Đã giao hàng</div>
                    </div>
                </div>

                @if (Model.EstimatedDeliveryDate.HasValue && currentIndex < 3)
                {
                    <div class="eta-banner mt-2">
                        <i class="bi bi-calendar-check fs-5"></i>
                        <span>Dự kiến giao hàng: @Model.EstimatedDeliveryDate.Value.ToString("HH:mm, dd/MM/yyyy")</span>
                    </div>
                }
            }
        </div>
    </div>

    <div class="row g-4">
        <!-- Cột trái: Thông tin & Tiến trình (Tracking) -->
        <div class="col-lg-8">
            <!-- Thẻ Thông tin người nhận -->
            <div class="card border-0   mb-4">
                <div class="card-body p-4">
                    <h5 class="fw-bold border-bottom pb-2 mb-3">Thông tin giao hàng</h5>
                    <div class="row g-2">
                        <div class="col-sm-6"><strong>Người nhận:</strong> @Model.CustomerName</div>
                        <div class="col-sm-6"><strong>Số điện thoại:</strong> @Model.CustomerPhone</div>
                        <div class="col-12"><strong>Địa chỉ:</strong> @Model.ShippingAddress</div>
                        <div class="col-sm-6"><strong>Tổng tiền:</strong> <span class="text-danger fw-bold">@Model.TotalAmount.ToString("N0") đ</span></div>
                        <div class="col-sm-6"><strong>Trạng thái hiện tại:</strong> <span class="badge bg-primary fs-6">@Model.CurrentStatus</span></div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.DeliveryProofImageUrl))
                    {
                        <hr />
                        <div>
                            <strong class="d-block mb-2"><i class="bi bi-camera-fill me-1"></i>Ảnh xác nhận đã giao:</strong>
                            <img src="@Model.DeliveryProofImageUrl" alt="Ảnh xác nhận giao hàng" class="proof-photo-preview" />
                        </div>
                    }
                </div>
            </div>

            <!-- Thẻ Lịch sử vận chuyển (Timeline / Stepper) -->
            <div class="card border-0  ">
                <div class="card-body p-4">
                    <h5 class="fw-bold border-bottom pb-2 mb-3"><i class="bi bi-clock-history me-2"></i>Lịch sử vận chuyển</h5>

                    <ul class="list-group list-group-flush position-relative border-start ms-3 ps-3">
                        @foreach (var log in Model.TrackingLogs)
                        {
                            <li class="list-group-item bg-transparent border-0 ps-0 pb-3 position-relative">
                                <span class="position-absolute top-0 start-0 translate-middle p-1 bg-primary border border-light " style="left: -16px !important;"></span>
                                <div class="fw-bold text-dark">@log.Status</div>
                                <div class="small text-muted">@log.LocationOrNote</div>
                                <div class="extra-small text-secondary">@log.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                                @if (!string.IsNullOrEmpty(log.ImageUrl))
                                {
                                    <img src="@log.ImageUrl" alt="Ảnh cập nhật" class="mt-2 " style="max-width:160px;max-height:120px;object-fit:cover;" />
                                }
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Cột phải: Quản lý giao nhận (Cập nhật trạng thái) -->
        <div class="col-lg-4">
            <div class="card border-0  ">
                <div class="card-body p-4">
                    <h5 class="fw-bold border-bottom pb-2 mb-3"><i class="bi bi-pencil-square me-2"></i>Cập nhật giao nhận</h5>

                    <form asp-action="UpdateDeliveryStatus" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="OrderId" value="@Model.OrderId" />

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Trạng thái mới <span class="text-danger">*</span></label>
                            <select name="NewStatus" id="newStatusSelect" class="form-select" required>
                                <option value="Chờ xác nhận" selected="@(Model.CurrentStatus == "Chờ xác nhận")">Chờ xác nhận</option>
                                <option value="Đã xác nhận" selected="@(Model.CurrentStatus == "Đã xác nhận")">Đã xác nhận (Đang đóng gói)</option>
                                <option value="Đang giao hàng" selected="@(Model.CurrentStatus == "Đang giao hàng")">Đang giao hàng</option>
                                <option value="Đã giao hàng" selected="@(Model.CurrentStatus == "Đã giao hàng")">Đã giao hàng (Hoàn tất)</option>
                                <option value="Đã hủy" selected="@(Model.CurrentStatus == "Đã hủy")">Đã hủy đơn</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Đơn vị vận chuyển</label>
                            <input type="text" name="ShippingProvider" class="form-control" placeholder="VD: GHN, Viettel Post, Shipper Shop..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Mã vận đơn (Tracking Code)</label>
                            <input type="text" name="TrackingNumber" class="form-control" placeholder="Nhập mã vận đơn..." />
                        </div>

                        <!-- Ngày dự kiến giao hàng: hiện khi đang giao / đã xác nhận -->
                        <div class="mb-3" id="etaField">
                            <label class="form-label fw-semibold"><i class="bi bi-calendar-event me-1"></i>Ngày dự kiến giao hàng</label>
                            <input type="datetime-local" name="EstimatedDeliveryDate" class="form-control"
                                   value="@(Model.EstimatedDeliveryDate?.ToString("yyyy-MM-ddTHH:mm"))" />
                        </div>

                        <!-- Ảnh xác nhận: chỉ hiện & bắt buộc khi chọn "Đã giao hàng" -->
                        <div class="mb-3 border  p-3 bg-light-subtle d-none" id="proofPhotoField">
                            <label class="form-label fw-semibold text-success">
                                <i class="bi bi-camera-fill me-1"></i>Ảnh xác nhận đã giao hàng <span class="text-danger">*</span>
                            </label>
                            <input type="file" name="DeliveryProofImage" id="proofPhotoInput" class="form-control" accept="image/*" />
                            <div class="form-text">Chụp ảnh sản phẩm/kiện hàng tại nơi giao để xác nhận hoàn tất đơn.</div>
                            <img id="proofPhotoPreview" class="proof-photo-preview mt-2 d-none" alt="Xem trước ảnh" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Ghi chú vận chuyển</label>
                            <textarea name="Note" class="form-control" rows="3" placeholder="Nhập ghi chú hoặc lý do chuyển trạng thái..."></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 fw-bold">
                            <i class="bi bi-save me-1"></i> Lưu thay đổi
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            // ----- Vẽ thanh tiến trình + vị trí xe giao hàng -----
            var tracker = document.getElementById('deliveryTracker');
            if (tracker) {
                var idx = parseInt(tracker.dataset.currentIndex, 10) || 0;
                var totalSteps = 4;
                var pct = (idx / (totalSteps - 1)) * 100;
                document.getElementById('trackerProgress').style.width = pct + '%';

                var truck = document.getElementById('truckRunner');
                truck.style.left = pct + '%';
                // Chỉ hiện icon xe khi đang trong quá trình giao (chưa hoàn tất)
                if (idx >= totalSteps - 1) {
                    truck.style.display = 'none';
                }
            }

            // ----- Hiện/ẩn ô upload ảnh xác nhận khi chọn "Đã giao hàng" -----
            var statusSelect = document.getElementById('newStatusSelect');
            var proofField = document.getElementById('proofPhotoField');
            var proofInput = document.getElementById('proofPhotoInput');
            var proofPreview = document.getElementById('proofPhotoPreview');

            function toggleProofField() {
                var isDelivered = statusSelect.value === 'Đã giao hàng';
                proofField.classList.toggle('d-none', !isDelivered);
                proofInput.required = isDelivered;
            }

            statusSelect.addEventListener('change', toggleProofField);
            toggleProofField();

            proofInput.addEventListener('change', function () {
                var file = this.files && this.files[0];
                if (!file) {
                    proofPreview.classList.add('d-none');
                    return;
                }
                var reader = new FileReader();
                reader.onload = function (e) {
                    proofPreview.src = e.target.result;
                    proofPreview.classList.remove('d-none');
                };
                reader.readAsDataURL(file);
            });
        })();
    </script>
}
