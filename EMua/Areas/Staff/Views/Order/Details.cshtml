@model DonHang
@{ ViewData["Title"] = $"Chi tiết đơn #DH-{Model.MaDonHang:D5}"; }
<div class="staff-toolbar"><a class="btn btn-light" asp-action="Index"><i class="bi bi-arrow-left"></i> Quay lại</a><form asp-action="CreateInvoice" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.MaDonHang"/><button class="btn btn-primary"><i class="bi bi-printer"></i> Xuất hóa đơn</button></form></div>
<div class="staff-order-detail"><section class="staff-card"><h2>Thông tin đơn hàng</h2><div class="staff-info-grid"><div><span>Khách hàng</span><strong>@(Model.HoTenNhanHang ?? Model.MaNguoiDungNavigation?.TenNguoiDung ?? "Khách hàng")</strong></div><div><span>Số điện thoại</span><strong>@(Model.SoDienThoaiNhanHang ?? "—")</strong></div><div><span>Địa chỉ nhận</span><strong>@(Model.DiaChiNhanHang ?? "—")</strong></div><div><span>Phương thức giao</span><strong>@(Model.PhuongThucVanChuyen ?? "—")</strong></div><div><span>Ghi chú</span><strong>@(Model.GhiChu ?? "Không có")</strong></div><div><span>Trạng thái</span><strong><span class="staff-badge">@(Model.TrangThaiDonHang ?? "Chờ xử lý")</span></strong></div></div></section><section class="staff-card"><h2>Sản phẩm trong đơn</h2><div class="table-responsive"><table class="staff-table"><thead><tr><th>Sản phẩm</th><th>Biến thể</th><th>Đơn giá</th><th>SL</th><th>Thành tiền</th></tr></thead><tbody>@foreach(var detail in Model.ChiTietDonHangs){<tr><td>@detail.MaBienTheNavigation.MaSanPhamNavigation.TenSanPham</td><td>@detail.MaBienTheNavigation.MauSac @detail.MaBienTheNavigation.PhienBan</td><td>@detail.DonGia.ToString("N0") đ</td><td>@detail.SoLuong</td><td>@detail.ThanhTien.ToString("N0") đ</td></tr>}</tbody></table></div><div class="staff-order-total">Tổng thanh toán: <strong>@((Model.TongTien ?? 0).ToString("N0")) đ</strong></div></section></div>
