@model DonHang
@{
    ViewData["Title"] = $"Chi tiết đơn #DH-{Model.MaDonHang:D5}";

    var allStatuses = (ViewBag.Statuses as string[]) ?? Array.Empty<string>();
    var currentStatus = (Model.TrangThaiDonHang ?? "Chờ xử lý").Trim();

    var isCancelled = currentStatus.Equals("Đã hủy", StringComparison.OrdinalIgnoreCase) ||
                      currentStatus.Contains("hủy", StringComparison.OrdinalIgnoreCase) ||
                      currentStatus.Contains("huỷ", StringComparison.OrdinalIgnoreCase);

    var returnStatuses = new[] { "Yêu cầu đổi trả", "Đang đổi trả", "Đã nhận đổi trả", "Đã hoàn tiền" };
    var hasReturnWorkflow = returnStatuses.Contains(currentStatus, StringComparer.OrdinalIgnoreCase);

    string[] progressStatuses;
    if (hasReturnWorkflow)
    {
        progressStatuses = new[] { "Chờ xử lý", "Đang xử lý", "Đã hoàn thành", "Yêu cầu đổi trả", "Đang đổi trả", "Đã nhận đổi trả", "Đã hoàn tiền" };
    }
    else
    {
        progressStatuses = new[] { "Chờ xử lý", "Đang xử lý", "Đã hoàn thành" };
    }

    var currentIndex = Array.FindIndex(progressStatuses, s => string.Equals(s, currentStatus, StringComparison.OrdinalIgnoreCase));
    if (currentIndex < 0)
    {
        if (currentStatus.Equals("Đã hoàn thành", StringComparison.OrdinalIgnoreCase) || currentStatus.Equals("Đã giao", StringComparison.OrdinalIgnoreCase))
        {
            currentIndex = Array.IndexOf(progressStatuses, "Đã hoàn thành");
        }
        else if (currentStatus.Equals("Đang xử lý", StringComparison.OrdinalIgnoreCase) || currentStatus.Equals("Đang giao", StringComparison.OrdinalIgnoreCase))
        {
            currentIndex = Array.IndexOf(progressStatuses, "Đang xử lý");
        }
        else
        {
            currentIndex = 0;
        }
    }

    var isCompleted = currentStatus.Equals("Đã hoàn thành", StringComparison.OrdinalIgnoreCase) || currentStatus.Equals("Đã giao", StringComparison.OrdinalIgnoreCase);
    var isReturnRequested = currentStatus == "Yêu cầu đổi trả" || currentStatus == "Đang đổi trả" || currentStatus == "Đã nhận đổi trả";

    var returnLog = Model.LichSuVanChuyens
        .OrderByDescending(x => x.ThoiGian)
        .FirstOrDefault(x => x.TrangThai == "Yêu cầu đổi trả");
}

@section Styles {
    <link rel="stylesheet" href="~/css/staff/staff-order-details.css" asp-append-version="true" />
}

<!-- 1. Thanh công cụ gọn gàng nằm trên cùng một hàng -->
<div class="staff-toolbar">
    <a class="btn btn-outline-secondary" asp-action="Index">
        <i class="bi bi-arrow-left"></i> Quay lại
    </a>

    @if (Model.HoaDon != null)
    {
        <a asp-area="Staff" asp-controller="Invoice" asp-action="Details" asp-route-id="@Model.HoaDon.MaHoaDon" class="btn btn-outline-primary">
            <i class="bi bi-file-earmark-text me-1"></i> Xem hóa đơn #HD-@Model.HoaDon.MaHoaDon.ToString("D5")
        </a>
        <a asp-area="Staff" asp-controller="Invoice" asp-action="Print" asp-route-id="@Model.HoaDon.MaHoaDon" target="_blank" class="btn btn-outline-secondary">
            <i class="bi bi-printer me-1"></i> In hóa đơn
        </a>
    }
    else if (!isCancelled)
    {
        <a asp-area="Staff" asp-controller="Invoice" asp-action="Create" asp-route-orderId="@Model.MaDonHang" class="btn btn-primary">
            <i class="bi bi-file-earmark-plus me-1"></i> Lập hóa đơn
        </a>
    }
    else
    {
        <span class="badge bg-secondary p-2"><i class="bi bi-slash-circle me-1"></i>Đơn đã hủy - Không lập hóa đơn</span>
    }
</div>

<!-- 2. Khối cảnh báo đổi trả & Chat (nếu có) -->
@if (isReturnRequested)
{
    <div class="return-request-alert">
        <div class="d-flex align-items-center justify-content-between mb-2">
            <h3 class="text-danger fs-6 mb-0 fw-bold">
                <i class="bi bi-exclamation-triangle-fill me-1"></i> ĐƠN HÀNG CÓ YÊU CẦU ĐỔI TRẢ / HOÀN TIỀN
            </h3>
            <span class="badge bg-danger">@currentStatus</span>
        </div>
        <p class="text-muted small mb-2">Khách hàng đã gửi yêu cầu hỗ trợ sự cố cho đơn hàng này:</p>

        @if (returnLog != null)
        {
            <div class="p-2 px-3 bg-white border mb-2">
                <div class="small mb-1 text-muted"><strong>Thời gian gửi:</strong> @returnLog.ThoiGian.ToString("dd/MM/yyyy HH:mm")</div>
                <div class="small text-dark" style="white-space: pre-line;">@returnLog.MoTa</div>
            </div>
        }

        <div class="d-flex gap-2 flex-wrap pt-2 border-top">
            <form id="formAcceptReturn" asp-action="ProcessReturnAction" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MaDonHang" />
                <input type="hidden" name="actionType" value="Accept" />
                <button type="button" class="btn btn-sm btn-success" onclick="confirmAcceptReturn()">
                    <i class="bi bi-check-circle me-1"></i> Chấp nhận Đổi trả
                </button>
            </form>

            <button type="button" class="btn btn-sm btn-outline-danger" data-bs-toggle="collapse" data-bs-target="#rejectReturnBox">
                <i class="bi bi-x-circle me-1"></i> Từ chối Yêu cầu
            </button>

            <a href="tel:@Model.SoDienThoaiNhanHang" class="btn btn-sm btn-outline-primary ms-auto">
                <i class="bi bi-telephone-outbound me-1"></i> Gọi hotline khách
            </a>
        </div>

        <div class="collapse mt-2" id="rejectReturnBox">
            <form asp-action="ProcessReturnAction" method="post" class="p-3 bg-white border border-danger">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.MaDonHang" />
                <input type="hidden" name="actionType" value="Reject" />
                <label class="form-label text-danger fw-bold small">Lý do từ chối yêu cầu đổi trả <span class="text-danger">*</span></label>
                <textarea name="rejectReason" class="form-control form-control-sm mb-2" rows="2" placeholder="Nhập rõ lý do từ chối để thông báo cho khách hàng..." required></textarea>
                <button type="submit" class="btn btn-sm btn-danger">Xác nhận Từ chối</button>
            </form>
        </div>

        <div class="staff-return-chat" id="staffReturnChatCard">
            <div id="staffChatWaiting" class="staff-chat-waiting">
                <i class="bi bi-chat-square-text text-muted fs-5"></i>
                <div class="small text-muted">Khách hàng chưa mở phiên chat trực tiếp.</div>
                <span class="badge bg-secondary ms-auto" id="staffChatStatusBadge">Chờ khách</span>
            </div>

            <div id="staffChatActive" class="d-none">
                <div class="staff-chat-header">
                    <div class="small fw-bold text-dark"><i class="bi bi-chat-dots-fill me-1 text-primary"></i> Trao đổi với khách hàng</div>
                    <button type="button" class="btn btn-sm btn-light text-danger py-0 px-2" id="btnEndStaffChat">Kết thúc phiên</button>
                </div>
                <div class="staff-chat-messages" id="staffChatMessageList">
                    <div class="text-center text-muted py-3 small">Khách chưa gửi tin nhắn.</div>
                </div>
                <form id="staffChatForm" class="staff-chat-composer">
                    <input type="text" id="staffChatInput" class="form-control" placeholder="Phản hồi khách hàng..." autocomplete="off" maxlength="1000" required />
                    <button type="submit" class="btn btn-primary px-3"><i class="bi bi-send"></i></button>
                </form>
            </div>
        </div>
    </div>
}

<!-- 3. Thanh tiến trình đơn hàng (Thấp, phẳng, thanh thoát) -->
<section class="staff-tracker-card">
    <div class="staff-tracker-header">
        <h2>Tiến trình đơn hàng</h2>
        <span class="badge @(isCompleted ? "bg-success" : (isCancelled ? "bg-secondary" : (hasReturnWorkflow ? "bg-danger" : "bg-primary")))">
            @currentStatus
        </span>
    </div>

    @if (isCancelled)
    {
        <div class="alert alert-secondary py-2 px-3 mb-0 d-flex align-items-center gap-2 small">
            <i class="bi bi-x-circle-fill text-danger"></i>
            <div>Đơn hàng đã được ghi nhận <strong>Đã hủy</strong>. Mọi tiến trình xử lý và giao hàng đều đã kết thúc.</div>
        </div>
    }
    else if (progressStatuses.Length > 0)
    {
        var pct = progressStatuses.Length > 1 ? (currentIndex * 100.0 / (progressStatuses.Length - 1)) : 0;
        <div class="staff-tracker">
            <div class="staff-tracker-line"></div>
            <div class="staff-tracker-progress" style="width:@pct.ToString("0.##")%"></div>
            @if (currentIndex < progressStatuses.Length - 1)
            {
                <div class="staff-truck-runner" style="left:@pct.ToString("0.##")%"><i class="bi bi-truck"></i></div>
            }
            @for (int i = 0; i < progressStatuses.Length; i++)
            {
                var stepName = progressStatuses[i];
                var isStepDone = i < currentIndex;
                var isStepActive = i == currentIndex;
                var isFinalCompleted = (stepName == "Đã hoàn thành" && (isStepDone || (isStepActive && isCompleted)));

                var cls = isFinalCompleted ? "completed-success" : (isStepDone ? "done" : (isStepActive ? "active" : ""));

                string iconClass = isFinalCompleted ? "bi-check-lg" : stepName switch
                {
                    "Chờ xử lý" => "bi-hourglass-split",
                    "Đang xử lý" => "bi-box-seam",
                    "Đã hoàn thành" => "bi-check-circle-fill",
                    "Yêu cầu đổi trả" => "bi-arrow-left-right",
                    "Đang đổi trả" => "bi-truck",
                    "Đã nhận đổi trả" => "bi-box-arrow-in-down",
                    "Đã hoàn tiền" => "bi-cash-coin",
                    _ => "bi-circle"
                };

                <div class="staff-tracker-step @cls">
                    <div class="icon-circle">
                        <i class="bi @iconClass"></i>
                    </div>
                    <div class="step-label">@stepName</div>
                </div>
            }
        </div>

        @if (Model.NgayDuKienGiao.HasValue && !isCompleted && !hasReturnWorkflow)
        {
            <div class="staff-eta-banner">
                <i class="bi bi-calendar-check"></i>
                <span>Dự kiến giao hàng: @Model.NgayDuKienGiao.Value.ToString("HH:mm, dd/MM/yyyy")</span>
            </div>
        }
    }
</section>

<!-- 4. Layout 2 cột: Bảng sản phẩm chiếm diện tích chính (7 phần) + Thông tin nhận hàng (5 phần) -->
<div class="staff-order-detail-layout">
    <!-- Cột trái: Bảng sản phẩm trong đơn -->
    <section class="staff-section-card">
        <div class="staff-section-title">
            <span>Sản phẩm trong đơn (@(Model.ChiTietDonHangs?.Count ?? 0))</span>
        </div>
        <div class="table-responsive">
            <table class="staff-order-product-table">
                <thead>
                    <tr>
                        <th>Sản phẩm</th>
                        <th>Biến thể</th>
                        <th class="text-end">Đơn giá</th>
                        <th class="text-center">SL</th>
                        <th class="text-end">Thành tiền</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var detail in Model.ChiTietDonHangs ?? Enumerable.Empty<ChiTietDonHang>())
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold text-dark">@(detail.MaBienTheNavigation?.MaSanPhamNavigation?.TenSanPham ?? "Sản phẩm")</div>
                            </td>
                            <td>
                                <small class="text-muted">@(detail.MaBienTheNavigation?.MauSac) @(detail.MaBienTheNavigation?.PhienBan)</small>
                            </td>
                            <td class="text-end">@detail.DonGia.ToString("N0") đ</td>
                            <td class="text-center">@detail.SoLuong</td>
                            <td class="text-end fw-semibold">@detail.ThanhTien.ToString("N0") đ</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="staff-order-total-bar">
            <span>Tổng thanh toán:</span>
            <strong>@((Model.TongTien ?? 0).ToString("N0")) đ</strong>
        </div>
    </section>

    <!-- Cột phải: Thông tin khách hàng & vận chuyển -->
    <section class="staff-section-card">
        <div class="staff-section-title">
            <span>Thông tin giao nhận</span>
            <span class="badge bg-light text-dark border">@currentStatus</span>
        </div>
        <div class="staff-order-info-list">
            <div class="staff-info-row">
                <span class="staff-info-label">Khách nhận</span>
                <span class="staff-info-val">@(Model.HoTenNhanHang ?? Model.MaNguoiDungNavigation?.TenNguoiDung ?? "Khách hàng")</span>
            </div>
            <div class="staff-info-row">
                <span class="staff-info-label">Số điện thoại</span>
                <span class="staff-info-val">@(Model.SoDienThoaiNhanHang ?? "—")</span>
            </div>
            <div class="staff-info-row">
                <span class="staff-info-label">Địa chỉ nhận</span>
                <span class="staff-info-val">@(Model.DiaChiNhanHang ?? "—")</span>
            </div>
            <div class="staff-info-row">
                <span class="staff-info-label">Phương thức giao</span>
                <span class="staff-info-val">@(Model.PhuongThucVanChuyen ?? "Giao hàng tiêu chuẩn")</span>
            </div>
            <div class="staff-info-row">
                <span class="staff-info-label">Ghi chú đơn</span>
                <span class="staff-info-val text-muted">@(Model.GhiChu ?? "Không có")</span>
            </div>
            @if (!string.IsNullOrEmpty(Model.AnhXacNhanGiao))
            {
                <div class="staff-info-row mt-2">
                    <span class="staff-info-label">Ảnh giao hàng</span>
                    <div class="staff-info-val">
                        <img src="@Model.AnhXacNhanGiao" alt="Ảnh xác nhận giao" class="staff-proof-photo" />
                    </div>
                </div>
            }
        </div>
    </section>
</div>

<!-- 5. Form cập nhật trạng thái & giao nhận gọn gàng -->
<section class="staff-delivery-section">
    <div class="staff-section-title">
        <span>Cập nhật tiến độ giao vận</span>
    </div>
    <form asp-action="UpdateDeliveryStatus" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.MaDonHang" />

        <div class="staff-delivery-grid">
            <div>
                <label class="form-label">Trạng thái đơn hàng</label>
                <select name="status" id="statusSelect" class="form-select">
                    @foreach (var status in allStatuses)
                    {
                        <option value="@status" selected="@(currentStatus == status)">@status</option>
                    }
                </select>
            </div>

            <div>
                <label class="form-label"><i class="bi bi-calendar-event me-1"></i>Ngày dự kiến giao</label>
                <input type="datetime-local" name="ngayDuKienGiao" id="etaInput" class="form-control"
                       value="@((Model.NgayDuKienGiao ?? DateTime.Now).ToString("yyyy-MM-ddTHH:mm"))" />
            </div>

            <div>
                <label class="form-label">Ghi chú giao nhận</label>
                <input type="text" name="ghiChuGiaoHang" id="ghiChuGiaoHang" class="form-control" placeholder="Nhập ghi chú hoặc mã vận đơn..." />
            </div>

            <div id="proofBox" style="display:none;">
                <label class="form-label"><i class="bi bi-camera me-1"></i>Ảnh xác nhận giao <span class="text-danger">*</span></label>
                <input type="file" name="anhXacNhanGiao" id="proofInput" accept="image/*" class="form-control" />
                <img id="proofPreview" class="staff-proof-photo" style="display:none;" alt="Xem trước ảnh" />
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <button type="submit" class="btn btn-primary px-4">
                <i class="bi bi-check2 me-1"></i> Lưu cập nhật
            </button>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        (function () {
            var statusSelect = document.getElementById('statusSelect');
            var proofBox = document.getElementById('proofBox');
            var proofInput = document.getElementById('proofInput');
            var proofPreview = document.getElementById('proofPreview');

            function toggleProofBox() {
                var isDelivered = statusSelect.value === 'Đã hoàn thành' || statusSelect.value === 'Đã giao';
                proofBox.style.display = isDelivered ? 'block' : 'none';
                proofInput.required = isDelivered;
            }

            statusSelect.addEventListener('change', toggleProofBox);
            toggleProofBox();

            proofInput.addEventListener('change', function () {
                var file = this.files && this.files[0];
                if (!file) { proofPreview.style.display = 'none'; return; }
                var reader = new FileReader();
                reader.onload = function (e) {
                    proofPreview.src = e.target.result;
                    proofPreview.style.display = 'block';
                };
                reader.readAsDataURL(file);
            });
        })();

        const staffOrderId = @Model.MaDonHang;
        const staffChatWaiting = document.getElementById('staffChatWaiting');
        const staffChatActive = document.getElementById('staffChatActive');
        const staffChatBox = document.getElementById('staffChatMessageList');
        const staffChatForm = document.getElementById('staffChatForm');
        const staffChatInput = document.getElementById('staffChatInput');
        const staffChatBadge = document.getElementById('staffChatStatusBadge');
        let staffSessionActive = false;

        function escapeStaffHtml(value) {
            const div = document.createElement('div'); div.textContent = value ?? ''; return div.innerHTML;
        }
        function setStaffChatState(active) {
            staffSessionActive = active;
            if (staffChatWaiting) staffChatWaiting.classList.toggle('d-none', active);
            if (staffChatActive) staffChatActive.classList.toggle('d-none', !active);
            if (staffChatBadge) staffChatBadge.textContent = active ? 'Đang hoạt động' : 'Chờ khách';
        }
        function appendStaffMessageUI(msg) {
            const isMe = msg.isStaff;
            const wrapper = document.createElement('div');
            wrapper.className = `d-flex flex-column ${isMe ? 'align-items-end' : 'align-items-start'} mb-2`;
            wrapper.innerHTML = `<small class="text-muted mb-1">${escapeStaffHtml(msg.senderName)} • ${escapeStaffHtml(msg.time)}</small><div class="p-2 px-3 ${isMe ? 'bg-primary text-white' : 'bg-light border text-dark'}" style="max-width:80%;word-break:break-word;font-size:13px;">${escapeStaffHtml(msg.message)}</div>`;
            staffChatBox.appendChild(wrapper);
        }
        async function loadStaffChat() {
            try {
                const statusResponse = await fetch(`/Staff/Order/GetOrderChatStatus?orderId=${staffOrderId}`, { cache:'no-store' });
                if (!statusResponse.ok) return;
                const status = await statusResponse.json();
                setStaffChatState(status.active);
                if (!status.active || !staffChatBox) return;

                const response = await fetch(`/Staff/Order/GetOrderMessages?orderId=${staffOrderId}`, { cache:'no-store' });
                if (!response.ok) return;
                const messages = await response.json();
                staffChatBox.innerHTML = '';
                if (!messages.length) {
                    staffChatBox.innerHTML = '<div class="text-center text-muted py-3 small">Khách đã mở phiên. Đang chờ tin nhắn...</div>';
                } else {
                    messages.forEach(appendStaffMessageUI);
                    staffChatBox.scrollTop = staffChatBox.scrollHeight;
                }
            } catch (err) { console.error('Lỗi tải chat Staff:', err); }
        }
        if (staffChatForm) {
            staffChatForm.addEventListener('submit', async function(e){
                e.preventDefault(); if (!staffSessionActive) return;
                const text = staffChatInput.value.trim(); if (!text) return;
                staffChatInput.value = '';
                try {
                    const response = await fetch('/Staff/Order/SendOrderMessage', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({orderId:staffOrderId,message:text}) });
                    const res = await response.json();
                    if (!res.success) { 
                        StaffDialog.warning('Phiên chat kết thúc', res.message || 'Phiên chat đã kết thúc.'); 
                        await loadStaffChat(); 
                        return; 
                    }
                    await loadStaffChat();
                } catch(err) { 
                    StaffDialog.error('Lỗi gửi tin', 'Không thể gửi tin nhắn lúc này.'); 
                }
            });
        }
        const endStaffBtn = document.getElementById('btnEndStaffChat');
        if (endStaffBtn) endStaffBtn.addEventListener('click', async function(){
            const confirmed = await StaffDialog.confirm({
                title: 'Kết thúc phiên chat?',
                message: 'Bạn có chắc muốn kết thúc phiên trò chuyện này? Toàn bộ nội dung trao đổi sẽ được xóa để bảo mật.',
                confirmText: 'Kết thúc chat',
                cancelText: 'Tiếp tục chat',
                isDanger: true
            });
            if (!confirmed) return;
            await fetch('/Staff/Order/EndOrderChat', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({orderId:staffOrderId}) });
            await loadStaffChat();
            StaffDialog.success('Đã kết thúc', 'Đã kết thúc phiên trao đổi với khách hàng.');
        });

        async function confirmAcceptReturn() {
            const confirmed = await StaffDialog.confirm({
                title: 'Chấp nhận đổi trả?',
                message: 'Bạn có chắc chắn muốn ĐỒNG Ý yêu cầu đổi trả của khách hàng cho đơn hàng này?',
                confirmText: 'Chấp nhận',
                cancelText: 'Xem lại',
                isDanger: false
            });
            if (confirmed) {
                document.getElementById('formAcceptReturn').submit();
            }
        }
        document.addEventListener('DOMContentLoaded', function(){
            loadStaffChat();
            setInterval(loadStaffChat, 3000);
        });
    </script>
}
