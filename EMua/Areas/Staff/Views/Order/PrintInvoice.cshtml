@model HoaDon
@{
    Layout = null;
    var order = Model.MaDonHangNavigation;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Hóa đơn #HD-@Model.MaHoaDon - EMUA Store</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        @@page {
            size: A4 portrait;
            margin: 10mm 12mm;
        }
        body {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            color: #172033;
            background: #f8fafc;
            margin: 0;
            padding: 24px 0;
            -webkit-font-smoothing: antialiased;
        }
        .invoice {
            max-width: 820px;
            margin: 0 auto;
            padding: 36px 40px;
            background: #fff;
            border: 1px solid #e2e8f0;
        }
        .top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            border-bottom: 2px solid #1e3a8a;
            padding-bottom: 18px;
            margin-bottom: 24px;
        }
        .brand-title {
            font-size: 26px;
            font-weight: 800;
            color: #1e3a8a;
            margin: 0 0 4px;
            letter-spacing: -0.5px;
        }
        .muted { color: #64748b; font-size: 13px; margin: 0; }
        .invoice-info { text-align: right; }
        .invoice-code { font-size: 18px; font-weight: 700; color: #1e3a8a; }
        .customer-meta {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            padding: 16px 20px;
            margin-bottom: 24px;
            font-size: 13.5px;
            line-height: 1.6;
        }
        .table-invoice {
            width: 100%;
            margin-bottom: 24px;
            border-collapse: collapse;
        }
        .table-invoice th {
            background: #f1f5f9;
            color: #334155;
            font-size: 12px;
            text-transform: uppercase;
            font-weight: 700;
            padding: 10px 12px;
            border-bottom: 1px solid #cbd5e1;
        }
        .table-invoice td {
            padding: 12px;
            border-bottom: 1px solid #f1f5f9;
            font-size: 13.5px;
            vertical-align: middle;
        }
        .total-box {
            display: flex;
            justify-content: flex-end;
            margin-top: 16px;
        }
        .total-panel {
            min-width: 280px;
            text-align: right;
            font-size: 14px;
        }
        .total-row {
            display: flex;
            justify-content: space-between;
            padding: 6px 0;
            border-bottom: 1px dashed #e2e8f0;
        }
        .total-row.grand {
            font-size: 17px;
            font-weight: 800;
            color: #1e3a8a;
            border-bottom: 2px solid #1e3a8a;
            border-top: 1px solid #1e3a8a;
            padding: 10px 0;
            margin-top: 6px;
        }
        @@media print {
            body {
                background: #fff !important;
                padding: 0 !important;
                color: #172033 !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            .no-print { display: none !important; }
            .invoice {
                border: 0 !important;
                padding: 0 !important;
                margin: 0 !important;
                max-width: 100% !important;
            }
            table { page-break-inside: auto; }
            tr { page-break-inside: avoid; page-break-after: auto; }
            thead { display: table-header-group; }
            tfoot { display: table-footer-group; }
        }
    </style>
</head>
<body>
    <div class="container mb-3 no-print" style="max-width: 820px;">
        <div class="d-flex justify-content-between align-items-center">
            <a href="javascript:window.close()" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Quay lại
            </a>
            <button class="btn btn-primary btn-sm px-3" onclick="window.print()">
                <i class="bi bi-printer-fill me-1"></i> In hóa đơn / Lưu PDF
            </button>
        </div>
    </div>

    <main class="invoice">
        <div class="top">
            <div>
                <h1 class="brand-title">EMUA TECHNOLOGY STORE</h1>
                <p class="muted">HÓA ĐƠN BÁN HÀNG NỘI BỘ</p>
                <p class="muted">Website: emua.vn | Hotline: 1900 6868</p>
            </div>
            <div class="invoice-info">
                <div class="invoice-code">#HD-@Model.MaHoaDon</div>
                <p class="muted">Mã đơn: #DH-@order.MaDonHang</p>
                <p class="muted">Ngày lập: @(Model.NgayLapHoaDon?.ToString("dd/MM/yyyy HH:mm") ?? DateTime.Now.ToString("dd/MM/yyyy HH:mm"))</p>
            </div>
        </div>

        <div class="customer-meta">
            <div><strong>Khách hàng:</strong> @(order.HoTenNhanHang ?? "Khách hàng")</div>
            <div><strong>Số điện thoại:</strong> @(order.SoDienThoaiNhanHang ?? "—")</div>
            <div><strong>Địa chỉ giao hàng:</strong> @(order.DiaChiNhanHang ?? "—")</div>
            @if (!string.IsNullOrWhiteSpace(Model.TenNguoiLap))
            {
                <div><strong>Nhân viên lập:</strong> @Model.TenNguoiLap</div>
            }
        </div>

        <table class="table-invoice">
            <thead>
                <tr>
                    <th style="width: 50px;">STT</th>
                    <th>Tên sản phẩm / Phiên bản</th>
                    <th class="text-center" style="width: 70px;">SL</th>
                    <th class="text-end" style="width: 140px;">Đơn giá</th>
                    <th class="text-end" style="width: 160px;">Thành tiền</th>
                </tr>
            </thead>
            <tbody>
                @{ int stt = 1; }
                @foreach (var item in order.ChiTietDonHangs)
                {
                    <tr>
                        <td class="text-center">@(stt++)</td>
                        <td>
                            <div class="fw-semibold">@item.MaBienTheNavigation.MaSanPhamNavigation.TenSanPham</div>
                            @if (!string.IsNullOrWhiteSpace(item.MaBienTheNavigation.MauSac) || !string.IsNullOrWhiteSpace(item.MaBienTheNavigation.PhienBan))
                            {
                                <div class="text-muted small">Phân loại: @item.MaBienTheNavigation.MauSac @item.MaBienTheNavigation.PhienBan</div>
                            }
                        </td>
                        <td class="text-center">@item.SoLuong</td>
                        <td class="text-end">@item.DonGia.ToString("N0") ₫</td>
                        <td class="text-end fw-semibold">@item.ThanhTien.ToString("N0") ₫</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="total-box">
            <div class="total-panel">
                @if (Model.TienTruocThue.HasValue && Model.TienThueVat.HasValue)
                {
                    <div class="total-row">
                        <span class="text-muted">Tiền trước thuế:</span>
                        <span>@Model.TienTruocThue.Value.ToString("N0") ₫</span>
                    </div>
                    <div class="total-row">
                        <span class="text-muted">Thuế VAT:</span>
                        <span>@Model.TienThueVat.Value.ToString("N0") ₫</span>
                    </div>
                }
                @if (Model.PhiVanChuyen.HasValue && Model.PhiVanChuyen > 0)
                {
                    <div class="total-row">
                        <span class="text-muted">Phí vận chuyển:</span>
                        <span>@Model.PhiVanChuyen.Value.ToString("N0") ₫</span>
                    </div>
                }
                @if (Model.TienGiamGia.HasValue && Model.TienGiamGia > 0)
                {
                    <div class="total-row">
                        <span class="text-muted">Giảm giá:</span>
                        <span class="text-success">-@Model.TienGiamGia.Value.ToString("N0") ₫</span>
                    </div>
                }
                <div class="total-row grand">
                    <span>Tổng thanh toán:</span>
                    <span>@((Model.TongTien ?? 0).ToString("N0")) ₫</span>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
