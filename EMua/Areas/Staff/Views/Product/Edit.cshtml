@model ProductCreateViewModel
@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
}
<section class="staff-card staff-form-card">
    <form method="post" class="row g-3">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="col-md-6"><label asp-for="TenSanPham"></label><input asp-for="TenSanPham"
                                                                             class="form-control" /><span asp-validation-for="TenSanPham"></span></div>
            <div class="col-md-6"><label asp-for="MaThuongHieu"></label><select asp-for="MaThuongHieu"
                                                                                    asp-items="ViewBag.Brands" class="form-select"></select><span asp-validation-for="MaThuongHieu"></span>
            </div>
            <div class="col-md-6"><label asp-for="MaDanhMuc"></label><select asp-for="MaDanhMuc"
                                                                             asp-items="ViewBag.Categories" class="form-select">
                <option value="">-- Chưa phân loại --</option>
            </select></div>
            <div class="col-md-6"><label asp-for="GiaGoc"></label><input asp-for="GiaGoc" type="number" min="0"
                                                                             class="form-control" /></div>
                <div class="col-md-6"><label asp-for="BaoHanh"></label><input asp-for="BaoHanh" class="form-control" /></div>
                <div class="col-12"><label asp-for="MoTa"></label><textarea asp-for="MoTa" class="form-control"
                                                                                rows="3"></textarea></div>
                    <div class="col-12"><label asp-for="ThongSoKyThuat"></label><textarea asp-for="ThongSoKyThuat"
                                                                                              class="form-control" rows="4"></textarea></div>@if (Model.BienThe.Any()) {
                        <div class="col-12"><label
                            class="form-label">Số lượng tồn kho</label>
                            <div class="table-responsive">
                                <table class="staff-table">
                                    <thead>
                                        <tr>
                                            <th>Biến thể</th>
                                            <th>Số lượng</th>
                                        </tr>
                                    </thead>
                                    <tbody>@for (var i = 0; i < Model.BienThe.Count; i++) {
                                        <tr>
                                            <td>@(string.Join(" - ", new[] { Model.BienThe[i].MauSac, Model.BienThe[i].PhienBan
                                }.Where(value => !string.IsNullOrWhiteSpace(value))))<input
                                                asp-for="BienThe[i].MaBienThe" type="hidden" /></td>
                                                <td><input asp-for="BienThe[i].SoLuong" type="number" min="0" class="form-control" /><span
                                                    asp-validation-for="BienThe[i].SoLuong"></span></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        }
                        <div class="col-12 d-flex gap-2"><button class="btn btn-primary">Lưu thay đổi</button><a
                            asp-action="Index" class="btn btn-light">Hủy</a></div>
                        </form>
                    </section>
                    @section Scripts {
                        <partial name="_ValidationScriptsPartial" />
                    }