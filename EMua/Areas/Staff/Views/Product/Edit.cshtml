@model ProductCreateViewModel
@{
    ViewData["Title"] = "Chỉnh sửa sản phẩm";
    var productId = ViewContext.RouteData.Values["id"];

    string FixImage(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "/images/no-image.png";
        path = path.Trim().Replace("\\", "/");
        if (path.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            path.StartsWith("//")) return path;
        return path.StartsWith("/") ? path : "/" + path;
    }
}

<section class="staff-card staff-form-card">
    <form method="post" enctype="multipart/form-data" class="row g-3" id="editProductForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input type="hidden" asp-for="SelectedMainImageUrl" id="selectedMainImageUrl" value="@Model.CurrentImageUrl" />

        <div class="col-md-6">
            <label asp-for="TenSanPham"></label>
            <input asp-for="TenSanPham" class="form-control" />
            <span asp-validation-for="TenSanPham" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="MaThuongHieu"></label>
            <select asp-for="MaThuongHieu" asp-items="ViewBag.Brands" class="form-select">
                <option value="">-- Chọn thương hiệu --</option>
            </select>
            <span asp-validation-for="MaThuongHieu" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="MaDanhMuc"></label>
            <select asp-for="MaDanhMuc" asp-items="ViewBag.Categories" class="form-select">
                <option value="">-- Chưa phân loại --</option>
            </select>
        </div>

        <div class="col-md-6">
            <label asp-for="GiaGoc"></label>
            <input asp-for="GiaGoc" type="number" step="1" min="0" value="@(Model.GiaGoc.HasValue? Convert.ToInt64(Model.GiaGoc.Value) : "")" class="form-control" />
            <span asp-validation-for="GiaGoc" class="text-danger"></span>
        </div>

        <div class="col-md-6">
            <label asp-for="BaoHanh"></label>
            <input asp-for="BaoHanh" class="form-control" placeholder="VD: 12 tháng" />
        </div>

        <!-- BỘ SƯU TẬP ẢNH HIỆN CÓ - CLICK ĐỔI ẢNH CHÍNH & NÚT XÓA ẢNH -->
        <div class="col-12">
            <label class="form-label fw-bold">Bộ sưu tập ảnh hiện tại <small class="text-primary fw-normal">(Click vào ảnh để đặt làm Ảnh chính)</small></label>

            @if (Model.CurrentImageUrls != null && Model.CurrentImageUrls.Any())
            {
                <div class="d-flex flex-wrap gap-3 p-3 border rounded bg-light" id="imageGallery">
                    @foreach (var imgUrl in Model.CurrentImageUrls)
                    {
                        var isMain = (imgUrl == Model.CurrentImageUrl) || (imgUrl == Model.SelectedMainImageUrl);
                        var fixedUrl = FixImage(imgUrl);
                        <div class="gallery-item position-relative text-center border rounded p-1 bg-white @(isMain ? "border-primary border-2 shadow-sm" : "")"
                             data-img-url="@imgUrl"
                             style="width: 120px; transition: all 0.2s;">

                            <!-- Nút xóa ảnh -->
                            <button type="button" class="btn btn-sm btn-danger position-absolute top-0 end-0 m-1 p-0 rounded-circle d-flex align-items-center justify-content-center"
                                    style="width: 22px; height: 22px; z-index: 10;"
                                    title="Xóa hình ảnh này"
                                    onclick="event.stopPropagation(); deleteGalleryImage('@imgUrl', '@productId', this)">
                                <i class="bi bi-x" style="font-size: 14px; line-height: 1;"></i>
                            </button>

                            <div style="cursor: pointer;" onclick="quickSelectMainImage('@imgUrl', this.parentElement, '@productId')">
                                <img src="@fixedUrl" class="img-fluid rounded mb-1" style="height: 80px; width: 100%; object-fit: contain;"
                                     onerror="this.onerror=null; this.src='/images/no-image.png';" />

                                <!-- Badge Ảnh chính -->
                                <span class="main-badge badge bg-primary position-absolute top-0 start-0 m-1 @(isMain ? "" : "d-none")" style="font-size: 9px;">Ảnh chính</span>

                                <div class="small text-muted status-text" style="font-size: 11px;">
                                    @(isMain ? "Ảnh chính" : "Bấm để chọn")
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Model.CurrentImageUrl))
            {
                var singleFixedUrl = FixImage(Model.CurrentImageUrl);
                <div class="p-2 border rounded bg-light d-inline-block">
                    <img src="@singleFixedUrl" class="img-fluid rounded" style="height: 80px; object-fit: contain;"
                         onerror="this.onerror=null; this.src='/images/no-image.png';" />
                </div>
            }
            else
            {
                <p class="text-muted small">Chưa có ảnh nào trong bộ sưu tập.</p>
            }
        </div>

        <div class="col-12">
            <label class="form-label fw-bold">Tải lên ảnh mới (Chọn một hoặc nhiều ảnh)</label>
            <input name="ImageFiles" type="file" multiple accept=".jpg,.jpeg,.png,.webp" class="form-control" />
            <span asp-validation-for="ImageFile" class="text-danger"></span>
            <small class="text-muted d-block mt-1">Giữ phím <b>Ctrl</b> hoặc <b>Shift</b> để chọn nhiều ảnh cùng lúc.</small>
        </div>

        <div class="col-12">
            <label asp-for="MoTa"></label>
            <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
        </div>

        <div class="col-12">
            <label asp-for="ThongSoKyThuat"></label>
            <textarea asp-for="ThongSoKyThuat" class="form-control" rows="4"></textarea>
        </div>

        <!-- QUẢN LÝ BIẾN THỂ -->
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h3 class="m-0">Biến thể sản phẩm</h3>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addVariantRow()">
                    <i class="bi bi-plus-lg"></i> + Thêm biến thể
                </button>
            </div>

            <div class="table-responsive">
                <table class="staff-table" id="variantTable">
                    <thead>
                        <tr>
                            <th>Màu sắc</th>
                            <th>Phiên bản</th>
                            <th>Giá bán</th>
                            <th style="min-width: 170px;">Tồn kho &amp; Nhập hàng</th>
                            <th>Trạng thái</th>
                            <th style="width: 50px;"></th>
                        </tr>
                    </thead>
                    <tbody id="variantTableBody">
                        @{
                            var pendingDict = (ViewBag.PendingImports as Dictionary<int, string>) ?? new Dictionary<int, string>();
                        }
                        @for (var i = 0; i < Model.BienThe.Count; i++)
                        {
                            var bId = Model.BienThe[i].MaBienThe;
                            var qty = Model.BienThe[i].SoLuong;
                            var hasPending = bId > 0 && pendingDict.ContainsKey(bId);

                            <tr class="variant-row">
                                <td>
                                    <input asp-for="BienThe[i].MauSac" class="form-control" placeholder="VD: Titan Sa Mạc" />
                                    <input asp-for="BienThe[i].MaBienThe" type="hidden" />
                                </td>
                                <td>
                                    <input asp-for="BienThe[i].PhienBan" class="form-control" placeholder="VD: 512GB" />
                                </td>
                                <td>
                                    <input asp-for="BienThe[i].Gia" type="number" step="1" min="0" value="@Convert.ToInt64(Model.BienThe[i].Gia)" class="form-control" />
                                </td>
                                <td>
                                    @if (bId > 0)
                                    {
                                        <div class="d-flex flex-column gap-1">
                                            <div class="d-flex align-items-center gap-2">
                                                <input asp-for="BienThe[i].SoLuong" type="number" readonly class="form-control form-control-sm bg-light fw-bold" style="width: 80px;" title="Tồn kho thực tế (cần lập phiếu nhập hàng để tăng tồn)" />
                                                @if (qty == 0)
                                                {
                                                    <span class="badge bg-danger">Hết hàng</span>
                                                }
                                                else if (qty <= 10)
                                                {
                                                    <span class="badge bg-warning text-dark">Sắp hết (@qty)</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-success">Còn hàng (@qty)</span>
                                                }
                                            </div>

                                            @if (hasPending)
                                            {
                                                <div class="small text-primary fw-semibold" style="font-size: 11px;">
                                                    <i class="bi bi-clock-history"></i> Đang chờ duyệt: @pendingDict[bId]
                                                </div>
                                            }

                                            <div>
                                                <a asp-area="Staff" asp-controller="ImportOrder" asp-action="Create" asp-route-productId="@productId" asp-route-variantId="@bId"
                                                   class="btn btn-xs @(qty == 0 ? "btn-danger fw-bold" : (qty <= 10 ? "btn-warning text-dark fw-semibold" : "btn-outline-primary")) mt-1 py-1 px-2 d-inline-flex align-items-center gap-1"
                                                   style="font-size: 11px;"
                                                   title="Lập phiếu đề nghị nhập hàng cho biến thể này">
                                                    <i class="bi bi-box-arrow-in-down"></i>
                                                    <span>Đề nghị nhập hàng</span>
                                                </a>
                                            </div>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            <input asp-for="BienThe[i].SoLuong" type="number" min="0" class="form-control" placeholder="Tồn khởi tạo" />
                                            <small class="text-muted">(Mới)</small>
                                        </div>
                                    }
                                </td>
                                <td>
                                    <select asp-for="BienThe[i].TrangThai" class="form-select">
                                        <option value="Còn hàng">Đang bán</option>
                                        <option value="Ẩn">Ẩn biến thể</option>
                                    </select>
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeVariantRow(this)" title="Xóa">
                                        &times;
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="col-12 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Lưu toàn bộ thay đổi</button>
            <a asp-action="Index" class="btn btn-light">Hủy</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Xử lý tự động lưu & đổi ảnh chính ngay lập tức qua AJAX
        function quickSelectMainImage(imgUrl, element, productId) {
            document.getElementById('selectedMainImageUrl').value = imgUrl;

            document.querySelectorAll('#imageGallery .gallery-item').forEach(item => {
                item.classList.remove('border-primary', 'border-2', 'shadow-sm');
                const badge = item.querySelector('.main-badge');
                if (badge) badge.classList.add('d-none');
                const text = item.querySelector('.status-text');
                if (text) text.innerText = 'Bấm để chọn';
            });

            element.classList.add('border-primary', 'border-2', 'shadow-sm');
            const selectedBadge = element.querySelector('.main-badge');
            if (selectedBadge) selectedBadge.classList.remove('d-none');
            const selectedText = element.querySelector('.status-text');
            if (selectedText) selectedText.innerText = 'Ảnh chính';

            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('imageUrl', imgUrl);

            fetch('/Staff/Product/SetMainImage', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                },
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    StaffDialog.success('Đã cập nhật', data.message || 'Đã đặt làm ảnh chính.');
                } else {
                    StaffDialog.error('Không thể đặt ảnh chính', data.message || 'Thao tác không thành công.');
                }
            })
            .catch(error => {
                StaffDialog.error('Lỗi kết nối', 'Không thể kết nối đến máy chủ. Vui lòng thử lại.');
            });
        }

        // Xử lý xóa hình ảnh sản phẩm với Confirmation Dialog
        async function deleteGalleryImage(imgUrl, productId, btn) {
            const confirmed = await StaffDialog.confirm({
                title: 'Xóa hình ảnh sản phẩm?',
                message: 'Bạn có chắc chắn muốn xóa hình ảnh này khỏi bộ sưu tập? Thao tác này không thể hoàn tác.',
                confirmText: 'Xóa ảnh',
                cancelText: 'Hủy',
                isDanger: true
            });

            if (!confirmed) return;

            btn.disabled = true;
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const formData = new FormData();
            formData.append('productId', productId);
            formData.append('imageUrl', imgUrl);

            fetch('/Staff/Product/DeleteImage', {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token
                },
                body: formData
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    const galleryItem = btn.closest('.gallery-item');
                    if (galleryItem) {
                        galleryItem.remove();
                    }
                    if (data.newMainImageUrl) {
                        document.getElementById('selectedMainImageUrl').value = data.newMainImageUrl;
                        const newMainItem = document.querySelector(`.gallery-item[data-img-url="${data.newMainImageUrl}"]`);
                        if (newMainItem) {
                            newMainItem.classList.add('border-primary', 'border-2', 'shadow-sm');
                            const b = newMainItem.querySelector('.main-badge');
                            if (b) b.classList.remove('d-none');
                            const t = newMainItem.querySelector('.status-text');
                            if (t) t.innerText = 'Ảnh chính';
                        }
                    }
                    StaffDialog.success('Xóa thành công', data.message || 'Đã xóa hình ảnh khỏi sản phẩm.');
                } else {
                    btn.disabled = false;
                    StaffDialog.error('Không thể xóa ảnh', data.message || 'Không thể xóa hình ảnh lúc này.');
                }
            })
            .catch(error => {
                btn.disabled = false;
                StaffDialog.error('Lỗi kết nối', 'Không thể kết nối đến máy chủ. Vui lòng kiểm tra và thử lại.');
            });
        }

        function addVariantRow() {
            const tbody = document.getElementById('variantTableBody');
            const index = tbody.querySelectorAll('.variant-row').length;

            const row = document.createElement('tr');
            row.className = 'variant-row';
            row.innerHTML = `
                <td>
                    <input name="BienThe[${index}].MauSac" class="form-control" placeholder="VD: Titan Sa Mạc" />
                    <input name="BienThe[${index}].MaBienThe" type="hidden" value="0" />
                </td>
                <td>
                    <input name="BienThe[${index}].PhienBan" class="form-control" placeholder="VD: 1TB" />
                </td>
                <td>
                    <input name="BienThe[${index}].Gia" type="number" step="1" min="0" value="0" class="form-control" />
                </td>
                <td>
                    <input name="BienThe[${index}].SoLuong" type="number" min="0" value="10" class="form-control" />
                </td>
                <td>
                    <select name="BienThe[${index}].TrangThai" class="form-select">
                        <option value="Còn hàng">Đang bán</option>
                        <option value="Ẩn">Ẩn biến thể</option>
                    </select>
                </td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeVariantRow(this)" title="Xóa">
                        &times;
                    </button>
                </td>
            `;
            tbody.appendChild(row);
        }

        async function removeVariantRow(button) {
            const tbody = document.getElementById('variantTableBody');
            const rows = tbody.querySelectorAll('.variant-row');

            if (rows.length <= 1) {
                StaffDialog.warning('Không thể xóa', 'Sản phẩm phải duy trì ít nhất 1 biến thể.');
                return;
            }

            const confirmed = await StaffDialog.confirm({
                title: 'Xóa biến thể này?',
                message: 'Bạn có chắc chắn muốn bỏ biến thể này khỏi danh sách?',
                confirmText: 'Xóa',
                cancelText: 'Giữ lại',
                isDanger: true
            });

            if (!confirmed) return;

            button.closest('tr').remove();
            reIndexVariantRows();
        }

        function reIndexVariantRows() {
            const rows = document.querySelectorAll('#variantTableBody .variant-row');
            rows.forEach((row, idx) => {
                row.querySelectorAll('input, select').forEach(input => {
                    const name = input.getAttribute('name');
                    if (name) {
                        input.setAttribute('name', name.replace(/BienThe\[\d+\]/, `BienThe[${idx}]`));
                    }
                    const id = input.getAttribute('id');
                    if (id) {
                        input.setAttribute('id', id.replace(/BienThe_\d+__/, `BienThe_${idx}__`));
                    }
                });
            });
        }
    </script>
}