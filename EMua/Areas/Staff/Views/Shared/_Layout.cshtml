@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject EMua.Data.EMuaDbContext DbContext
@{
    // TenNguoiDung tu database duoc uu tien hon ten dang nhap trong claims.
    // Fallback: ten claim, sau cung la "Nhan vien".
    var claimDisplayName = User.Identity?.Name;
    var displayName = string.IsNullOrWhiteSpace(claimDisplayName)
        ? "Nhân viên"
        : claimDisplayName.Trim();

    string? avatarUrl = null;
    var userIdClaim = User.FindFirstValue(ClaimTypes.NameIdentifier);

    // Chi truy van bang ID so khi claim thuc su chua MaNguoiDung.
    // Neu identity dung ID khac, can doi chieu luong dang nhap truoc khi sua.
    if (int.TryParse(userIdClaim, out var staffUserId))
    {
        var staffUser = await DbContext.NguoiDungs
            .AsNoTracking()
            .Where(u => u.MaNguoiDung == staffUserId)
            .Select(u => new { u.TenNguoiDung, u.AnhDaiDien })
            .FirstOrDefaultAsync();

        if (staffUser != null)
        {
            if (!string.IsNullOrWhiteSpace(staffUser.TenNguoiDung))
            {
                displayName = staffUser.TenNguoiDung.Trim();
            }

            if (!string.IsNullOrWhiteSpace(staffUser.AnhDaiDien))
            {
                avatarUrl = staffUser.AnhDaiDien;
            }
        }
    }

    var avatarLetter = string.IsNullOrWhiteSpace(displayName)
        ? "N"
        : displayName[..1].ToUpperInvariant();

    var currentController =
        ViewContext.RouteData.Values["Controller"]?.ToString();

    var currentStatusFilter =
        Context.Request.Query["status"].ToString();

    var isReturnPage =
        currentController == "Order" &&
        currentStatusFilter == "Yêu cầu đổi trả";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EMUA Nhân viên</title>

    <link rel="icon"
          type="image/png"
          href="~/images/logo/chicken.png"
          asp-append-version="true" />

    <link rel="apple-touch-icon"
          href="~/images/logo/chicken.png"
          asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/admin/admin-layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/staff/staff-layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/staff/staff-dialog.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/staff/staff-theme.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/shared/design-system.css"
          asp-append-version="true" />



    <style>
        /* Staff: header chỉ một dòng, không dư ngày tháng và khoảng trống */
        body.emua-staff .admin-header {
            min-height: 58px;
            padding-top: 9px;
            padding-bottom: 9px;
        }

        body.emua-staff .admin-header-left h1 {
            margin: 0;
            font-size: 17px;
            line-height: 1.35;
            font-weight: 650;
        }

        body.emua-staff .staff-content {
            padding-top: 14px;
        }

        @@media (max-width: 575.98px) {
            body.emua-staff .admin-header {
                min-height: 54px;
            }

            body.emua-staff .staff-content {
                padding-top: 10px;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="emua-staff">
    <div class="admin-shell staff-shell">

        <!-- BACKDROP MENU ĐIỆN THOẠI -->
        <div class="admin-sidebar-backdrop"
             id="staffSidebarBackdrop"></div>

        <!-- SIDEBAR -->
        <aside class="admin-sidebar staff-sidebar"
               id="staffSidebar">

            <!-- LOGO -->
            <a asp-area="Staff"
               asp-controller="Dashboard"
               asp-action="Index"
               class="admin-logo staff-brand"
               title="EMUA Nhân viên">

                <span class="admin-logo-text">
                    <img src="~/images/logo/icon-logo.png"
                         asp-append-version="true"
                         alt="EMUA"
                         class="staff-brand-wordmark" />

                    <small>Nhân viên</small>
                </span>

                <span class="admin-logo-mini">
                    <img src="~/images/logo/icon-logo-v2.png"
                         asp-append-version="true"
                         alt="EMUA"
                         class="staff-brand-icon" />
                </span>
            </a>

            <!-- MENU -->
            <nav class="admin-nav" aria-label="Menu nhân viên">

                <span class="admin-nav-label">Tổng quan</span>

                <a class="@(currentController == "Dashboard" ? "active" : "")"
                   data-tooltip="Tổng quan"
                   asp-area="Staff"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Tổng quan</span>
                </a>

                <span class="admin-nav-label">
                    Quản lý bán hàng
                </span>

                <a class="@(currentController == "Product" ? "active" : "")"
                   data-tooltip="Sản phẩm"
                   asp-area="Staff"
                   asp-controller="Product"
                   asp-action="Index">
                    <i class="bi bi-box-seam"></i>
                    <span>Sản phẩm</span>
                </a>

                <a class="@(currentController == "ImportOrder" ? "active" : "")"
                   data-tooltip="Đề nghị nhập hàng"
                   asp-area="Staff"
                   asp-controller="ImportOrder"
                   asp-action="Index">
                    <i class="bi bi-box-arrow-in-down"></i>
                    <span>Nhập hàng</span>
                </a>

                <a class="@(currentController == "Order" && !isReturnPage ? "active" : "")"
                   data-tooltip="Đơn hàng"
                   asp-area="Staff"
                   asp-controller="Order"
                   asp-action="Index">
                    <i class="bi bi-receipt"></i>
                    <span>Tất cả đơn hàng</span>
                </a>

                <a class="@(currentController == "Promotion" ? "active" : "")"
                   data-tooltip="Khuyến mãi"
                   asp-area="Staff"
                   asp-controller="Promotion"
                   asp-action="Index">
                    <i class="bi bi-ticket-perforated"></i>
                    <span>Khuyến mãi</span>
                </a>

                <a class="@(currentController == "Invoice" ? "active" : "")"
                   data-tooltip="Hóa đơn"
                   asp-area="Staff"
                   asp-controller="Invoice"
                   asp-action="Index">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Hóa đơn</span>
                </a>

                <a class="@(currentController == "Report" ? "active" : "")"
                   data-tooltip="Báo cáo"
                   asp-area="Staff"
                   asp-controller="Report"
                   asp-action="Index">
                    <i class="bi bi-bar-chart"></i>
                    <span>Báo cáo thống kê</span>
                </a>

                <span class="admin-nav-label">Tài khoản</span>

                <a class="@(currentController == "Profile" ? "active" : "")"
                   data-tooltip="Cài đặt"
                   asp-area="Staff"
                   asp-controller="Profile"
                   asp-action="Index">
                    <i class="bi bi-gear"></i>
                    <span>Cài đặt</span>
                </a>
            </nav>

            <!-- MENU DƯỚI -->
            <div class="admin-sidebar-bottom">
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="admin-bottom-link"
                   data-tooltip="Xem website">
                    <i class="bi bi-eye"></i>
                    <span>Xem website</span>
                </a>

                <form asp-area=""
                      asp-controller="Auth"
                      asp-action="Logout"
                      method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="admin-bottom-link logout"
                            data-tooltip="Đăng xuất">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- NỘI DUNG CHÍNH -->
        <main class="admin-main">

            <!-- HEADER -->
            <header class="admin-header">
                <div class="admin-header-left">
                    <button type="button"
                            class="admin-menu-toggle"
                            id="staffMenuToggle"
                            aria-label="Thu gọn menu"
                            aria-controls="staffSidebar"
                            aria-expanded="true">
                        <i class="bi bi-list"></i>
                    </button>

                    <div>
                        <h1>@ViewData["Title"]</h1>
                    </div>
                </div>

                <div class="admin-header-actions staff-header-actions">
                    <div class="dropdown">
                        <button type="button"
                                class="staff-notification dropdown-toggle"
                                id="staffNotificationToggle"
                                data-bs-toggle="dropdown"
                                data-bs-auto-close="outside"
                                aria-expanded="false"
                                aria-label="Mở thông báo">
                            <i class="bi bi-bell" aria-hidden="true"></i>
                            <span class="staff-notification-badge"
                                  id="headerNotificationBadge"
                                  style="display: none;">0</span>
                        </button>

                        <div class="dropdown-menu dropdown-menu-end staff-notification-menu"
                             aria-labelledby="staffNotificationToggle">
                            <div class="dropdown-header">
                                <strong>Thông báo</strong>
                                <span>Cập nhật tự động</span>
                            </div>

                            <a class="staff-notification-item"
                               data-notification="returns"
                               asp-area="Staff"
                               asp-controller="Order"
                               asp-action="Index"
                               asp-route-status="Yêu cầu đổi trả">
                                <span class="staff-notification-item-icon">
                                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                                </span>
                                <span class="staff-notification-item-copy">
                                    <strong>Yêu cầu đổi trả</strong>
                                    <small>Đơn hàng cần xử lý đổi trả</small>
                                </span>
                                <span class="staff-notification-item-count"
                                      id="headerReturnCount">0</span>
                            </a>

                            <a class="staff-notification-item"
                               data-notification="orders"
                               asp-area="Staff"
                               asp-controller="Order"
                               asp-action="Index"
                               asp-route-status="Chờ xử lý">
                                <span class="staff-notification-item-icon">
                                    <i class="bi bi-box-seam" aria-hidden="true"></i>
                                </span>
                                <span class="staff-notification-item-copy">
                                    <strong>Đơn hàng chờ xử lý</strong>
                                    <small>Đơn mới cần xác nhận</small>
                                </span>
                                <span class="staff-notification-item-count"
                                      id="headerPendingOrderCount">0</span>
                            </a>

                            <a class="staff-notification-item"
                               data-notification="stock"
                               asp-area="Staff"
                               asp-controller="Product"
                               asp-action="Index"
                               asp-route-lowStock="true">
                                <span class="staff-notification-item-icon">
                                    <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
                                </span>
                                <span class="staff-notification-item-copy">
                                    <strong>Tồn kho thấp</strong>
                                    <small>Biến thể còn không quá 10 sản phẩm</small>
                                </span>
                                <span class="staff-notification-item-count"
                                      id="headerLowStockCount">0</span>
                            </a>

                            <p class="staff-notification-empty"
                               id="staffNotificationEmpty">
                                Bạn đã xử lý hết thông báo.
                            </p>
                        </div>
                    </div>

                    <!-- TÀI KHOẢN NHÂN VIÊN -->
                    <a class="admin-user"
                       asp-area=""
                       asp-controller="Account"
                       asp-action="Profile"
                       title="Hồ sơ của tôi">
                        <div class="admin-avatar">
                            @if (!string.IsNullOrWhiteSpace(avatarUrl))
                            {
                                <img src="@avatarUrl" alt="@displayName" class="staff-avatar-img" onerror="this.style.display='none'; if(this.nextElementSibling) this.nextElementSibling.style.display='flex';" />
                                <span class="staff-avatar-fallback" style="display: none;">@avatarLetter</span>
                            }
                            else
                            {
                                <span class="staff-avatar-fallback">@avatarLetter</span>
                            }
                        </div>

                        <span class="staff-user-name">
                            @displayName
                        </span>
                    </a>
                </div>
            </header>

            <!-- NỘI DUNG TỪNG TRANG -->
            <section class="admin-content staff-content">
                @await Html.PartialAsync("_StaffDialog")

                @RenderBody()
            </section>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/staff/staff-dialog.js" asp-append-version="true"></script>

    <script>
        (function () {
            const sidebar = document.getElementById("staffSidebar");
            const backdrop = document.getElementById("staffSidebarBackdrop");
            const menuToggle = document.getElementById("staffMenuToggle");

            const desktopBreakpoint = 850;
            const sidebarStorageKey = "emua_staff_sidebar_collapsed";

            function isMobile() {
                return window.innerWidth <= desktopBreakpoint;
            }

            function getSavedSidebarState() {
                try {
                    return localStorage.getItem(sidebarStorageKey) === "true";
                } catch {
                    return false;
                }
            }

            function saveSidebarState(isCollapsed) {
                try {
                    localStorage.setItem(
                        sidebarStorageKey,
                        isCollapsed.toString()
                    );
                } catch {
                    // Menu vẫn hoạt động khi trình duyệt chặn lưu trữ.
                }
            }

            function closeMobileSidebar() {
                sidebar?.classList.remove("is-open");
                backdrop?.classList.remove("is-visible");

                if (isMobile()) {
                    menuToggle?.setAttribute("aria-expanded", "false");
                    menuToggle?.setAttribute("aria-label", "Mở menu");
                }
            }

            function updateDesktopSidebar() {
                sidebar?.classList.remove("is-open");
                backdrop?.classList.remove("is-visible");

                if (isMobile()) {
                    document.body.classList.remove(
                        "admin-sidebar-collapsed"
                    );

                    closeMobileSidebar();
                    return;
                }

                const isCollapsed = getSavedSidebarState();

                document.body.classList.toggle(
                    "admin-sidebar-collapsed",
                    isCollapsed
                );

                menuToggle?.setAttribute(
                    "aria-expanded",
                    (!isCollapsed).toString()
                );

                menuToggle?.setAttribute(
                    "aria-label",
                    isCollapsed ? "Mở rộng menu" : "Thu gọn menu"
                );
            }

            menuToggle?.addEventListener("click", function () {
                if (isMobile()) {
                    const isOpen =
                        sidebar?.classList.toggle("is-open") ?? false;

                    backdrop?.classList.toggle("is-visible", isOpen);

                    menuToggle.setAttribute(
                        "aria-expanded",
                        isOpen.toString()
                    );

                    menuToggle.setAttribute(
                        "aria-label",
                        isOpen ? "Đóng menu" : "Mở menu"
                    );

                    return;
                }

                const isCollapsed =
                    !document.body.classList.contains(
                        "admin-sidebar-collapsed"
                    );

                document.body.classList.toggle(
                    "admin-sidebar-collapsed",
                    isCollapsed
                );

                saveSidebarState(isCollapsed);

                menuToggle.setAttribute(
                    "aria-expanded",
                    (!isCollapsed).toString()
                );

                menuToggle.setAttribute(
                    "aria-label",
                    isCollapsed ? "Mở rộng menu" : "Thu gọn menu"
                );
            });

            backdrop?.addEventListener("click", closeMobileSidebar);

            sidebar?.querySelectorAll("a").forEach(function (link) {
                link.addEventListener("click", function () {
                    if (isMobile()) {
                        closeMobileSidebar();
                    }
                });
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape" && isMobile()) {
                    closeMobileSidebar();
                }
            });

            window.addEventListener("resize", updateDesktopSidebar);

            updateDesktopSidebar();

            // =====================================
            // CẬP NHẬT THÔNG BÁO NHÂN VIÊN
            // =====================================

            let isFetchingNotificationCounts = false;

            const notificationCountsUrl =
                '@Url.Action("GetNotificationCounts", "Order", new { area = "Staff" })';

            async function fetchNotificationCounts() {
                if (isFetchingNotificationCounts || document.hidden) {
                    return;
                }

                isFetchingNotificationCounts = true;

                try {
                    const response = await fetch(notificationCountsUrl, {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        },
                        cache: "no-store"
                    });

                    if (!response.ok) {
                        throw new Error(
                            "Không thể lấy số lượng thông báo: " +
                            response.status
                        );
                    }

                    const data = await response.json();

                    const notifications = [
                        { key: "returns", value: data.returnCount, elementId: "headerReturnCount" },
                        { key: "orders", value: data.pendingOrderCount, elementId: "headerPendingOrderCount" },
                        { key: "stock", value: data.lowStockCount, elementId: "headerLowStockCount" }
                    ];

                    let totalCount = 0;

                    notifications.forEach(function (notification) {
                        const rawCount = Number(notification.value);
                        if (!Number.isFinite(rawCount) || rawCount < 0) {
                            throw new Error("Số lượng thông báo không hợp lệ.");
                        }

                        const count = Math.floor(rawCount);
                        totalCount += count;

                        const countElement = document.getElementById(notification.elementId);
                        const notificationElement = document.querySelector(
                            '[data-notification="' + notification.key + '"]'
                        );

                        if (countElement) {
                            countElement.textContent = count > 99 ? "99+" : count.toString();
                        }

                        if (notificationElement) {
                            notificationElement.hidden = count === 0;
                        }
                    });

                    const badge = document.getElementById("headerNotificationBadge");
                    if (badge) {
                        badge.textContent = totalCount > 99 ? "99+" : totalCount.toString();
                        badge.style.display = totalCount > 0 ? "flex" : "none";
                    }

                    const toggle = document.getElementById("staffNotificationToggle");
                    toggle?.setAttribute(
                        "aria-label",
                        totalCount > 0
                            ? "Mở thông báo, có " + totalCount + " mục cần xử lý"
                            : "Mở thông báo, không có mục cần xử lý"
                    );

                    const hasNotifications = totalCount > 0;
                    const emptyMessage = document.getElementById("staffNotificationEmpty");
                    if (emptyMessage) {
                        emptyMessage.style.display = hasNotifications ? "none" : "block";
                    }
                } catch (error) {
                    console.error(
                        "Lỗi lấy số lượng thông báo:",
                        error
                    );
                } finally {
                    isFetchingNotificationCounts = false;
                }
            }

            fetchNotificationCounts();
            setInterval(fetchNotificationCounts, 10000);

            document.addEventListener("visibilitychange", function () {
                if (!document.hidden) {
                    fetchNotificationCounts();
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>