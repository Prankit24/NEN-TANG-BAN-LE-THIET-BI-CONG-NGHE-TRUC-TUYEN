@{
    var displayName = User.Identity?.Name ?? "Nhân viên";
    var avatarLetter = string.IsNullOrWhiteSpace(displayName)
        ? "N"
        : displayName[..1].ToUpperInvariant();

    var currentController = ViewContext.RouteData.Values["Controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - EMUA Nhân viên</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet"
          href="~/css/admin/admin-layout.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/staff/staff.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/css/admin/admin-layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/staff/staff.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <div class="admin-shell staff-shell">
        <div class="admin-sidebar-backdrop"
             id="staffSidebarBackdrop"></div>

        <aside class="admin-sidebar staff-sidebar"
               id="staffSidebar">
            <a asp-area="Staff"
               asp-controller="Dashboard"
               asp-action="Index"
               class="admin-logo"
               title="EMUA Nhân viên">
                <span class="admin-logo-text">
                    <strong>EMUA</strong>
                    <small>Nhân viên</small>
                </span>
                <span class="admin-logo-mini">EM</span>
            </a>

            <nav class="admin-nav">
                <span class="admin-nav-label">Tổng quan</span>

                <a class="@(currentController == "Dashboard" ? "active" : "")"
                   data-tooltip="Tổng quan"
                   asp-area="Staff"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Tổng quan</span>
                </a>

                <span class="admin-nav-label">Quản lý bán hàng</span>

                <a class="@(currentController == "Product" ? "active" : "")"
                   data-tooltip="Sản phẩm"
                   asp-area="Staff"
                   asp-controller="Product"
                   asp-action="Index">
                    <i class="bi bi-box-seam"></i>
                    <span>Sản phẩm</span>
                </a>

                <a class="@(currentController == "Order" ? "active" : "")"
                   data-tooltip="Đơn hàng"
                   asp-area="Staff"
                   asp-controller="Order"
                   asp-action="Index">
                    <i class="bi bi-receipt"></i>
                    <span>Đơn hàng</span>
                </a>

                <a class="@(currentController == "Promotion" ? "active" : "")"
                   data-tooltip="Khuyến mãi"
                   asp-area="Staff"
                   asp-controller="Promotion"
                   asp-action="Index">
                    <i class="bi bi-ticket-perforated"></i>
                    <span>Khuyến mãi</span>
                </a>

                <a class="@(currentController == "Invoice" ? "active" : "")"
                   data-tooltip="Hóa đơn"
                   asp-area="Staff"
                   asp-controller="Invoice"
                   asp-action="Index">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Hóa đơn</span>
                </a>

                <a class="@(currentController == "Report" ? "active" : "")"
                   data-tooltip="Báo cáo"
                   asp-area="Staff"
                   asp-controller="Report"
                   asp-action="Index">
                    <i class="bi bi-bar-chart"></i>
                    <span>Báo cáo thống kê</span>
                </a>

                <span class="admin-nav-label">Tài khoản</span>

                <a class="@(currentController == "Profile" ? "active" : "")"
                   data-tooltip="Cài đặt"
                   asp-area="Staff"
                   asp-controller="Profile"
                   asp-action="Index">
                    <i class="bi bi-gear"></i>
                    <span>Cài đặt</span>
                </a>
            </nav>

            <div class="admin-sidebar-bottom">
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="admin-bottom-link"
                   data-tooltip="Xem website">
                    <i class="bi bi-eye"></i>
                    <span>Xem website</span>
                </a>

                <form asp-area=""
                      asp-controller="Auth"
                      asp-action="Logout"
                      method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="admin-bottom-link logout"
                            data-tooltip="Đăng xuất">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </div>
        </aside>

        <main class="admin-main">
            <header class="admin-header">
                <div class="admin-header-left">
                    <button type="button"
                            class="admin-menu-toggle"
                            id="staffMenuToggle"
                            aria-label="Thu gọn menu"
                            aria-controls="staffSidebar"
                            aria-expanded="true">
                        <i class="bi bi-list"></i>
                    </button>

                    <div>
                        <h1>@ViewData["Title"]</h1>
                        <p>EMUA Nhân viên — @DateTime.Now.ToString("dd/MM/yyyy")</p>
                    </div>
                </div>

                <div class="admin-header-actions staff-header-actions">
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       class="admin-header-link"
                       title="Xem website">
                        <i class="bi bi-house-door"></i>
                        <span>Trang chủ</span>
                    </a>

                    <button type="button"
                            class="admin-header-link"
                            title="Thông báo">
                        <i class="bi bi-bell"></i>
                        <span>Thông báo</span>
                    </button>

                    <div class="admin-user" title="@displayName">
                        <div class="admin-avatar">@avatarLetter</div>
                        <span class="staff-user-name">@displayName</span>
                        <i class="bi bi-chevron-down"></i>
                    </div>
                </div>
            </header>

            <section class="admin-content staff-content">
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="alert alert-success staff-alert">@successMessage</div>
                }

                @RenderBody()
            </section>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const sidebar = document.getElementById("staffSidebar");
        const backdrop = document.getElementById("staffSidebarBackdrop");
        const menuToggle = document.getElementById("staffMenuToggle");

        const desktopBreakpoint = 850;
        const sidebarStorageKey = "emua_staff_sidebar_collapsed";

        function isMobile() {
            return window.innerWidth <= desktopBreakpoint;
        }

        function closeMobileSidebar() {
            sidebar?.classList.remove("is-open");
            backdrop?.classList.remove("is-visible");
        }

        function updateDesktopSidebar() {
            if (isMobile()) {
                document.body.classList.remove("admin-sidebar-collapsed");
                closeMobileSidebar();
                return;
            }

            const isCollapsed =
                localStorage.getItem(sidebarStorageKey) === "true";

            document.body.classList.toggle(
                "admin-sidebar-collapsed",
                isCollapsed
            );

            menuToggle?.setAttribute(
                "aria-expanded",
                (!isCollapsed).toString()
            );

            menuToggle?.setAttribute(
                "aria-label",
                isCollapsed ? "Mở rộng menu" : "Thu gọn menu"
            );
        }

        menuToggle?.addEventListener("click", function () {
            if (isMobile()) {
                const isOpen = sidebar?.classList.toggle("is-open");
                backdrop?.classList.toggle("is-visible", !!isOpen);
                return;
            }

            const isCollapsed =
                !document.body.classList.contains("admin-sidebar-collapsed");

            document.body.classList.toggle(
                "admin-sidebar-collapsed",
                isCollapsed
            );

            localStorage.setItem(
                sidebarStorageKey,
                isCollapsed.toString()
            );

            menuToggle.setAttribute(
                "aria-expanded",
                (!isCollapsed).toString()
            );

            menuToggle.setAttribute(
                "aria-label",
                isCollapsed ? "Mở rộng menu" : "Thu gọn menu"
            );
        });

        backdrop?.addEventListener("click", closeMobileSidebar);

        window.addEventListener("resize", updateDesktopSidebar);
        updateDesktopSidebar();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
