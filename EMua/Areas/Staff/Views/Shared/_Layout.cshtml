@{
    var displayName = User.Identity?.Name ?? "Nhân viên";

    var avatarLetter = string.IsNullOrWhiteSpace(displayName)
        ? "N"
        : displayName[..1].ToUpperInvariant();

    var currentController =
        ViewContext.RouteData.Values["Controller"]?.ToString();

    var currentStatusFilter =
        Context.Request.Query["status"].ToString();

    var isReturnPage =
        currentController == "Order" &&
        currentStatusFilter == "Yêu cầu đổi trả";
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - EMUA Nhân viên</title>

    <link rel="icon"
          type="image/png"
          href="~/images/logo/chicken.png"
          asp-append-version="true" />

    <link rel="apple-touch-icon"
          href="~/images/logo/chicken.png"
          asp-append-version="true" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/admin/admin-layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/staff/staff.css"
          asp-append-version="true" />

    <style>
        /* =========================================
           HỆ THỐNG THIẾT KẾ ĐỒNG BỘ EMUA (ADMIN & STAFF)
           Sidebar: #141827 | Nền: #F4F6FA | Thẻ: #FFFFFF | Điểm nhấn: #315EFB
        ========================================= */

        html,
        body {
            min-height: 100%;
            background: #f4f6fa;
            color: #26344c;
            font-family: "Inter", sans-serif;
            -webkit-font-smoothing: antialiased;
        }

        body {
            margin: 0;
        }

        .staff-shell {
            --staff-bg: #f4f6fa;
            --staff-sidebar: #141827;
            --staff-surface: #ffffff;
            --staff-border: #e5eaf2;
            --staff-text: #26344c;
            --staff-muted: #7b879a;
            --staff-blue: #315efb;
            --staff-blue-hover: #244bd6;
            min-height: 100vh;
            background: var(--staff-bg);
            color: var(--staff-text);
        }

        .staff-shell .admin-main,
        .staff-shell .staff-content {
            min-width: 0;
            background: var(--staff-bg);
            color: var(--staff-text);
        }

        /* SIDEBAR (ĐỒNG BỘ ADMIN: #141827) */
        .staff-shell .staff-sidebar {
            background: #141827;
            border-right: 1px solid #252c3e;
            color: #c3cce0;
            box-shadow: none;
        }

        .staff-shell .staff-brand {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 104px;
            padding: 18px 22px;
            background: transparent;
            border-bottom: 1px solid #252c3e;
            text-decoration: none;
        }

        .staff-brand .admin-logo-text {
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 6px;
            min-width: 0;
        }

        .staff-brand .staff-brand-wordmark {
            display: block;
            width: 156px;
            max-width: 100%;
            height: 56px;
            object-fit: contain;
            background: transparent;
            border: 0;
            border-radius: 0 !important;
            box-shadow: none;
        }

        .staff-brand .admin-logo-text small {
            margin: 0;
            color: #8795b0;
            font-size: 11px;
            font-weight: 600;
            line-height: 1.4;
            letter-spacing: 1.2px;
            text-transform: uppercase;
        }

        .staff-brand .admin-logo-mini {
            display: none;
            align-items: center;
            justify-content: center;
            background: transparent;
            border: 0;
            box-shadow: none;
        }

        .staff-brand .staff-brand-icon {
            display: block;
            width: 36px;
            height: 36px;
            object-fit: contain;
            background: transparent;
            border: 0;
            border-radius: 0 !important;
            box-shadow: none;
        }

        body.admin-sidebar-collapsed .staff-brand .admin-logo-text {
            display: none;
        }

        body.admin-sidebar-collapsed .staff-brand .admin-logo-mini {
            display: flex;
        }

        body.admin-sidebar-collapsed .staff-shell .staff-brand {
            padding: 18px 8px;
        }

        /* MENU SIDEBAR */
        .staff-shell .admin-nav-label {
            display: block;
            margin: 18px 0 5px;
            padding: 0 12px;
            color: #8795b0;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: .8px;
            text-transform: uppercase;
        }

        .staff-shell .admin-nav-label:first-child {
            margin-top: 0;
        }

        .staff-shell .admin-nav > a {
            display: flex;
            align-items: center;
            gap: 12px;
            min-height: 44px;
            padding: 11px 13px;
            background: transparent;
            color: #bdc8dd;
            border-radius: 0 !important;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            transition: background .18s ease, color .18s ease;
        }

        .staff-shell .admin-nav > a > i {
            width: 20px;
            font-size: 17px;
            color: #91a3c5;
            text-align: center;
        }

        .staff-shell .admin-nav > a:hover {
            background: #202a42;
            color: #fff;
        }

        .staff-shell .admin-nav > a:hover > i {
            color: #bfd0ff;
        }

        .staff-shell .admin-nav > a.active {
            background: #263555;
            color: #d3deff;
            box-shadow: inset 3px 0 0 #315efb;
            font-weight: 600;
        }

        .staff-shell .admin-nav > a.active > i {
            color: #8bb2ff;
        }

        .staff-shell .admin-sidebar-bottom {
            margin-top: auto;
            padding: 12px 14px;
            background: #141827;
            border-top: 1px solid #252c3e;
        }

        .staff-shell .admin-bottom-link {
            display: flex;
            align-items: center;
            gap: 12px;
            min-height: 42px;
            padding: 10px 13px;
            background: transparent;
            color: #bdc8dd;
            border: 0;
            border-radius: 0 !important;
            font-size: 13px;
            font-weight: 500;
            text-decoration: none;
            cursor: pointer;
            transition: background .18s ease, color .18s ease;
        }

        .staff-shell .admin-bottom-link:hover {
            background: #202a42;
            color: #fff;
        }

        .staff-shell .admin-bottom-link.logout {
            color: #f6a1af;
        }

        .staff-shell .admin-bottom-link.logout:hover {
            background: #34232e;
            color: #ffc0cc;
        }

        /* HEADER (TRẮNG SẠCH: #FFFFFF, BORDER #E5EAF2) */
        .staff-shell .admin-header {
            position: sticky;
            top: 0;
            z-index: 1020;
            display: flex;
            min-height: 84px;
            align-items: center;
            justify-content: space-between;
            gap: 20px;
            padding: 16px 28px;
            border-bottom: 1px solid #e5eaf2;
            background: #ffffff;
            color: #26344c;
            box-shadow: none;
        }

        .staff-shell .admin-header-left {
            display: flex;
            min-width: 0;
            align-items: center;
            gap: 16px;
        }

        .staff-shell .admin-header h1 {
            margin: 0 0 5px;
            color: #26344c;
            font-size: 18px;
            font-weight: 700;
            line-height: 1.4;
            letter-spacing: -.5px;
        }

        .staff-shell .admin-header p {
            margin: 0;
            color: #7b879a;
            font-size: 11px;
            line-height: 1.5;
        }

        .staff-shell .staff-header-actions {
            display: flex;
            flex-shrink: 0;
            align-items: center;
            gap: 10px;
        }

        .staff-shell .admin-menu-toggle {
            display: grid;
            box-sizing: border-box;
            width: 38px;
            height: 38px;
            flex-shrink: 0;
            place-items: center;
            padding: 0;
            border: 1px solid #e2e8f1;
            border-radius: 0 !important;
            background: #ffffff;
            color: #66758e;
            font-size: 21px;
            cursor: pointer;
            transition: all .18s ease;
        }

        .staff-shell .admin-header-link {
            display: inline-flex;
            box-sizing: border-box;
            min-height: 37px;
            align-items: center;
            justify-content: center;
            gap: 7px;
            padding: 8px 12px;
            border: 1px solid #e5eaf2;
            border-radius: 0 !important;
            background: #ffffff;
            color: #71809a;
            font-size: 11px;
            font-weight: 500;
            line-height: 1.4;
            text-decoration: none;
            cursor: pointer;
            transition: all .18s ease;
        }

        .staff-shell .admin-menu-toggle:hover,
        .staff-shell .admin-header-link:hover,
        .staff-shell .staff-notification:hover {
            border-color: #cad7fa;
            background: #f0f4ff;
            color: #315efb;
        }

        /* THÔNG BÁO ĐỔI TRẢ */
        .staff-notification {
            position: relative;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 37px;
            height: 37px;
            flex-shrink: 0;
            border: 1px solid #e5eaf2;
            border-radius: 0 !important;
            background: #ffffff;
            color: #71809a;
            text-decoration: none;
            transition: all .18s ease;
        }

        .staff-notification > i {
            font-size: 17px;
        }

        .staff-notification-badge {
            position: absolute;
            top: -5px;
            right: -5px;
            display: flex;
            align-items: center;
            justify-content: center;
            min-width: 18px;
            height: 18px;
            padding: 0 4px;
            border: 2px solid #ffffff;
            border-radius: 0 !important;
            background: #ef4444;
            color: #fff;
            font-size: 10px;
            font-weight: 800;
            line-height: 1;
        }

        /* TÀI KHOẢN */
        .staff-shell .admin-user {
            display: flex;
            min-width: 0;
            align-items: center;
            gap: 10px;
            margin-left: 6px;
            padding: 0 0 0 14px;
            border-left: 1px solid #e5eaf2;
            background: transparent;
            color: #34435b;
        }

        .staff-shell .admin-avatar {
            display: grid;
            box-sizing: border-box;
            width: 37px;
            height: 37px;
            flex-shrink: 0;
            place-items: center;
            border: 1px solid #dbe5ff;
            border-radius: 0 !important;
            background: #edf2ff;
            color: #315efb;
            font-size: 13px;
            font-weight: 700;
            box-shadow: none;
        }

        .staff-shell .staff-user-name {
            display: block;
            max-width: 160px;
            overflow: hidden;
            color: #34435b;
            font-size: 12px;
            font-weight: 600;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        .staff-shell .admin-user > i {
            color: #8c98ac;
            font-size: 11px;
        }

        /* NỘI DUNG */
        .staff-shell .admin-content {
            min-width: 0;
            padding: 28px;
            background: #f4f6fa;
            color: #26344c;
        }

        .staff-shell .staff-alert.alert-success {
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
            color: #065f46;
            border-radius: 0 !important;
        }

        /* FOCUS OUTLINE */
        .staff-shell a:focus-visible,
        .staff-shell button:focus-visible,
        .staff-shell input:focus-visible,
        .staff-shell select:focus-visible {
            outline: 2px solid #315efb;
            outline-offset: 2px;
        }

        /* RESPONSIVE */
        @@media (max-width: 850px) {
            .staff-shell .admin-header {
                padding: 14px 18px;
                min-height: 72px;
            }

            .staff-shell .admin-content {
                padding: 18px 14px;
            }

            .staff-shell .admin-header h1 {
                font-size: 17px;
            }

            .staff-shell .staff-user-name {
                max-width: 100px;
            }
        }

        @@media (max-width: 576px) {
            .staff-shell .admin-header {
                gap: 10px;
                padding: 12px 14px;
            }

            .staff-shell .admin-header h1 {
                font-size: 15px;
            }

            .staff-shell .admin-header p {
                font-size: 10px;
            }

            .staff-shell .staff-header-actions {
                gap: 6px;
            }

            .staff-shell .admin-header-link span,
            .staff-shell .staff-user-name {
                display: none;
            }

            .staff-shell .admin-user > i {
                display: none;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            .staff-shell a,
            .staff-shell button {
                transition: none;
            }
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="emua-staff">
    <div class="admin-shell staff-shell">

        <!-- BACKDROP MENU ĐIỆN THOẠI -->
        <div class="admin-sidebar-backdrop"
             id="staffSidebarBackdrop"></div>

        <!-- SIDEBAR -->
        <aside class="admin-sidebar staff-sidebar"
               id="staffSidebar">

            <!-- LOGO -->
            <a asp-area="Staff"
               asp-controller="Dashboard"
               asp-action="Index"
               class="admin-logo staff-brand"
               title="EMUA Nhân viên">

                <span class="admin-logo-text">
                    <img src="~/images/logo/icon-logo.png"
                         asp-append-version="true"
                         alt="EMUA"
                         class="staff-brand-wordmark" />

                    <small>Nhân viên</small>
                </span>

                <span class="admin-logo-mini">
                    <img src="~/images/logo/icon-logo-v2.png"
                         asp-append-version="true"
                         alt="EMUA"
                         class="staff-brand-icon" />
                </span>
            </a>

            <!-- MENU -->
            <nav class="admin-nav" aria-label="Menu nhân viên">

                <span class="admin-nav-label">Tổng quan</span>

                <a class="@(currentController == "Dashboard" ? "active" : "")"
                   data-tooltip="Tổng quan"
                   asp-area="Staff"
                   asp-controller="Dashboard"
                   asp-action="Index">
                    <i class="bi bi-grid-1x2"></i>
                    <span>Tổng quan</span>
                </a>

                <span class="admin-nav-label">
                    Quản lý bán hàng
                </span>

                <a class="@(currentController == "Product" ? "active" : "")"
                   data-tooltip="Sản phẩm"
                   asp-area="Staff"
                   asp-controller="Product"
                   asp-action="Index">
                    <i class="bi bi-box-seam"></i>
                    <span>Sản phẩm</span>
                </a>

                <a class="@(currentController == "Order" && !isReturnPage ? "active" : "")"
                   data-tooltip="Đơn hàng"
                   asp-area="Staff"
                   asp-controller="Order"
                   asp-action="Index">
                    <i class="bi bi-receipt"></i>
                    <span>Tất cả đơn hàng</span>
                </a>

                <a class="@(currentController == "Promotion" ? "active" : "")"
                   data-tooltip="Khuyến mãi"
                   asp-area="Staff"
                   asp-controller="Promotion"
                   asp-action="Index">
                    <i class="bi bi-ticket-perforated"></i>
                    <span>Khuyến mãi</span>
                </a>

                <a class="@(currentController == "Invoice" ? "active" : "")"
                   data-tooltip="Hóa đơn"
                   asp-area="Staff"
                   asp-controller="Invoice"
                   asp-action="Index">
                    <i class="bi bi-file-earmark-text"></i>
                    <span>Hóa đơn</span>
                </a>

                <a class="@(currentController == "Report" ? "active" : "")"
                   data-tooltip="Báo cáo"
                   asp-area="Staff"
                   asp-controller="Report"
                   asp-action="Index">
                    <i class="bi bi-bar-chart"></i>
                    <span>Báo cáo thống kê</span>
                </a>

                <span class="admin-nav-label">Tài khoản</span>

                <a class="@(currentController == "Profile" ? "active" : "")"
                   data-tooltip="Cài đặt"
                   asp-area="Staff"
                   asp-controller="Profile"
                   asp-action="Index">
                    <i class="bi bi-gear"></i>
                    <span>Cài đặt</span>
                </a>
            </nav>

            <!-- MENU DƯỚI -->
            <div class="admin-sidebar-bottom">
                <a asp-area=""
                   asp-controller="Home"
                   asp-action="Index"
                   class="admin-bottom-link"
                   data-tooltip="Xem website">
                    <i class="bi bi-eye"></i>
                    <span>Xem website</span>
                </a>

                <form asp-area=""
                      asp-controller="Auth"
                      asp-action="Logout"
                      method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="admin-bottom-link logout"
                            data-tooltip="Đăng xuất">
                        <i class="bi bi-box-arrow-right"></i>
                        <span>Đăng xuất</span>
                    </button>
                </form>
            </div>
        </aside>

        <!-- NỘI DUNG CHÍNH -->
        <main class="admin-main">

            <!-- HEADER -->
            <header class="admin-header">
                <div class="admin-header-left">
                    <button type="button"
                            class="admin-menu-toggle"
                            id="staffMenuToggle"
                            aria-label="Thu gọn menu"
                            aria-controls="staffSidebar"
                            aria-expanded="true">
                        <i class="bi bi-list"></i>
                    </button>

                    <div>
                        <h1>@ViewData["Title"]</h1>
                        <p>
                            EMUA Nhân viên —
                            @DateTime.Now.ToString("dd/MM/yyyy")
                        </p>
                    </div>
                </div>

                <div class="admin-header-actions staff-header-actions">
                    <a asp-area=""
                       asp-controller="Home"
                       asp-action="Index"
                       class="admin-header-link"
                       title="Xem website">
                        <i class="bi bi-house-door"></i>
                        <span>Trang chủ</span>
                    </a>

                    <!-- THÔNG BÁO ĐỔI TRẢ -->
                    <a asp-area="Staff"
                       asp-controller="Order"
                       asp-action="Index"
                       asp-route-status="Yêu cầu đổi trả"
                       class="staff-notification"
                       title="Yêu cầu đổi trả đang chờ xử lý"
                       aria-label="Thông báo đổi trả">
                        <i class="bi bi-bell"></i>

                        <span class="staff-notification-badge"
                              id="headerReturnBadge"
                              style="display: none;">0</span>
                    </a>

                    <!-- TÀI KHOẢN -->
                    <div class="admin-user" title="@displayName">
                        <div class="admin-avatar">
                            @avatarLetter
                        </div>

                        <span class="staff-user-name">
                            @displayName
                        </span>

                        <i class="bi bi-chevron-down"></i>
                    </div>
                </div>
            </header>

            <!-- NỘI DUNG TỪNG TRANG -->
            <section class="admin-content staff-content">
                @if (TempData["Success"] is string successMessage)
                {
                    <div class="alert alert-success staff-alert"
                         role="status">
                        @successMessage
                    </div>
                }

                @RenderBody()
            </section>
        </main>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        (function () {
            const sidebar = document.getElementById("staffSidebar");
            const backdrop = document.getElementById("staffSidebarBackdrop");
            const menuToggle = document.getElementById("staffMenuToggle");

            const desktopBreakpoint = 850;
            const sidebarStorageKey = "emua_staff_sidebar_collapsed";

            function isMobile() {
                return window.innerWidth <= desktopBreakpoint;
            }

            function getSavedSidebarState() {
                try {
                    return localStorage.getItem(sidebarStorageKey) === "true";
                } catch {
                    return false;
                }
            }

            function saveSidebarState(isCollapsed) {
                try {
                    localStorage.setItem(
                        sidebarStorageKey,
                        isCollapsed.toString()
                    );
                } catch {
                    // Menu vẫn hoạt động khi trình duyệt chặn lưu trữ.
                }
            }

            function closeMobileSidebar() {
                sidebar?.classList.remove("is-open");
                backdrop?.classList.remove("is-visible");

                if (isMobile()) {
                    menuToggle?.setAttribute("aria-expanded", "false");
                    menuToggle?.setAttribute("aria-label", "Mở menu");
                }
            }

            function updateDesktopSidebar() {
                sidebar?.classList.remove("is-open");
                backdrop?.classList.remove("is-visible");

                if (isMobile()) {
                    document.body.classList.remove(
                        "admin-sidebar-collapsed"
                    );

                    closeMobileSidebar();
                    return;
                }

                const isCollapsed = getSavedSidebarState();

                document.body.classList.toggle(
                    "admin-sidebar-collapsed",
                    isCollapsed
                );

                menuToggle?.setAttribute(
                    "aria-expanded",
                    (!isCollapsed).toString()
                );

                menuToggle?.setAttribute(
                    "aria-label",
                    isCollapsed ? "Mở rộng menu" : "Thu gọn menu"
                );
            }

            menuToggle?.addEventListener("click", function () {
                if (isMobile()) {
                    const isOpen =
                        sidebar?.classList.toggle("is-open") ?? false;

                    backdrop?.classList.toggle("is-visible", isOpen);

                    menuToggle.setAttribute(
                        "aria-expanded",
                        isOpen.toString()
                    );

                    menuToggle.setAttribute(
                        "aria-label",
                        isOpen ? "Đóng menu" : "Mở menu"
                    );

                    return;
                }

                const isCollapsed =
                    !document.body.classList.contains(
                        "admin-sidebar-collapsed"
                    );

                document.body.classList.toggle(
                    "admin-sidebar-collapsed",
                    isCollapsed
                );

                saveSidebarState(isCollapsed);

                menuToggle.setAttribute(
                    "aria-expanded",
                    (!isCollapsed).toString()
                );

                menuToggle.setAttribute(
                    "aria-label",
                    isCollapsed ? "Mở rộng menu" : "Thu gọn menu"
                );
            });

            backdrop?.addEventListener("click", closeMobileSidebar);

            sidebar?.querySelectorAll("a").forEach(function (link) {
                link.addEventListener("click", function () {
                    if (isMobile()) {
                        closeMobileSidebar();
                    }
                });
            });

            document.addEventListener("keydown", function (event) {
                if (event.key === "Escape" && isMobile()) {
                    closeMobileSidebar();
                }
            });

            window.addEventListener("resize", updateDesktopSidebar);

            updateDesktopSidebar();

            // =====================================
            // ĐẾM YÊU CẦU ĐỔI TRẢ
            // =====================================

            let isFetchingReturnCount = false;

            const returnCountUrl =
                '@Url.Action("GetPendingReturnCount", "Order", new { area = "Staff" })';

            async function fetchReturnCount() {
                if (isFetchingReturnCount || document.hidden) {
                    return;
                }

                isFetchingReturnCount = true;

                try {
                    const response = await fetch(returnCountUrl, {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        },
                        cache: "no-store"
                    });

                    if (!response.ok) {
                        throw new Error(
                            "Không thể lấy số lượng đơn đổi trả: " +
                            response.status
                        );
                    }

                    const data = await response.json();
                    const rawCount = Number(data.count);

                    if (!Number.isFinite(rawCount)) {
                        throw new Error(
                            "Số lượng đơn trả về không hợp lệ."
                        );
                    }

                    const count = Math.max(0, Math.floor(rawCount));
                    const headerBadge =
                        document.getElementById("headerReturnBadge");

                    if (headerBadge) {
                        headerBadge.textContent =
                            count > 99 ? "99+" : count.toString();

                        headerBadge.style.display =
                            count > 0 ? "flex" : "none";

                        headerBadge.parentElement?.setAttribute(
                            "aria-label",
                            count > 0
                                ? count + " yêu cầu đổi trả đang chờ xử lý"
                                : "Không có yêu cầu đổi trả đang chờ xử lý"
                        );
                    }
                } catch (error) {
                    console.error(
                        "Lỗi lấy số lượng đơn đổi trả:",
                        error
                    );
                } finally {
                    isFetchingReturnCount = false;
                }
            }

            fetchReturnCount();
            setInterval(fetchReturnCount, 10000);

            document.addEventListener("visibilitychange", function () {
                if (!document.hidden) {
                    fetchReturnCount();
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>