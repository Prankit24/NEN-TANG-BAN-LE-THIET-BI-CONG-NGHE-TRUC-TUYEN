@model StaffDashboardViewModel

@{
    ViewData["Title"] = "Tổng quan công việc";

    var monthNames = new[]
    {
        "T1", "T2", "T3", "T4", "T5", "T6",
        "T7", "T8", "T9", "T10", "T11", "T12"
    };
}

@section Styles {
    <style>
        .emua-dashboard {
            --dash-blue: #315efb;
            --dash-text: #0f172a;
            --dash-muted: #64748b;
            --dash-border: #e2e8f0;
            color: var(--dash-text);
            margin: 0;
            padding: 0;
            display: flow-root;
        }

        /* Không để các margin mặc định của layout kéo giãn đầu trang */
        .staff-content:has(> .emua-dashboard) {
            padding-top: 12px;
        }

        .emua-dashboard > :first-child {
            margin-top: 0 !important;
        }

        .dash-urgent-card,
        .dash-period,
        .dash-kpi,
        .dash-panel,
        .dash-stock-item {
            border-radius: 0 !important;
            box-shadow: none !important;
        }

            .dash-kpi-icon,
            .dash-period-icon,
            .dash-period button {
                border-radius: 0 !important;
            }

        /* KHỐI CÔNG VIỆC CẦN XỬ LÝ NGAY */
        .dash-urgent-grid {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 14px;
        }

        .dash-urgent-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 16px;
            background: #fff;
            border: 1px solid #e4eaf3;
            text-decoration: none;
            color: inherit;
            transition: all .2s ease;
        }

            .dash-urgent-card:hover {
                border-color: #b7c9ff;
                background: #fafcff;
            }

            .dash-urgent-card.warning {
                border-left: 4px solid #f59e0b;
            }

            .dash-urgent-card.danger {
                border-left: 4px solid #ef4444;
            }

            .dash-urgent-card.primary {
                border-left: 4px solid #315efb;
            }

        .dash-urgent-title {
            display: block;
            font-size: 13px;
            color: #64748b;
            margin-bottom: 4px;
            font-weight: 600;
        }

        .dash-urgent-count {
            display: block;
            font-size: 26px;
            font-weight: 800;
            color: #0f172a;
        }

        .dash-urgent-action {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: 12px;
            color: #315efb;
            font-weight: 600;
        }

        /* BỘ LỌC THÁNG */
        .dash-topbar {
            display: flex;
            justify-content: flex-start;
            align-items: center;
            min-height: 40px;
            margin: 0 0 10px;
            padding: 0;
            border: 0;
            background: transparent;
        }

        .dash-period {
            display: flex;
            align-items: center;
            flex-wrap: wrap;
            justify-content: flex-start;
            gap: 8px;
            margin: 0;
            padding: 0;
            border: none;
            background: transparent;
            box-shadow: none;
        }

            .dash-period select,
            .dash-period button {
                height: 40px;
                border-radius: 0 !important;
                font-size: 13px;
            }

        .dash-period-icon {
            display: grid;
            width: 36px;
            height: 36px;
            place-items: center;
            background: #eff4ff;
            color: #315efb;
            font-size: 16px;
        }

        .dash-period-field {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: 13px;
            padding: 0;
        }

            .dash-period-field select {
                border: 1px solid #cbd5e1;
                padding: 0 10px;
                font-size: 13px;
                background: #fff;
            }

        .dash-period button {
            border: none;
            background: #315efb;
            color: #fff;
            padding: 0 14px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }

        /* KPIS */
        .dash-kpis {
            display: grid;
            grid-template-columns: repeat(4, minmax(0, 1fr));
            gap: 12px;
            margin-bottom: 14px;
        }

        .dash-kpi {
            background: #fff;
            border: 1px solid #e4eaf3;
            padding: 14px 16px;
        }

        .dash-kpi-top {
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .dash-kpi-label {
            display: block;
            font-size: 12px;
            color: #64748b;
            font-weight: 600;
            margin-bottom: 6px;
        }

        .dash-kpi-value {
            font-size: 22px;
            font-weight: 800;
            color: #0f172a;
        }

        .dash-kpi-icon {
            width: 40px;
            height: 40px;
            display: grid;
            place-items: center;
            background: #eff4ff;
            color: #315efb;
            font-size: 18px;
        }

            .dash-kpi-icon.green {
                background: #ecfdf5;
                color: #10b981;
            }

            .dash-kpi-icon.orange {
                background: #fffbeb;
                color: #f59e0b;
            }

            .dash-kpi-icon.cyan {
                background: #f0fdf4;
                color: #06b6d4;
            }

        .dash-kpi-bottom {
            margin: 12px 0 0;
            font-size: 12px;
            color: #64748b;
        }

        .dash-trend {
            font-weight: 700;
            color: #10b981;
            margin-right: 4px;
        }

            .dash-trend.negative {
                color: #ef4444;
            }

        /* MIDDLE GRIDS */
        .dash-middle {
            display: grid;
            grid-template-columns: minmax(0, 1.8fr) minmax(0, 1fr);
            gap: 12px;
            margin-bottom: 14px;
        }

        .dash-panel {
            background: #fff;
            border: 1px solid #e4eaf3;
        }

        .dash-panel-heading {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 16px;
            border-bottom: 1px solid #edf1f6;
        }

            .dash-panel-heading h3 {
                margin: 0;
                font-size: 15px;
                font-weight: 700;
                color: #1e293b;
            }

            .dash-panel-heading p {
                margin: 2px 0 0;
                font-size: 12px;
                color: #64748b;
            }

        .dash-chart-wrap {
            padding: 12px 16px;
        }

        .dash-chart {
            height: 220px;
        }

        .dash-stock-list {
            padding: 10px 16px;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .dash-stock-item {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 9px 0;
            background: transparent;
            border: 0;
            border-bottom: 1px solid #edf2f7;
            font-size: 13px;
        }

            .dash-stock-item strong {
                display: block;
                color: #1e293b;
            }

            .dash-stock-item small {
                color: #64748b;
            }

        /* ORDERS TABLE */
        .dash-orders-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 13px;
        }

            .dash-orders-table th {
                padding: 11px 14px;
                background: #f8fafc;
                border-bottom: 1px solid #edf1f6;
                color: #64748b;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
            }

            .dash-orders-table td {
                padding: 11px 14px;
                border-bottom: 1px solid #edf1f6;
                vertical-align: middle;
            }

            .dash-orders-table tbody tr:hover td {
                background: #fafcff;
            }

        .dash-status {
            display: inline-block;
            padding: 4px 10px;
            font-size: 11px;
            font-weight: 600;
            background: #f1f5f9;
            color: #334155;
            border: 1px solid #e2e8f0;
        }

        @@media (max-width: 1100px) {
            .dash-kpis {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }
        }

        @@media (max-width: 900px) {
            .dash-urgent-grid {
                grid-template-columns: 1fr;
            }

            .dash-middle {
                grid-template-columns: 1fr;
            }
        }

        @@media (max-width: 560px) {
            .dash-topbar {
                justify-content: flex-start;
            }

            .dash-period {
                justify-content: flex-start;
            }

            .dash-kpis {
                grid-template-columns: 1fr;
            }

            .dash-period-icon {
                display: none;
            }

            .dash-period-field {
                gap: 4px;
            }

            .dash-urgent-card {
                padding: 12px;
            }
        }
    </style>
}

<div class="emua-dashboard">

    <!-- BỘ LỌC KỲ BÁO CÁO -->
    <div class="dash-topbar">
        <form method="get" class="dash-period">
            <span class="dash-period-icon" aria-hidden="true">
                <i class="bi bi-calendar3"></i>
            </span>

            <label class="dash-period-field">
                <span>Tháng</span>
                <select name="month" aria-label="Chọn tháng">
                    @for (var option = 1; option <= 12; option++)
                    {
                        <option value="@option" selected="@(option == Model.SelectedMonth)">@option</option>
                    }
                </select>
            </label>

            <label class="dash-period-field">
                <span>Năm</span>
                <select name="year" aria-label="Chọn năm">
                    @for (var option = Model.SelectedYear - 2; option <= Model.SelectedYear + 1; option++)
                    {
                        <option value="@option" selected="@(option == Model.SelectedYear)">@option</option>
                    }
                </select>
            </label>

            <button type="submit">Áp dụng</button>
        </form>
    </div>

    <!-- 1. ƯU TIÊN: CÔNG VIỆC CẦN XỬ LÝ HÔM NAY -->
    <div class="dash-urgent-grid">
        <a asp-area="Staff" asp-controller="Order" asp-action="Index" asp-route-status="Chờ xử lý" class="dash-urgent-card primary">
            <div>
                <span class="dash-urgent-title"><i class="bi bi-hourglass-split me-1 text-primary"></i> Đơn chờ xác nhận &amp; xử lý</span>
                <strong class="dash-urgent-count">@Model.PendingOrderCount</strong>
            </div>
            <span class="dash-urgent-action">Xử lý ngay <i class="bi bi-arrow-right"></i></span>
        </a>

        <a asp-area="Staff" asp-controller="Order" asp-action="Index" asp-route-status="Yêu cầu đổi trả" class="dash-urgent-card danger">
            <div>
                <span class="dash-urgent-title"><i class="bi bi-arrow-counterclockwise me-1 text-danger"></i> Yêu cầu đổi trả / hoàn tiền</span>
                <strong class="dash-urgent-count text-danger">@Model.ReturnRequestCount</strong>
            </div>
            <span class="dash-urgent-action text-danger">Kiểm tra <i class="bi bi-arrow-right"></i></span>
        </a>

        <a asp-area="Staff" asp-controller="Product" asp-action="Index" class="dash-urgent-card warning">
            <div>
                <span class="dash-urgent-title"><i class="bi bi-exclamation-triangle me-1 text-warning"></i> Biến thể tồn kho &le; 10</span>
                <strong class="dash-urgent-count" style="color: #d97706;">@Model.LowStockCount</strong>
            </div>
            <span class="dash-urgent-action" style="color: #d97706;">Bổ sung <i class="bi bi-arrow-right"></i></span>
        </a>
    </div>

    <!-- 2. THỐNG KÊ DOANH SỐ TRONG THÁNG -->
    <div class="dash-kpis">
        <article class="dash-kpi">
            <div class="dash-kpi-top">
                <div>
                    <span class="dash-kpi-label">Tổng doanh thu</span>
                    <strong class="dash-kpi-value">@Model.Revenue.ToString("N0") <small>đ</small></strong>
                </div>
                <span class="dash-kpi-icon"><i class="bi bi-cash-stack"></i></span>
            </div>
            <p class="dash-kpi-bottom">
                <span class="dash-trend @(Model.RevenueGrowth < 0 ? "negative" : "")">
                    <i class="bi @(Model.RevenueGrowth >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                    @Math.Abs(Model.RevenueGrowth)%
                </span>
                <span>so với tháng trước</span>
            </p>
        </article>

        <article class="dash-kpi">
            <div class="dash-kpi-top">
                <div>
                    <span class="dash-kpi-label">Đơn hàng trong kỳ</span>
                    <strong class="dash-kpi-value">@Model.OrderCount.ToString("N0")</strong>
                </div>
                <span class="dash-kpi-icon green"><i class="bi bi-bag-check"></i></span>
            </div>
            <p class="dash-kpi-bottom">
                <span class="dash-trend @(Model.OrderGrowth < 0 ? "negative" : "")">
                    <i class="bi @(Model.OrderGrowth >= 0 ? "bi-arrow-up-right" : "bi-arrow-down-right")"></i>
                    @Math.Abs(Model.OrderGrowth)%
                </span>
                <span>so với tháng trước</span>
            </p>
        </article>

        <article class="dash-kpi">
            <div class="dash-kpi-top">
                <div>
                    <span class="dash-kpi-label">Sản phẩm đã bán</span>
                    <strong class="dash-kpi-value">@Model.SoldUnits.ToString("N0")</strong>
                </div>
                <span class="dash-kpi-icon orange"><i class="bi bi-box-seam"></i></span>
            </div>
            <p class="dash-kpi-bottom">
                <span>Từ các đơn hoàn thành</span>
            </p>
        </article>

        <article class="dash-kpi">
            <div class="dash-kpi-top">
                <div>
                    <span class="dash-kpi-label">Khách hàng mới</span>
                    <strong class="dash-kpi-value">@Model.NewCustomers.ToString("N0")</strong>
                </div>
                <span class="dash-kpi-icon cyan"><i class="bi bi-person-plus"></i></span>
            </div>
            <p class="dash-kpi-bottom">
                <span>Tài khoản tạo mới trong tháng</span>
            </p>
        </article>
    </div>

    <!-- 3. BIỂU ĐỒ & CẢNH BÁO TỒN KHO -->
    <div class="dash-middle">
        <section class="dash-panel">
            <div class="dash-panel-heading">
                <div>
                    <h3>Biểu đồ doanh thu 12 tháng</h3>
                    <p>Số liệu tổng hợp năm @Model.SelectedYear (VNĐ)</p>
                </div>
            </div>
            <div class="dash-chart-wrap">
                <div class="dash-chart">
                    <canvas id="staffRevenueChart" role="img" aria-label="Biểu đồ doanh thu năm @Model.SelectedYear"></canvas>
                </div>
            </div>
        </section>

        <section class="dash-panel">
            <div class="dash-panel-heading">
                <div>
                    <h3>Mặt hàng sắp hết</h3>
                    <p>Cần ưu tiên liên hệ nhập kho</p>
                </div>
                <a asp-area="Staff" asp-controller="Product" asp-action="Index" class="btn btn-sm btn-outline-primary">Tất cả</a>
            </div>

            <div class="dash-stock-list">
                @if (Model.LowStockItems.Any())
                {
                    @foreach (var item in Model.LowStockItems)
                    {
                        <div class="dash-stock-item">
                            <div>
                                <strong>@item.ProductName</strong>
                                <small>@item.VariantName</small>
                            </div>
                            <span class="badge bg-danger">Còn @item.Quantity</span>
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted text-center py-4 my-0">Tất cả sản phẩm đều có số lượng an toàn (&gt; 10).</p>
                }
            </div>
        </section>
    </div>

    <!-- 4. ĐƠN HÀNG MỚI ĐẶT GẦN ĐÂY -->
    <section class="dash-panel">
        <div class="dash-panel-heading">
            <div>
                <h3>Đơn hàng mới nhất</h3>
                <p>Danh sách 5 đơn hàng vừa được khách đặt trên hệ thống</p>
            </div>
            <a asp-area="Staff" asp-controller="Order" asp-action="Index" class="btn btn-sm btn-outline-primary">Xem tất cả đơn</a>
        </div>

        <div class="table-responsive">
            <table class="dash-orders-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Khách hàng</th>
                        <th>Sản phẩm</th>
                        <th>Thời gian</th>
                        <th>Tổng tiền</th>
                        <th>Trạng thái</th>
                        <th class="text-end">Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model.RecentOrders)
                    {
                        <tr>
                            <td><strong>#DH-@order.OrderId.ToString("D5")</strong></td>
                            <td>
                                <div><strong>@order.CustomerName</strong></div>
                                <small class="text-muted">@(order.CustomerEmail ?? "—")</small>
                            </td>
                            <td>@order.ProductSummary</td>
                            <td>@(order.OrderedAt?.ToString("HH:mm - dd/MM/yyyy") ?? "—")</td>
                            <td><strong class="text-primary">@order.Total.ToString("N0") đ</strong></td>
                            <td><span class="dash-status">@order.Status</span></td>
                            <td class="text-end">
                                <a asp-area="Staff" asp-controller="Order" asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-sm btn-outline-info">
                                    <i class="bi bi-eye"></i> Xử lý
                                </a>
                            </td>
                        </tr>
                    }
                    @if (!Model.RecentOrders.Any())
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">Chưa có đơn hàng nào được ghi nhận.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (() => {
            const canvas = document.getElementById('staffRevenueChart');
            if (!canvas) return;

            const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(monthNames));
            const revenue = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.RevenueByMonth));
            const selectedMonth = @Model.SelectedMonth - 1;
            const formatCurrency = value => new Intl.NumberFormat('vi-VN').format(value) + ' đ';

            new Chart(canvas, {
                type: 'bar',
                data: {
                    labels,
                    datasets: [{
                        label: 'Doanh thu',
                        data: revenue,
                        backgroundColor: labels.map((_, index) =>
                            index === selectedMonth ? '#315efb' : '#cbd5e1'),
                        hoverBackgroundColor: '#1f6feb',
                        borderRadius: 0,
                        maxBarThickness: 38
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: context => ' Doanh thu: ' + formatCurrency(context.parsed.y)
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: {
                                callback: value => {
                                    const amount = Number(value);
                                    if (amount >= 1e9) return (amount / 1e9).toFixed(1) + ' tỷ';
                                    if (amount >= 1e6) return (amount / 1e6).toFixed(0) + ' tr';
                                    if (amount >= 1e3) return (amount / 1e3).toFixed(0) + ' k';
                                    return amount;
                                }
                            },
                            grid: { color: '#f1f5f9' }
                        },
                        x: { grid: { display: false } }
                    }
                }
            });
        })();
    </script>
}
