@model IEnumerable<KhuyenMai>
@{
    ViewData["Title"] = "Quản lý khuyến mãi";
    var totalCount = Model.Count();
    var now = DateTime.Now;
    var activeCount = Model.Count(k => k.TrangThai && (!k.NgayBatDau.HasValue || k.NgayBatDau <= now) && (!k.NgayKetThuc.HasValue || k.NgayKetThuc >= now));
    var upcomingCount = Model.Count(k => k.TrangThai && k.NgayBatDau.HasValue && k.NgayBatDau > now);
    var expiredCount = Model.Count(k => k.NgayKetThuc.HasValue && k.NgayKetThuc < now);
    var disabledCount = Model.Count(k => !k.TrangThai);
}

<style>
    .promo-status-badge {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 3px 8px;
        font-size: 11px;
        font-weight: 600;
    }
    .promo-status-badge.active {
        background: #f0fdf4;
        color: #166534;
        border: 1px solid #bbf7d0;
    }
    .promo-status-badge.upcoming {
        background: #eff6ff;
        color: #1e40af;
        border: 1px solid #bfdbfe;
    }
    .promo-status-badge.expired {
        background: #f1f5f9;
        color: #64748b;
        border: 1px solid #cbd5e1;
    }
    .promo-status-badge.disabled {
        background: #fef2f2;
        color: #991b1b;
        border: 1px solid #fecaca;
    }
    .staff-promo-table th {
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        color: #64748b;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
        padding: 12px 14px;
        white-space: nowrap;
    }
    .staff-promo-table td {
        font-size: 13px;
        vertical-align: middle;
        padding: 12px 14px;
        border-bottom: 1px solid #edf2f7;
    }
</style>

<div class="d-flex align-items-center justify-content-between mb-3 flex-wrap gap-2">
    <div>
        <h4 class="mb-1 fw-bold"><i class="bi bi-ticket-perforated me-2"></i>Chương trình khuyến mãi &amp; Voucher</h4>
        <span class="text-muted small">
            Tổng: <strong>@totalCount</strong> mã | 
            <span class="text-success fw-semibold">Đang áp dụng: @activeCount</span> | 
            <span class="text-primary fw-semibold">Sắp diễn ra: @upcomingCount</span> | 
            <span class="text-muted">Đã hết hạn: @expiredCount</span> | 
            <span class="text-danger">Đã tắt: @disabledCount</span>
        </span>
    </div>
    <div>
        <a class="btn btn-sm btn-primary" asp-action="Create">
            <i class="bi bi-plus-lg me-1"></i> Tạo khuyến mãi mới
        </a>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<form method="get" class="mb-4 bg-white p-3 border">
    <div class="row g-2 align-items-center">
        <div class="col-md-7">
            <input name="q" value="@ViewBag.Search" class="form-control form-control-sm" placeholder="Tìm theo mã code (VD: SALE10) hoặc tên chương trình..." />
        </div>
        <div class="col-md-3">
            <select name="status" class="form-select form-select-sm">
                <option value="all">Tất cả trạng thái kích hoạt</option>
                <option value="active" selected="@(ViewBag.Status == "active")">Đang bật kích hoạt</option>
                <option value="inactive" selected="@(ViewBag.Status == "inactive")">Đã tắt kích hoạt</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-2">
            <button type="submit" class="btn btn-sm btn-primary w-100">
                <i class="bi bi-search me-1"></i> Tìm
            </button>
            @if (!string.IsNullOrWhiteSpace(ViewBag.Search as string) || (ViewBag.Status as string) != "all" && !string.IsNullOrWhiteSpace(ViewBag.Status as string))
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Đặt lại</a>
            }
        </div>
    </div>
</form>

<!-- Bảng khuyến mãi -->
<section class="staff-card bg-white border p-0">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 staff-promo-table">
            <thead>
                <tr>
                    <th style="min-width: 140px;">Mã Voucher</th>
                    <th style="min-width: 220px;">Tên chương trình</th>
                    <th style="min-width: 130px;" class="text-end">Mức giảm</th>
                    <th style="min-width: 150px;">Đơn tối thiểu</th>
                    <th style="min-width: 180px;">Thời gian hiệu lực</th>
                    <th style="min-width: 100px;" class="text-center">Số lượng</th>
                    <th style="min-width: 130px;" class="text-center">Tình trạng</th>
                    <th style="min-width: 110px;" class="text-end">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var isExpired = item.NgayKetThuc.HasValue && item.NgayKetThuc.Value < now;
                    var isUpcoming = item.NgayBatDau.HasValue && item.NgayBatDau.Value > now;
                    var isRunning = item.TrangThai && !isExpired && !isUpcoming;

                    <tr>
                        <td>
                            <strong class="text-primary font-monospace fs-6">@item.MaCode</strong>
                        </td>
                        <td>
                            <div class="fw-semibold text-dark">@item.TenKhuyenMai</div>
                            @if (!string.IsNullOrWhiteSpace(item.MoTa))
                            {
                                <small class="text-muted d-block text-truncate" style="max-width: 240px;">@item.MoTa</small>
                            }
                        </td>
                        <td class="text-end">
                            <span class="fw-bold text-danger">
                                @(item.LoaiGiamGia == "Phần trăm" ? $"{item.GiaTriGiam:0.#}%" : $"{item.GiaTriGiam:N0} đ")
                            </span>
                        </td>
                        <td>
                            <span class="text-muted">
                                @(item.GiaTriDonHangToiThieu.HasValue && item.GiaTriDonHangToiThieu > 0 ? $"{item.GiaTriDonHangToiThieu:N0} đ" : "Không yêu cầu")
                            </span>
                        </td>
                        <td>
                            <small class="text-dark d-block">
                                Từ: @(item.NgayBatDau?.ToString("dd/MM/yyyy") ?? "Bắt đầu ngay")
                            </small>
                            <small class="text-muted d-block">
                                Đến: @(item.NgayKetThuc?.ToString("dd/MM/yyyy") ?? "Vô thời hạn")
                            </small>
                        </td>
                        <td class="text-center">
                            @if (item.SoLuong.HasValue)
                            {
                                <span class="badge bg-light text-dark border">@item.SoLuong.Value lượt</span>
                            }
                            else
                            {
                                <span class="text-muted small">&infin; Không giới hạn</span>
                            }
                        </td>
                        <td class="text-center">
                            @if (!item.TrangThai)
                            {
                                <span class="promo-status-badge disabled"><i class="bi bi-pause-circle"></i> Đã tắt</span>
                            }
                            else if (isExpired)
                            {
                                <span class="promo-status-badge expired"><i class="bi bi-clock-history"></i> Hết hạn</span>
                            }
                            else if (isUpcoming)
                            {
                                <span class="promo-status-badge upcoming"><i class="bi bi-calendar-event"></i> Sắp diễn ra</span>
                            }
                            else
                            {
                                <span class="promo-status-badge active"><i class="bi bi-check-circle"></i> Đang chạy</span>
                            }
                        </td>
                        <td class="text-end">
                            <form asp-action="Toggle" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@item.MaKhuyenMai" />
                                <button type="submit" class="btn btn-sm @(item.TrangThai ? "btn-outline-danger" : "btn-outline-success")" title="@(item.TrangThai ? "Tạm dừng chương trình" : "Kích hoạt chương trình")">
                                    <i class="bi @(item.TrangThai ? "bi-power" : "bi-play-fill") me-1"></i>
                                    @(item.TrangThai ? "Tắt" : "Bật")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                            Không có chương trình khuyến mãi nào được tìm thấy.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
